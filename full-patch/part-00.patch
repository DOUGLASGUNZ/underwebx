@@ -0,0 +1,356 @@
+import { computed, ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import { useUnderWebNetworkStore } from './underwebNetwork';
+import { useLocationStore } from './location';
+
+const CONFIG = Object.freeze({
+    enabled: 'UWX_oscEnabled',
+    customStatus: 'UWX_oscCustomStatus',
+    showWorld: 'UWX_oscShowWorld',
+    showEvent: 'UWX_oscShowEvent',
+    showHeartRate: 'UWX_oscShowHeartRate',
+    showNowPlaying: 'UWX_oscShowNowPlaying',
+    nowPlayingTitle: 'UWX_oscNowPlayingTitle',
+    nowPlayingArtist: 'UWX_oscNowPlayingArtist',
+    pulsoidToken: 'UWX_pulsoidToken',
+    pulseAvatarParameter: 'UWX_pulseAvatarParameter',
+    bpmAvatarParameter: 'UWX_bpmAvatarParameter',
+    preset: 'UWX_oscPreset'
+});
+
+const PRESETS = Object.freeze({
+    normal: { customStatus: '', showWorld: true, showEvent: false, showHeartRate: false, showNowPlaying: false },
+    music: { customStatus: '', showWorld: false, showEvent: false, showHeartRate: false, showNowPlaying: true },
+    event: { customStatus: 'UNDERWEB // EVENT LIVE', showWorld: true, showEvent: true, showHeartRate: true, showNowPlaying: true },
+    afk: { customStatus: 'AFK', showWorld: false, showEvent: false, showHeartRate: false, showNowPlaying: false }
+});
+
+const clampChatbox = (text) => Array.from(String(text || '')).slice(0, 144).join('');
+
+export const useOscLabStore = defineStore('OscLab', () => {
+    const networkStore = useUnderWebNetworkStore();
+    const locationStore = useLocationStore();
+
+    const initialized = ref(false);
+    const enabled = ref(false);
+    const customStatus = ref('');
+    const showWorld = ref(true);
+    const showEvent = ref(true);
+    const showHeartRate = ref(false);
+    const showNowPlaying = ref(false);
+    const nowPlayingTitle = ref('');
+    const nowPlayingArtist = ref('');
+    const pulsoidToken = ref('');
+    const heartRate = ref(0);
+    const heartRateState = ref('offline');
+    const pulseAvatarParameter = ref('isHRBeat');
+    const bpmAvatarParameter = ref('HR');
+    const preset = ref('normal');
+    const lastSentAt = ref(0);
+    const lastError = ref('');
+
+    let pulsoidSocket = null;
+    let reconnectTimer = null;
+
+    const worldName = computed(() => locationStore.lastLocation.name || 'VRChat');
+    const activeEvent = computed(() => networkStore.activeEvent);
+
+    const chatboxParts = computed(() => {
+        const parts = [];
+        if (customStatus.value.trim()) parts.push(customStatus.value.trim());
+        if (showEvent.value && activeEvent.value?.title) parts.push(`🕷 ${activeEvent.value.title}`);
+        if (showNowPlaying.value && nowPlayingTitle.value.trim()) {
+            parts.push(`🎵 ${nowPlayingTitle.value.trim()}${nowPlayingArtist.value.trim() ? ` — ${nowPlayingArtist.value.trim()}` : ''}`);
+        }
+        if (showHeartRate.value && heartRate.value > 0) parts.push(`♥ ${heartRate.value} BPM`);
+        if (showWorld.value && worldName.value) parts.push(`🌎 ${worldName.value}`);
+        return parts;
+    });
+
+    const chatboxPreview = computed(() => {
+        const preferred = chatboxParts.value.join(' · ');
+        if (preferred.length <= 144) return preferred;
+        // Drop lower-priority trailing blocks before hard truncation.
+        const priority = [...chatboxParts.value];
+        while (priority.length > 1 && priority.join(' · ').length > 144) priority.pop();
+        return clampChatbox(priority.join(' · '));
+    });
+
+    const previewLength = computed(() => Array.from(chatboxPreview.value).length);
+
+    async function loadSettings() {
+        const [
+            storedEnabled,
+            storedStatus,
+            storedWorld,
+            storedEvent,
+            storedHeartRate,
+            storedNowPlaying,
+            storedTitle,
+            storedArtist,
+            storedToken,
+            storedPulseParam,
+            storedBpmParam,
+            storedPreset
+        ] = await Promise.all([
+            configRepository.getBool(CONFIG.enabled, false),
+            configRepository.getString(CONFIG.customStatus, ''),
+            configRepository.getBool(CONFIG.showWorld, true),
+            configRepository.getBool(CONFIG.showEvent, true),
+            configRepository.getBool(CONFIG.showHeartRate, false),
+            configRepository.getBool(CONFIG.showNowPlaying, false),
+            configRepository.getString(CONFIG.nowPlayingTitle, ''),
+            configRepository.getString(CONFIG.nowPlayingArtist, ''),
+            configRepository.getString(CONFIG.pulsoidToken, ''),
+            configRepository.getString(CONFIG.pulseAvatarParameter, 'isHRBeat'),
+            configRepository.getString(CONFIG.bpmAvatarParameter, 'HR'),
+            configRepository.getString(CONFIG.preset, 'normal')
+        ]);
+        enabled.value = Boolean(storedEnabled);
+        customStatus.value = storedStatus || '';
+        showWorld.value = Boolean(storedWorld);
+        showEvent.value = Boolean(storedEvent);
+        showHeartRate.value = Boolean(storedHeartRate);
+        showNowPlaying.value = Boolean(storedNowPlaying);
+        nowPlayingTitle.value = storedTitle || '';
+        nowPlayingArtist.value = storedArtist || '';
+        pulsoidToken.value = storedToken || '';
+        pulseAvatarParameter.value = storedPulseParam || 'isHRBeat';
+        bpmAvatarParameter.value = storedBpmParam || 'HR';
+        preset.value = PRESETS[storedPreset] ? storedPreset : 'normal';
+    }
+
+    async function initOscLab() {
+        if (initialized.value) return;
+        await loadSettings();
+        initialized.value = true;
+        if (showHeartRate.value && pulsoidToken.value) connectPulsoid();
+    }
+
+    async function persistBool(key, value) {
+        await configRepository.setBool(key, Boolean(value));
+    }
+
+    async function setEnabled(value) {
+        enabled.value = Boolean(value);
+        await persistBool(CONFIG.enabled, enabled.value);
+    }
+
+    async function setCustomStatus(value) {
+        customStatus.value = String(value || '').slice(0, 144);
+        await configRepository.setString(CONFIG.customStatus, customStatus.value);
+    }
+
+    async function setShowWorld(value) {
+        showWorld.value = Boolean(value);
+        await persistBool(CONFIG.showWorld, showWorld.value);
+    }
+
+    async function setShowEvent(value) {
+        showEvent.value = Boolean(value);
+        await persistBool(CONFIG.showEvent, showEvent.value);
+    }
+
+    async function setShowHeartRate(value) {
+        showHeartRate.value = Boolean(value);
+        await persistBool(CONFIG.showHeartRate, showHeartRate.value);
+        if (showHeartRate.value && pulsoidToken.value) connectPulsoid();
+        if (!showHeartRate.value) disconnectPulsoid();
+    }
+
+    async function setShowNowPlaying(value) {
+        showNowPlaying.value = Boolean(value);
+        await persistBool(CONFIG.showNowPlaying, showNowPlaying.value);
+    }
+
+    async function setNowPlayingTitle(value) {
+        nowPlayingTitle.value = String(value || '').slice(0, 80);
+        await configRepository.setString(CONFIG.nowPlayingTitle, nowPlayingTitle.value);
+    }
+
+    async function setNowPlayingArtist(value) {
+        nowPlayingArtist.value = String(value || '').slice(0, 80);
+        await configRepository.setString(CONFIG.nowPlayingArtist, nowPlayingArtist.value);
+    }
+
+    async function setPulsoidToken(value) {
+        pulsoidToken.value = String(value || '').trim();
+        await configRepository.setString(CONFIG.pulsoidToken, pulsoidToken.value);
+        if (showHeartRate.value && pulsoidToken.value) connectPulsoid();
+        else disconnectPulsoid();
+    }
+
+    async function setPulseAvatarParameter(value) {
+        pulseAvatarParameter.value = String(value || '').trim() || 'isHRBeat';
+        await configRepository.setString(CONFIG.pulseAvatarParameter, pulseAvatarParameter.value);
+    }
+
+    async function setBpmAvatarParameter(value) {
+        bpmAvatarParameter.value = String(value || '').trim() || 'HR';
+        await configRepository.setString(CONFIG.bpmAvatarParameter, bpmAvatarParameter.value);
+    }
+
+    async function applyPreset(name) {
+        const next = PRESETS[name] || PRESETS.normal;
+        preset.value = PRESETS[name] ? name : 'normal';
+        customStatus.value = next.customStatus;
+        showWorld.value = next.showWorld;
+        showEvent.value = next.showEvent;
+        showHeartRate.value = next.showHeartRate;
+        showNowPlaying.value = next.showNowPlaying;
+        await Promise.all([
+            configRepository.setString(CONFIG.preset, preset.value),
+            configRepository.setString(CONFIG.customStatus, customStatus.value),
+            persistBool(CONFIG.showWorld, showWorld.value),
+            persistBool(CONFIG.showEvent, showEvent.value),
+            persistBool(CONFIG.showHeartRate, showHeartRate.value),
+            persistBool(CONFIG.showNowPlaying, showNowPlaying.value)
+        ]);
+        if (showHeartRate.value && pulsoidToken.value) connectPulsoid();
+        else disconnectPulsoid();
+    }
+
+    async function sendChatbox(text = chatboxPreview.value) {
+        if (!enabled.value) {
+            toast.error('Enable OSC Lab before sending to VRChat.');
+            return false;
+        }
+        const message = clampChatbox(text);
+        if (!message) return false;
+        try {
+            await AppApi.SendOscChatbox(message, true, false);
+            lastSentAt.value = Date.now();
+            lastError.value = '';
+            return true;
+        } catch (error) {
+            lastError.value = error?.message || 'OSC send failed.';
+            toast.error(lastError.value);
+            return false;
+        }
+    }
+
+    async function sendAvatarParameter(name, type, value) {
+        if (!enabled.value) throw new Error('OSC Lab is disabled.');
+        const parameter = String(name || '').trim();
+        if (!parameter) throw new Error('Avatar parameter name is required.');
+        if (type === 'bool') return AppApi.SendOscAvatarBool(parameter, Boolean(value));
+        if (type === 'int') return AppApi.SendOscAvatarInt(parameter, Math.round(Number(value) || 0));
+        return AppApi.SendOscAvatarFloat(parameter, Number(value) || 0);
+    }
+
+    async function pushHeartRateToAvatar() {
+        if (!enabled.value || heartRate.value <= 0) return;
+        try {
+            await Promise.all([
+                sendAvatarParameter(bpmAvatarParameter.value, 'int', heartRate.value),
+                sendAvatarParameter(pulseAvatarParameter.value, 'bool', true)
+            ]);
+            window.setTimeout(() => {
+                if (enabled.value) void sendAvatarParameter(pulseAvatarParameter.value, 'bool', false);
+            }, 150);
+        } catch {
+            // Do not turn a transient OSC issue into a noisy toast every heartbeat.
+        }
+    }
+
+    function disconnectPulsoid() {
+        if (reconnectTimer) window.clearTimeout(reconnectTimer);
+        reconnectTimer = null;
+        if (pulsoidSocket) {
+            pulsoidSocket.onclose = null;
+            pulsoidSocket.close();
+        }
+        pulsoidSocket = null;
+        heartRateState.value = 'offline';
+    }
+
+    function scheduleReconnect() {
+        if (!showHeartRate.value || !pulsoidToken.value || reconnectTimer) return;
+        reconnectTimer = window.setTimeout(() => {
+            reconnectTimer = null;
+            connectPulsoid();
+        }, 5000);
+    }
+
+    function connectPulsoid() {
+        disconnectPulsoid();
+        if (!showHeartRate.value || !pulsoidToken.value) return;
+        try {
+            heartRateState.value = 'connecting';
+            const url = `wss://dev.pulsoid.net/api/v1/data/real_time?access_token=${encodeURIComponent(pulsoidToken.value)}`;
+            pulsoidSocket = new WebSocket(url);
+            pulsoidSocket.onopen = () => {
+                heartRateState.value = 'online';
+                lastError.value = '';
+            };
+            pulsoidSocket.onmessage = (event) => {
+                try {
+                    const payload = JSON.parse(event.data);
