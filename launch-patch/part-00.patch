+import { computed, ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import { useUnderWebNetworkStore } from './underwebNetwork';
+import { useLocationStore } from './location';
+
+const CONFIG = Object.freeze({
+    enabled: 'UWX_oscEnabled',
+    customStatus: 'UWX_oscCustomStatus',
+    showWorld: 'UWX_oscShowWorld',
+    showEvent: 'UWX_oscShowEvent',
+    showHeartRate: 'UWX_oscShowHeartRate',
+    showNowPlaying: 'UWX_oscShowNowPlaying',
+    nowPlayingTitle: 'UWX_oscNowPlayingTitle',
+    nowPlayingArtist: 'UWX_oscNowPlayingArtist',
+    pulsoidToken: 'UWX_pulsoidToken',
+    pulseAvatarParameter: 'UWX_pulseAvatarParameter',
+    bpmAvatarParameter: 'UWX_bpmAvatarParameter',
+    preset: 'UWX_oscPreset'
+});
+
+const PRESETS = Object.freeze({
+    normal: { customStatus: '', showWorld: true, showEvent: false, showHeartRate: false, showNowPlaying: false },
+    music: { customStatus: '', showWorld: false, showEvent: false, showHeartRate: false, showNowPlaying: true },
+    event: { customStatus: 'UNDERWEB // EVENT LIVE', showWorld: true, showEvent: true, showHeartRate: true, showNowPlaying: true },
+    afk: { customStatus: 'AFK', showWorld: false, showEvent: false, showHeartRate: false, showNowPlaying: false }
+});
+
+const clampChatbox = (text) => Array.from(String(text || '')).slice(0, 144).join('');
+
+export const useOscLabStore = defineStore('OscLab', () => {
+    const networkStore = useUnderWebNetworkStore();
+    const locationStore = useLocationStore();
+
+    const initialized = ref(false);
+    const enabled = ref(false);
+    const customStatus = ref('');
+    const showWorld = ref(true);
+    const showEvent = ref(true);
+    const showHeartRate = ref(false);
+    const showNowPlaying = ref(false);
+    const nowPlayingTitle = ref('');
+    const nowPlayingArtist = ref('');
+    const pulsoidToken = ref('');
+    const heartRate = ref(0);
+    const heartRateState = ref('offline');
+    const pulseAvatarParameter = ref('isHRBeat');
+    const bpmAvatarParameter = ref('HR');
+    const preset = ref('normal');
+    const lastSentAt = ref(0);
+    const lastError = ref('');
+
+    let pulsoidSocket = null;
+    let reconnectTimer = null;
+
+    const worldName = computed(() => locationStore.lastLocation.name || 'VRChat');
+    const activeEvent = computed(() => networkStore.activeEvent);
+
+    const chatboxParts = computed(() => {
+        const parts = [];
+        if (customStatus.value.trim()) parts.push(customStatus.value.trim());
+        if (showEvent.value && activeEvent.value?.title) parts.push(`🕷 ${activeEvent.value.title}`);
+        if (showNowPlaying.value && nowPlayingTitle.value.trim()) {
+            parts.push(`🎵 ${nowPlayingTitle.value.trim()}${nowPlayingArtist.value.trim() ? ` — ${nowPlayingArtist.value.trim()}` : ''}`);
+        }
+        if (showHeartRate.value && heartRate.value > 0) parts.push(`♥ ${heartRate.value} BPM`);
+        if (showWorld.value && worldName.value) parts.push(`🌎 ${worldName.value}`);
+        return parts;
+    });
+
+    const chatboxPreview = computed(() => {
+        const preferred = chatboxParts.value.join(' · ');
+        if (preferred.length <= 144) return preferred;
+        // Drop lower-priority trailing blocks before hard truncation.
+        const priority = [...chatboxParts.value];
+        while (priority.length > 1 && priority.join(' · ').length > 144) priority.pop();
+        return clampChatbox(priority.join(' · '));
+    });
+
+    const previewLength = computed(() => Array.from(chatboxPreview.value).length);
+
+    async function loadSettings() {
+        const [
+            storedEnabled,
+            storedStatus,
+            storedWorld,
+            storedEvent,
+            storedHeartRate,
+            storedNowPlaying,
+            storedTitle,
+            storedArtist,
+            storedToken,
+            storedPulseParam,
+            storedBpmParam,
+            storedPreset
+        ] = await Promise.all([
+            configRepository.getBool(CONFIG.enabled, false),
+            configRepository.getString(CONFIG.customStatus, ''),
+            configRepository.getBool(CONFIG.showWorld, true),
+            configRepository.getBool(CONFIG.showEvent, true),
+            configRepository.getBool(CONFIG.showHeartRate, false),
+            configRepository.getBool(CONFIG.showNowPlaying, false),
+            configRepository.getString(CONFIG.nowPlayingTitle, ''),
+            configRepository.getString(CONFIG.nowPlayingArtist, ''),
+            configRepository.getString(CONFIG.pulsoidToken, ''),
+            configRepository.getString(CONFIG.pulseAvatarParameter, 'isHRBeat'),
+            configRepository.getString(CONFIG.bpmAvatarParameter, 'HR'),
+            configRepository.getString(CONFIG.preset, 'normal')
+        ]);
+        enabled.value = Boolean(storedEnabled);
+        customStatus.value = storedStatus || '';
+        showWorld.value = Boolean(storedWorld);
+        showEvent.value = Boolean(storedEvent);
+        showHeartRate.value = Boolean(storedHeartRate);
+        showNowPlaying.value = Boolean(storedNowPlaying);
+        nowPlayingTitle.value = storedTitle || '';
+        nowPlayingArtist.value = storedArtist || '';
+        pulsoidToken.value = storedToken || '';
+        pulseAvatarParameter.value = storedPulseParam || 'isHRBeat';
+        bpmAvatarParameter.value = storedBpmParam || 'HR';
+        preset.value = PRESETS[storedPreset] ? storedPreset : 'normal';
+    }
+
+    async function initOscLab() {
+        if (initialized.value) return;
+        await loadSettings();
+        initialized.value = true;
+        if (showHeartRate.value && pulsoidToken.value) connectPulsoid();
+    }
+
+    async function persistBool(key, value) {
+        await configRepository.setBool(key, Boolean(value));
+    }
+
+    async function setEnabled(value) {
