+        private static byte[] OscPaddedString(string value)
+        {
+            var raw = Encoding.UTF8.GetBytes(value ?? string.Empty);
+            var length = raw.Length + 1;
+            var padded = (length + 3) & ~3;
+            var output = new byte[padded];
+            Buffer.BlockCopy(raw, 0, output, 0, raw.Length);
+            return output;
+        }
+
+        private static byte[] OscInt32(int value)
+        {
+            var bytes = BitConverter.GetBytes(value);
+            if (BitConverter.IsLittleEndian) Array.Reverse(bytes);
+            return bytes;
+        }
+
+        private static byte[] OscFloat32(float value)
+        {
+            var bytes = BitConverter.GetBytes(value);
+            if (BitConverter.IsLittleEndian) Array.Reverse(bytes);
+            return bytes;
+        }
+
+        private static void SendOscPacket(string address, string typeTags, params byte[][] payloadParts)
+        {
+            if (string.IsNullOrWhiteSpace(address) || !address.StartsWith('/'))
+                throw new ArgumentException("Invalid OSC address", nameof(address));
+
+            var parts = new List<byte[]>
+            {
+                OscPaddedString(address),
+                OscPaddedString("," + typeTags)
+            };
+            parts.AddRange(payloadParts ?? Array.Empty<byte[]>());
+            var size = 0;
+            foreach (var part in parts) size += part.Length;
+            var packet = new byte[size];
+            var offset = 0;
+            foreach (var part in parts)
+            {
+                Buffer.BlockCopy(part, 0, packet, offset, part.Length);
+                offset += part.Length;
+            }
+
+            using var udp = new UdpClient();
+            udp.Send(packet, packet.Length, new IPEndPoint(IPAddress.Loopback, 9000));
+        }
+
+        public void SendOscChatbox(string text, bool sendImmediately, bool playNotification)
+        {
+            var safe = text ?? string.Empty;
+            if (safe.Length > 512) safe = safe[..512];
+            SendOscPacket(
+                "/chatbox/input",
+                "s" + (sendImmediately ? "T" : "F") + (playNotification ? "T" : "F"),
+                OscPaddedString(safe)
+            );
+        }
+
+        private static string NormalizeOscParameter(string parameter)
+        {
+            var value = (parameter ?? string.Empty).Trim();
+            if (string.IsNullOrWhiteSpace(value) || value.Contains("..") || value.Contains('\\'))
+                throw new ArgumentException("Invalid OSC avatar parameter", nameof(parameter));
+            return value.Trim('/');
+        }
+
+        public void SendOscAvatarBool(string parameter, bool value)
+        {
+            var name = NormalizeOscParameter(parameter);
+            SendOscPacket($"/avatar/parameters/{name}", value ? "T" : "F");
+        }
+
+        public void SendOscAvatarInt(string parameter, int value)
+        {
+            var name = NormalizeOscParameter(parameter);
+            SendOscPacket($"/avatar/parameters/{name}", "i", OscInt32(value));
+        }
+
+        public void SendOscAvatarFloat(string parameter, double value)
+        {
+            var name = NormalizeOscParameter(parameter);
+            SendOscPacket($"/avatar/parameters/{name}", "f", OscFloat32((float)value));
+        }
