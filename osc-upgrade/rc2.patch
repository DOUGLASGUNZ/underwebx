+        broadcastTimer = window.setInterval(() => {
+            if (enabled.value && autoBroadcast.value && chatboxPreview.value) void sendChatbox();
+        }, 4000);
+    }
+
+    async function refreshSystemMedia() {
+        if (!autoMedia.value) return;
+        try {
+            const raw = await AppApi.GetSystemMediaInfo();
+            const data = raw ? JSON.parse(raw) : {};
+            mediaState.value = String(data?.status || 'idle').toLowerCase();
+            mediaSource.value = String(data?.source || '');
+            if (data?.title) nowPlayingTitle.value = String(data.title).slice(0, 80);
+            if (data?.artist) nowPlayingArtist.value = String(data.artist).slice(0, 80);
+            if (!data?.title && mediaState.value === 'idle') {
+                mediaState.value = 'nothing playing';
+            }
+        } catch (error) {
+            mediaState.value = 'unavailable';
+            lastError.value = error?.message || lastError.value;
+        }
+    }
+
+    function stopMediaPolling() {
+        if (mediaTimer) window.clearInterval(mediaTimer);
+        mediaTimer = null;
+        mediaState.value = 'manual';
+    }
+
+    function startMediaPolling() {
+        stopMediaPolling();
+        if (!autoMedia.value) return;
+        void refreshSystemMedia();
+        mediaTimer = window.setInterval(() => void refreshSystemMedia(), 4000);
