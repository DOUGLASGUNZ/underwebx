+        public async Task<string> GetSystemMediaInfo()
+        {
+#if WINDOWS
+            try
+            {
+                var manager = await GlobalSystemMediaTransportControlsSessionManager.RequestAsync();
+                var sessions = manager.GetSessions();
+                GlobalSystemMediaTransportControlsSession? session = null;
+
+                foreach (var candidate in sessions)
+                {
+                    if ((candidate.SourceAppUserModelId ?? string.Empty).Contains("Spotify", StringComparison.OrdinalIgnoreCase))
+                    {
+                        session = candidate;
+                        break;
+                    }
+                }
+
+                session ??= manager.GetCurrentSession();
+                if (session == null) return "{}";
+
+                var properties = await session.TryGetMediaPropertiesAsync();
+                var playback = session.GetPlaybackInfo();
+                return JsonConvert.SerializeObject(new
+                {
+                    title = properties?.Title ?? string.Empty,
+                    artist = properties?.Artist ?? string.Empty,
+                    album = properties?.AlbumTitle ?? string.Empty,
+                    source = session.SourceAppUserModelId ?? string.Empty,
+                    status = playback?.PlaybackStatus.ToString() ?? string.Empty
+                });
+            }
+            catch (Exception ex)
+            {
+                logger.Debug(ex, "Unable to read Windows media session");
+                return "{}";
+            }
+#else
+            return "{}";
+#endif
+        }
