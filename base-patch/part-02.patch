+
+const MANIFEST_URL = 'https://underweb.cloud/api/uwx/manifest';
+const MANIFEST_TIMEOUT_MS = 7000;
+const CONFIG = Object.freeze({
+    cachedManifest: 'UWX_networkCachedManifest',
+    cachedAt: 'UWX_networkCachedAt',
+    notifications: 'UWX_networkNotificationRules'
+});
+
+const DEFAULT_NOTIFICATIONS = Object.freeze({
+    eventLive: true,
+    approvedInstance: true,
+    favoriteOnline: false,
+    updateAvailable: true
+});
+
+
+function compareVersions(a, b) {
+    const pa = String(a || '').replace(/^v/i, '').split('.').map((value) => Number.parseInt(value, 10) || 0);
+    const pb = String(b || '').replace(/^v/i, '').split('.').map((value) => Number.parseInt(value, 10) || 0);
+    const length = Math.max(pa.length, pb.length);
+    for (let index = 0; index < length; index += 1) {
+        const av = pa[index] || 0;
+        const bv = pb[index] || 0;
+        if (av > bv) return 1;
+        if (av < bv) return -1;
+    }
+    return 0;
+}
+
+function asArray(value) {
+    return Array.isArray(value) ? value : [];
+}
+
+function normalizeManifest(raw) {
+    const manifest = raw && typeof raw === 'object' ? raw : {};
+    const members = asArray(manifest.members)
+        .map((member) => ({
+            underwebUserId: String(member?.underwebUserId || member?.id || ''),
+            vrchatUserId: String(member?.vrchatUserId || member?.vrchat?.id || ''),
+            displayName: String(member?.displayName || member?.name || ''),
+            roles: asArray(member?.roles).map((role) => String(role)),
+            creatorTypes: asArray(member?.creatorTypes).map((role) => String(role)),
+            badges: asArray(member?.badges).map((role) => String(role)),
+            partner: Boolean(member?.partner),
+            staff: Boolean(member?.staff)
+        }))
+        .filter((member) => member.vrchatUserId.startsWith('usr_'));
+
+    const events = asArray(manifest.events)
+        .map((event) => ({
+            id: String(event?.id || ''),
+            title: String(event?.title || 'UnderWeb Event'),
+            status: String(event?.status || 'upcoming').toLowerCase(),
+            startAt: event?.startAt || null,
+            endAt: event?.endAt || null,
+            worldId: String(event?.worldId || ''),
+            groupId: String(event?.groupId || ''),
+            instanceTag: String(event?.instanceTag || ''),
+            host: String(event?.host || ''),
+            posterUrl: String(event?.posterUrl || ''),
+            staff: asArray(event?.staff).map((value) => String(value)),
+            performers: asArray(event?.performers).map((value) => String(value))
+        }))
+        .filter((event) => event.id || event.title);
+
+    return {
+        schemaVersion: String(manifest.schemaVersion || manifest.version || '1'),
+        generatedAt: manifest.generatedAt || null,
+        self: manifest.self && typeof manifest.self === 'object' ? manifest.self : null,
+        members,
+        events,
+        release: manifest.release && typeof manifest.release === 'object' ? manifest.release : null
+    };
+}
+
+export const useUnderWebNetworkStore = defineStore('UnderWebNetwork', () => {
