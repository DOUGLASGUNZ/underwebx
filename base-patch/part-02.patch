+            },
+            discord: {
+                connected: Boolean(discordId),
+                id: discordId,
+                label: discordName || 'Discord'
+            }
+        };
+    });
+
+    const activeEvent = computed(() => manifest.value.events.find((event) => event.status === 'live') || null);
