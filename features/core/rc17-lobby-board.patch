+        return d <= 0 ? 'today' : d === 1 ? 'yesterday' : `${d}d ago`;
+    };
+
+    async function inviteToGroup(row) {
+        busyId.value = row.userId;
+        try {
+            const result = await underweb.invitePlayerToGroup(row);
+            if (result === 'member') board.markMember(row.userId, 'member');
