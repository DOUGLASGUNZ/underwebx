+import { describe, expect, it } from 'vitest';
+import { buildLobbyRows, filterLobby, formatHere, lobbySummary } from '../uwxLobby';
+
+const NOW = Date.parse('2026-10-16T00:00:00Z');
+const MIN = 60000;
+const p = (n, name, minsAgo) => ({ userId: `usr_${n}`, displayName: name, joinTime: NOW - minsAgo * MIN });
+
+describe('uwxLobby', () => {
+    const players = [p('me', 'Darko', 90), p('a', 'Friend', 30), p('b', 'Blooty', 60), p('c', 'Stranger', 5), p('d', 'BadActor', 2), p('e', 'Newbie', 10)];
+    const ctx = {
+        selfId: 'usr_me',
+        now: NOW,
+        isFriend: (id) => id === 'usr_a',
+        isStaff: (id) => id === 'usr_b',
+        roles: (id) => (id === 'usr_b' ? ['Moderator'] : []),
+        intel: (id) => (id === 'usr_d' ? { risk_level: 'high', verified_flags: ['crashing'] } : null),
+        notesCount: (id) => (id === 'usr_c' ? 2 : 0),
+        membership: (id) => ({ usr_a: 'member', usr_b: 'member', usr_c: 'not-member', usr_e: 'member' })[id] || 'unknown',
+        joinedGroupAt: (id) => (id === 'usr_e' ? NOW - 2 * 24 * 60 * MIN : id === 'usr_a' ? NOW - 300 * 24 * 60 * MIN : 0)
+    };
+
+    it('orders labeled, then staff, then new members, then non-members; never lists you', () => {
+        const rows = buildLobbyRows(players, ctx);
+        expect(rows.map((r) => r.displayName)).toEqual(['BadActor', 'Blooty', 'Newbie', 'Stranger', 'Friend']);
+        expect(rows.find((r) => r.displayName === 'Newbie').isNew).toBe(true);
+        expect(rows.find((r) => r.displayName === 'Friend').isNew).toBe(false);
+        expect(rows.find((r) => r.displayName === 'Stranger')).toMatchObject({ notes: 2, membership: 'not-member', hereMs: 5 * MIN });
+    });
+
+    it('summarizes and filters', () => {
+        const rows = buildLobbyRows(players, ctx);
+        expect(lobbySummary(rows)).toEqual({ total: 5, friends: 1, members: 3, notMembers: 1, newMembers: 1, staff: 1, labeled: 1 });
+        expect(filterLobby(rows, 'not-member').map((r) => r.displayName)).toEqual(['Stranger']);
+        expect(filterLobby(rows, 'labeled').map((r) => r.displayName)).toEqual(['BadActor']);
+        expect(filterLobby(rows, 'all')).toHaveLength(5);
+    });
+
+    it('formats time here', () => {
+        expect(formatHere(30 * 1000)).toBe('just now');
+        expect(formatHere(42 * MIN)).toBe('42m');
+        expect(formatHere(125 * MIN)).toBe('2h 5m');
+    });
+});
diff --git a/src/shared/utils/uwxLobby.js b/src/shared/utils/uwxLobby.js
new file mode 100644
index 0000000..c0c5e49
--- /dev/null
+++ b/src/shared/utils/uwxLobby.js
@@ -0,0 +1,83 @@
+// Live lobby board (pure): who's in your instance, with everything UWX knows about them.
+
+import { riskRank } from './uwxSafety';
+
+export const LOBBY_FILTERS = Object.freeze([
+    { id: 'all', label: 'Everyone' },
+    { id: 'not-member', label: 'Not in group' },
+    { id: 'new', label: 'New members' },
+    { id: 'friends', label: 'Friends' },
+    { id: 'staff', label: 'Staff' },
+    { id: 'labeled', label: 'Labeled' }
+]);
+
+const WEEK = 7 * 24 * 60 * 60 * 1000;
+
+/**
+ * @param {Array<{userId:string, displayName:string, joinTime?:number}>} players
+ * @param {object} ctx  lookups: selfId, now, isFriend, roles, isStaff, intel, notesCount, membership, joinedGroupAt
+ */
+export function buildLobbyRows(players, ctx) {
+    const now = ctx.now || Date.now();
+    return (players || [])
+        .filter((p) => String(p?.userId || '').startsWith('usr_') && p.userId !== ctx.selfId)
+        .map((p) => {
+            const intel = ctx.intel?.(p.userId) || null;
+            const joinedGroupAt = ctx.joinedGroupAt?.(p.userId) || 0;
+            const membership = ctx.membership?.(p.userId) || 'unknown';
+            return {
+                userId: p.userId,
+                displayName: p.displayName || p.userId,
+                hereMs: p.joinTime ? Math.max(0, now - p.joinTime) : 0,
+                friend: Boolean(ctx.isFriend?.(p.userId)),
+                roles: ctx.roles?.(p.userId) || [],
+                staff: Boolean(ctx.isStaff?.(p.userId)),
+                intel,
+                notes: ctx.notesCount?.(p.userId) || 0,
+                membership,
+                isNew: membership !== 'not-member' && joinedGroupAt > 0 && now - joinedGroupAt < WEEK,
+                joinedGroupAt
+            };
+        })
+        .sort((a, b) => {
+            const score = (r) =>
+                (r.intel ? 1000 + riskRank(r.intel.risk_level) * 10 : 0) + (r.staff ? 100 : 0) + (r.isNew ? 50 : 0) + (r.membership === 'not-member' ? 10 : 0);
+            return score(b) - score(a) || b.hereMs - a.hereMs;
+        });
+}
+
+export function lobbySummary(rows) {
+    return {
+        total: rows.length,
+        friends: rows.filter((r) => r.friend).length,
+        members: rows.filter((r) => r.membership === 'member').length,
+        notMembers: rows.filter((r) => r.membership === 'not-member').length,
+        newMembers: rows.filter((r) => r.isNew).length,
+        staff: rows.filter((r) => r.staff).length,
+        labeled: rows.filter((r) => r.intel).length
+    };
+}
+
+export function filterLobby(rows, filter) {
+    switch (filter) {
+        case 'not-member':
+            return rows.filter((r) => r.membership === 'not-member');
+        case 'new':
+            return rows.filter((r) => r.isNew);
+        case 'friends':
+            return rows.filter((r) => r.friend);
+        case 'staff':
+            return rows.filter((r) => r.staff);
+        case 'labeled':
+            return rows.filter((r) => r.intel);
+        default:
+            return rows;
+    }
+}
+
+export function formatHere(ms) {
+    const m = Math.floor(ms / 60000);
+    if (m < 1) return 'just now';
+    if (m < 60) return `${m}m`;
+    return `${Math.floor(m / 60)}h ${m % 60}m`;
+}
