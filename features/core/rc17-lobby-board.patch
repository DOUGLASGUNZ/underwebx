+    const groupStore = useGroupStore();
+    const notes = useUwxMemberNotesStore();
+    const modalStore = useModalStore();
+
+    const filter = ref('all');
+    const busyId = ref('');
+
+    const groupName = computed(() => (groupId.value ? groupStore.currentUserGroups.get(groupId.value)?.name || 'this group' : ''));
+    const inInstance = computed(() => Boolean(currentParsedLocation.value?.isRealInstance));
+    const visibleFilters = computed(() =>
+        LOBBY_FILTERS.filter((f) => f.id === 'all' || (f.id === 'not-member' ? summary.value.notMembers : f.id === 'new' ? summary.value.newMembers : f.id === 'friends' ? summary.value.friends : f.id === 'staff' ? summary.value.staff : summary.value.labeled))
