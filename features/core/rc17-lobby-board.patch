diff --git a/src/stores/uwxLobbyBoard.js b/src/stores/uwxLobbyBoard.js
new file mode 100644
index 0000000..33a3cb1
--- /dev/null
+++ b/src/stores/uwxLobbyBoard.js
@@ -0,0 +1,131 @@
+import { computed, reactive, ref, watch } from 'vue';
+import { defineStore } from 'pinia';
+
+import { groupRequest } from '../api';
+import auditArchive from '../services/uwxAuditArchive';
+import { watchState } from '../services/watchState';
+import { buildLobbyRows, lobbySummary } from '../shared/utils/uwxLobby';
+import { useFriendStore } from './friend';
+import { useLocationStore } from './location';
+import { useSafetyIntelStore } from './safetyIntel';
+import { useUnderWebStore } from './underweb';
+import { useUnderWebNetworkStore } from './underwebNetwork';
+import { useUserStore } from './user';
+import { useUwxMemberNotesStore } from './uwxMemberNotes';
+
+// Live lobby board: everyone in your instance with roles, labels, notes, time here,
+// and whether they're in "our" group (the group recruiting targets here).
+// Group membership is checked gently — one VRChat request at a time, cached for the session —
+// and only while the board is on screen.
+
+const CHECK_GAP_MS = 1500;
+
+export const useUwxLobbyBoardStore = defineStore('UwxLobbyBoard', () => {
+    const locationStore = useLocationStore();
+    const friendStore = useFriendStore();
+    const network = useUnderWebNetworkStore();
+    const safety = useSafetyIntelStore();
+    const underweb = useUnderWebStore();
+    const userStore = useUserStore();
+    const notes = useUwxMemberNotesStore();
+
+    const now = ref(Date.now());
+    const visible = ref(false);
+    /** `${groupId}:${userId}` -> 'member' | 'not-member' */
+    const membership = reactive(new Map());
+    /** groupId -> Map(userId -> first join ts) from the local audit archive */
+    const joinsByGroup = reactive(new Map());
+    let checking = false;
+    let clock = null;
+
+    const groupId = computed(() => underweb.recruitGroupId || underweb.currentGroupId || '');
+
+    const rows = computed(() => {
+        const gid = groupId.value;
+        const joins = joinsByGroup.get(gid);
+        return buildLobbyRows(Array.from(locationStore.lastLocation.playerList?.values?.() || []), {
+            selfId: userStore.currentUser?.id,
+            now: now.value,
+            isFriend: (id) => friendStore.friends.has(id),
+            roles: (id) => network.rolesForUser(id),
+            isStaff: (id) => network.staffUserIds.has(id),
+            intel: (id) => safety.getIntel(id),
+            notesCount: (id) => notes.forUser(id).length,
+            membership: (id) => (gid ? membership.get(`${gid}:${id}`) || 'unknown' : 'unknown'),
+            joinedGroupAt: (id) => joins?.get(id) || 0
+        });
+    });
+    const summary = computed(() => lobbySummary(rows.value));
+
+    async function loadJoins(gid) {
+        if (!gid || joinsByGroup.has(gid)) return;
+        joinsByGroup.set(gid, new Map());
+        try {
+            const entries = await auditArchive.loadGroup(gid, 5000);
+            const map = new Map();
+            for (const e of entries) {
+                if (e.eventType === 'group.member.join' && e.actorId && (!map.has(e.actorId) || e.ts < map.get(e.actorId))) {
+                    map.set(e.actorId, e.ts);
+                }
+            }
+            joinsByGroup.set(gid, map);
+        } catch {
+            // No archive yet — "new member" just won't show.
+        }
+    }
+
+    async function checkMemberships() {
+        if (checking || !visible.value || !watchState.isLoggedIn) return;
+        const gid = groupId.value;
+        if (!gid) return;
+        checking = true;
+        try {
+            for (const row of rows.value) {
+                if (!visible.value || groupId.value !== gid) break;
+                const key = `${gid}:${row.userId}`;
+                if (membership.has(key)) continue;
+                try {
+                    const args = await groupRequest.getGroupMember({ groupId: gid, userId: row.userId });
+                    membership.set(key, args?.json ? 'member' : 'not-member');
+                } catch (error) {
+                    const status = error?.status || error?.statusCode;
+                    if (status === 404) membership.set(key, 'not-member');
+                    else if (status === 429) break;
+                }
+                await new Promise((r) => setTimeout(r, CHECK_GAP_MS));
+            }
+        } finally {
+            checking = false;
+        }
+    }
+
+    function markMember(userId, value) {
+        if (groupId.value) membership.set(`${groupId.value}:${userId}`, value);
+    }
+
+    function show() {
+        visible.value = true;
+        void notes.load();
+        void loadJoins(groupId.value);
+        void safety.batchLookup(rows.value.map((r) => r.userId)).catch(() => {});
+        void checkMemberships();
+        if (!clock) clock = setInterval(() => (now.value = Date.now()), 15000);
+    }
+
+    function hide() {
+        visible.value = false;
+        if (clock) clearInterval(clock);
+        clock = null;
+    }
+
+    watch(
+        () => [groupId.value, rows.value.map((r) => r.userId).join(',')],
+        () => {
+            if (!visible.value) return;
+            void loadJoins(groupId.value);
+            void checkMemberships();
+        }
+    );
+
+    return { rows, summary, groupId, visible, show, hide, markMember, checkMemberships };
+});
