diff --git a/src/stores/uwxStaffOps.js b/src/stores/uwxStaffOps.js
new file mode 100644
index 0000000..15ee92b
--- /dev/null
+++ b/src/stores/uwxStaffOps.js
@@ -0,0 +1,426 @@
+import { computed, reactive, ref, watch } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import { useLocationStore } from './location';
+import { useUwxAccountStore } from './uwxAccount';
+import { useUwxEventModeStore } from './uwxEventMode';
+import { useUwxGroupToolsStore } from './uwxGroupTools';
+import { useUwxIntelStore } from './uwxIntel';
+
+// UWX staff operations, all through UnderWeb (RLS decides who sees what):
+//   - on duty: check in / check out (uwx_staff_shifts)
+//   - "need staff here" help requests with desktop alerts (uwx_help_requests)
+//   - staff summary per person (uwx_staff_stats) — workload and responsiveness, never a ban leaderboard
+//   - alerts when someone with an open case (or a high-severity case a partner group shares) is in your instance
+//   - alerts when a case becomes escalated / critical, or one assigned to you changes
+//   - Event Mode recaps shared with the rest of staff (uwx_event_recaps)
+
+const SETTINGS_KEY = 'UWX_staffOpsSettings';
+const UPLOADED_KEY = 'UWX_recapsUploaded';
+const POLL_MS = 60 * 1000;
+const FLAGS_EVERY_MS = 10 * 60 * 1000;
+const errorText = (e) => e?.error?.message || e?.message || 'Unknown error';
+
+function desktopNotify(title, body) {
+    try {
+        if (typeof WINDOWS !== 'undefined' && WINDOWS && typeof AppApi !== 'undefined') AppApi.DesktopNotification(title, body, '');
+        else window.electron?.desktopNotification?.(title, body, '');
+    } catch {
+        // best effort
+    }
+}
+
+/** Which people in the instance match flagged subjects (pure, for tests). */
+export function matchFlagged(occupants, flagged) {
+    const byId = new Map();
+    for (const f of flagged || []) {
+        const list = byId.get(f.subject_vrc_id) || [];
+        list.push(f);
+        byId.set(f.subject_vrc_id, list);
+    }
+    const out = [];
+    for (const p of occupants || []) {
+        const hits = byId.get(p.userId);
+        if (hits) out.push({ ...p, cases: hits });
+    }
+    return out;
+}
+
+/** Text for one flagged person, most severe first. */
+export function flagText(hit) {
+    const order = { critical: 0, high: 1, medium: 2, low: 3 };
+    const c = hit.cases.slice().sort((a, b) => (order[a.severity] ?? 9) - (order[b.severity] ?? 9))[0];
+    const where = c.source === 'own' ? `case #${c.case_number}` : `reported by ${c.source}`;
+    return `${hit.displayName} is in your instance — ${where} (${c.severity}${hit.cases.length > 1 ? `, ${hit.cases.length} cases` : ''})`;
+}
+
+export const useUwxStaffOpsStore = defineStore('UwxStaffOps', () => {
+    const account = useUwxAccountStore();
+    const intel = useUwxIntelStore();
+    const tools = useUwxGroupToolsStore();
+    const locationStore = useLocationStore();
+
+    const settings = reactive({ alertFlagged: true, alertHelp: true, alertCases: true });
+    const onDuty = ref([]);
+    const myShift = ref(null);
+    const help = ref([]);
+    const stats = ref([]);
+    const statsDays = ref(7);
+    const statsLoading = ref(false);
+    const recaps = ref([]);
+    const flagged = ref([]);
+    const flaggedHere = ref([]);
+    const names = ref({});
+    const error = ref('');
+    const busy = ref(false);
+
+    const remote = computed(() => intel.remote);
+    const level = computed(() => intel.level);
+    const ready = computed(() => Boolean(account.signedIn && remote.value && level.value >= 1));
+
+    let timer = null;
+    let started = false;
+    let flagsAt = 0;
+    let lastPollIso = '';
+    const seenHelp = new Set();
+    const notifiedFlags = new Set();
+    let flagLocation = '';
+
+    async function loadSettings() {
+        try {
+            const raw = JSON.parse((await configRepository.getString(SETTINGS_KEY, '')) || '{}');
+            for (const k of Object.keys(settings)) if (typeof raw[k] === 'boolean') settings[k] = raw[k];
+        } catch {
+            // defaults
+        }
+    }
+    async function setOption(key, value) {
+        if (!(key in settings)) return;
+        settings[key] = Boolean(value);
+        await configRepository.setString(SETTINGS_KEY, JSON.stringify({ ...settings }));
+    }
+
+    async function resolveNames(ids) {
+        const missing = [...new Set(ids.filter((id) => id && !names.value[id]))];
+        if (!missing.length || !remote.value) return;
+        try {
+            const rows = (await account.rpc('uwx_names', { p_group: remote.value.id, p_ids: missing })) || [];
+            const next = { ...names.value };
+            for (const r of rows) next[r.user_id] = r.display_name || r.username || 'Staff';
+            names.value = next;
+        } catch {
+            // cosmetic
+        }
+    }
+    const nameOf = (id) => (id === account.userId ? 'You' : names.value[id] || 'Staff');
+
+    // ───────── duty ─────────
+    async function loadDuty() {
+        const g = remote.value.id;
+        const rows = (await account.api(`uwx_staff_shifts?select=id,user_id,started_at,note&group_id=eq.${g}&ended_at=is.null&order=started_at.asc`)) || [];
+        onDuty.value = rows;
+        myShift.value = rows.find((r) => r.user_id === account.userId) || null;
+        await resolveNames(rows.map((r) => r.user_id));
+    }
+
+    async function checkIn(note = '') {
+        if (!ready.value) return false;
+        busy.value = true;
+        try {
+            await account.api('uwx_staff_shifts', {
+                method: 'POST',
+                headers: { Prefer: 'return=minimal' },
+                body: JSON.stringify({ group_id: remote.value.id, user_id: account.userId, note: String(note).slice(0, 200) })
+            });
+            await loadDuty();
+            toast.success('You’re on duty.');
+            return true;
+        } catch (e) {
+            toast.error(/duplicate|unique/i.test(errorText(e)) ? 'You’re already checked in.' : errorText(e));
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    async function checkOut() {
+        if (!myShift.value) return false;
+        busy.value = true;
+        try {
+            await account.api(`uwx_staff_shifts?id=eq.${myShift.value.id}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ ended_at: new Date().toISOString() }) });
+            await loadDuty();
+            toast.success('Checked out. Thanks for covering!');
+            return true;
+        } catch (e) {
+            toast.error(errorText(e));
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    // ───────── help requests ─────────
+    async function loadHelp({ notify = false } = {}) {
+        const g = remote.value.id;
+        const since = new Date(Date.now() - 24 * 3600 * 1000).toISOString();
+        const rows =
+            (await account.api(
+                `uwx_help_requests?select=*&group_id=eq.${g}&or=${encodeURIComponent(`(status.neq.closed,created_at.gte."${since}")`)}&order=created_at.desc&limit=50`
+            )) || [];
+        await resolveNames(rows.flatMap((r) => [r.requested_by, r.claimed_by]));
+        for (const r of rows) {
+            if (seenHelp.has(r.id)) continue;
+            seenHelp.add(r.id);
+            if (notify && settings.alertHelp && r.status === 'open' && r.requested_by !== account.userId) {
+                const text = `${nameOf(r.requested_by)} needs staff${r.world_name ? ` in ${r.world_name}` : ''}${r.message ? `: ${r.message}` : ''}`;
+                if (r.urgency === 'urgent') toast.error(text);
+                else toast.warning(text);
+                desktopNotify(r.urgency === 'urgent' ? 'URGENT: staff needed' : 'Staff needed', text);
+            }
+        }
+        help.value = rows;
+    }
+
+    async function requestHelp({ message = '', urgency = 'normal', includeLocation = true } = {}) {
+        if (!ready.value) return false;
+        const loc = locationStore.lastLocation;
+        try {
+            await account.api('uwx_help_requests', {
+                method: 'POST',
+                headers: { Prefer: 'return=minimal' },
+                body: JSON.stringify({
+                    group_id: remote.value.id,
+                    requested_by: account.userId,
+                    world_name: includeLocation ? String(loc?.name || '').slice(0, 120) || null : null,
+                    location: includeLocation ? String(loc?.location || '').slice(0, 300) || null : null,
+                    message: String(message).slice(0, 500),
+                    urgency
+                })
+            });
+            await loadHelp();
+            toast.success('Staff have been alerted.');
+            return true;
+        } catch (e) {
+            toast.error(errorText(e));
+            return false;
+        }
+    }
+
+    async function updateHelp(id, action) {
+        try {
+            await account.rpc('uwx_help_update', { p_id: id, p_action: action });
+            await loadHelp();
+        } catch (e) {
+            toast.error(errorText(e));
+        }
+    }
+
+    // ───────── case alerts ─────────
+    async function pollCases() {
+        if (level.value < 2 || !settings.alertCases) return;
+        const g = remote.value.id;
+        const since = lastPollIso || new Date().toISOString();
+        lastPollIso = new Date().toISOString();
+        if (since === lastPollIso) return;
+        const rows =
+            (await account.api(
+                `uwx_cases?select=id,case_number,title,status,severity,assigned_to,updated_at&group_id=eq.${g}&updated_at=gt.${encodeURIComponent(since)}&order=updated_at.asc&limit=50`
+            )) || [];
+        for (const c of rows) {
+            const important = c.status === 'escalated' || c.severity === 'critical';
+            const mine = c.assigned_to === account.userId;
+            if (!important && !mine) continue;
+            const text = `Case #${c.case_number} ${important ? `(${c.status === 'escalated' ? 'escalated' : 'critical'})` : '(assigned to you)'} was updated: ${c.title}`;
+            toast.info(text);
+            desktopNotify('UnderWeb case updated', text);
+        }
+    }
+
+    // ───────── flagged people in your instance ─────────
+    async function loadFlagged(force = false) {
+        if (level.value < 2) {
+            flagged.value = [];
+            return;
+        }
+        if (!force && Date.now() - flagsAt < FLAGS_EVERY_MS) return;
+        try {
+            flagged.value = (await account.rpc('uwx_flagged_subjects', { p_group: remote.value.id })) || [];
+            flagsAt = Date.now();
+        } catch {
+            flagged.value = [];
+        }
+        checkInstance();
+    }
+
+    function checkInstance() {
+        const loc = String(locationStore.lastLocation?.location || '');
+        if (loc !== flagLocation) {
+            flagLocation = loc;
+            notifiedFlags.clear();
+        }
+        flaggedHere.value = matchFlagged(tools.instanceOccupants, flagged.value);
+        if (!settings.alertFlagged) return;
+        for (const hit of flaggedHere.value) {
+            if (notifiedFlags.has(hit.userId)) continue;
+            notifiedFlags.add(hit.userId);
+            const text = flagText(hit);
+            toast.warning(text, { duration: 15000 });
+            desktopNotify('Flagged user in your instance', `${text}. Check Moderation → User Intelligence before acting.`);
+        }
+    }
+
+    // ───────── stats ─────────
+    async function loadStats(days = statsDays.value) {
+        if (!ready.value) return;
+        statsDays.value = days;
+        statsLoading.value = true;
+        try {
+            stats.value = (await account.rpc('uwx_staff_stats', { p_group: remote.value.id, p_since: new Date(Date.now() - days * 86400000).toISOString() })) || [];
+            error.value = '';
+        } catch (e) {
+            error.value = /uwx_staff_stats|does not exist|schema cache/i.test(errorText(e)) ? 'The staff database step for this release isn’t applied yet.' : errorText(e);
+        } finally {
+            statsLoading.value = false;
+        }
+    }
+
+    // ───────── Event Mode recaps ─────────
+    async function syncRecaps() {
+        if (!ready.value) return;
+        const eventMode = useUwxEventModeStore();
+        let uploaded = [];
+        try {
+            uploaded = JSON.parse((await configRepository.getString(UPLOADED_KEY, '')) || '[]');
+        } catch {
+            uploaded = [];
+        }
+        const key = (r) => `${remote.value.id}:${r.id || r.startedAt}`;
+        const pending = (eventMode.history || []).filter((r) => r?.startedAt && !uploaded.includes(key(r)));
+        if (pending.length) {
+            const rows = pending.map((r) => ({
+                group_id: remote.value.id,
+                recorded_by: account.userId,
+                client_event_id: String(r.id || r.startedAt).slice(0, 80),
+                name: String(r.name || 'Event').slice(0, 120),
+                started_at: new Date(r.startedAt).toISOString(),
+                ended_at: r.endedAt ? new Date(r.endedAt).toISOString() : null,
+                peak: Math.max(0, Math.round(r.peak || 0)),
+                unique_count: Math.max(0, Math.round(r.unique || 0)),
+                stayed_five: Math.max(0, Math.round(r.stayedFiveMinutes || 0)),
+                group_invites: Math.max(0, Math.round(r.groupInvites || 0)),
+                instance_invites: Math.max(0, Math.round(r.instanceInvites || 0)),
+                staff_present: (r.staffPresent || []).map((s) => String(s).slice(0, 80)).slice(0, 50)
+            }));
+            try {
+                await account.api('uwx_event_recaps?on_conflict=group_id,recorded_by,client_event_id', {
+                    method: 'POST',
+                    headers: { Prefer: 'resolution=ignore-duplicates,return=minimal' },
+                    body: JSON.stringify(rows)
+                });
+                await configRepository.setString(UPLOADED_KEY, JSON.stringify([...uploaded, ...pending.map(key)].slice(-500)));
+            } catch {
+                // retry next poll
+            }
+        }
+        try {
+            recaps.value =
+                (await account.api(
+                    `uwx_event_recaps?select=id,name,started_at,ended_at,peak,unique_count,stayed_five,group_invites,instance_invites,staff_present,recorded_by&group_id=eq.${remote.value.id}&order=started_at.desc&limit=200`
+                )) || [];
+        } catch {
+            recaps.value = [];
+        }
+    }
+
+    // ───────── loop ─────────
+    async function poll({ notify = true } = {}) {
+        if (!ready.value) return;
+        try {
+            await Promise.all([loadDuty(), loadHelp({ notify }), pollCases()]);
+            await loadFlagged();
+            error.value = '';
+        } catch (e) {
+            error.value = /uwx_staff_shifts|uwx_help_requests|does not exist|schema cache/i.test(errorText(e)) ? 'The staff database step for this release isn’t applied yet.' : errorText(e);
+        }
+    }
+
+    async function start() {
+        if (started) return;
+        started = true;
+        await loadSettings();
+        // Staff ops need to know the registered group even if Group Intel was never opened.
+        await intel.load();
+        watch(
+            () => account.signedIn,
+            (signedIn) => {
+                if (signedIn) void intel.loadRegistered();
+            },
+            { immediate: true }
+        );
+        watch(
+            () => [ready.value, remote.value?.id],
+            async ([isReady]) => {
+                clearInterval(timer);
+                timer = null;
+                seenHelp.clear();
+                lastPollIso = '';
+                flagsAt = 0;
+                if (!isReady) {
+                    onDuty.value = [];
+                    help.value = [];
+                    flagged.value = [];
+                    return;
+                }
+                try {
+                    await account.rpc('uwx_close_stale_shifts', { p_group: remote.value.id });
+                } catch {
+                    // older database: fine
+                }
+                await poll({ notify: false });
+                void syncRecaps();
+                timer = setInterval(() => void poll(), POLL_MS);
+            },
+            { immediate: true }
+        );
+        // Re-check whenever the people in your instance change.
+        watch(
+            () => tools.instanceOccupants.map((p) => p.userId).join(','),
+            () => checkInstance()
+        );
+        watch(
+            () => useUwxEventModeStore().history?.length,
+            () => void syncRecaps()
+        );
+    }
+
+    return {
+        settings,
+        onDuty,
+        myShift,
+        help,
+        stats,
+        statsDays,
+        statsLoading,
+        recaps,
+        flagged,
+        flaggedHere,
+        error,
+        busy,
+        ready,
+        level,
+        remote,
+        nameOf,
+        setOption,
+        start,
+        poll,
+        checkIn,
+        checkOut,
+        requestHelp,
+        updateHelp,
+        loadStats,
+        loadFlagged,
+        syncRecaps
+    };
+});
