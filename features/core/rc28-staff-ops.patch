+import { describe, expect, test } from 'vitest';
+import { vi } from 'vitest';
+
+vi.mock('../../services/config', () => ({ default: { getString: async () => '', setString: async () => {} } }));
+vi.mock('vue-sonner', () => ({ toast: {} }));
+vi.mock('../location', () => ({ useLocationStore: () => ({}) }));
+vi.mock('../uwxAccount', () => ({ useUwxAccountStore: () => ({}) }));
+vi.mock('../uwxEventMode', () => ({ useUwxEventModeStore: () => ({}) }));
+vi.mock('../uwxGroupTools', () => ({ useUwxGroupToolsStore: () => ({}) }));
+vi.mock('../uwxIntel', () => ({ useUwxIntelStore: () => ({}) }));
+
+const { flagText, matchFlagged } = await import('../uwxStaffOps');
+
+describe('flagged people in your instance', () => {
+    const flagged = [
+        { subject_vrc_id: 'usr_a', case_number: 14, severity: 'high', source: 'own' },
+        { subject_vrc_id: 'usr_a', case_number: 3, severity: 'critical', source: 'Symbiotes' },
+        { subject_vrc_id: 'usr_b', case_number: 9, severity: 'medium', source: 'own' }
+    ];
+
+    test('matches only people who are actually here', () => {
+        const hits = matchFlagged([{ userId: 'usr_a', displayName: 'Crash' }, { userId: 'usr_c', displayName: 'Fine' }], flagged);
+        expect(hits.map((h) => h.userId)).toEqual(['usr_a']);
+        expect(hits[0].cases).toHaveLength(2);
+        expect(matchFlagged([], flagged)).toEqual([]);
+    });
+
+    test('alert text leads with the most severe case and says where it came from', () => {
+        const [hit] = matchFlagged([{ userId: 'usr_a', displayName: 'Crash' }], flagged);
+        expect(flagText(hit)).toBe('Crash is in your instance — reported by Symbiotes (critical, 2 cases)');
+        const [own] = matchFlagged([{ userId: 'usr_b', displayName: 'Bob' }], flagged);
+        expect(flagText(own)).toBe('Bob is in your instance — case #9 (medium)');
+    });
+});
