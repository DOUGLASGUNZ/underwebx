+    const hours = (m) => (m ? (m >= 60 ? `${(m / 60).toFixed(1)} h` : `${m} min`) : '—');
+    const mins = (m) => (m >= 60 ? `${(m / 60).toFixed(1)} h` : `${Math.round(m)} min`);
+    const time = (v) => new Date(v).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
+    function elapsed(v) {
+        const m = Math.max(0, Math.round((now.value - Date.parse(v)) / 60000));
+        return m >= 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m} min`;
+    }
