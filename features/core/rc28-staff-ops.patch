+    const compact = computed(() => intel.settings.compact);
+    const groupName = computed(() => intel.group?.name || remote.value?.name || '');
+    const worldName = computed(() => locationStore.lastLocation?.name || 'not in a world');
+    const LEVELS = ['', 'Viewer', 'Moderator', 'Manager', 'Owner'];
+
+    const now = ref(Date.now());
+    let tick = null;
+    onMounted(async () => {
+        await ops.start();
+        void intel.start();
+        void ops.poll({ notify: false });
