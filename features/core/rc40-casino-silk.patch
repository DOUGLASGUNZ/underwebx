new file mode 100644
index 0000000..3686b0e
--- /dev/null
+++ b/src/shared/utils/uwxCasino.js
@@ -0,0 +1,92 @@
+// UnderWeb casino: one Silk balance between the hub casino and underweb.cloud.
+//
+// Every few minutes the casino's instance master writes one line per player to VRChat's log:
+//   [VRCX] UWSILK SNAP 1|<last seq applied>|<balance>|<whale tier>|<legacy level>|<declined seqs>|<display name>
+// VRCX hands everything after "[VRCX] " to UWX. UWX matches each display name to the VRChat user id
+// it already saw join the instance, then reports the latest balance per player to underweb.cloud
+// (uw_casino_report) at most once a minute. Only hub worlds, only when the setting is on.
+
+/** "UWSILK SNAP 1|12|1234567890123|7|1||Dаrko" -> snapshot, or null if it isn't one. */
+export function parseSnapLine(data) {
+    const text = String(data ?? '').replace(/[\r\n]+$/, '');
+    const prefix = 'UWSILK SNAP 1|';
+    if (!text.startsWith(prefix)) return null;
+    const parts = text.slice(prefix.length).split('|');
+    if (parts.length < 6) return null;
+    const [seq, balance, tier, legacy, declined] = parts;
+    const name = parts.slice(5).join('|'); // name is last, so a "|" in it can't shift the columns
+    if (!/^\d{1,18}$/.test(seq) || !/^\d{1,19}$/.test(balance)) return null;
+    if (!/^\d{1,2}$/.test(tier) || !/^\d{1,2}$/.test(legacy)) return null;
+    if (declined && !/^\d{1,18}(,\d{1,18})*$/.test(declined)) return null;
+    if (!name || name.length > 64) return null;
+    return {
+        display_name: name,
+        last_seq: seq,
+        balance, // string: balances can be above 2^53
+        whale_tier: Number(tier),
+        legacy_level: Number(legacy),
+        declined: declined ? declined.split(',') : []
+    };
+}
+
+/** VRChat user id for a display name from the instance player list (Map of { displayName, userId }). */
+export function userIdForName(playerList, name) {
+    if (!playerList || !name) return '';
+    for (const p of playerList.values ? playerList.values() : []) {
+        if (p?.displayName === name && /^usr_[A-Za-z0-9-]{5,40}$/.test(p.userId || '')) return p.userId;
+    }
+    return '';
+}
+
+/**
+ * Collects snapshots and reports the newest one per player, batched.
+ * ctx() -> { enabled, worldId, playerList, rpc } is read at the moment a line arrives / a batch is sent.
+ */
+export function createCasinoReporter(ctx, { minGapMs = 60000, settleMs = 15000, now = () => Date.now(), timers = globalThis } = {}) {
+    const pending = new Map(); // vrc_user_id -> row
+    let worldId = '';
+    let timer = null;
+    let lastSent = 0;
+
+    function schedule() {
+        if (timer) return;
+        const wait = Math.max(settleMs, lastSent + minGapMs - now());
+        timer = timers.setTimeout(() => {
+            timer = null;
+            void flush();
+        }, wait);
+    }
+
+    async function flush() {
+        const c = ctx();
+        if (!pending.size || !c.enabled || !c.rpc || !worldId) return null;
+        const rows = [...pending.values()].slice(0, 100);
+        rows.forEach((r) => pending.delete(r.vrc_user_id));
+        lastSent = now();
+        try {
+            return await c.rpc('uw_casino_report', { p_world_id: worldId, p_rows: rows });
+        } catch {
+            rows.forEach((r) => pending.has(r.vrc_user_id) || pending.set(r.vrc_user_id, r)); // try again next batch
+            return null;
+        } finally {
+            if (pending.size) schedule();
+        }
+    }
+
+    function push(data, dt) {
+        const c = ctx();
+        if (!c.enabled || !c.worldId) return false;
+        const snap = parseSnapLine(data);
+        if (!snap) return false;
+        const vrc = userIdForName(c.playerList, snap.display_name);
+        if (!vrc) return false;
+        if (worldId && worldId !== c.worldId) pending.clear();
+        worldId = c.worldId;
+        const seenAt = new Date(dt || now());
+        pending.set(vrc, { vrc_user_id: vrc, ...snap, seen_at: Number.isNaN(seenAt.getTime()) ? new Date(now()).toISOString() : seenAt.toISOString() });
+        schedule();
+        return true;
+    }
+
+    return { push, flush, get size() { return pending.size; } };
+}
