@@ -0,0 +1,100 @@
+import { describe, expect, test, vi } from 'vitest';
+
+import { createCasinoReporter, parseSnapLine, userIdForName } from '../uwxCasino';
+
+const ME = 'usr_6608aa1d-6133-49f4-aae5-d1145d76abd1';
+const BLOOTY = 'usr_11086c52-c5a1-493a-8b35-d41e0d05c816';
+const players = new Map([
+    [ME, { displayName: 'Dаrko', userId: ME }], // Cyrillic а
+    [BLOOTY, { displayName: 'Blooty', userId: BLOOTY }]
+]);
+
+describe('casino snapshot lines', () => {
+    test('parses a snapshot, keeping huge balances as strings', () => {
+        expect(parseSnapLine('UWSILK SNAP 1|12|9123456789012345678|7|1|5,9|Dаrko')).toEqual({
+            display_name: 'Dаrko',
+            last_seq: '12',
+            balance: '9123456789012345678',
+            whale_tier: 7,
+            legacy_level: 1,
+            declined: ['5', '9']
+        });
+    });
+
+    test('a "|" in a display name stays in the name', () => {
+        expect(parseSnapLine('UWSILK SNAP 1|0|5|0|0||A|B').display_name).toBe('A|B');
+    });
+
+    test('rejects anything malformed', () => {
+        for (const bad of [
+            '',
+            'UWLike Bob\tx\t1',
+            'UWSILK SNAP 2|1|1|0|0||Bob',
+            'UWSILK SNAP 1|1|-5|0|0||Bob',
+            'UWSILK SNAP 1|1|5|0|0||',
+            'UWSILK SNAP 1|x|5|0|0||Bob',
+            'UWSILK SNAP 1|1|5|0|0|1,,2|Bob',
+            'UWSILK SNAP 1|1|5|0|0'
+        ]) {
+            expect(parseSnapLine(bad)).toBeNull();
+        }
+    });
+
+    test('matches display names exactly (Latin a is not Cyrillic а)', () => {
+        expect(userIdForName(players, 'Dаrko')).toBe(ME);
+        expect(userIdForName(players, 'Darko')).toBe('');
+    });
+});
+
+describe('casino reporter', () => {
+    const setup = (over = {}) => {
+        const rpc = vi.fn(async () => ({ status: 'ok', accepted: 1 }));
+        let t = 1_000_000;
+        const timers = { pending: [], setTimeout: (fn, ms) => timers.pending.push({ fn, ms }) };
+        const ctx = { enabled: true, worldId: 'wrld_6075046e-74f3-4c5d-8433-9f28149bfd81', playerList: players, rpc, ...over };
+        const r = createCasinoReporter(() => ctx, { now: () => t, timers });
+        return { r, rpc, ctx, timers, advance: (ms) => (t += ms) };
+    };
+
+    test('keeps the newest line per player and sends one batch', async () => {
+        const { r, rpc, timers } = setup();
+        expect(r.push('UWSILK SNAP 1|3|100|0|0||Dаrko', '2026-11-19T22:00:00Z')).toBe(true);
+        expect(r.push('UWSILK SNAP 1|4|250|1|0||Dаrko', '2026-11-19T22:05:00Z')).toBe(true);
+        expect(r.push('UWSILK SNAP 1|0|7|0|0||Blooty', '2026-11-19T22:05:00Z')).toBe(true);
+        expect(timers.pending).toHaveLength(1); // one timer, not one per line
+        await r.flush();
+        expect(rpc).toHaveBeenCalledTimes(1);
+        const [name, args] = rpc.mock.calls[0];
+        expect(name).toBe('uw_casino_report');
+        expect(args.p_world_id).toBe('wrld_6075046e-74f3-4c5d-8433-9f28149bfd81');
+        expect(args.p_rows).toHaveLength(2);
+        expect(args.p_rows.find((x) => x.vrc_user_id === ME)).toMatchObject({ balance: '250', last_seq: '4', whale_tier: 1, seen_at: '2026-11-19T22:05:00.000Z' });
+        expect(r.size).toBe(0);
+    });
+
+    test('ignores players it never saw join, and does nothing when off or outside the hub', async () => {
+        expect(setup().r.push('UWSILK SNAP 1|0|5|0|0||Stranger', '2026-11-19T22:00:00Z')).toBe(false);
+        expect(setup({ enabled: false }).r.push('UWSILK SNAP 1|0|5|0|0||Blooty')).toBe(false);
+        expect(setup({ worldId: '' }).r.push('UWSILK SNAP 1|0|5|0|0||Blooty')).toBe(false);
+    });
+
+    test('keeps rows for the next batch when sending fails', async () => {
+        const { r, rpc } = setup();
+        rpc.mockRejectedValueOnce(new Error('offline'));
+        r.push('UWSILK SNAP 1|0|5|0|0||Blooty', '2026-11-19T22:00:00Z');
+        expect(await r.flush()).toBeNull();
+        expect(r.size).toBe(1);
+        await r.flush();
+        expect(rpc).toHaveBeenCalledTimes(2);
+        expect(r.size).toBe(0);
+    });
+
+    test('waits at least a minute between batches', async () => {
+        const { r, timers } = setup();
+        r.push('UWSILK SNAP 1|0|5|0|0||Blooty', '2026-11-19T22:00:00Z');
+        timers.pending.shift().fn();
+        await Promise.resolve();
+        r.push('UWSILK SNAP 1|0|6|0|0||Blooty', '2026-11-19T22:00:30Z');
+        expect(timers.pending.at(-1).ms).toBeGreaterThanOrEqual(59000);
+    });
+});
