+import { describe, expect, test } from 'vitest';
+
+import {
+    eventStartConfirm,
+    friendAutoConfirm,
+    friendBatchConfirm,
+    friendStatus,
+    groupAutoConfirm,
+    groupBatchConfirm,
+    groupStatus,
+    namesPreview
+} from '../uwxInviteSafety';
+
+const names = (n) => Array.from({ length: n }, (_, i) => `P${i + 1}`);
+
+describe('UWX invite safety text', () => {
+    test('names preview', () => {
+        expect(namesPreview([])).toBe('nobody right now');
+        expect(namesPreview(['Vex'])).toBe('Vex');
+        expect(namesPreview(['Vex', 'Kai'])).toBe('Vex and Kai');
+        expect(namesPreview(names(8))).toBe('P1, P2, P3, P4, P5 and 3 more');
+    });
+
+    test('turning on auto invites for ALL online friends is a loud, red confirm with names and count', () => {
+        const c = friendAutoConfirm({ scopeId: 'all-online', scopeLabel: 'All online friends', eligibleNames: names(37), poolCount: 41, messageText: 'MVN at the Hub', cooldownMinutes: 30 });
+        expect(c.title).toBe('Auto-invite ALL your online friends?');
+        expect(c.description).toMatch(/37 people: P1, P2, P3, P4, P5 and 32 more/);
+        expect(c.description).toMatch(/41 online/);
+        expect(c.description).toMatch(/“MVN at the Hub”/);
+        expect(c.confirmText).toBe('Turn on · invite 37 now');
+        expect(c.destructive).toBe(true);
+    });
+
+    test('a small favorites setup is a normal confirm', () => {
+        const c = friendAutoConfirm({ scopeId: 'favorites', scopeLabel: 'Favorite friends', eligibleNames: ['Vex', 'Kai'], poolCount: 4, cooldownMinutes: 30 });
+        expect(c.title).toBe('Turn on automatic friend invites?');
+        expect(c.description).toMatch(/2 people: Vex and Kai/);
+        expect(c.description).toMatch(/No message attached/);
+        expect(c.destructive).toBe(false);
+    });
+
+    test('batch confirms', () => {
+        expect(friendBatchConfirm({ names: names(12), scopeLabel: 'Favorite friends', messageText: '' })).toMatchObject({ title: 'Send 12 friend invites now?', confirmText: 'Invite 12', destructive: true });
+        expect(groupBatchConfirm({ groupName: 'The UnderWeb', names: ['Vex'] })).toMatchObject({ title: 'Send 1 group invite to The UnderWeb?', destructive: false });
+        expect(groupAutoConfirm({ groupName: 'The UnderWeb', eligibleNames: [], dwellSeconds: 60 }).description).toMatch(/after 60s here/);
+    });
+
+    test('event start only asks when the preset sends invites', () => {
+        expect(eventStartConfirm({ eventName: 'Hub Hangout', friendAuto: false, groupAuto: false })).toBe(null);
+        const c = eventStartConfirm({ eventName: 'MVN', friendAuto: true, friendScopeLabel: 'Favorite friends', friendCount: 6, groupAuto: true, groupName: 'The UnderWeb', groupCount: 3 });
+        expect(c.description).toBe('This turns on auto friend invites to favorite friends (6 people right now) and automatic group invites to The UnderWeb (3 eligible here). Everything goes back to your usual settings when the event ends.');
+    });
+
+    test('status lines say exactly what is happening', () => {
+        expect(friendStatus({ enabled: false }).state).toBe('off');
+        expect(friendStatus({ enabled: true, canInviteHere: false, blockedReason: 'Only the instance owner can invite here.' }).text).toMatch(/paused here: Only the instance owner/);
+        expect(friendStatus({ enabled: true, canInviteHere: true, autoAllowedHere: false }).state).toBe('blocked');
+        expect(friendStatus({ enabled: true, canInviteHere: true, autoAllowedHere: true, scopeLabel: 'Favorite friends', poolCount: 5, eligibleNames: ['Vex', 'Kai'], cooldownMinutes: 30 }).text).toBe(
+            'On — inviting favorite friends (5 online) to you, each at most once per 30 min. Next: Vex and Kai.'
+        );
+        expect(groupStatus({ enabled: true, canRecruitHere: true, groupName: 'The UnderWeb', eligibleCount: 2, dwellSeconds: 60 }).text).toBe(
+            "On — people here who aren't in The UnderWeb get a group invite after 60s. 2 people ready now."
+        );
+        expect(groupStatus({ enabled: true, canRecruitHere: false, blockedText: 'Not our instance.' }).state).toBe('blocked');
+    });
+});
