+++ b/src/views/UnderWeb/useInviteGuard.js
@@ -0,0 +1,104 @@
+// "Are you sure?" for everything that sends invites. Every switch and button that can
+// invite people goes through here, so turning something on always shows who it would hit.
+
+import { toast } from 'vue-sonner';
+
+import {
+    CONFIRM_BATCH_AT,
+    eventStartConfirm,
+    friendAutoConfirm,
+    friendBatchConfirm,
+    groupAutoConfirm,
+    groupBatchConfirm
+} from '../../shared/utils/uwxInviteSafety';
+import { useGroupStore, useModalStore, useUnderWebStore } from '../../stores';
+import { useUwxAccessStore } from '../../stores/uwxAccess';
+
+export const SCOPE_LABELS = Object.freeze({
+    selected: 'Selected friends',
+    favorites: 'Favorite friends',
+    'all-online': 'All online friends',
+    staff: 'UnderWeb staff',
+    creators: 'UnderWeb creators',
+    partners: 'UnderWeb partners'
+});
+
+export function useInviteGuard() {
+    const underweb = useUnderWebStore();
+    const modal = useModalStore();
+    const groupStore = useGroupStore();
+
+    const groupName = () => groupStore.currentUserGroups.get(underweb.recruitGroupId)?.name || 'your group';
+    const nameOf = (f) => f?.displayName || f?.ref?.displayName || f?.id;
+    const ask = async (c) => (await modal.confirm({ ...c, dismissible: true })).ok;
+
+    async function setFriendAuto(value) {
+        if (!value) return underweb.setAutoInviteEnabled(false);
+        const ok = await ask(
+            friendAutoConfirm({
+                scopeId: underweb.inviteScope,
+                scopeLabel: SCOPE_LABELS[underweb.inviteScope] || 'Selected friends',
+                eligibleNames: underweb.eligibleInviteFriends.map(nameOf),
+                poolCount: underweb.invitePoolFriends.length,
+                messageText: underweb.selectedInviteMessage,
+                cooldownMinutes: underweb.cooldownMinutes
+            })
+        );
+        if (ok) await underweb.setAutoInviteEnabled(true);
+    }
+
+    async function setGroupAuto(value) {
+        if (!value) return underweb.setGroupRecruitEnabled(false);
+        const ok = await ask(
+            groupAutoConfirm({
+                groupName: groupName(),
+                eligibleNames: underweb.eligibleLobbyRecruits.map((p) => p.displayName),
+                dwellSeconds: underweb.groupRecruitMinPresenceSeconds
+            })
+        );
+        if (ok) await underweb.setGroupRecruitEnabled(true);
+    }
+
+    /** "Invite now" for a list of friend ids. Asks first for 3 or more. */
+    async function inviteFriends(ids) {
+        const list = (ids || []).filter(Boolean);
+        if (!list.length) {
+            toast.info('Nobody to invite.');
+            return null;
+        }
+        if (list.length >= CONFIRM_BATCH_AT) {
+            const names = list.map((id) => underweb.selectedFriends.find((f) => f.id === id) || underweb.allOnlineFriends.find((f) => f.id === id)).map((f, i) => nameOf(f) || list[i]);
+            const ok = await ask(friendBatchConfirm({ names, scopeLabel: SCOPE_LABELS[underweb.inviteScope] || 'Friends', messageText: underweb.selectedInviteMessage }));
+            if (!ok) return null;
+        }
+        return underweb.inviteFriendsNow(list);
+    }
+
+    async function recruitLobby() {
+        const names = underweb.eligibleLobbyRecruits.map((p) => p.displayName);
+        if (!names.length) {
+            toast.info('Nobody in this lobby can get a group invite right now.');
+            return null;
+        }
+        if (!(await ask(groupBatchConfirm({ groupName: groupName(), names })))) return null;
+        return underweb.scanAndRecruitGroup({ source: 'manual', force: true });
+    }
+
+    /** Before Event Mode switches invites on. */
+    async function confirmEventStart(preset, eventName) {
+        const groupAuto = Boolean(preset.recruit && useUwxAccessStore().showGroupInvites);
+        const pool = underweb.poolForScope(preset.scope).filter((f) => underweb.isFriendEligible(f));
+        const c = eventStartConfirm({
+            eventName: eventName || preset.name,
+            friendAuto: Boolean(preset.autoInvite),
+            friendScopeLabel: SCOPE_LABELS[preset.scope] || 'Favorite friends',
+            friendCount: pool.length,
+            groupAuto,
+            groupName: groupName(),
+            groupCount: underweb.eligibleLobbyRecruits.length
+        });
+        return c ? ask(c) : true;
+    }
+
+    return { setFriendAuto, setGroupAuto, inviteFriends, recruitLobby, confirmEventStart, stopAll: () => underweb.stopAllInvites() };
+}
