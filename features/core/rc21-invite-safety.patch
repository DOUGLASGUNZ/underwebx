@@ -0,0 +1,117 @@
+// Invite safety: the plain-English "are you sure" text and status lines for friend
+// (instance) invites and group invites. Pure — the views show these in dialogs/cards.
+
+/** Manual batches this size or bigger ask first. */
+export const CONFIRM_BATCH_AT = 3;
+/** Automatic friend invites never send more than this in one go (15s apart). */
+export const AUTO_FRIEND_MAX_PER_SCAN = 8;
+/** At or above this many people, the confirm button is red. */
+export const BIG_BATCH = 10;
+
+const plural = (n, one, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
+
+/** "Vex, Kai, Moth and 4 more" */
+export function namesPreview(names, max = 5) {
+    const list = (names || []).filter(Boolean);
+    if (!list.length) return 'nobody right now';
+    if (list.length <= max) return list.length === 1 ? list[0] : `${list.slice(0, -1).join(', ')} and ${list.at(-1)}`;
+    return `${list.slice(0, max).join(', ')} and ${list.length - max} more`;
+}
+
+const messageLine = (text) => (text ? `Message: “${text}”.` : 'No message attached.');
+
+/**
+ * Turning ON automatic friend (instance) invites.
+ * @param {{ scopeId: string, scopeLabel: string, eligibleNames: string[], poolCount: number, messageText?: string, cooldownMinutes: number }} o
+ */
+export function friendAutoConfirm(o) {
+    const n = o.eligibleNames.length;
+    const everyone = o.scopeId === 'all-online';
+    return {
+        title: everyone ? 'Auto-invite ALL your online friends?' : 'Turn on automatic friend invites?',
+        description: [
+            `UWX will keep sending VRChat invites to ${o.scopeLabel.toLowerCase()} (${o.poolCount} online) to join you here, and again whenever you move instance.`,
+            n ? `Right away that's ${plural(n, 'person', 'people')}: ${namesPreview(o.eligibleNames)}.` : 'Nobody would be invited right this second.',
+            `Each person gets at most one invite per ${o.cooldownMinutes} minutes per instance, up to ${AUTO_FRIEND_MAX_PER_SCAN} every 15 seconds.`,
+            messageLine(o.messageText)
+        ].join(' '),
+        confirmText: n ? `Turn on · invite ${n} now` : 'Turn on',
+        destructive: everyone || n >= BIG_BATCH
+    };
+}
+
+/** "Invite now" for friends. */
+export function friendBatchConfirm({ names, scopeLabel, messageText }) {
+    const n = names.length;
+    return {
+        title: `Send ${plural(n, 'friend invite')} now?`,
+        description: `${scopeLabel}: ${namesPreview(names, 8)}. They'll get a VRChat invite to this instance, one every 2.5 seconds. ${messageLine(messageText)} You can stop it from the pop-up.`,
+        confirmText: `Invite ${n}`,
+        destructive: n >= BIG_BATCH
+    };
+}
+
+/** Turning ON automatic group invites. */
+export function groupAutoConfirm({ groupName, eligibleNames, dwellSeconds }) {
+    const n = eligibleNames.length;
+    return {
+        title: `Turn on automatic group invites to ${groupName}?`,
+        description: [
+            `Anyone in this lobby who isn't in ${groupName} gets a VRChat group invite after ${dwellSeconds}s here — and new people as they join.`,
+            n ? `Right away: ${namesPreview(eligibleNames)}.` : 'Nobody here is eligible right now.',
+            'Only in our instances. Members, labeled people and your do-not-invite list are skipped; each person once per day.'
+        ].join(' '),
+        confirmText: n ? `Turn on · invite ${n} now` : 'Turn on',
+        destructive: n >= BIG_BATCH
+    };
+}
+
+/** "Invite N to group" button. */
+export function groupBatchConfirm({ groupName, names }) {
+    const n = names.length;
+    return {
+        title: `Send ${plural(n, 'group invite')} to ${groupName}?`,
+        description: `${namesPreview(names, 8)}. Each is checked first — anyone already in the group is skipped. One every 3 seconds; you can stop it from the pop-up.`,
+        confirmText: `Invite ${n} to group`,
+        destructive: n >= BIG_BATCH
+    };
+}
+
+/**
+ * Starting an Event Mode preset that turns invites on.
+ * @returns {null | { title, description, confirmText, destructive }} null when the preset sends nothing
+ */
+export function eventStartConfirm({ eventName, friendAuto, friendScopeLabel, friendCount, groupAuto, groupName, groupCount }) {
+    if (!friendAuto && !groupAuto) return null;
+    const parts = [];
+    if (friendAuto) parts.push(`auto friend invites to ${friendScopeLabel.toLowerCase()} (${plural(friendCount, 'person', 'people')} right now)`);
+    if (groupAuto) parts.push(`automatic group invites to ${groupName} (${groupCount} eligible here)`);
+    const total = (friendAuto ? friendCount : 0) + (groupAuto ? groupCount : 0);
+    return {
+        title: `Start ${eventName}?`,
+        description: `This turns on ${parts.join(' and ')}. Everything goes back to your usual settings when the event ends.`,
+        confirmText: 'Start event',
+        destructive: friendScopeLabel.toLowerCase().startsWith('all') || total >= BIG_BATCH
+    };
+}
+
+/**
+ * One-line status for a card: what is happening right now, in plain words.
+ * @returns {{ state: 'on'|'off'|'blocked', text: string }}
+ */
+export function friendStatus({ enabled, canInviteHere, autoAllowedHere, blockedReason, scopeLabel, poolCount, eligibleNames, cooldownMinutes }) {
+    if (!enabled) return { state: 'off', text: `Off — nothing is sent unless you press Invite now.` };
+    if (!canInviteHere) return { state: 'blocked', text: `On, but paused here: ${blockedReason || 'VRChat won’t let you invite into this instance.'}` };
+    if (!autoAllowedHere) return { state: 'blocked', text: 'On, but paused here: automatic invites only run in approved group instances (see "Auto-invite in any instance").' };
+    const next = eligibleNames.length ? ` Next: ${namesPreview(eligibleNames, 3)}.` : ' Everyone in that list is already here or recently invited.';
+    return { state: 'on', text: `On — inviting ${scopeLabel.toLowerCase()} (${poolCount} online) to you, each at most once per ${cooldownMinutes} min.${next}` };
+}
+
+export function groupStatus({ enabled, canRecruitHere, groupName, eligibleCount, dwellSeconds, blockedText }) {
+    if (!enabled) return { state: 'off', text: 'Off — no group invites are sent unless you press the button.' };
+    if (!canRecruitHere) return { state: 'blocked', text: `On, but paused here: ${blockedText}` };
+    return {
+        state: 'on',
+        text: `On — people here who aren't in ${groupName} get a group invite after ${dwellSeconds}s.${eligibleCount ? ` ${plural(eligibleCount, 'person', 'people')} ready now.` : ''}`
+    };
+}
