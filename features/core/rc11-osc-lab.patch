+        .trim();
+}
+
+const charCount = (text) => Array.from(text).length;
+
+/**
+ * Render each enabled module that has data into one line.
+ * @returns {Array<{ key: string, text: string }>}
+ */
+export function renderModuleLines(settings, data, now = Date.now()) {
+    const lines = [];
+    for (const key of settings.order) {
+        const mod = settings.modules[key];
+        if (!mod?.enabled) continue;
+        let values = null;
+        if (key === 'music') {
+            const media = data.media;
+            const playing = String(media?.status || '').toLowerCase() === 'playing';
+            if (media?.title && (playing || !mod.hideWhenPaused)) {
+                const position = estimatePosition(media, now);
+                const duration = Number(media.durationSeconds) || 0;
+                values = {
+                    title: media.title,
+                    artist: media.artist || '',
+                    time: duration ? formatClock(position) : '',
+                    duration: duration ? formatClock(duration) : '',
+                    remaining: duration ? `-${formatClock(duration - position)}` : '',
+                    bar: progressBar(position, duration)
+                };
+                if (!playing) values.title = `⏸ ${values.title}`;
+            }
+        } else if (key === 'weather' && data.weather) {
+            values = data.weather;
+        } else if (key === 'status' && data.status) {
+            values = { status: data.status };
+        } else if (key === 'heart' && Number(data.heartRate) > 0) {
+            values = { bpm: Math.round(Number(data.heartRate)) };
+        } else if (key === 'world' && data.world) {
+            values = { world: data.world };
+        }
+        if (!values) continue;
+        const text = cleanLine(fill(mod.template, values));
+        if (text) lines.push({ key, text });
+    }
+    return lines;
+}
+
+/**
+ * Fit lines into VRChat's chatbox (144 characters, 9 lines). Drops the lowest
+ * priority module (last in order) first, and only truncates if one line alone is too long.
+ */
+export function fitChatbox(lines) {
+    const kept = lines.slice(0, CHATBOX_MAX_LINES);
+    while (kept.length > 1 && charCount(kept.map((l) => l.text).join('\n')) > CHATBOX_MAX_CHARS) kept.pop();
+    let text = kept.map((l) => l.text).join('\n');
+    if (charCount(text) > CHATBOX_MAX_CHARS) text = Array.from(text).slice(0, CHATBOX_MAX_CHARS - 1).join('') + '…';
+    return { text, keys: kept.map((l) => l.key), dropped: lines.length - kept.length };
+}
+
+/**
+ * A stable "what changed" key: the chatbox with moving music time stripped out.
+ * Track, pause state, status, weather or heart rate changing → new key → send soon.
+ * Only the clock moving → same key → wait for the slow progress refresh.
+ */
+export function meaningfulKey(settings, data) {
+    const frozen = data.media ? { ...data.media, positionSeconds: 0, sampledAt: 0 } : data.media;
+    return renderModuleLines(settings, { ...data, media: frozen }, 0)
+        .map((l) => l.text)
+        .join('\n');
+}
+
+/**
+ * Decides when to actually transmit. Pure state machine: pass in `now`.
+ *  - never sends faster than minIntervalMs (VRChat throttles fast senders and
+ *    shows "sending too many messages" — others stop seeing your chatbox)
+ *  - sends when the meaningful content changes
+ *  - sends music progress at most every progressIntervalMs
+ *  - re-sends unchanged text every keepAliveMs so it stays up
+ *  - sends one empty message when output turns off so the chatbox clears
+ */
+export function createOscScheduler({ minIntervalMs = 2500, keepAliveMs = 25000 } = {}) {
+    let lastText = '';
+    let lastKey = '';
+    let lastSentAt = -Infinity;
+    return {
+        /** @returns {{ send: boolean, text?: string, reason?: string }} */
+        decide({ now, text, key, progressIntervalMs = 10000 }) {
+            const since = now - lastSentAt;
+            if (!text) {
+                if (lastText && since >= minIntervalMs) {
+                    lastText = '';
+                    lastKey = '';
+                    lastSentAt = now;
+                    return { send: true, text: '', reason: 'clear' };
+                }
+                return { send: false };
+            }
+            if (since < minIntervalMs) return { send: false, reason: 'throttled' };
+            let reason = '';
+            if (key !== lastKey) reason = 'changed';
+            else if (text !== lastText && since >= progressIntervalMs) reason = 'progress';
+            else if (since >= keepAliveMs) reason = 'keepalive';
+            if (!reason) return { send: false };
+            lastText = text;
+            lastKey = key;
+            lastSentAt = now;
+            return { send: true, text, reason };
+        },
+        reset() {
+            lastText = '';
+            lastKey = '';
+            lastSentAt = -Infinity;
+        },
+        get lastSentAt() {
+            return lastSentAt;
+        }
+    };
+}
+
+/**
+ * Status rotation. Sequential walks favorites in list order; random shuffles a
+ * bag so every favorite shows once before any repeats.
+ */
+export function createStatusRotator() {
+    let bag = [];
+    let index = -1;
+    let currentId = '';
+    return {
+        next(statuses, order) {
+            const pool = statuses.filter((s) => s.favorite);
+            if (!pool.length) {
+                currentId = '';
+                return null;
+            }
+            if (order === 'random') {
+                bag = bag.filter((id) => pool.some((s) => s.id === id));
+                if (!bag.length) {
+                    bag = pool.map((s) => s.id);
+                    for (let i = bag.length - 1; i > 0; i -= 1) {
+                        const j = Math.floor(Math.random() * (i + 1));
+                        [bag[i], bag[j]] = [bag[j], bag[i]];
+                    }
+                    if (bag.length > 1 && bag[0] === currentId) bag.push(bag.shift());
+                }
+                currentId = bag.shift();
+            } else {
+                const pos = pool.findIndex((s) => s.id === currentId);
+                index = pos >= 0 ? (pos + 1) % pool.length : (index + 1) % pool.length;
+                currentId = pool[index].id;
+            }
+            return pool.find((s) => s.id === currentId) || null;
+        },
+        current(statuses) {
+            return statuses.find((s) => s.id === currentId && s.favorite) || null;
+        }
+    };
+}
