@@ -0,0 +1,198 @@
+import { describe, expect, test } from 'vitest';
+
+import {
+    CHATBOX_MAX_CHARS,
+    createOscScheduler,
+    createStatusRotator,
+    describeWeather,
+    estimatePosition,
+    fitChatbox,
+    meaningfulKey,
+    migrateLegacySettings,
+    normalizeSettings,
+    renderModuleLines
+} from '../uwxOsc';
+
+const T0 = 1_000_000;
+
+function settings(overrides = {}) {
+    const s = normalizeSettings({});
+    s.modules.weather.enabled = true;
+    return { ...s, ...overrides };
+}
+
+const playing = (extra = {}) => ({
+    status: 'playing',
+    title: 'Song',
+    artist: 'Artist',
+    positionSeconds: 102,
+    durationSeconds: 208,
+    sampledAt: T0,
+    ...extra
+});
+
+describe('composer', () => {
+    test('music, weather and status all show together — none replaces another', () => {
+        const lines = renderModuleLines(
+            settings(),
+            { media: playing(), weather: { icon: '🌧️', temp: '54°F', condition: 'Cloudy' }, status: '🕸️ Lost somewhere in The UnderWeb' },
+            T0
+        );
+        expect(lines.map((l) => l.text)).toEqual([
+            '🎵 Artist — Song | 1:42 / 3:28',
+            '🌧️ 54°F | Cloudy',
+            '🕸️ Lost somewhere in The UnderWeb'
+        ]);
+    });
+
+    test('respects the user-chosen order and per-module switches', () => {
+        const s = settings({ order: ['status', 'music', 'weather', 'heart', 'world'] });
+        s.modules.weather.enabled = false;
+        const lines = renderModuleLines(s, { media: playing(), weather: { icon: 'x', temp: '1', condition: 'y' }, status: 'hi' }, T0);
+        expect(lines.map((l) => l.key)).toEqual(['status', 'music']);
+    });
+
+    test('missing artist or length leaves no dangling separators', () => {
+        const [line] = renderModuleLines(settings(), { media: playing({ artist: '', durationSeconds: 0 }) }, T0);
+        expect(line.text).toBe('🎵 Song');
+    });
+
+    test('paused music is hidden by default, or marked paused when the user keeps it', () => {
+        const paused = playing({ status: 'paused' });
+        expect(renderModuleLines(settings(), { media: paused }, T0)).toEqual([]);
+        const s = settings();
+        s.modules.music.hideWhenPaused = false;
+        expect(renderModuleLines(s, { media: paused }, T0)[0].text).toContain('⏸ Song');
+    });
+
+    test('fits VRChat limits by dropping the lowest-priority line first', () => {
+        const long = 'x'.repeat(100);
+        const { text, keys, dropped } = fitChatbox([
+            { key: 'music', text: 'a'.repeat(40) },
+            { key: 'weather', text: 'b'.repeat(20) },
+            { key: 'status', text: long }
+        ]);
+        expect(keys).toEqual(['music', 'weather']);
+        expect(dropped).toBe(1);
+        expect(Array.from(text).length).toBeLessThanOrEqual(CHATBOX_MAX_CHARS);
+    });
+
+    test('a single over-long line is truncated with an ellipsis', () => {
+        const { text } = fitChatbox([{ key: 'status', text: 'y'.repeat(300) }]);
+        expect(Array.from(text).length).toBe(CHATBOX_MAX_CHARS);
+        expect(text.endsWith('…')).toBe(true);
+    });
+
+    test('progress ticking does not change the meaningful key; a new track does', () => {
+        const s = settings();
+        const a = meaningfulKey(s, { media: playing(), status: 'x' });
+        const b = meaningfulKey(s, { media: playing({ positionSeconds: 150, sampledAt: T0 + 48000 }), status: 'x' });
+        const c = meaningfulKey(s, { media: playing({ title: 'Other' }), status: 'x' });
+        expect(a).toBe(b);
+        expect(a).not.toBe(c);
+    });
+
+    test('weather output never contains the ZIP code', () => {
+        const s = settings();
+        s.modules.weather.zip = '48226';
+        const w = describeWeather({ temperature_2m: 53.6, weather_code: 3 }, 'F');
+        const text = renderModuleLines(s, { weather: w }, T0).map((l) => l.text).join('\n');
+        expect(text).toBe('☁️ 54°F | Cloudy');
+        expect(text).not.toContain('48226');
+    });
+});
+
+describe('media timeline', () => {
+    test('extrapolates while playing and clamps to the track length', () => {
+        expect(estimatePosition(playing(), T0 + 5000)).toBeCloseTo(107);
+        expect(estimatePosition(playing(), T0 + 500_000)).toBe(208);
+    });
+    test('does not move while paused', () => {
+        expect(estimatePosition(playing({ status: 'paused' }), T0 + 5000)).toBe(102);
+    });
+});
+
+describe('scheduler (the "sending too many messages" fix)', () => {
+    test('a 1-second render loop for 60s sends only a handful of messages', () => {
+        const sched = createOscScheduler();
+        const s = settings();
+        let sends = 0;
+        for (let t = 0; t <= 60_000; t += 1000) {
+            const data = { media: playing({ positionSeconds: 102 + t / 1000, sampledAt: T0 + t }), status: 'hello' };
+            const { text } = fitChatbox(renderModuleLines(s, data, T0 + t));
+            const out = sched.decide({ now: T0 + t, text, key: meaningfulKey(s, data), progressIntervalMs: 10_000 });
+            if (out.send) sends += 1;
+        }
+        // first send + one progress refresh every 10s
+        expect(sends).toBe(7);
+    });
+
+    test('never sends twice within the minimum interval, even if content changes', () => {
+        const sched = createOscScheduler({ minIntervalMs: 2500 });
+        expect(sched.decide({ now: 0, text: 'a', key: 'a' }).send).toBe(true);
+        expect(sched.decide({ now: 1000, text: 'b', key: 'b' }).send).toBe(false);
+        expect(sched.decide({ now: 2500, text: 'b', key: 'b' })).toMatchObject({ send: true, reason: 'changed' });
+    });
+
+    test('identical output is not resent until the keep-alive', () => {
+        const sched = createOscScheduler({ keepAliveMs: 25_000 });
+        sched.decide({ now: 0, text: 'same', key: 'same' });
+        expect(sched.decide({ now: 20_000, text: 'same', key: 'same' }).send).toBe(false);
+        expect(sched.decide({ now: 25_000, text: 'same', key: 'same' })).toMatchObject({ send: true, reason: 'keepalive' });
+    });
+
+    test('turning output off sends one clear message, then nothing', () => {
+        const sched = createOscScheduler();
+        sched.decide({ now: 0, text: 'x', key: 'x' });
+        expect(sched.decide({ now: 3000, text: '', key: '' })).toMatchObject({ send: true, text: '' });
+        expect(sched.decide({ now: 9000, text: '', key: '' }).send).toBe(false);
+    });
+});
+
+describe('statuses', () => {
+    const list = [
+        { id: 'a', text: 'A', favorite: true },
+        { id: 'b', text: 'B', favorite: false },
+        { id: 'c', text: 'C', favorite: true }
+    ];
+
+    test('sequential rotation follows list order over favorites only', () => {
+        const r = createStatusRotator();
+        expect([r.next(list), r.next(list), r.next(list)].map((s) => s.id)).toEqual(['a', 'c', 'a']);
+    });
+
+    test('random rotation shows every favorite before repeating', () => {
+        const r = createStatusRotator();
+        const many = Array.from({ length: 6 }, (_, i) => ({ id: String(i), text: String(i), favorite: true }));
+        const firstRound = new Set(Array.from({ length: 6 }, () => r.next(many, 'random').id));
+        expect(firstRound.size).toBe(6);
+    });
+
+    test('no favorites → no status line', () => {
+        expect(createStatusRotator().next([{ id: 'x', text: 'x', favorite: false }])).toBeNull();
+    });
+});
+
+describe('settings persistence', () => {
+    test('normalize drops junk and keeps valid values', () => {
+        const s = normalizeSettings({
+            enabled: 1,
+            order: ['weather', 'bogus', 'weather'],
+            modules: { weather: { zip: 'abc', unit: 'C' }, status: { rotateSeconds: 2 } },
+            statuses: [{ id: '1', text: '  hi  ' }, { text: '' }, null]
+        });
+        expect(s.enabled).toBe(true);
+        expect(s.order).toEqual(['weather', 'music', 'status', 'heart', 'world']);
+        expect(s.modules.weather).toMatchObject({ zip: '', unit: 'C' });
+        expect(s.modules.status.rotateSeconds).toBe(10);
+        expect(s.statuses).toEqual([{ id: '1', text: 'hi', favorite: true }]);
+    });
+
+    test('migrates old custom status and turns world name off for privacy', () => {
+        const s = migrateLegacySettings({ enabled: true, customStatus: 'AFK', showNowPlaying: true, weatherZip: '48226' });
+        expect(s.enabled).toBe(true);
+        expect(s.statuses.map((x) => x.text)).toEqual(['AFK']);
+        expect(s.modules.weather).toMatchObject({ enabled: true, zip: '48226' });
+        expect(s.modules.world.enabled).toBe(false);
+    });
+});
diff --git a/src/shared/utils/uwxOsc.js b/src/shared/utils/uwxOsc.js
new file mode 100644
index 0000000..b53a2f0
--- /dev/null
+++ b/src/shared/utils/uwxOsc.js
@@ -0,0 +1,341 @@
+// UWX OSC Lab engine — pure logic, no Vue, no I/O. Everything here is unit-tested.
+//
+// Design:
+//  * One composer builds the whole chatbox from every enabled module at once
+//    (music + weather + status + …), so modules never replace each other.
+//  * One scheduler decides when that text is actually sent to VRChat. The app can
+//    re-render every second (live progress in the UI) while OSC only goes out when
+//    something meaningful changes, plus a slow progress refresh and a keep-alive.
+
+export const CHATBOX_MAX_CHARS = 144;
+export const CHATBOX_MAX_LINES = 9;
+
+export const OSC_MODULES = Object.freeze(['music', 'weather', 'status', 'heart', 'world']);
+
+export const DEFAULT_TEMPLATES = Object.freeze({
+    music: '🎵 {artist} — {title} | {time} / {duration}',
+    weather: '{icon} {temp} | {condition}',
+    status: '{status}',
+    heart: '❤️ {bpm} BPM',
+    world: '🌎 {world}'
+});
+
+export const TEMPLATE_TOKENS = Object.freeze({
+    music: ['title', 'artist', 'time', 'duration', 'remaining', 'bar'],
+    weather: ['icon', 'temp', 'condition'],
+    status: ['status'],
+    heart: ['bpm'],
+    world: ['world']
+});
+
+export const DEFAULT_SETTINGS = Object.freeze({
+    version: 3,
+    enabled: false,
+    order: ['music', 'weather', 'status', 'heart', 'world'],
+    modules: {
+        music: { enabled: true, template: DEFAULT_TEMPLATES.music, hideWhenPaused: true },
+        weather: { enabled: false, template: DEFAULT_TEMPLATES.weather, zip: '', unit: 'F' },
+        status: { enabled: true, template: DEFAULT_TEMPLATES.status, rotateSeconds: 20, order: 'sequential' },
+        heart: { enabled: false, template: DEFAULT_TEMPLATES.heart },
+        world: { enabled: false, template: DEFAULT_TEMPLATES.world }
+    },
+    statuses: [],
+    progressRefreshSeconds: 10
+});
+
+const clampInt = (value, min, max, fallback) => {
+    const n = Math.round(Number(value));
+    return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
+};
+
+/** Merge stored settings over defaults, dropping anything malformed. */
+export function normalizeSettings(raw) {
+    const input = raw && typeof raw === 'object' ? raw : {};
+    const out = JSON.parse(JSON.stringify(DEFAULT_SETTINGS));
+    out.enabled = Boolean(input.enabled);
+    if (Array.isArray(input.order)) {
+        const valid = input.order.filter((key, i, arr) => OSC_MODULES.includes(key) && arr.indexOf(key) === i);
+        out.order = [...valid, ...OSC_MODULES.filter((key) => !valid.includes(key))];
+    }
+    for (const key of OSC_MODULES) {
+        const m = input.modules?.[key];
+        if (!m || typeof m !== 'object') continue;
+        const target = out.modules[key];
+        target.enabled = m.enabled === undefined ? target.enabled : Boolean(m.enabled);
+        if (typeof m.template === 'string' && m.template.trim()) target.template = m.template.slice(0, 144);
+        if (key === 'music' && m.hideWhenPaused !== undefined) target.hideWhenPaused = Boolean(m.hideWhenPaused);
+        if (key === 'weather') {
+            target.zip = /^\d{5}$/.test(String(m.zip || '')) ? String(m.zip) : '';
+            target.unit = m.unit === 'C' ? 'C' : 'F';
+        }
+        if (key === 'status') {
+            target.rotateSeconds = clampInt(m.rotateSeconds, 10, 600, 20);
+            target.order = m.order === 'random' ? 'random' : 'sequential';
+        }
+    }
+    if (Array.isArray(input.statuses)) {
+        const seen = new Set();
+        out.statuses = input.statuses
+            .filter((s) => s && typeof s.text === 'string' && s.text.trim())
+            .map((s) => ({
+                id: String(s.id || `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`),
+                text: s.text.trim().slice(0, 144),
+                favorite: s.favorite !== false
+            }))
+            .filter((s) => (seen.has(s.id) ? false : (seen.add(s.id), true)));
+    }
+    out.progressRefreshSeconds = clampInt(input.progressRefreshSeconds, 5, 60, 10);
+    return out;
+}
+
+/** Build v3 settings from the pre-0.5.2 scattered config keys. */
+export function migrateLegacySettings(legacy) {
+    const statuses = [];
+    if (Array.isArray(legacy?.osc2Statuses)) {
+        legacy.osc2Statuses.forEach((s) => s?.text && statuses.push({ id: s.id, text: s.text, favorite: s.favorite !== false }));
+    }
+    if (typeof legacy?.customStatus === 'string' && legacy.customStatus.trim() && !statuses.some((s) => s.text === legacy.customStatus.trim())) {
+        statuses.push({ id: 'legacy-custom', text: legacy.customStatus.trim(), favorite: true });
+    }
+    return normalizeSettings({
+        enabled: Boolean(legacy?.enabled),
+        modules: {
+            music: { enabled: legacy?.showNowPlaying !== false },
+            weather: { enabled: Boolean(legacy?.weatherZip), zip: legacy?.weatherZip || '' },
+            status: { enabled: true },
+            heart: { enabled: Boolean(legacy?.showHeartRate) },
+            // World name is off after migration: it tells everyone where you are.
+            world: { enabled: false }
+        },
+        statuses
+    });
+}
+
+export function formatClock(seconds) {
+    const total = Math.max(0, Math.floor(Number(seconds) || 0));
+    const h = Math.floor(total / 3600);
+    const m = Math.floor((total % 3600) / 60);
+    const s = total % 60;
+    return h > 0 ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}` : `${m}:${String(s).padStart(2, '0')}`;
+}
+
+export function progressBar(position, duration, width = 10) {
+    if (!duration || duration <= 0) return '';
+    const ratio = Math.max(0, Math.min(1, position / duration));
+    const filled = Math.round(ratio * width);
+    return '▰'.repeat(filled) + '▱'.repeat(width - filled);
+}
+
+/**
+ * Windows media sessions (and Spotify in particular) only report a new position
+ * occasionally. Extrapolate from the last report while playing so progress moves
+ * smoothly, and clamp to the track length.
+ * @param {{ status?: string, positionSeconds?: number, durationSeconds?: number, sampledAt?: number, playbackRate?: number }} media
+ */
+export function estimatePosition(media, now) {
+    const base = Math.max(0, Number(media?.positionSeconds) || 0);
+    const duration = Math.max(0, Number(media?.durationSeconds) || 0);
+    if (String(media?.status || '').toLowerCase() !== 'playing' || !media?.sampledAt) return duration ? Math.min(base, duration) : base;
+    const rate = Number(media.playbackRate) > 0 ? Number(media.playbackRate) : 1;
+    const pos = base + Math.max(0, (now - media.sampledAt) / 1000) * rate;
+    return duration ? Math.min(pos, duration) : pos;
+}
+
+const WEATHER_CODES = Object.freeze({
+    0: ['Clear', '☀️'], 1: ['Mostly clear', '🌤️'], 2: ['Partly cloudy', '⛅'], 3: ['Cloudy', '☁️'],
+    45: ['Fog', '🌫️'], 48: ['Fog', '🌫️'],
+    51: ['Drizzle', '🌦️'], 53: ['Drizzle', '🌦️'], 55: ['Drizzle', '🌦️'], 56: ['Freezing drizzle', '🌧️'], 57: ['Freezing drizzle', '🌧️'],
+    61: ['Rain', '🌧️'], 63: ['Rain', '🌧️'], 65: ['Heavy rain', '🌧️'], 66: ['Freezing rain', '🌧️'], 67: ['Freezing rain', '🌧️'],
+    71: ['Snow', '🌨️'], 73: ['Snow', '🌨️'], 75: ['Heavy snow', '❄️'], 77: ['Snow grains', '🌨️'],
+    80: ['Showers', '🌦️'], 81: ['Showers', '🌧️'], 82: ['Heavy showers', '⛈️'], 85: ['Snow showers', '🌨️'], 86: ['Snow showers', '❄️'],
+    95: ['Thunderstorm', '⛈️'], 96: ['Thunderstorm', '⛈️'], 99: ['Thunderstorm', '⛈️']
+});
+
+/** Turn an Open-Meteo `current` block into display-only weather (no location data). */
+export function describeWeather(current, unit = 'F') {
+    const temp = Number(current?.temperature_2m);
+    if (!Number.isFinite(temp)) return null;
+    const [condition, icon] = WEATHER_CODES[Number(current?.weather_code)] || ['Current conditions', '🌡️'];
+    return { temp: `${Math.round(temp)}°${unit === 'C' ? 'C' : 'F'}`, condition, icon };
+}
+
+const SEP = '(?:—|–|-|\\||/|·)';
+
+function fill(template, values) {
+    let out = String(template || '');
+    // Remove empty tokens together with one neighbouring separator so a missing
+    // artist or track length doesn't leave "— " or "| /" behind.
+    for (const [, key] of out.matchAll(/\{(\w+)\}/g)) {
+        const value = values[key];
+        if (value !== undefined && value !== null && String(value) !== '') continue;
+        const after = new RegExp(`\\{${key}\\}\\s*${SEP}\\s*`);
+        const before = new RegExp(`\\s*${SEP}?\\s*\\{${key}\\}`);
+        out = after.test(out) ? out.replace(after, '') : out.replace(before, '');
+    }
+    return out.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
+}
+
+function cleanLine(line) {
+    // Tidy separators left dangling when a token was empty, e.g. "🎵  — Song | /".
+    return line
+        .replace(/\s+/g, ' ')
+        .replace(/(\s[|—-]\s?)+$/u, '')
+        .replace(/^\s*[|—-]\s/u, '')
