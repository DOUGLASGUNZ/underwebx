+import { describe, expect, it } from 'vitest';
+import {
+    categorizeEvent,
+    describeChanges,
+    eventLabel,
+    filterEntries,
+    listActors,
+    mergeEntries,
+    normalizeEntry,
+    summarize,
+    targetKind,
+    toCsv
+} from '../uwxAudit';
+
+const raw = (over = {}) => ({
+    id: 'gaud_1',
+    created_at: '2026-10-15T18:04:11.123Z',
+    groupId: 'grp_a',
+    actorId: 'usr_staff',
+    actorDisplayName: 'Darko',
+    targetId: 'usr_target',
+    eventType: 'group.user.ban',
+    description: 'Darko banned Troll',
+    data: {},
+    ...over
+});
+
+describe('uwxAudit', () => {
+    it('categorizes VRChat event types, including unknown ones', () => {
+        expect(categorizeEvent('group.user.ban')).toBe('moderation');
+        expect(categorizeEvent('group.user.unban')).toBe('moderation');
+        expect(categorizeEvent('group.member.remove')).toBe('moderation');
+        expect(categorizeEvent('group.instance.kick')).toBe('moderation');
+        expect(categorizeEvent('group.request.block')).toBe('moderation');
+        expect(categorizeEvent('group.member.join')).toBe('members');
+        expect(categorizeEvent('group.invite.create')).toBe('members');
+        expect(categorizeEvent('group.member.role.assign')).toBe('roles');
+        expect(categorizeEvent('group.role.update')).toBe('roles');
+        expect(categorizeEvent('group.instance.create')).toBe('instances');
+        expect(categorizeEvent('group.announcement.create')).toBe('content');
+        expect(categorizeEvent('group.update')).toBe('group');
+        expect(categorizeEvent('group.something.new')).toBe('other');
+        expect(categorizeEvent('')).toBe('other');
+    });
+
+    it('labels known and unknown events', () => {
+        expect(eventLabel('group.user.ban')).toBe('Banned');
+        expect(eventLabel('group.calendar.event.create')).toBe('Calendar Event Create');
+    });
+
+    it('normalizes entries with an exact timestamp and parses string data', () => {
+        const e = normalizeEntry(raw({ data: '{"name":{"old":"A","new":"B"}}' }));
+        expect(e.ts).toBe(Date.parse('2026-10-15T18:04:11.123Z'));
+        expect(e.actorName).toBe('Darko');
+        expect(e.data.name.new).toBe('B');
+        expect(normalizeEntry({})).toBeNull();
+    });
+
+    it('merges without duplicates, newest first', () => {
+        const a = normalizeEntry(raw({ id: 'a', created_at: '2026-10-15T10:00:00Z' }));
+        const b = normalizeEntry(raw({ id: 'b', created_at: '2026-10-15T12:00:00Z' }));
+        const b2 = { ...b, description: 'updated' };
+        const merged = mergeEntries([a, b], [b2]);
+        expect(merged.map((e) => e.id)).toEqual(['b', 'a']);
+        expect(merged[0].description).toBe('updated');
+    });
+
+    it('describes old/new changes, list diffs and resolves role names', () => {
+        const roleName = (id) => ({ grol_mod: 'Moderator', grol_dj: 'DJ' })[id] || '';
+        const rows = describeChanges(
+            {
+                name: { old: 'Staff', new: 'Senior Staff' },
+                roleIds: { old: ['grol_mod'], new: ['grol_mod', 'grol_dj'] },
+                isPublic: { old: false, new: true },
+                note: 'hello'
+            },
+            roleName
+        );
+        expect(rows[0]).toMatchObject({ label: 'Name', kind: 'change', before: 'Staff', after: 'Senior Staff' });
+        expect(rows[1]).toMatchObject({ label: 'Role Ids', kind: 'list', added: ['DJ'], removed: [] });
+        expect(rows[2]).toMatchObject({ kind: 'change', before: 'off', after: 'on' });
+        expect(rows[3]).toMatchObject({ kind: 'value', value: 'hello' });
+        expect(describeChanges(null)).toEqual([]);
+    });
+
+    it('filters by category, actor, text and time', () => {
+        const list = [
+            normalizeEntry(raw({ id: '1', eventType: 'group.user.ban', created_at: '2026-10-15T10:00:00Z' })),
+            normalizeEntry(raw({ id: '2', eventType: 'group.member.join', actorId: 'usr_x', actorDisplayName: 'Newbie', description: 'Newbie joined', created_at: '2026-10-10T10:00:00Z' }))
+        ];
+        expect(filterEntries(list, { category: 'moderation' }).map((e) => e.id)).toEqual(['1']);
+        expect(filterEntries(list, { actorId: 'usr_x' }).map((e) => e.id)).toEqual(['2']);
+        expect(filterEntries(list, { query: 'newbie' }).map((e) => e.id)).toEqual(['2']);
+        expect(filterEntries(list, { query: 'usr_target' }).length).toBe(2);
+        expect(filterEntries(list, { sinceMs: Date.parse('2026-10-14T00:00:00Z') }).map((e) => e.id)).toEqual(['1']);
+    });
+
+    it('summarizes counts and only counts staff actions for top actors', () => {
+        const list = [
+            normalizeEntry(raw({ id: '1' })),
+            normalizeEntry(raw({ id: '2', eventType: 'group.member.remove' })),
+            normalizeEntry(raw({ id: '3', eventType: 'group.member.join', actorId: 'usr_x', actorDisplayName: 'Newbie' }))
+        ];
+        const s = summarize(list);
+        expect(s.total).toBe(3);
+        expect(s.byCategory).toEqual({ moderation: 2, members: 1 });
+        expect(s.topActors).toEqual([{ actorId: 'usr_staff', name: 'Darko', count: 2 }]);
+        expect(listActors(list).map((a) => a.name)).toEqual(['Darko', 'Newbie']);
+    });
+
+    it('identifies target kinds', () => {
+        expect(targetKind('usr_123')).toBe('user');
+        expect(targetKind('wrld_123')).toBe('world');
+        expect(targetKind('grol_123')).toBe('role');
+        expect(targetKind('')).toBe('');
+    });
+
+    it('exports CSV with escaping and flattened details', () => {
+        const csv = toCsv([normalizeEntry(raw({ description: 'Said "hi", left', data: { name: { old: 'A', new: 'B' } } }))]);
+        const [header, row] = csv.split('\r\n');
+        expect(header.startsWith('time_utc,event,')).toBe(true);
+        expect(row).toContain('"Said ""hi"", left"');
+        expect(row).toContain('Name: A -> B');
+        expect(row.startsWith('2026-10-15T18:04:11.123Z,Banned,group.user.ban')).toBe(true);
+    });
+});
