+// Local archive of VRChat group audit log entries, stored in UWX's own SQLite database
+// on this PC. Nothing here leaves the machine. Keeping a copy means the history UWX
+// shows can go further back than what VRChat still returns.
+
+import sqliteService from './sqlite.js';
+
+const TABLE = 'uwx_group_audit';
+let ready = false;
+
+async function ensureTable() {
+    if (ready) return;
+    await sqliteService.executeNonQuery(
+        `CREATE TABLE IF NOT EXISTS ${TABLE} (id TEXT PRIMARY KEY, group_id TEXT, created_at TEXT, ts INTEGER, event_type TEXT, actor_id TEXT, actor_name TEXT, target_id TEXT, description TEXT, data_json TEXT)`
+    );
+    await sqliteService.executeNonQuery(`CREATE INDEX IF NOT EXISTS ${TABLE}_group_ts_idx ON ${TABLE} (group_id, ts)`);
+    ready = true;
+}
+
+/** @param {object[]} entries normalized entries (see shared/utils/uwxAudit.js) */
+async function saveEntries(entries) {
+    if (!entries?.length) return;
+    await ensureTable();
+    for (const e of entries) {
+        await sqliteService.executeNonQuery(
+            `INSERT OR REPLACE INTO ${TABLE} (id, group_id, created_at, ts, event_type, actor_id, actor_name, target_id, description, data_json) VALUES (@id, @group_id, @created_at, @ts, @event_type, @actor_id, @actor_name, @target_id, @description, @data_json)`,
+            {
+                '@id': e.id,
+                '@group_id': e.groupId,
+                '@created_at': e.createdAt,
+                '@ts': e.ts,
+                '@event_type': e.eventType,
+                '@actor_id': e.actorId,
+                '@actor_name': e.actorName,
+                '@target_id': e.targetId,
+                '@description': e.description,
+                '@data_json': JSON.stringify(e.data || {})
+            }
+        );
+    }
+}
+
+/** Newest first. */
+async function loadGroup(groupId, limit = 5000) {
+    await ensureTable();
+    const rows = [];
+    await sqliteService.execute(
+        (row) => {
+            let data = {};
+            try {
+                data = JSON.parse(row[9] || '{}');
+            } catch {
+                data = {};
+            }
+            rows.push({
+                id: row[0],
+                groupId: row[1],
+                createdAt: row[2],
+                ts: Number(row[3]) || 0,
+                eventType: row[4] || '',
+                actorId: row[5] || '',
+                actorName: row[6] || '',
+                targetId: row[7] || '',
+                description: row[8] || '',
+                data
+            });
+        },
+        `SELECT id, group_id, created_at, ts, event_type, actor_id, actor_name, target_id, description, data_json FROM ${TABLE} WHERE group_id = @group_id ORDER BY ts DESC LIMIT ${Math.max(1, Math.min(20000, Number(limit) || 5000))}`,
+        { '@group_id': groupId }
+    );
+    return rows;
+}
+
+async function clearGroup(groupId) {
+    await ensureTable();
+    await sqliteService.executeNonQuery(`DELETE FROM ${TABLE} WHERE group_id = @group_id`, { '@group_id': groupId });
+}
+
+export default { saveEntries, loadGroup, clearGroup };
