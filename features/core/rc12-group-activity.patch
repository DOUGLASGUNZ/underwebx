+// UWX group audit log helpers (pure — no Vue, no network).
+// Entries come from VRChat's official GET /groups/{groupId}/auditLogs endpoint,
+// requested with the signed-in user's own session. Shape (as returned by VRChat):
+//   { id, created_at, groupId, actorId, actorDisplayName, targetId, eventType, description, data }
+
+export const AUDIT_CATEGORIES = Object.freeze([
+    { id: 'all', label: 'Everything' },
+    { id: 'moderation', label: 'Bans & removals' },
+    { id: 'members', label: 'Joins, leaves & invites' },
+    { id: 'roles', label: 'Roles' },
+    { id: 'instances', label: 'Instances' },
+    { id: 'content', label: 'Posts & gallery' },
+    { id: 'group', label: 'Group settings' },
+    { id: 'other', label: 'Other' }
+]);
+
+const KNOWN_LABELS = Object.freeze({
+    'group.user.ban': 'Banned',
+    'group.user.unban': 'Unbanned',
+    'group.member.remove': 'Removed from group',
+    'group.member.join': 'Joined',
+    'group.member.leave': 'Left',
+    'group.member.user.update': 'Member updated',
+    'group.member.role.assign': 'Role given',
+    'group.member.role.unassign': 'Role taken away',
+    'group.role.create': 'Role created',
+    'group.role.update': 'Role edited',
+    'group.role.delete': 'Role deleted',
+    'group.instance.create': 'Instance opened',
+    'group.instance.close': 'Instance closed',
+    'group.instance.kick': 'Kicked from instance',
+    'group.instance.warn': 'Warned in instance',
+    'group.invite.create': 'Invite sent',
+    'group.invite.cancel': 'Invite cancelled',
+    'group.request.create': 'Join request',
+    'group.request.reject': 'Join request rejected',
+    'group.request.block': 'Join requests blocked',
+    'group.request.unblock': 'Join requests unblocked',
+    'group.post.create': 'Post created',
+    'group.post.delete': 'Post deleted',
+    'group.announcement.create': 'Announcement posted',
+    'group.announcement.delete': 'Announcement removed',
+    'group.gallery.create': 'Gallery created',
+    'group.gallery.delete': 'Gallery deleted',
+    'group.update': 'Group settings changed'
+});
+
+/** @param {string} eventType */
+export function categorizeEvent(eventType) {
+    const t = String(eventType || '').toLowerCase();
+    if (!t) return 'other';
+    if (/\.(ban|unban)$/.test(t) || t === 'group.member.remove' || /instance\.(kick|warn)$/.test(t) || /request\.(block|unblock)$/.test(t)) {
+        return 'moderation';
+    }
+    if (t.includes('.role.')) return 'roles';
+    if (t.includes('.instance.')) return 'instances';
+    if (t.startsWith('group.member.') || t.includes('.invite.') || t.includes('.request.') || t.includes('.joinrequest')) {
+        return 'members';
+    }
+    if (t.includes('.post.') || t.includes('.announcement.') || t.includes('.gallery.')) return 'content';
+    if (t === 'group.update' || t.startsWith('group.transfer') || t.startsWith('group.settings') || t.startsWith('group.language') || t.startsWith('group.link')) {
+        return 'group';
+    }
+    return 'other';
+}
+
+/** Human label for an event type; unknown types are prettified, never hidden. */
+export function eventLabel(eventType) {
+    const t = String(eventType || '');
+    if (KNOWN_LABELS[t]) return KNOWN_LABELS[t];
+    if (!t) return 'Unknown event';
+    return t
+        .replace(/^group\./, '')
+        .split('.')
+        .join(' ')
+        .replace(/\b\w/g, (c) => c.toUpperCase());
+}
+
+/** @returns {object|null} normalized entry, or null if the row is unusable */
+export function normalizeEntry(json, groupId = '') {
+    if (!json || !json.id) return null;
+    const createdAt = String(json.created_at || json.createdAt || '');
+    const ts = Date.parse(createdAt);
+    let data = json.data;
+    if (typeof data === 'string') {
+        try {
+            data = JSON.parse(data);
+        } catch {
+            data = { value: data };
+        }
+    }
+    return {
+        id: String(json.id),
+        groupId: String(json.groupId || groupId || ''),
+        createdAt,
+        ts: Number.isFinite(ts) ? ts : 0,
+        eventType: String(json.eventType || ''),
+        actorId: String(json.actorId || ''),
+        actorName: String(json.actorDisplayName || json.actorId || ''),
+        targetId: String(json.targetId || ''),
+        description: String(json.description || ''),
+        data: data && typeof data === 'object' ? data : {}
+    };
+}
+
+/** Merge two entry lists, newest first, de-duplicated by VRChat's entry id. */
+export function mergeEntries(existing, incoming) {
+    const byId = new Map();
+    for (const entry of existing || []) if (entry?.id) byId.set(entry.id, entry);
+    for (const entry of incoming || []) if (entry?.id) byId.set(entry.id, entry);
+    return Array.from(byId.values()).sort((a, b) => b.ts - a.ts || (a.id < b.id ? 1 : -1));
+}
+
+const ID_PATTERN = /^(grol|usr|wrld|grp|gpst|ganc|ggal)_[0-9a-f-]{8,}/i;
+
+function formatValue(value, roleName) {
+    if (value === null || value === undefined || value === '') return '—';
+    if (typeof value === 'boolean') return value ? 'on' : 'off';
+    if (typeof value === 'string') {
+        if (value.startsWith('grol_') && roleName) return roleName(value) || value;
+        return value;
+    }
+    if (typeof value === 'number') return String(value);
+    if (Array.isArray(value)) {
+        if (!value.length) return 'none';
+        return value.map((v) => formatValue(v, roleName)).join(', ');
+    }
+    try {
+        return JSON.stringify(value);
+    } catch {
+        return String(value);
+    }
+}
+
+function prettyField(field) {
+    return String(field)
+        .replace(/([a-z])([A-Z])/g, '$1 $2')
+        .replace(/[_.-]+/g, ' ')
+        .trim()
+        .replace(/^\w/, (c) => c.toUpperCase());
+}
+
+/**
+ * Turn VRChat's `data` payload into readable change rows.
+ * VRChat sends changes as { field: { old, new } }; anything else is shown as a plain value.
+ * @param {object} data
+ * @param {(id: string) => string} [roleName] resolves grol_ ids to names
+ * @returns {{ field: string, label: string, kind: 'change'|'list'|'value', before?: string, after?: string, added?: string[], removed?: string[], value?: string }[]}
+ */
+export function describeChanges(data, roleName) {
+    if (!data || typeof data !== 'object') return [];
+    const rows = /** @type {any[]} */ ([]);
+    for (const [field, raw] of Object.entries(data)) {
+        const label = prettyField(field);
+        const isChange = raw && typeof raw === 'object' && !Array.isArray(raw) && ('old' in raw || 'new' in raw);
+        if (isChange) {
+            const before = raw.old;
+            const after = raw.new;
+            if (Array.isArray(before) || Array.isArray(after)) {
+                const b = Array.isArray(before) ? before : [];
+                const a = Array.isArray(after) ? after : [];
+                const added = a.filter((x) => !b.some((y) => JSON.stringify(y) === JSON.stringify(x)));
+                const removed = b.filter((x) => !a.some((y) => JSON.stringify(y) === JSON.stringify(x)));
+                rows.push({
+                    field,
+                    label,
+                    kind: 'list',
+                    added: added.map((x) => formatValue(x, roleName)),
+                    removed: removed.map((x) => formatValue(x, roleName))
+                });
+                continue;
+            }
+            rows.push({ field, label, kind: 'change', before: formatValue(before, roleName), after: formatValue(after, roleName) });
+            continue;
+        }
+        rows.push({ field, label, kind: 'value', value: formatValue(raw, roleName) });
+    }
+    return rows;
+}
+
+/** Kind of thing a target id points at, for linking in the UI. */
+export function targetKind(targetId) {
+    const id = String(targetId || '');
+    if (id.startsWith('usr_')) return 'user';
+    if (id.startsWith('wrld_')) return 'world';
+    if (id.startsWith('grol_')) return 'role';
+    if (id.startsWith('grp_')) return 'group';
+    if (ID_PATTERN.test(id)) return 'other';
+    return id ? 'other' : '';
+}
+
+/**
+ * @param {object[]} entries
+ * @param {{ category?: string, actorId?: string, query?: string, sinceMs?: number }} filters
+ */
+export function filterEntries(entries, { category = 'all', actorId = '', query = '', sinceMs = 0 } = {}) {
+    const q = String(query || '').trim().toLowerCase();
+    return (entries || []).filter((entry) => {
+        if (sinceMs && entry.ts < sinceMs) return false;
+        if (category && category !== 'all' && categorizeEvent(entry.eventType) !== category) return false;
+        if (actorId && entry.actorId !== actorId) return false;
+        if (q) {
+            const hay = `${entry.description} ${entry.actorName} ${entry.actorId} ${entry.targetId} ${entry.eventType} ${eventLabel(entry.eventType)}`.toLowerCase();
+            if (!hay.includes(q)) return false;
+        }
+        return true;
+    });
+}
+
+/** Counts per category and the most active staff, over entries since `sinceMs`. */
+export function summarize(entries, sinceMs = 0) {
+    const byCategory = {};
+    const actors = new Map();
+    let total = 0;
+    for (const entry of entries || []) {
+        if (sinceMs && entry.ts < sinceMs) continue;
+        total += 1;
+        const cat = categorizeEvent(entry.eventType);
+        byCategory[cat] = (byCategory[cat] || 0) + 1;
+        // Joins/leaves/requests are done by the member themselves; only count staff-ish actions.
+        if (cat !== 'members' && entry.actorId) {
+            const a = actors.get(entry.actorId) || { actorId: entry.actorId, name: entry.actorName, count: 0 };
+            a.count += 1;
+            actors.set(entry.actorId, a);
+        }
+    }
+    const topActors = Array.from(actors.values()).sort((a, b) => b.count - a.count).slice(0, 5);
+    return { total, byCategory, topActors };
+}
+
+/** Distinct actors in a list, for the "who did it" filter. */
+export function listActors(entries) {
+    const map = new Map();
+    for (const e of entries || []) {
+        if (!e.actorId) continue;
+        const a = map.get(e.actorId) || { actorId: e.actorId, name: e.actorName, count: 0 };
+        a.count += 1;
+        map.set(e.actorId, a);
+    }
+    return Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name));
+}
+
+function csvCell(value) {
+    const s = String(value ?? '');
+    return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+}
+
+/** CSV with exact UTC timestamps and the change details flattened. */
+export function toCsv(entries, roleName) {
+    const header = ['time_utc', 'event', 'event_type', 'actor', 'actor_id', 'target_id', 'description', 'details', 'entry_id'];
+    const lines = [header.join(',')];
+    for (const e of entries || []) {
+        const details = describeChanges(e.data, roleName)
+            .map((r) =>
+                r.kind === 'change'
+                    ? `${r.label}: ${r.before} -> ${r.after}`
+                    : r.kind === 'list'
+                      ? `${r.label}: +[${r.added.join('; ')}] -[${r.removed.join('; ')}]`
+                      : `${r.label}: ${r.value}`
+            )
+            .join(' | ');
+        lines.push(
+            [e.createdAt, eventLabel(e.eventType), e.eventType, e.actorName, e.actorId, e.targetId, e.description, details, e.id]
+                .map(csvCell)
+                .join(',')
+        );
+    }
+    return lines.join('\r\n');
+}
diff --git a/src/stores/__tests__/uwxGroupAudit.test.js b/src/stores/__tests__/uwxGroupAudit.test.js
new file mode 100644
index 0000000..d31ef38
--- /dev/null
+++ b/src/stores/__tests__/uwxGroupAudit.test.js
@@ -0,0 +1,141 @@
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+
+const groupRequest = { getGroupLogs: vi.fn() };
+vi.mock('../../api', () => ({ groupRequest }));
+
+const archive = { rows: [], saveEntries: vi.fn(), loadGroup: vi.fn(), clearGroup: vi.fn() };
+vi.mock('../../services/uwxAuditArchive', () => ({ default: archive }));
+vi.mock('../../services/watchState', () => ({ watchState: { isLoggedIn: true } }));
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn(), message: vi.fn() } }));
+
+const tools = { canAudit: true, groupInfo: new Map(), can: (gid, action) => action === 'audit' && tools.canAudit };
+vi.mock('../uwxGroupTools', () => ({ useUwxGroupToolsStore: () => tools }));
+
+vi.useFakeTimers();
+const { useUwxGroupAuditStore } = await import('../uwxGroupAudit');
+
+const GROUP = 'grp_11111111-1111-1111-1111-111111111111';
+
+/** Fake VRChat log: `total` entries, newest = index 0. */
+function fakeLog(total, startMs = Date.parse('2026-10-15T20:00:00Z')) {
+    return Array.from({ length: total }, (_, i) => ({
+        id: `gaud_${total - i}`,
+        created_at: new Date(startMs - i * 60000).toISOString(),
+        groupId: GROUP,
+        actorId: 'usr_staff',
+        actorDisplayName: 'Darko',
+        eventType: 'group.member.join',
+        description: `entry ${total - i}`
+    }));
+}
+
+function serve(log) {
+    groupRequest.getGroupLogs.mockImplementation(async ({ n, offset }) => ({
+        json: { results: log.slice(offset, offset + n), hasNext: offset + n < log.length }
+    }));
+}
+
+async function flush(promise) {
+    // Let paging sleeps resolve.
+    for (let i = 0; i < 40; i++) {
+        await vi.advanceTimersByTimeAsync(1000);
+    }
+    return promise;
+}
+
+describe('uwxGroupAudit', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        groupRequest.getGroupLogs.mockReset();
+        archive.saveEntries.mockReset();
+        archive.loadGroup.mockReset().mockResolvedValue([]);
+        tools.canAudit = true;
+    });
+
+    test('first open pulls pages until VRChat has no more, then archives them', async () => {
+        serve(fakeLog(250));
+        const store = useUwxGroupAuditStore();
+        await flush(store.open(GROUP));
+        expect(store.entries.length).toBe(250);
+        expect(store.entries[0].id).toBe('gaud_250');
+        expect(store.reachedEnd).toBe(true);
+        expect(groupRequest.getGroupLogs).toHaveBeenCalledTimes(3);
+        expect(archive.saveEntries).toHaveBeenCalledTimes(1);
+        expect(archive.saveEntries.mock.calls[0][0].length).toBe(250);
+        store.close();
+    });
+
+    test('later checks stop at the first page that overlaps saved history', async () => {
+        const log = fakeLog(300);
+        archive.loadGroup.mockResolvedValue([]);
+        serve(log);
+        const store = useUwxGroupAuditStore();
+        await flush(store.open(GROUP));
+        groupRequest.getGroupLogs.mockClear();
+        archive.saveEntries.mockClear();
+
+        // 5 new entries arrive at the top.
+        serve(fakeLog(305));
+        await flush(store.syncNewest());
+        expect(groupRequest.getGroupLogs).toHaveBeenCalledTimes(1);
+        expect(store.lastNewCount).toBe(5);
+        expect(store.entries.length).toBe(305);
+        expect(archive.saveEntries.mock.calls[0][0].map((e) => e.id)).toEqual([
+            'gaud_305',
+            'gaud_304',
+            'gaud_303',
+            'gaud_302',
+            'gaud_301'
+        ]);
+        store.close();
+    });
+
+    test('shows the saved archive straight away, even before VRChat answers', async () => {
+        archive.loadGroup.mockResolvedValue([
+            { id: 'gaud_old', groupId: GROUP, createdAt: '2026-01-01T00:00:00Z', ts: Date.parse('2026-01-01T00:00:00Z'), eventType: 'group.user.ban', actorId: 'usr_staff', actorName: 'Darko', targetId: '', description: 'old ban', data: {} }
+        ]);
+        serve(fakeLog(3));
+        const store = useUwxGroupAuditStore();
+        await flush(store.open(GROUP));
+        expect(store.entries.map((e) => e.id)).toEqual(['gaud_3', 'gaud_2', 'gaud_1', 'gaud_old']);
+        store.close();
+    });
+
+    test('never calls VRChat without the audit permission', async () => {
+        tools.canAudit = false;
+        serve(fakeLog(3));
+        const store = useUwxGroupAuditStore();
+        await flush(store.open(GROUP));
+        expect(groupRequest.getGroupLogs).not.toHaveBeenCalled();
+        expect(store.error).toMatch(/audit log/);
+        store.close();
+    });
+
+    test('a 403 or rate limit is reported, and entries fetched before it are kept', async () => {
+        const log = fakeLog(250);
+        groupRequest.getGroupLogs.mockImplementation(async ({ n, offset }) => {
+            if (offset >= 100) throw { status: 429 };
+            return { json: { results: log.slice(offset, offset + n), hasNext: true } };
+        });
+        const store = useUwxGroupAuditStore();
+        await flush(store.open(GROUP));
+        expect(store.entries.length).toBe(100);
+        expect(store.error).toMatch(/rate limit/);
+        expect(archive.saveEntries).toHaveBeenCalled();
+        store.close();
+    });
+
+    test('load older walks past saved pages to fetch history beyond them', async () => {
+        const log = fakeLog(1500);
+        serve(log);
+        const store = useUwxGroupAuditStore();
+        await flush(store.open(GROUP)); // first sync caps at 10 pages = 1000
+        expect(store.entries.length).toBe(1000);
+        expect(store.reachedEnd).toBe(false);
+        await flush(store.loadOlder());
+        expect(store.entries.length).toBe(1100);
+        expect(store.entries.at(-1).id).toBe('gaud_401');
+        store.close();
+    });
+});
diff --git a/src/stores/uwxGroupAudit.js b/src/stores/uwxGroupAudit.js
new file mode 100644
index 0000000..c66777d
--- /dev/null
+++ b/src/stores/uwxGroupAudit.js
@@ -0,0 +1,280 @@
+import { computed, ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import { groupRequest } from '../api';
+import auditArchive from '../services/uwxAuditArchive';
+import { watchState } from '../services/watchState';
+import { mergeEntries, normalizeEntry, toCsv } from '../shared/utils/uwxAudit';
+import { useUwxGroupToolsStore } from './uwxGroupTools';
+
+// UWX group activity: VRChat's official group audit log (GET /groups/{id}/auditLogs),
+// read with your own signed-in VRChat session — the same session UWX already uses.
+// It needs the "group-audit-view" permission in that group; VRChat enforces it.
+// Entries are archived locally (SQLite on this PC) so history keeps growing over time.
+
+const PAGE_SIZE = 100;
+const PAGE_GAP_MS = 600;
+const MAX_PAGES_PER_SYNC = 10; // up to 1000 entries per refresh
+const AUTO_REFRESH_MS = 2 * 60 * 1000;
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+const errorStatus = (error) => error?.status || error?.statusCode || error?.response?.status || 0;
+
+export const useUwxGroupAuditStore = defineStore('UwxGroupAudit', () => {
+    const tools = useUwxGroupToolsStore();
+
+    const groupId = ref('');
+    const entries = ref([]);
+    const loading = ref(false);
+    const loadingOlder = ref(false);
+    const reachedEnd = ref(false);
+    const error = ref('');
+    const lastSyncAt = ref(0);
+    const lastNewCount = ref(0);
+    const autoRefresh = ref(true);
+
+    // How far down VRChat's list (newest = offset 0) we've walked this session.
+    let serverOffset = 0;
+    let timer = null;
+    let syncToken = 0;
+
+    const canView = computed(() => Boolean(groupId.value && tools.can(groupId.value, 'audit')));
+
+    const roles = computed(() => {
+        const ref = tools.groupInfo.get(groupId.value)?.ref;
+        return Array.isArray(ref?.roles) ? ref.roles : [];
+    });
+
+    function roleName(id) {
+        return roles.value.find((role) => role?.id === id)?.name || '';
+    }
+
+    async function fetchPage(gid, offset) {
+        const args = await groupRequest.getGroupLogs({ groupId: gid, n: PAGE_SIZE, offset });
+        const json = args?.json || {};
+        const results = Array.isArray(json.results) ? json.results : Array.isArray(json) ? json : [];
+        return {
+            rows: results.map((row) => normalizeEntry(row, gid)).filter(Boolean),
+            hasNext: Boolean(json.hasNext ?? results.length === PAGE_SIZE)
+        };
+    }
+
+    /** Saving to the local archive must never break showing the live log. */
+    async function saveSafely(list) {
+        try {
+            await auditArchive.saveEntries(list);
+        } catch (err) {
+            console.warn('UWX audit archive save failed', err?.message || err);
+        }
+    }
+
+    function friendlyError(err) {
+        const status = errorStatus(err);
+        if (status === 403) return "VRChat says your role in this group can't view the audit log.";
+        if (status === 429) return 'VRChat rate limit — UWX will try again shortly.';
+        if (status === 401) return 'Your VRChat session expired. Log in again.';
+        return err?.error?.message || err?.message || 'Could not load the audit log.';
+    }
+
+    /** Pull everything newer than what we have (walks pages until it overlaps the archive). */
+    async function syncNewest({ quiet = false } = {}) {
+        const gid = groupId.value;
+        if (!gid || loading.value || !watchState.isLoggedIn) return;
+        if (!canView.value) {
+            error.value = "Your role in this group doesn't include viewing the audit log.";
+            return;
+        }
+        const token = ++syncToken;
+        loading.value = true;
+        error.value = '';
+        let fresh = [];
+        try {
+            const known = new Set(entries.value.map((e) => e.id));
+            for (let page = 0; page < MAX_PAGES_PER_SYNC; page++) {
+                const { rows, hasNext } = await fetchPage(gid, page * PAGE_SIZE);
+                if (token !== syncToken || gid !== groupId.value) return;
+                const newRows = rows.filter((row) => !known.has(row.id));
+                fresh = fresh.concat(newRows);
+                newRows.forEach((row) => known.add(row.id));
+                if (page === 0 && !entries.value.length && !hasNext) reachedEnd.value = true;
+                // Stop once a page overlaps what we already have, or VRChat has nothing more.
+                if (newRows.length < rows.length || !hasNext) {
+                    if (!hasNext && newRows.length === rows.length) reachedEnd.value = true;
+                    serverOffset = Math.max(serverOffset + fresh.length, (page + 1) * PAGE_SIZE);
+                    break;
+                }
+                serverOffset = (page + 1) * PAGE_SIZE;
+                await sleep(PAGE_GAP_MS);
+            }
+            if (fresh.length) {
+                entries.value = mergeEntries(entries.value, fresh);
+                await saveSafely(fresh);
+            }
+            lastNewCount.value = fresh.length;
+            lastSyncAt.value = Date.now();
+        } catch (err) {
+            if (token !== syncToken) return;
+            // Keep whatever we got before the error.
+            if (fresh.length) {
+                entries.value = mergeEntries(entries.value, fresh);
+                await saveSafely(fresh);
+            }
+            error.value = friendlyError(err);
+            if (!quiet) toast.error(error.value);
+        } finally {
+            if (token === syncToken) loading.value = false;
+        }
+    }
+
+    /** Walk further back in VRChat's history, skipping pages we already archived. */
+    async function loadOlder() {
+        const gid = groupId.value;
+        if (!gid || loadingOlder.value || loading.value || reachedEnd.value || !canView.value) return;
+        loadingOlder.value = true;
+        error.value = '';
+        let fresh = [];
+        try {
+            const known = new Set(entries.value.map((e) => e.id));
+            for (let page = 0; page < MAX_PAGES_PER_SYNC; page++) {
+                const { rows, hasNext } = await fetchPage(gid, serverOffset);
+                if (gid !== groupId.value) return;
+                serverOffset += rows.length || PAGE_SIZE;
+                const newRows = rows.filter((row) => !known.has(row.id));
+                newRows.forEach((row) => known.add(row.id));
+                fresh = fresh.concat(newRows);
+                if (!hasNext || !rows.length) {
+                    reachedEnd.value = true;
+                    break;
+                }
+                if (fresh.length >= PAGE_SIZE) break;
+                await sleep(PAGE_GAP_MS);
+            }
+            if (fresh.length) {
+                entries.value = mergeEntries(entries.value, fresh);
+                await saveSafely(fresh);
+            } else if (reachedEnd.value) {
+                toast.message('That is the start of what VRChat keeps for this group.');
+            }
+        } catch (err) {
+            if (fresh.length) {
+                entries.value = mergeEntries(entries.value, fresh);
+                await saveSafely(fresh);
+            }
+            error.value = friendlyError(err);
+            toast.error(error.value);
+        } finally {
+            loadingOlder.value = false;
+        }
+    }
+
+    function stopTimer() {
+        if (timer) clearInterval(timer);
+        timer = null;
+    }
+
+    function startTimer() {
+        stopTimer();
+        if (!autoRefresh.value) return;
+        timer = setInterval(() => {
+            if (document.visibilityState === 'hidden') return;
+            void syncNewest({ quiet: true });
+        }, AUTO_REFRESH_MS);
+    }
+
+    /** Show a group's activity: archived entries instantly, then fetch what's new. */
+    async function open(gid) {
+        if (!gid) return;
+        if (gid === groupId.value && (entries.value.length || loading.value)) {
+            startTimer();
+            if (!loading.value && Date.now() - lastSyncAt.value > 30 * 1000) void syncNewest({ quiet: true });
+            return;
+        }
+        syncToken++;
+        groupId.value = gid;
+        entries.value = [];
+        error.value = '';
+        reachedEnd.value = false;
+        lastSyncAt.value = 0;
+        lastNewCount.value = 0;
+        serverOffset = 0;
+        loading.value = false;
+        try {
+            const archived = await auditArchive.loadGroup(gid);
+            if (gid === groupId.value) entries.value = archived;
+        } catch {
+            // Archive is a convenience; the live log still works without it.
+        }
+        await syncNewest();
+        startTimer();
+    }
+
+    function close() {
+        stopTimer();
+    }
+
+    function setAutoRefresh(value) {
+        autoRefresh.value = Boolean(value);
+        if (autoRefresh.value && groupId.value) startTimer();
+        else stopTimer();
+    }
+
+    /** Refresh soon after UWX itself moderates, so the action shows up. */
+    function nudge(gid) {
+        if (gid && gid === groupId.value) setTimeout(() => void syncNewest({ quiet: true }), 3000);
+    }
+
+    function download(filename, text, type) {
+        const blob = new Blob([text], { type });
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement('a');
+        a.href = url;
+        a.download = filename;
+        document.body.appendChild(a);
+        a.click();
+        a.remove();
+        setTimeout(() => URL.revokeObjectURL(url), 2000);
+    }
+
+    function exportEntries(list, format = 'csv', label = 'group') {
+        const safe = String(label).replace(/[^a-z0-9-_]+/gi, '_').slice(0, 40) || 'group';
+        const stamp = new Date().toISOString().slice(0, 10);
+        if (format === 'json') {
+            download(`${safe}-audit-${stamp}.json`, JSON.stringify(list, null, 2), 'application/json');
+        } else {
+            download(`${safe}-audit-${stamp}.csv`, toCsv(list, roleName), 'text/csv');
+        }
+    }
+
+    async function clearArchive() {
+        if (!groupId.value) return;
+        await auditArchive.clearGroup(groupId.value);
+        entries.value = [];
+        serverOffset = 0;
+        reachedEnd.value = false;
+        await syncNewest();
+    }
+
+    return {
+        groupId,
+        entries,
+        loading,
+        loadingOlder,
+        reachedEnd,
+        error,
+        lastSyncAt,
+        lastNewCount,
+        autoRefresh,
+        canView,
+        roles,
+        roleName,
+        open,
+        close,
+        syncNewest,
+        loadOlder,
+        setAutoRefresh,
+        nudge,
+        exportEntries,
+        clearArchive
+    };
+});
