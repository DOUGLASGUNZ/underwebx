+            ),
+            `Entry: ${entry.id}`
+        ].filter(Boolean);
+        try {
+            await navigator.clipboard.writeText(lines.join('\n'));
+            toast.success('Copied');
+        } catch {
+            toast.error('Could not copy');
+        }
+    }
