+<template>
+    <Card class="uwx-card uwx-card-wide">
+        <CardHeader>
+            <div class="flex flex-wrap items-start justify-between gap-3">
+                <div class="min-w-0">
+                    <CardTitle>Group activity</CardTitle>
+                    <CardDescription>
+                        VRChat's audit log for {{ groupName }}, read with your account. Saved on this PC so history keeps
+                        building up.
+                    </CardDescription>
+                </div>
+                <div class="flex flex-wrap items-center gap-2">
+                    <label class="uwx-inline-toggle text-xs">
+                        <Switch :model-value="autoRefresh" @update:model-value="setAutoRefresh" />
+                        Auto-check every 2 min
+                    </label>
+                    <Button size="sm" variant="outline" :disabled="loading || !canView" @click="syncNewest()">
+                        <i :class="loading ? 'ri-loader-4-line animate-spin' : 'ri-refresh-line'" />
+                        Check now
+                    </Button>
+                    <Button size="sm" variant="ghost" :disabled="!filtered.length" @click="exportEntries(filtered, 'csv', groupName)">
+                        <i class="ri-download-2-line" />
+                        CSV
+                    </Button>
+                    <Button size="sm" variant="ghost" :disabled="!filtered.length" @click="exportEntries(filtered, 'json', groupName)">
+                        JSON
+                    </Button>
+                </div>
+            </div>
+        </CardHeader>
+
+        <CardContent class="space-y-4">
+            <p v-if="!canView" class="text-sm text-muted-foreground">
+                Your role in {{ groupName }} doesn't include “View audit log”, so VRChat won't share it. Ask the owner to
+                add that permission to your role.
+            </p>
+
+            <template v-else>
+                <div class="uwx-audit-status">
+                    <span v-if="loading && !entries.length">Loading from VRChat…</span>
+                    <span v-else-if="lastSyncAt">
+                        Checked {{ formatClock(lastSyncAt) }}
+                        <template v-if="lastNewCount"> · {{ lastNewCount }} new</template>
+                        · {{ entries.length }} saved
+                    </span>
+                    <span v-if="error" class="uwx-audit-error">{{ error }}</span>
+                </div>
+
+                <div class="uwx-audit-summary">
+                    <button
+                        v-for="cat in summaryCats"
+                        :key="cat.id"
+                        type="button"
+                        class="uwx-audit-stat"
+                        :class="[`cat-${cat.id}`, { active: category === cat.id }]"
+                        @click="category = category === cat.id ? 'all' : cat.id">
+                        <strong>{{ cat.count }}</strong>
+                        <span>{{ cat.label }}</span>
+                    </button>
+                    <div class="uwx-audit-stat-note">last 24 hours</div>
+                </div>
+                <div v-if="daySummary.topActors.length" class="uwx-audit-staff">
+                    <span class="uwx-section-label">MOST ACTIVE STAFF (24H)</span>
+                    <button
+                        v-for="actor in daySummary.topActors"
+                        :key="actor.actorId"
+                        type="button"
+                        class="uwx-audit-chip"
+                        :class="{ active: actorId === actor.actorId }"
+                        @click="actorId = actorId === actor.actorId ? '' : actor.actorId">
+                        {{ actor.name }} · {{ actor.count }}
+                    </button>
+                </div>
+
+                <div class="uwx-audit-filters">
+                    <Input v-model="query" placeholder="Search names, IDs, descriptions…" aria-label="Search activity" />
+                    <NativeSelect v-model="category" aria-label="Type of activity">
+                        <NativeSelectOption v-for="cat in AUDIT_CATEGORIES" :key="cat.id" :value="cat.id">{{ cat.label }}</NativeSelectOption>
+                    </NativeSelect>
+                    <NativeSelect v-model="range" aria-label="Time range">
+                        <NativeSelectOption value="1">Last 24 hours</NativeSelectOption>
+                        <NativeSelectOption value="7">Last 7 days</NativeSelectOption>
+                        <NativeSelectOption value="30">Last 30 days</NativeSelectOption>
+                        <NativeSelectOption value="0">All saved</NativeSelectOption>
+                    </NativeSelect>
+                    <NativeSelect v-model="actorId" aria-label="Who did it">
+                        <NativeSelectOption value="">Anyone</NativeSelectOption>
+                        <NativeSelectOption v-for="actor in actors" :key="actor.actorId" :value="actor.actorId">
+                            {{ actor.name }} ({{ actor.count }})
+                        </NativeSelectOption>
+                    </NativeSelect>
+                    <Button v-if="hasFilters" size="sm" variant="ghost" @click="resetFilters">Clear filters</Button>
+                </div>
+
+                <p v-if="!filtered.length && !loading" class="text-sm text-muted-foreground">
+                    {{ entries.length ? 'Nothing matches these filters.' : 'No activity returned by VRChat yet.' }}
+                </p>
+
+                <div v-else class="uwx-audit-list">
+                    <template v-for="block in visibleDays" :key="block.day">
+                        <div class="uwx-audit-day">{{ block.day }}</div>
+                        <div
+                            v-for="entry in block.items"
+                            :key="entry.id"
+                            class="uwx-audit-row"
+                            :class="[`cat-${categorizeEvent(entry.eventType)}`, { open: openId === entry.id }]">
+                            <button type="button" class="uwx-audit-row-main" @click="toggle(entry.id)">
+                                <span class="uwx-audit-time" :title="entry.createdAt">{{ formatTime(entry.ts) }}</span>
+                                <span class="uwx-audit-type">{{ eventLabel(entry.eventType) }}</span>
+                                <span class="uwx-audit-desc">{{ entry.description || entry.eventType }}</span>
+                                <i :class="openId === entry.id ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'" />
+                            </button>
+                            <div v-if="openId === entry.id" class="uwx-audit-detail">
+                                <dl>
+                                    <dt>When</dt>
+                                    <dd>{{ formatFull(entry.ts) }} <small>({{ entry.createdAt }})</small></dd>
+                                    <dt>Done by</dt>
+                                    <dd>
+                                        <a v-if="entry.actorId.startsWith('usr_')" href="#" @click.prevent="showUserDialog(entry.actorId)">{{ entry.actorName }}</a>
+                                        <span v-else>{{ entry.actorName || '—' }}</span>
+                                        <small> {{ entry.actorId }}</small>
+                                    </dd>
+                                    <template v-if="entry.targetId">
+                                        <dt>Target</dt>
+                                        <dd>
+                                            <a v-if="targetKind(entry.targetId) === 'user'" href="#" @click.prevent="showUserDialog(entry.targetId)">Open profile</a>
+                                            <a v-else-if="targetKind(entry.targetId) === 'world'" href="#" @click.prevent="showWorldDialog(entry.targetId)">Open world</a>
+                                            <span v-else-if="targetKind(entry.targetId) === 'role' && roleName(entry.targetId)">{{ roleName(entry.targetId) }}</span>
+                                            <small> {{ entry.targetId }}</small>
