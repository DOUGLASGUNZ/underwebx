diff --git a/src/views/UnderWeb/UwxSilkCard.vue b/src/views/UnderWeb/UwxSilkCard.vue
new file mode 100644
index 0000000..a0d841f
--- /dev/null
+++ b/src/views/UnderWeb/UwxSilkCard.vue
@@ -0,0 +1,264 @@
+<template>
+    <Card class="uwx-card uwx-card-wide">
+        <CardHeader>
+            <div class="flex flex-wrap items-start justify-between gap-3">
+                <div>
+                    <CardTitle>Silk & hub check-ins</CardTitle>
+                    <CardDescription>Show up at the hub, earn Silk. UWX checks you in after 10 minutes there — only your own visit is sent, nothing about who else is there.</CardDescription>
+                </div>
+                <label class="flex items-center gap-2 text-sm">
+                    <Switch :model-value="enabled" @update:modelValue="silk.setEnabled" />
+                    Count my visits
+                </label>
+            </div>
+        </CardHeader>
+        <CardContent class="uwx-silk">
+            <p v-if="!account.signedIn" class="text-sm text-muted-foreground">Sign in to UnderWeb (System tab) to earn and keep Silk.</p>
+            <p v-else-if="!serverReady" class="text-sm text-muted-foreground">Silk isn't switched on at UnderWeb yet (one database step for the owner).</p>
+            <template v-else>
+                <div class="uwx-silk-status" :class="state">
+                    <i :class="statusIcon" />
+                    <span>{{ statusText }}</span>
+                </div>
+
+                <div class="uwx-silk-stats">
+                    <div><strong>{{ (summary?.balance ?? 0).toLocaleString() }}</strong><span>Silk</span></div>
+                    <div><strong>+{{ (summary?.week ?? 0).toLocaleString() }}</strong><span>this week</span></div>
+                    <div><strong>{{ summary?.streak ?? 0 }}</strong><span>week streak</span></div>
+                    <div><strong>{{ summary?.visits ?? 0 }}</strong><span>hub visits</span></div>
+                </div>
+
+                <div class="uwx-silk-cols">
+                    <section>
+                        <div class="uwx-silk-label">HOW TO EARN</div>
+                        <ul class="uwx-silk-ways">
+                            <li><b>+25</b> first 10 minutes at the hub each day</li>
+                            <li><b>+50</b> and an “I was there” badge during an UnderWeb event</li>
+                            <li><b>+10×</b> weeks in a row you visit (up to +50 a week)</li>
+                            <li><b>+10</b> for each approved photo or piece of work (3 a day)</li>
+                            <li><b>+100</b> for every friend staff verify you brought in (Road to 500)</li>
+                        </ul>
+                        <p class="text-xs text-muted-foreground">Spending account Silk in the hub casino is coming — the casino uses in-world Silk for now.</p>
+                    </section>
+                    <section>
+                        <div class="uwx-silk-label">THIS WEEK'S TOP EARNERS</div>
+                        <p v-if="!board.length" class="text-sm text-muted-foreground">Nobody yet — be first.</p>
+                        <div v-for="(r, i) in board.slice(0, 8)" :key="i" class="uwx-silk-row" :class="{ me: r.me }">
+                            <span class="rank">{{ i + 1 }}</span><span class="name">{{ r.display_name || r.username }}</span><strong>{{ r.earned }}</strong>
+                        </div>
+                    </section>
+                    <section>
+                        <div class="uwx-silk-label">RECENT</div>
+                        <p v-if="!summary?.recent?.length" class="text-sm text-muted-foreground">No Silk yet.</p>
+                        <div v-for="(r, i) in (summary?.recent || []).slice(0, 8)" :key="i" class="uwx-silk-row">
+                            <span class="name">{{ r.note || r.reason }}</span>
+                            <strong :class="r.amount < 0 ? 'neg' : ''">{{ r.amount > 0 ? '+' : '' }}{{ r.amount }}</strong>
+                        </div>
+                        <template v-if="summary?.badges?.length">
+                            <div class="uwx-silk-label" style="margin-top: 10px">I WAS THERE</div>
+                            <div class="flex flex-wrap gap-1">
+                                <Badge v-for="b in summary.badges" :key="b.event + b.at" variant="outline">{{ b.event }}</Badge>
+                            </div>
+                        </template>
+                    </section>
+                </div>
+
+                <div v-if="canSetHub" class="uwx-silk-admin">
+                    <div class="uwx-silk-label">HUB WORLDS (OWNER)</div>
+                    <p class="text-xs text-muted-foreground">Visits only count in these worlds. Stand in the hub in VRChat and add it.</p>
+                    <div class="flex flex-wrap items-center gap-2" style="margin-top: 6px">
+                        <Badge v-for="w in hubWorlds" :key="w.world_id" variant="outline">
+                            {{ w.name }}
+                            <button type="button" class="uwx-silk-x" title="Stop counting this world" @click="remove(w)">×</button>
+                        </Badge>
+                        <span v-if="!hubWorlds.length" class="text-sm" style="color: #fab219">No hub world set — check-ins are off until you add one.</span>
+                        <Button size="sm" variant="outline" :disabled="!currentWorldId || inHub" @click="addHere">
+                            {{ inHub ? 'This world is already a hub' : currentWorldId ? `Add “${currentWorldName || 'this world'}”` : 'Join the hub world first' }}
+                        </Button>
+                    </div>
+                </div>
+            </template>
+        </CardContent>
+    </Card>
+</template>
+
+<script setup>
+    import { computed, onBeforeUnmount, onMounted, ref } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { toast } from 'vue-sonner';
+    import { Badge } from '@/components/ui/badge';
+    import { Button } from '@/components/ui/button';
+    import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+    import { Switch } from '@/components/ui/switch';
+
+    import { useModalStore } from '../../stores/modal';
+    import { useUwxAccountStore } from '../../stores/uwxAccount';
+    import { useUwxSilkStore } from '../../stores/uwxSilk';
+
+    const silk = useUwxSilkStore();
+    const account = useUwxAccountStore();
+    const modal = useModalStore();
+    const { enabled, summary, board, hubWorlds, state, note, arrivedAt, serverReady, inHub, currentWorldId, currentWorldName, canSetHub } = storeToRefs(silk);
+
+    const now = ref(Date.now());
+    let tick = null;
+    onMounted(() => {
+        void silk.start();
+        void silk.load();
+        tick = setInterval(() => (now.value = Date.now()), 15000);
+    });
+    onBeforeUnmount(() => clearInterval(tick));
+
+    const statusText = computed(() => {
+        switch (state.value) {
+            case 'here': {
+                const left = Math.max(0, Math.ceil((arrivedAt.value + 10 * 60000 - now.value) / 60000));
+                return left ? `You're at the hub — checking you in in about ${left} min.` : 'You’re at the hub — checking you in…';
+            }
+            case 'checked-in':
+                return 'Checked in at the hub today.';
+            case 'not-verified':
+                return note.value;
+            case 'off':
+                return 'Visit counting is off on this PC.';
+            case 'error':
+                return `Check-in failed: ${note.value}`;
+            default:
+                return summary.value?.today?.confirmed_at ? 'Checked in at the hub today.' : 'Not at the hub right now.';
+        }
+    });
+    const statusIcon = computed(
+        () => ({ here: 'ri-time-line', 'checked-in': 'ri-checkbox-circle-line', 'not-verified': 'ri-error-warning-line', error: 'ri-error-warning-line', off: 'ri-pause-circle-line' })[state.value] || 'ri-map-pin-line'
+    );
+
+    async function addHere() {
+        const { ok } = await modal.confirm({ title: 'Make this a hub world?', description: `Visits to “${currentWorldName.value || currentWorldId.value}” will earn Silk for everyone.` });
+        if (!ok) return;
+        try {
+            await silk.useCurrentWorldAsHub();
+            toast.success('Hub world added.');
+        } catch (e) {
+            toast.error(e.message);
+        }
+    }
+    async function remove(w) {
+        const { ok } = await modal.confirm({ title: 'Stop counting this world?', description: `Visits to ${w.name} won't earn Silk anymore. Earned Silk stays.` });
+        if (ok) await silk.removeHubWorld(w);
+    }
+</script>
+
+<style scoped>
+    .uwx-silk {
+        display: flex;
+        flex-direction: column;
