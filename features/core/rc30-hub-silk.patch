+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, getActivePinia, setActivePinia } from 'pinia';
+import { nextTick, reactive } from 'vue';
+
+const config = { store: {}, getString: vi.fn(async (k, d) => config.store[k] ?? d), setString: vi.fn(async (k, v) => (config.store[k] = v)) };
+vi.mock('../../services/config', () => ({ default: config }));
+const toast = { success: vi.fn() };
+vi.mock('vue-sonner', () => ({ toast }));
+const HUB = 'wrld_11111111-2222-3333-4444-555555555555';
+const loc = reactive({ lastLocation: { location: '', name: '' } });
+vi.mock('../location', () => ({ useLocationStore: () => loc }));
+const account = reactive({ signedIn: true, topRole: { rank: 100 }, rpc: vi.fn() });
+vi.mock('../uwxAccount', () => ({ useUwxAccountStore: () => account }));
+
+const { awardText, useUwxSilkStore, worldIdOf } = await import('../uwxSilk');
+
+const flush = async () => {
+    for (let i = 0; i < 5; i++) await nextTick();
+    await vi.advanceTimersByTimeAsync(0);
+};
+
+describe('hub check-in', () => {
+    afterEach(() => getActivePinia()?._s.forEach((store) => store.$dispose()));
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        vi.clearAllMocks();
+        vi.useFakeTimers();
+        loc.lastLocation = { location: '', name: '' };
+        account.rpc.mockImplementation(async (name, args) => {
+            if (name === 'uw_silk_summary') return { balance: 0, worlds: [{ world_id: HUB, name: 'UnderWeb Hub' }] };
+            if (name === 'uw_silk_leaderboard') return [];
+            if (name === 'uw_hub_checkin' && args.p_stage === 'start') return { status: 'started', confirm_after: new Date(Date.now() + 600000).toISOString() };
+            if (name === 'uw_hub_checkin') return { status: 'checked_in', awards: [{ amount: 25, why: 'Hub visit' }, { amount: 50, why: 'Event: Opening' }], streak: 1 };
+            return null;
+        });
+    });
+
+    test('parses world ids from VRChat locations', () => {
+        expect(worldIdOf(`${HUB}:48213~group(grp_x)~region(us)`)).toBe(HUB);
+        expect(worldIdOf('offline')).toBe('');
+        expect(awardText({ awards: [{ amount: 25, why: 'Hub visit' }, { amount: 50, why: 'Event: X' }] })).toBe('+75 Silk — Hub visit, Event: X');
+    });
+
+    test('checks in after 10 minutes in the hub, only with your own world id', async () => {
+        const s = useUwxSilkStore();
+        await s.start();
+        await flush();
+        loc.lastLocation = { location: `${HUB}:123~private(usr_me)`, name: 'UnderWeb Hub' };
+        await flush();
+        expect(s.state).toBe('here');
+        const starts = account.rpc.mock.calls.filter(([n]) => n === 'uw_hub_checkin');
+        expect(starts).toHaveLength(1);
+        expect(starts[0][1]).toEqual({ p_world_id: HUB, p_stage: 'start' });
+        await vi.advanceTimersByTimeAsync(10 * 60000 + 5000);
+        expect(account.rpc.mock.calls.filter(([n, a]) => n === 'uw_hub_checkin' && a.p_stage === 'confirm')).toHaveLength(1);
+        expect(s.state).toBe('checked-in');
+        expect(toast.success).toHaveBeenCalledWith('+75 Silk — Hub visit, Event: Opening', expect.anything());
+    });
+
+    test('leaving before 10 minutes means no check-in; other worlds never report', async () => {
+        const s = useUwxSilkStore();
+        await s.start();
+        await flush();
+        loc.lastLocation = { location: `${HUB}:1`, name: 'Hub' };
+        await flush();
+        loc.lastLocation = { location: 'wrld_99999999-2222-3333-4444-555555555555:7', name: 'Elsewhere' };
+        await flush();
+        await vi.advanceTimersByTimeAsync(11 * 60000);
+        expect(account.rpc.mock.calls.filter(([n, a]) => n === 'uw_hub_checkin' && a.p_stage === 'confirm')).toHaveLength(0);
+        expect(account.rpc.mock.calls.filter(([n, a]) => n === 'uw_hub_checkin' && a.p_world_id !== HUB)).toHaveLength(0);
+        expect(s.state).toBe('idle');
+    });
+
+    test('turning it off stops reporting', async () => {
+        const s = useUwxSilkStore();
+        await s.start();
+        await s.setEnabled(false);
+        loc.lastLocation = { location: `${HUB}:1`, name: 'Hub' };
+        await flush();
+        expect(account.rpc.mock.calls.filter(([n]) => n === 'uw_hub_checkin')).toHaveLength(0);
+        expect(config.store.UWX_hubCheckinEnabled).toBe('false');
+    });
+});
diff --git a/src/stores/uwxSilk.js b/src/stores/uwxSilk.js
new file mode 100644
index 0000000..ca48382
--- /dev/null
+++ b/src/stores/uwxSilk.js
@@ -0,0 +1,186 @@
+import { computed, ref, watch } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import { useLocationStore } from './location';
+import { useUwxAccountStore } from './uwxAccount';
+
+// Hub check-ins + Silk.
+// When you're in an UnderWeb hub world (the list lives on UnderWeb), UWX tells UnderWeb you arrived,
+// and after 10 minutes there it confirms the visit. UnderWeb decides what that's worth:
+// +25 Silk a day for visiting, +50 and an "I was there" badge during an event, a weekly streak bonus.
+// Only your own visit is reported — never who else is in the instance, never the instance itself.
+
+const ENABLED_KEY = 'UWX_hubCheckinEnabled';
+const CONFIRM_AFTER_MS = 10 * 60 * 1000;
+const errorText = (e) => e?.error?.message || e?.message || 'Unknown error';
+
+/** World id from a VRChat location string ("wrld_…:12345~region(us)") or '' */
+export function worldIdOf(location) {
+    const m = String(location || '').match(/^(wrld_[0-9a-f-]{36})/i);
+    return m ? m[1].toLowerCase() : '';
+}
+
+/** Short toast text for awards returned by uw_hub_checkin. */
+export function awardText(res) {
+    const awards = Array.isArray(res?.awards) ? res.awards : [];
+    if (!awards.length) return 'Checked in at the hub.';
+    const total = awards.reduce((n, a) => n + Number(a.amount || 0), 0);
+    return `+${total} Silk — ${awards.map((a) => a.why).join(', ')}`;
+}
+
+export const useUwxSilkStore = defineStore('UwxSilk', () => {
+    const account = useUwxAccountStore();
+    const locationStore = useLocationStore();
+
+    const enabled = ref(true);
+    const summary = ref(null);
+    const board = ref([]);
+    const hubWorlds = ref([]);
+    const state = ref('idle'); // idle | here | checked-in | not-verified | off | error
+    const note = ref('');
+    const arrivedAt = ref(0);
+    const serverReady = ref(true);
+
+    let started = false;
+    let confirmTimer = null;
+    let currentWorld = '';
+
+    const inHub = computed(() => hubWorlds.value.some((w) => w.world_id === worldIdOf(locationStore.lastLocation?.location)));
+    const currentWorldId = computed(() => worldIdOf(locationStore.lastLocation?.location));
+    const currentWorldName = computed(() => locationStore.lastLocation?.name || '');
+    const canSetHub = computed(() => Number(account.topRole?.rank || 0) >= 90);
+
+    async function load() {
+        if (!account.signedIn) {
+            summary.value = null;
+            return;
+        }
+        try {
+            summary.value = await account.rpc('uw_silk_summary');
+            hubWorlds.value = summary.value?.worlds || [];
+            board.value = (await account.rpc('uw_silk_leaderboard', { p_days: 7 })) || [];
+            serverReady.value = true;
+        } catch (e) {
+            if (e?.status === 404 || /uw_silk_summary|does not exist|schema cache/i.test(errorText(e))) serverReady.value = false;
+        }
+    }
+
+    async function setEnabled(value) {
+        enabled.value = Boolean(value);
+        await configRepository.setString(ENABLED_KEY, enabled.value ? 'true' : 'false');
+        if (!enabled.value) {
+            clearTimeout(confirmTimer);
+            state.value = 'off';
+        } else void onLocation();
+    }
+
+    async function checkin(stage) {
+        try {
+            const res = await account.rpc('uw_hub_checkin', { p_world_id: currentWorld, p_stage: stage });
+            return res || {};
+        } catch (e) {
+            state.value = 'error';
+            note.value = errorText(e);
+            return null;
+        }
+    }
+
+    async function onLocation() {
+        const wid = currentWorldId.value;
+        if (wid === currentWorld && state.value !== 'idle') return;
+        clearTimeout(confirmTimer);
+        currentWorld = wid;
+        arrivedAt.value = 0;
+        if (!enabled.value) return void (state.value = 'off');
+        if (!account.signedIn || !wid || !inHub.value) return void (state.value = 'idle');
+        arrivedAt.value = Date.now();
+        state.value = 'here';
+        const res = await checkin('start');
+        if (!res) return;
+        if (res.status === 'unverified') {
+            state.value = 'not-verified';
+            note.value = 'Verify your VRChat on underweb.cloud to earn Silk for hub visits.';
+            return;
+        }
+        if (res.status === 'already') {
+            state.value = 'checked-in';
+            return;
+        }
+        const wait = Math.max(5000, (Date.parse(res.confirm_after) || Date.now() + CONFIRM_AFTER_MS) - Date.now() + 2000);
+        confirmTimer = setTimeout(() => void confirm(), wait);
+    }
+
+    async function confirm() {
+        if (!inHub.value || currentWorldId.value !== currentWorld) return; // left before 10 minutes
+        const res = await checkin('confirm');
+        if (!res) return;
+        if (res.status === 'too_soon') {
+            confirmTimer = setTimeout(() => void confirm(), Math.max(5000, Date.parse(res.confirm_after) - Date.now() + 2000));
+            return;
+        }
+        if (res.status === 'checked_in') {
+            state.value = 'checked-in';
+            toast.success(awardText(res), { description: res.streak >= 2 ? `${res.streak}-week streak` : undefined });
+            void load();
+        } else if (res.status === 'already') {
+            state.value = 'checked-in';
+        }
+    }
+
+    /** Owner / Director: mark the world you're standing in as an UnderWeb hub world. */
+    async function useCurrentWorldAsHub() {
+        const wid = currentWorldId.value;
+        if (!wid) throw new Error('Join the hub world in VRChat first.');
+        await account.rpc('uw_hub_world_set', { p_world_id: wid, p_name: currentWorldName.value || 'UnderWeb Hub', p_active: true });
+        await load();
+        currentWorld = '';
+        await onLocation();
+    }
+
+    async function removeHubWorld(w) {
+        await account.rpc('uw_hub_world_set', { p_world_id: w.world_id, p_name: w.name, p_active: false });
+        await load();
+    }
+
+    // Watchers live in the store's own scope (cleaned up with it) and only act once started.
+    watch(
+        () => account.signedIn,
+        async (signedIn) => {
+            if (!started) return;
+            await load();
+            if (signedIn) void onLocation();
+        }
+    );
+    watch(currentWorldId, () => started && void onLocation());
+    watch(hubWorlds, () => started && void onLocation());
+
+    async function start() {
+        if (started) return;
+        started = true;
+        enabled.value = (await configRepository.getString(ENABLED_KEY, 'true')) !== 'false';
+        await load();
+        if (account.signedIn) void onLocation();
+    }
+
+    return {
+        enabled,
+        summary,
+        board,
+        hubWorlds,
+        state,
+        note,
+        arrivedAt,
+        serverReady,
+        inHub,
+        currentWorldId,
+        currentWorldName,
+        canSetHub,
+        start,
+        load,
+        setEnabled,
+        useCurrentWorldAsHub,
+        removeHubWorld
+    };
+});
