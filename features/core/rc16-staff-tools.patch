@@ -0,0 +1,85 @@
+import { ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import { useUnderWebStore } from './underweb';
+
+// Saved instance-invite setups: who to invite + which saved invite message, one click.
+
+const KEY = 'UWX_invitePresets';
+const SCOPES = ['selected', 'favorites', 'all-online', 'staff', 'creators', 'partners'];
+
+export const DEFAULT_INVITE_PRESETS = Object.freeze([
+    { id: 'staff-call', name: 'Staff call', scope: 'staff', messageSlot: -1 },
+    { id: 'favorites', name: 'Favorites', scope: 'favorites', messageSlot: -1 },
+    { id: 'creators', name: 'Creators', scope: 'creators', messageSlot: -1 }
+]);
+
+export function normalizeInvitePreset(raw) {
+    const name = String(raw?.name || '').trim().slice(0, 40);
+    if (!name) return null;
+    const slot = Number(raw?.messageSlot);
+    return {
+        id: String(raw?.id || `preset-${Date.now()}`),
+        name,
+        scope: SCOPES.includes(raw?.scope) ? raw.scope : 'favorites',
+        messageSlot: Number.isInteger(slot) && slot >= 0 && slot < 12 ? slot : -1
+    };
+}
+
+export const useUwxInvitePresetsStore = defineStore('UwxInvitePresets', () => {
+    const underweb = useUnderWebStore();
+    const presets = ref(DEFAULT_INVITE_PRESETS.map((p) => ({ ...p })));
+    const loaded = ref(false);
+
+    async function load() {
+        if (loaded.value) return;
+        loaded.value = true;
+        try {
+            const raw = JSON.parse((await configRepository.getString(KEY, '')) || 'null');
+            if (Array.isArray(raw)) {
+                const list = raw.map(normalizeInvitePreset).filter(Boolean);
+                presets.value = list;
+            }
+        } catch {
+            // keep defaults
+        }
+    }
+
+    async function save() {
+        await configRepository.setString(KEY, JSON.stringify(presets.value));
+    }
+
+    /** Save what the inviter is set to right now as a preset. */
+    async function saveCurrent(name) {
+        const preset = normalizeInvitePreset({ name, scope: underweb.inviteScope, messageSlot: underweb.inviteMessageSlot });
+        if (!preset) {
+            toast.error('Give the preset a name.');
+            return null;
+        }
+        presets.value = [...presets.value.filter((p) => p.name.toLowerCase() !== preset.name.toLowerCase()), preset];
+        await save();
+        toast.success(`Saved "${preset.name}".`);
+        return preset;
+    }
+
+    async function remove(id) {
+        presets.value = presets.value.filter((p) => p.id !== id);
+        await save();
+    }
+
+    /** Switch the inviter to a preset. With inviteNow, also sends the invites. */
+    async function apply(id, { inviteNow = false } = {}) {
+        const preset = presets.value.find((p) => p.id === id);
+        if (!preset) return null;
+        await underweb.setInviteScope(preset.scope);
+        await underweb.setInviteMessageSlot(preset.messageSlot);
+        if (inviteNow) {
+            return underweb.inviteFriendsNow(underweb.invitePoolFriends.map((f) => f.id));
+        }
+        return { applied: true };
+    }
+
+    return { presets, load, saveCurrent, remove, apply };
+});
