@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest';
+import { memberHistory, memberSummary, recruitingStats, staffActivity, unusualActivity } from '../uwxStaffInsights';
+
+const MIN = 60 * 1000;
+const DAY = 24 * 60 * MIN;
+const T0 = Date.parse('2026-10-10T00:00:00Z');
+let n = 0;
+const e = (ts, eventType, actorId, actorName, targetId = '', data = {}) => ({ id: `e${++n}`, ts, eventType, actorId, actorName, targetId, description: '', data });
+
+describe('uwxStaffInsights', () => {
+    it('counts staff actions but not members joining or leaving', () => {
+        const list = [
+            e(T0, 'group.user.ban', 'usr_b', 'Blooty', 'usr_x'),
+            e(T0 + MIN, 'group.member.remove', 'usr_b', 'Blooty', 'usr_y'),
+            e(T0 + 2 * MIN, 'group.member.role.assign', 'usr_d', 'Darko', 'usr_z'),
+            e(T0 + 3 * MIN, 'group.member.join', 'usr_new', 'Newbie'),
+            e(T0 + 4 * MIN, 'group.invite.create', 'usr_d', 'Darko', 'usr_q')
+        ];
+        const act = staffActivity(list, 0);
+        expect(act.map((a) => [a.name, a.total])).toEqual([['Blooty', 2], ['Darko', 2]]);
+        expect(act[0].byCategory).toEqual({ moderation: 2 });
+    });
+
+    it('flags a burst of bans, permission changes and sensitive changes', () => {
+        const list = [];
+        for (let i = 0; i < 6; i++) list.push(e(T0 + i * MIN, 'group.user.ban', 'usr_b', 'Blooty', `usr_${i}`));
+        list.push(e(T0 + 2 * DAY, 'group.user.ban', 'usr_b', 'Blooty', 'usr_lone'));
+        list.push(e(T0 + DAY, 'group.role.update', 'usr_d', 'Darko', 'grol_mod', { permissions: { old: [], new: ['group-bans-manage'] } }));
+        list.push(e(T0 + DAY, 'group.role.update', 'usr_d', 'Darko', 'grol_mod', { name: { old: 'Mod', new: 'Moderator' } }));
+        list.push(e(T0 + DAY, 'group.role.delete', 'usr_d', 'Darko', 'grol_old'));
+        const flags = unusualActivity(list);
+        expect(flags.map((f) => f.kind).sort()).toEqual(['burst', 'permissions', 'sensitive']);
+        const burst = flags.find((f) => f.kind === 'burst');
+        expect(burst.entryIds).toHaveLength(6);
+        expect(burst.text).toMatch(/6 bans\/removals in 5 min/);
+    });
+
+    it('does not flag normal paced moderation', () => {
+        const list = [];
+        for (let i = 0; i < 6; i++) list.push(e(T0 + i * 30 * MIN, 'group.user.ban', 'usr_b', 'Blooty', `usr_${i}`));
+        expect(unusualActivity(list)).toEqual([]);
+    });
+
+    it('builds a member history and summary', () => {
+        const list = [
+            e(T0, 'group.member.join', 'usr_m', 'Member'),
+            e(T0 + DAY, 'group.instance.warn', 'usr_b', 'Blooty', 'usr_m'),
+            e(T0 + 2 * DAY, 'group.instance.kick', 'usr_b', 'Blooty', 'usr_m'),
+            e(T0 + 3 * DAY, 'group.user.ban', 'usr_d', 'Darko', 'usr_m'),
+            e(T0 + 3 * DAY, 'group.user.ban', 'usr_d', 'Darko', 'usr_other')
+        ];
+        expect(memberHistory(list, 'usr_m')).toHaveLength(4);
+        expect(memberSummary(list, 'usr_m')).toEqual({ firstJoinAt: T0, bans: 1, removals: 0, kicks: 1, warnings: 1 });
+    });
+
+    it('measures how many invited people joined, by staff and by event', () => {
+        const list = [
+            e(T0, 'group.invite.create', 'usr_d', 'Darko', 'usr_1'),
+            e(T0 + MIN, 'group.invite.create', 'usr_d', 'Darko', 'usr_2'),
+            e(T0 + 2 * MIN, 'group.invite.create', 'usr_b', 'Blooty', 'usr_3'),
+            e(T0 + DAY, 'group.member.join', 'usr_1', 'One'),
+            e(T0 + 20 * DAY, 'group.member.join', 'usr_2', 'Two'), // too late to count
+            e(T0 + DAY, 'group.member.join', 'usr_9', 'Walk-in')
+        ];
+        const stats = recruitingStats(list, { events: [{ name: 'MVN', startedAt: T0 - MIN, endedAt: T0 + 90 * MIN }] });
+        expect(stats).toMatchObject({ sent: 3, people: 3, accepted: 1, joinsTotal: 3 });
+        expect(stats.rate).toBeCloseTo(1 / 3);
+        expect(stats.byStaff).toEqual([
+            { actorId: 'usr_d', name: 'Darko', sent: 2, accepted: 1 },
+            { actorId: 'usr_b', name: 'Blooty', sent: 1, accepted: 0 }
+        ]);
+        expect(stats.byEvent).toEqual([{ name: 'MVN', sent: 3, accepted: 1 }]);
+    });
+});
diff --git a/src/shared/utils/uwxStaffInsights.js b/src/shared/utils/uwxStaffInsights.js
new file mode 100644
index 0000000..3c3ff47
--- /dev/null
+++ b/src/shared/utils/uwxStaffInsights.js
@@ -0,0 +1,152 @@
+// Staff insights from the group audit archive (pure): who's moderating, unusual activity,
+// a member's history, and recruiting conversion. Input entries are normalized audit
+// entries (see uwxAudit.js): { id, ts, eventType, actorId, actorName, targetId, description, data }.
+
+import { categorizeEvent, eventLabel } from './uwxAudit';
+
+const MIN = 60 * 1000;
+const DAY = 24 * 60 * MIN;
+
+const INVITE_TYPES = new Set(['group.invite.create']);
+const JOIN_TYPES = new Set(['group.member.join']);
+const SENSITIVE_TYPES = new Set(['group.role.delete', 'group.update', 'group.transfer.start', 'group.transfer.accept', 'group.owner.change']);
+
+/** Per-staff activity since `sinceMs`: counts by category, total, last action. Self-service events excluded. */
+export function staffActivity(entries, sinceMs) {
+    const byActor = new Map();
+    for (const e of entries || []) {
+        if (e.ts < sinceMs || !e.actorId) continue;
+        const cat = categorizeEvent(e.eventType);
+        if (cat === 'members' && !INVITE_TYPES.has(e.eventType)) continue; // joins/leaves are done by members themselves
+        const a = byActor.get(e.actorId) || { actorId: e.actorId, name: e.actorName, total: 0, lastAt: 0, byCategory: {} };
+        a.total += 1;
+        a.byCategory[cat] = (a.byCategory[cat] || 0) + 1;
+        if (e.ts > a.lastAt) {
+            a.lastAt = e.ts;
+            a.name = e.actorName || a.name;
+        }
+        byActor.set(e.actorId, a);
+    }
+    return Array.from(byActor.values()).sort((a, b) => b.total - a.total);
+}
+
+/**
+ * Things a group owner would want to look at:
+ *  - burst: one person banning/removing/kicking many people quickly
+ *  - permissions: a role's permissions changed
+ *  - sensitive: role deleted, group settings changed, ownership moves
+ * @returns {Array<{ id: string, kind: string, ts: number, actorId: string, actorName: string, text: string, entryIds: string[] }>}
+ */
+export function unusualActivity(entries, { sinceMs = 0, burstCount = 5, burstWindowMs = 10 * MIN } = {}) {
+    const flags = [];
+    const recent = (entries || []).filter((e) => e.ts >= sinceMs).sort((a, b) => a.ts - b.ts);
+
+    const modByActor = new Map();
+    for (const e of recent) {
+        if (categorizeEvent(e.eventType) !== 'moderation' || /unban|unblock/.test(e.eventType)) continue;
+        if (!modByActor.has(e.actorId)) modByActor.set(e.actorId, []);
+        modByActor.get(e.actorId).push(e);
+    }
+    for (const [actorId, list] of modByActor) {
+        let start = 0;
+        let lastFlagEnd = -1;
+        for (let end = 0; end < list.length; end++) {
+            while (list[end].ts - list[start].ts > burstWindowMs) start++;
+            const count = end - start + 1;
+            if (count >= burstCount && start > lastFlagEnd) {
+                // extend to the whole burst
+                let stop = end;
+                while (stop + 1 < list.length && list[stop + 1].ts - list[start].ts <= burstWindowMs) stop++;
+                const slice = list.slice(start, stop + 1);
+                flags.push({
+                    id: `burst-${slice[0].id}`,
+                    kind: 'burst',
+                    ts: slice[slice.length - 1].ts,
+                    actorId,
+                    actorName: slice[0].actorName,
+                    text: `${slice[0].actorName} did ${slice.length} bans/removals in ${Math.max(1, Math.round((slice[slice.length - 1].ts - slice[0].ts) / MIN))} min`,
+                    entryIds: slice.map((x) => x.id)
+                });
+                lastFlagEnd = stop;
+                end = stop;
+            }
+        }
+    }
+
+    for (const e of recent) {
+        const permsChanged = e.eventType === 'group.role.update' && e.data && Object.keys(e.data).some((k) => /permission/i.test(k));
+        if (permsChanged) {
+            flags.push({ id: `perm-${e.id}`, kind: 'permissions', ts: e.ts, actorId: e.actorId, actorName: e.actorName, text: `${e.actorName} changed a role's permissions`, entryIds: [e.id] });
+        } else if (SENSITIVE_TYPES.has(e.eventType)) {
+            flags.push({ id: `sens-${e.id}`, kind: 'sensitive', ts: e.ts, actorId: e.actorId, actorName: e.actorName, text: `${e.actorName}: ${eventLabel(e.eventType)}`, entryIds: [e.id] });
+        }
+    }
+    return flags.sort((a, b) => b.ts - a.ts);
+}
+
+/** Everything the group log knows about one person (as target or actor), newest first. */
+export function memberHistory(entries, userId) {
+    return (entries || []).filter((e) => e.targetId === userId || e.actorId === userId).sort((a, b) => b.ts - a.ts);
+}
+
+/** Their first join and whether they've been banned/removed before, for the member card. */
+export function memberSummary(entries, userId) {
+    const history = memberHistory(entries, userId);
+    const joins = history.filter((e) => JOIN_TYPES.has(e.eventType) && e.actorId === userId);
+    const strikes = history.filter((e) => e.targetId === userId && /user\.ban|member\.remove|instance\.kick|instance\.warn/.test(e.eventType));
+    return {
+        firstJoinAt: joins.length ? Math.min(...joins.map((e) => e.ts)) : 0,
+        bans: strikes.filter((e) => /ban/.test(e.eventType)).length,
+        removals: strikes.filter((e) => /member\.remove/.test(e.eventType)).length,
+        kicks: strikes.filter((e) => /instance\.kick/.test(e.eventType)).length,
+        warnings: strikes.filter((e) => /instance\.warn/.test(e.eventType)).length
+    };
+}
+
+/**
+ * Group invites vs. joins. An invite counts as accepted if that person joined within `windowMs`.
+ * `events` (optional): Event Mode runs [{ name, startedAt, endedAt }] to credit invites sent during an event.
+ */
+export function recruitingStats(entries, { sinceMs = 0, windowMs = 14 * DAY, events = [] } = {}) {
+    const all = (entries || []).slice().sort((a, b) => a.ts - b.ts);
+    const joinsByUser = new Map();
+    for (const e of all) {
+        if (JOIN_TYPES.has(e.eventType) && e.actorId) {
+            if (!joinsByUser.has(e.actorId)) joinsByUser.set(e.actorId, []);
+            joinsByUser.get(e.actorId).push(e.ts);
+        }
+    }
+    const invites = all.filter((e) => INVITE_TYPES.has(e.eventType) && e.ts >= sinceMs && e.targetId);
+    const byStaff = new Map();
+    const byEvent = new Map();
+    let accepted = 0;
+    const seen = new Set();
+    for (const inv of invites) {
+        const key = `${inv.targetId}`;
+        const joined = (joinsByUser.get(inv.targetId) || []).some((t) => t >= inv.ts && t - inv.ts <= windowMs);
+        const firstForUser = !seen.has(key);
+        seen.add(key);
+        if (joined && firstForUser) accepted += 1;
+        const s = byStaff.get(inv.actorId) || { actorId: inv.actorId, name: inv.actorName, sent: 0, accepted: 0 };
+        s.sent += 1;
+        if (joined && firstForUser) s.accepted += 1;
+        byStaff.set(inv.actorId, s);
+        const ev = events.find((x) => inv.ts >= x.startedAt && inv.ts <= (x.endedAt || x.startedAt));
+        if (ev) {
+            const b = byEvent.get(ev.name) || { name: ev.name, sent: 0, accepted: 0 };
+            b.sent += 1;
+            if (joined && firstForUser) b.accepted += 1;
+            byEvent.set(ev.name, b);
+        }
+    }
+    const people = seen.size;
+    return {
+        sent: invites.length,
+        people,
+        accepted,
+        rate: people ? accepted / people : 0,
+        joinsTotal: all.filter((e) => JOIN_TYPES.has(e.eventType) && e.ts >= sinceMs).length,
+        byStaff: Array.from(byStaff.values()).sort((a, b) => b.sent - a.sent),
+        byEvent: Array.from(byEvent.values()).sort((a, b) => b.sent - a.sent)
+    };
+}
