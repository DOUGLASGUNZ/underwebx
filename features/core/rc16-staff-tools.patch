diff --git a/src/stores/uwxDiscordAlerts.js b/src/stores/uwxDiscordAlerts.js
new file mode 100644
index 0000000..cf0e70e
--- /dev/null
+++ b/src/stores/uwxDiscordAlerts.js
@@ -0,0 +1,213 @@
+import { reactive, ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import { groupRequest } from '../api';
+import auditArchive from '../services/uwxAuditArchive';
+import configRepository from '../services/config';
+import { watchState } from '../services/watchState';
+import { categorizeEvent, eventLabel, normalizeEntry } from '../shared/utils/uwxAudit';
+import { formatRecap } from '../shared/utils/uwxEvent';
+import { labelSummary } from '../shared/utils/uwxSafety';
+import { unusualActivity } from '../shared/utils/uwxStaffInsights';
+
+// Discord alerts: posts to a staff channel through a Discord webhook you create.
+// The webhook URL is a secret — it stays in UWX's local settings and is never logged.
+// Posts contain display names and what happened; never instance IDs, locations or IPs.
+
+const CONFIG = Object.freeze({
+    url: 'UWX_discordWebhookUrl',
+    settings: 'UWX_discordAlertSettings',
+    cursor: 'UWX_discordAlertCursor'
+});
+const WEBHOOK_RE = /^https:\/\/(?:ptb\.|canary\.)?discord(?:app)?\.com\/api\/webhooks\/\d{5,25}\/[\w-]{20,}$/;
+const POLL_MS = 2 * 60 * 1000;
+const SEND_GAP_MS = 2000;
+const MAX_LINES = 12;
+
+export const DEFAULT_ALERT_SETTINGS = Object.freeze({
+    groupId: '',
+    groupName: '',
+    moderation: true, // bans, removals, kicks, warnings
+    roles: true, // roles given/taken, role edits
+    flags: true, // unusual activity
+    labeled: false, // a labeled person is in your instance
+    recaps: true // Event Mode recaps
+});
+
+export function isWebhookUrl(url) {
+    return WEBHOOK_RE.test(String(url || '').trim());
+}
+
+/** One Discord line for an audit entry, or '' if the settings don't include it. */
+export function alertLine(entry, settings) {
+    const cat = categorizeEvent(entry.eventType);
+    const wanted = (cat === 'moderation' && settings.moderation) || (cat === 'roles' && settings.roles);
+    if (!wanted) return '';
+    const icon = cat === 'moderation' ? (/unban|unblock/.test(entry.eventType) ? '♻️' : '🔨') : '🎭';
+    const when = `<t:${Math.floor(entry.ts / 1000)}:t>`;
+    const text = entry.description || `${entry.actorName}: ${eventLabel(entry.eventType)}`;
+    return `${icon} ${when} ${text.replace(/[@`]/g, '')}`.slice(0, 300);
+}
+
+export const useUwxDiscordAlertsStore = defineStore('UwxDiscordAlerts', () => {
+    const webhookSet = ref(false);
+    const settings = reactive({ ...DEFAULT_ALERT_SETTINGS });
+    const lastPostAt = ref(0);
+    const lastError = ref('');
+    const initialized = ref(false);
+    let webhookUrl = '';
+    let cursorTs = 0;
+    let pollTimer = null;
+    const queue = [];
+    let sending = false;
+
+    async function persistSettings() {
+        await configRepository.setString(CONFIG.settings, JSON.stringify(settings));
+    }
+
+    async function send(content) {
+        if (!webhookUrl) return false;
+        queue.push(String(content).slice(0, 1900));
+        if (sending) return true;
+        sending = true;
+        try {
+            while (queue.length) {
+                const body = queue.shift();
+                const response = await fetch(webhookUrl, {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ username: 'UnderWeb X', content: body, allowed_mentions: { parse: [] } })
+                });
+                if (response.status === 429) {
+                    const json = await response.json().catch(() => ({}));
+                    queue.unshift(body);
+                    await new Promise((r) => setTimeout(r, Math.ceil((Number(json.retry_after) || 2) * 1000)));
+                    continue;
+                }
+                if (!response.ok) {
+                    lastError.value =
+                        response.status === 404 || response.status === 401
+                            ? 'Discord says this webhook no longer exists. Paste a new one.'
+                            : `Discord refused the alert (${response.status}).`;
+                    queue.length = 0;
+                    return false;
+                }
+                lastError.value = '';
+                lastPostAt.value = Date.now();
+                if (queue.length) await new Promise((r) => setTimeout(r, SEND_GAP_MS));
+            }
+            return true;
+        } catch (error) {
+            lastError.value = error?.message || 'Could not reach Discord.';
+            return false;
+        } finally {
+            sending = false;
+        }
+    }
+
+    async function poll() {
+        if (!webhookUrl || !settings.groupId || !watchState.isLoggedIn) return;
+        let rows = [];
+        try {
+            const args = await groupRequest.getGroupLogs({ groupId: settings.groupId, n: 50, offset: 0 });
+            rows = (args?.json?.results || []).map((r) => normalizeEntry(r, settings.groupId)).filter(Boolean);
+        } catch {
+            return; // try again next poll (rate limit, offline, no permission)
+        }
+        if (!rows.length) return;
+        const fresh = rows.filter((e) => e.ts > cursorTs).sort((a, b) => a.ts - b.ts);
+        if (!fresh.length) return;
+        await auditArchive.saveEntries(fresh).catch(() => {});
+        cursorTs = fresh[fresh.length - 1].ts;
+        await configRepository.setString(CONFIG.cursor, String(cursorTs));
+
+        const lines = fresh.map((e) => alertLine(e, settings)).filter(Boolean);
+        if (settings.flags) {
+            for (const flag of unusualActivity(fresh, { sinceMs: 0 })) lines.push(`⚠️ **Unusual:** ${flag.text}`);
+        }
+        for (let i = 0; i < lines.length; i += MAX_LINES) {
+            const header = i === 0 ? `**${settings.groupName || 'Group'}** activity\n` : '';
+            await send(header + lines.slice(i, i + MAX_LINES).join('\n'));
+        }
+    }
+
+    function restartPolling() {
+        if (pollTimer) clearInterval(pollTimer);
+        pollTimer = null;
+        if (webhookUrl && settings.groupId) {
+            pollTimer = setInterval(() => void poll(), POLL_MS);
+            void poll();
+        }
+    }
+
+    async function init() {
+        if (initialized.value) return;
+        initialized.value = true;
+        webhookUrl = (await configRepository.getString(CONFIG.url, '')) || '';
+        webhookSet.value = isWebhookUrl(webhookUrl);
+        if (!webhookSet.value) webhookUrl = '';
+        try {
+            Object.assign(settings, DEFAULT_ALERT_SETTINGS, JSON.parse((await configRepository.getString(CONFIG.settings, '')) || '{}'));
+        } catch {
+            // defaults
+        }
+        cursorTs = Number(await configRepository.getString(CONFIG.cursor, '0')) || 0;
+        restartPolling();
+    }
+
+    async function setWebhook(url) {
+        const value = String(url || '').trim();
+        if (value && !isWebhookUrl(value)) {
+            toast.error('That isn’t a Discord webhook link. In Discord: channel settings → Integrations → Webhooks → Copy URL.');
+            return false;
+        }
+        webhookUrl = value;
+        webhookSet.value = Boolean(value);
+        await configRepository.setString(CONFIG.url, value);
+        // Start from "now" so connecting doesn't dump old history into the channel.
+        cursorTs = Date.now();
+        await configRepository.setString(CONFIG.cursor, String(cursorTs));
+        restartPolling();
+        if (value) toast.success('Discord alerts connected.');
+        return true;
+    }
+
+    async function setSetting(key, value) {
+        if (!(key in DEFAULT_ALERT_SETTINGS)) return;
+        settings[key] = value;
+        await persistSettings();
+        if (key === 'groupId') {
+            cursorTs = Date.now();
+            await configRepository.setString(CONFIG.cursor, String(cursorTs));
+            restartPolling();
+        }
+    }
+
+    async function sendTest() {
+        const ok = await send(`✅ UnderWeb X alerts are connected${settings.groupName ? ` for **${settings.groupName}**` : ''}.`);
+        if (ok) toast.success('Test message sent to Discord.');
+        else toast.error(lastError.value || 'Test failed.');
+        return ok;
+    }
+
+    /** Called by Lobby Guard. Names only — never where you are. */
+    function onLabeledPerson(person, selfName = '') {
+        if (!settings.labeled || !webhookUrl) return;
+        void send(`🚨 **${person.displayName}** (${labelSummary(person.intel)}) is in an instance with ${selfName || 'a staff member'}.`);
+    }
+
+    /** Called by Event Mode when an event ends. */
+    function onEventRecap(recap) {
+        if (!settings.recaps || !webhookUrl) return;
+        void send(formatRecap(recap));
+    }
+
+    function dispose() {
+        if (pollTimer) clearInterval(pollTimer);
+        pollTimer = null;
+        initialized.value = false;
+    }
+
+    return { webhookSet, settings, lastPostAt, lastError, init, setWebhook, setSetting, sendTest, poll, onLabeledPerson, onEventRecap, dispose };
+});
