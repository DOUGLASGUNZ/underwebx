@@ -0,0 +1,90 @@
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+
+const config = {};
+vi.mock('../../services/config', () => ({
+    default: {
+        getString: vi.fn(async (k, d) => (k in config ? config[k] : d)),
+        setString: vi.fn(async (k, v) => (config[k] = v))
+    }
+}));
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn() } }));
+vi.mock('../../services/watchState', () => ({ watchState: { isLoggedIn: true } }));
+vi.mock('../../services/uwxAuditArchive', () => ({ default: { saveEntries: vi.fn(async () => {}) } }));
+let logRows = [];
+vi.mock('../../api', () => ({ groupRequest: { getGroupLogs: vi.fn(async () => ({ json: { results: logRows } })) } }));
+
+const { useUwxDiscordAlertsStore, isWebhookUrl, alertLine, DEFAULT_ALERT_SETTINGS } = await import('../uwxDiscordAlerts');
+
+const HOOK = 'https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyzABCDEF0123456789';
+let posts;
+global.fetch = vi.fn(async (url, init) => {
+    posts.push({ url, body: JSON.parse(init.body) });
+    return { ok: true, status: 204, json: async () => ({}) };
+});
+const row = (id, ts, eventType, description) => ({ id, created_at: new Date(ts).toISOString(), eventType, actorId: 'usr_b', actorDisplayName: 'Blooty', targetId: 'usr_x', description });
+
+describe('Discord alerts', () => {
+    beforeEach(() => {
+        vi.useFakeTimers();
+        vi.setSystemTime(new Date('2026-10-16T02:00:00Z'));
+        setActivePinia(createPinia());
+        for (const k of Object.keys(config)) delete config[k];
+        posts = [];
+        logRows = [];
+    });
+
+    test('only accepts real Discord webhook links', () => {
+        expect(isWebhookUrl(HOOK)).toBe(true);
+        expect(isWebhookUrl('https://evil.example/api/webhooks/1/abc')).toBe(false);
+        expect(isWebhookUrl('http://discord.com/api/webhooks/123456/abcdefghijklmnopqrstuvwxyz')).toBe(false);
+    });
+
+    test('lines respect the settings and never ping anyone', () => {
+        const ban = { ts: Date.now(), eventType: 'group.user.ban', actorName: 'Blooty', description: 'Blooty banned @everyone' };
+        expect(alertLine(ban, DEFAULT_ALERT_SETTINGS)).toMatch(/^🔨 <t:\d+:t> Blooty banned everyone$/);
+        expect(alertLine(ban, { ...DEFAULT_ALERT_SETTINGS, moderation: false })).toBe('');
+        expect(alertLine({ ...ban, eventType: 'group.member.join' }, DEFAULT_ALERT_SETTINGS)).toBe('');
+    });
+
+    test('connecting does not dump old history; new bans post once with a burst warning', async () => {
+        const store = useUwxDiscordAlertsStore();
+        await store.init();
+        await store.setSetting('groupId', 'grp_1');
+        await store.setSetting('groupName', 'The UnderWeb');
+        logRows = [row('old', Date.now() - 3600e3, 'group.user.ban', 'Blooty banned OldGuy')];
+        await store.setWebhook(HOOK);
+        await vi.advanceTimersByTimeAsync(10);
+        expect(posts).toHaveLength(0);
+
+        const t = Date.now() + 60e3;
+        logRows = [0, 1, 2, 3, 4].map((i) => row(`b${i}`, t + i * 30e3, 'group.user.ban', `Blooty banned Raider${i}`)).concat(logRows);
+        vi.setSystemTime(t + 5 * 60e3);
+        await store.poll();
+        await vi.advanceTimersByTimeAsync(5000);
+        expect(posts).toHaveLength(1);
+        const text = posts[0].body.content;
+        expect(text).toContain('**The UnderWeb** activity');
+        expect(text.match(/Blooty banned Raider/g)).toHaveLength(5);
+        expect(text).toContain('Unusual');
+        expect(posts[0].body.allowed_mentions).toEqual({ parse: [] });
+
+        await store.poll();
+        expect(posts).toHaveLength(1);
+    });
+
+    test('labeled-person alerts are off by default and never include where you are', async () => {
+        const store = useUwxDiscordAlertsStore();
+        await store.init();
+        await store.setWebhook(HOOK);
+        const person = { displayName: 'BadActor', userId: 'usr_x', intel: { verified_flags: ['crashing'], risk_level: 'high' } };
+        store.onLabeledPerson(person, 'Darko');
+        await vi.advanceTimersByTimeAsync(10);
+        expect(posts).toHaveLength(0);
+        await store.setSetting('labeled', true);
+        store.onLabeledPerson(person, 'Darko');
+        await vi.advanceTimersByTimeAsync(10);
+        expect(posts[0].body.content).toBe('🚨 **BadActor** (Crasher) is in an instance with Darko.');
+        expect(posts[0].body.content).not.toMatch(/wrld_|usr_/);
+    });
+});
