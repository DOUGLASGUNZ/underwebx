diff --git a/src/stores/uwxMemberNotes.js b/src/stores/uwxMemberNotes.js
new file mode 100644
index 0000000..96c880c
--- /dev/null
+++ b/src/stores/uwxMemberNotes.js
@@ -0,0 +1,53 @@
+import { ref } from 'vue';
+import { defineStore } from 'pinia';
+
+import configRepository from '../services/config';
+
+// Private staff notes about members, kept on this PC (not shared, not sent anywhere).
+
+const KEY = 'UWX_memberNotes';
+const MAX_PER_USER = 50;
+
+export const useUwxMemberNotesStore = defineStore('UwxMemberNotes', () => {
+    const notes = ref({}); // userId -> [{ id, at, text }]
+    const loaded = ref(false);
+
+    async function load() {
+        if (loaded.value) return;
+        loaded.value = true;
+        try {
+            const raw = JSON.parse((await configRepository.getString(KEY, '')) || '{}');
+            notes.value = raw && typeof raw === 'object' ? raw : {};
+        } catch {
+            notes.value = {};
+        }
+    }
+
+    async function save() {
+        await configRepository.setString(KEY, JSON.stringify(notes.value));
+    }
+
+    function forUser(userId) {
+        return notes.value[userId] || [];
+    }
+
+    async function add(userId, text) {
+        const value = String(text || '').trim().slice(0, 1000);
+        if (!value || !String(userId).startsWith('usr_')) return false;
+        const list = [{ id: `${Date.now()}`, at: Date.now(), text: value }, ...forUser(userId)].slice(0, MAX_PER_USER);
+        notes.value = { ...notes.value, [userId]: list };
+        await save();
+        return true;
+    }
+
+    async function remove(userId, id) {
+        const list = forUser(userId).filter((n) => n.id !== id);
+        const next = { ...notes.value };
+        if (list.length) next[userId] = list;
+        else delete next[userId];
+        notes.value = next;
+        await save();
+    }
+
+    return { notes, load, forUser, add, remove };
+});
