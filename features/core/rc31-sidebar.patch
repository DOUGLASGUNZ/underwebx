new file mode 100644
index 0000000..6b5629d
--- /dev/null
+++ b/src/shared/constants/uwxNav.js
@@ -0,0 +1,27 @@
+// UWX sections as first-class sidebar entries (one route each, all rendered by views/UnderWeb/UnderWeb.vue).
+// access: who sees the entry. 'all' | 'groupStaff' (VRChat group role can moderate) | 'staffOrGroup' | 'underwebStaff'.
+export const UWX_PANELS = Object.freeze([
+    { id: 'command', key: 'underweb', route: 'underweb', path: 'underweb', label: 'Overview', icon: 'ri-radar-line', access: 'all' },
+    { id: 'invites', key: 'uwx-invites', route: 'uwx-invites', path: 'uwx/invites', label: 'Invites', icon: 'ri-mail-send-line', access: 'all' },
+    { id: 'people', key: 'uwx-people', route: 'uwx-people', path: 'uwx/people', label: 'People & Activity', icon: 'ri-team-line', access: 'all' },
+    { id: 'groups', key: 'uwx-groups', route: 'uwx-groups', path: 'uwx/groups', label: 'Group Tools', icon: 'ri-shield-user-line', access: 'groupStaff' },
+    { id: 'intel', key: 'uwx-intel', route: 'uwx-intel', path: 'uwx/intel', label: 'Group Intelligence', icon: 'ri-line-chart-line', access: 'staffOrGroup' },
+    { id: 'moderation', key: 'uwx-moderation', route: 'uwx-moderation', path: 'uwx/moderation', label: 'Moderation Center', icon: 'ri-folder-shield-2-line', access: 'staffOrGroup' },
+    { id: 'staff', key: 'uwx-staff', route: 'uwx-staff', path: 'uwx/staff', label: 'Staff Dashboard', icon: 'ri-team-fill', access: 'underwebStaff' },
+    { id: 'approvals', key: 'uwx-approvals', route: 'uwx-approvals', path: 'uwx/approvals', label: 'Approvals', icon: 'ri-checkbox-multiple-line', access: 'underwebStaff' },
+    { id: 'safety', key: 'uwx-safety', route: 'uwx-safety', path: 'uwx/safety', label: 'Safety Intel', icon: 'ri-shield-check-line', access: 'all' },
+    { id: 'osc', key: 'uwx-osc', route: 'uwx-osc', path: 'uwx/osc', label: 'Chatbox (OSC)', icon: 'ri-chat-3-line', access: 'all' },
+    { id: 'system', key: 'uwx-system', route: 'uwx-system', path: 'uwx/system', label: 'UWX Settings', icon: 'ri-settings-3-line', access: 'all' }
+]);
+
+export const uwxPanelByRoute = (name) => UWX_PANELS.find((p) => p.route === name) || null;
+export const uwxPanelById = (id) => UWX_PANELS.find((p) => p.id === id) || null;
+
+/** Is this panel visible for the given access flags? */
+export function uwxPanelAllowed(panel, { groupStaff = false, underwebStaff = false } = {}) {
+    if (!panel) return false;
+    if (panel.access === 'groupStaff') return groupStaff;
+    if (panel.access === 'staffOrGroup') return groupStaff || underwebStaff;
+    if (panel.access === 'underwebStaff') return underwebStaff;
+    return true;
+}
