diff --git a/src/shared/constants/__tests__/uwxNav.test.js b/src/shared/constants/__tests__/uwxNav.test.js
new file mode 100644
index 0000000..1c68359
--- /dev/null
+++ b/src/shared/constants/__tests__/uwxNav.test.js
@@ -0,0 +1,30 @@
+import { describe, expect, test } from 'vitest';
+
+import { createBaseDefaultNavLayout } from '../../../components/nav-menu/navLayoutDefaults';
+import { collectLayoutKeys } from '../../../components/nav-menu/navLayoutHelpers';
+import { navDefinitions } from '../ui';
+import { UWX_PANELS, uwxPanelAllowed, uwxPanelById, uwxPanelByRoute } from '../uwxNav';
+
+describe('UWX sections in the sidebar', () => {
+    test('every UWX section has a nav entry and is in the default sidebar', () => {
+        const keys = collectLayoutKeys(createBaseDefaultNavLayout((k) => k));
+        const defs = new Map(navDefinitions.map((d) => [d.key, d]));
+        for (const panel of UWX_PANELS) {
+            expect(defs.get(panel.key)?.routeName).toBe(panel.route);
+            expect(keys.has(panel.key)).toBe(true);
+        }
+        for (const k of ['feed', 'friends-locations', 'game-log', 'player-list', 'search', 'favorite-friends', 'friend-log', 'friend-list', 'moderation', 'notification', 'my-avatars', 'tools', 'direct-access']) {
+            expect(keys.has(k)).toBe(true);
+        }
+        expect(uwxPanelByRoute('underweb').id).toBe('command');
+        expect(uwxPanelById('intel').route).toBe('uwx-intel');
+    });
+
+    test('staff sections follow real access', () => {
+        expect(uwxPanelAllowed(uwxPanelById('staff'), {})).toBe(false);
+        expect(uwxPanelAllowed(uwxPanelById('staff'), { underwebStaff: true })).toBe(true);
+        expect(uwxPanelAllowed(uwxPanelById('intel'), { groupStaff: true })).toBe(true);
+        expect(uwxPanelAllowed(uwxPanelById('groups'), { underwebStaff: true })).toBe(false);
+        expect(uwxPanelAllowed(uwxPanelById('osc'), {})).toBe(true);
+    });
+});
