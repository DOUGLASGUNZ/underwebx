+        account.rpc.mockImplementation(async (name, args) => {
+            if (name === 'uwx_my_groups') return [remoteRow];
+            if (name === 'uwx_ingest_group_data') return { inserted: args.p_events.length };
+            return null;
+        });
+        account.api.mockImplementation(async (path) => (path.startsWith('uwx_group_sync_state') ? [{ newest_event_at: new Date(newest).toISOString(), events_total: 5 }] : []));
