+    // Validated palette (dark surface): joins aqua, leaves yellow, removals blue, bans magenta, instance actions orange.
+    const COLORS = { joins: '#199e70', leaves: '#c98500', removals: '#3987e5', bans: '#d55181', instance: '#d95926' };
