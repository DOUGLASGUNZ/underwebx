+        ];
+        const store = useUwxIntelStore();
+        await store.load();
+        await store.loadRegistered();
+        await run(store.refresh({ manual: true }));
+        const ingest = account.rpc.mock.calls.filter(([n]) => n === 'uwx_ingest_group_data');
+        expect(ingest).toHaveLength(1);
+        expect(ingest[0][1].p_group).toBe('uuid-1');
+        expect(ingest[0][1].p_snapshot).toMatchObject({ member_count: 412 });
+        expect(ingest[0][1].p_events.map((e) => e.id)).toEqual(['new']);
+        expect(store.upload.lastInserted).toBe(1);
+        expect(store.goal).toBe(500);
+    });
+
+    test('server rows round-trip into the normalized entry shape', () => {
+        const row = toServerEvent({ id: 'g1', ts: 1, createdAt: '2026-10-22T00:00:00.000Z', eventType: 'group.user.ban', actorId: 'usr_a', actorName: 'A', targetId: 'usr_b', description: 'x', data: {} });
+        expect(row).toMatchObject({ id: 'g1', event_type: 'group.user.ban', target_id: 'usr_b' });
+        const back = fromServerEvent({ vrchat_event_id: 'g1', occurred_at: row.created_at, event_type: row.event_type, actor_vrc_id: 'usr_a', target_vrc_id: 'usr_b' }, GROUP);
+        expect(back).toMatchObject({ id: 'g1', eventType: 'group.user.ban', actorId: 'usr_a', targetId: 'usr_b', groupId: GROUP });
+    });
+});
