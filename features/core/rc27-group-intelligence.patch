@@ -0,0 +1,84 @@
+// Local history of group counts (member count, online, bans, requests, invites), one row per
+// group per 15 minutes, stored in UWX's SQLite database on this PC. This is what growth charts
+// are drawn from when the group isn't registered with UnderWeb (and a cache when it is).
+
+import sqliteService from './sqlite.js';
+import { snapshotBucket } from '../shared/utils/uwxIntel';
+
+const TABLE = 'uwx_group_snapshots';
+let ready = false;
+
+async function ensureTable() {
+    if (ready) return;
+    await sqliteService.executeNonQuery(
+        `CREATE TABLE IF NOT EXISTS ${TABLE} (group_id TEXT, bucket INTEGER, member_count INTEGER, online_count INTEGER, ban_count INTEGER, request_count INTEGER, invite_count INTEGER, capped_json TEXT, PRIMARY KEY (group_id, bucket))`
+    );
+    ready = true;
+}
+
+const intOrNull = (v) => (Number.isFinite(v) ? Math.round(v) : null);
+
+/** Save (or update) the snapshot for the current 15-minute bucket. Missing values keep what was there. */
+async function saveSnapshot(groupId, snap, now = Date.now()) {
+    await ensureTable();
+    const bucket = snapshotBucket(now);
+    await sqliteService.executeNonQuery(
+        `INSERT INTO ${TABLE} (group_id, bucket, member_count, online_count, ban_count, request_count, invite_count, capped_json)
+         VALUES (@g, @b, @m, @o, @ban, @r, @i, @c)
+         ON CONFLICT(group_id, bucket) DO UPDATE SET
+           member_count = COALESCE(excluded.member_count, member_count),
+           online_count = COALESCE(excluded.online_count, online_count),
+           ban_count = COALESCE(excluded.ban_count, ban_count),
+           request_count = COALESCE(excluded.request_count, request_count),
+           invite_count = COALESCE(excluded.invite_count, invite_count),
+           capped_json = excluded.capped_json`,
+        {
+            '@g': groupId,
+            '@b': bucket,
+            '@m': intOrNull(snap.memberCount),
+            '@o': intOrNull(snap.onlineCount),
+            '@ban': intOrNull(snap.banCount),
+            '@r': intOrNull(snap.requestCount),
+            '@i': intOrNull(snap.inviteCount),
+            '@c': JSON.stringify(snap.capped || {})
+        }
+    );
+    return bucket;
+}
+
+/** Oldest first. */
+async function loadSnapshots(groupId, sinceMs = 0) {
+    await ensureTable();
+    const rows = [];
+    const num = (v) => (v === null || v === undefined || v === '' ? null : Number(v));
+    await sqliteService.execute(
+        (row) => {
+            let capped = {};
+            try {
+                capped = JSON.parse(row[6] || '{}');
+            } catch {
+                capped = {};
+            }
+            rows.push({
+                ts: Number(row[0]) || 0,
+                memberCount: num(row[1]),
+                onlineCount: num(row[2]),
+                banCount: num(row[3]),
+                requestCount: num(row[4]),
+                inviteCount: num(row[5]),
+                capped,
+                source: 'local'
+            });
+        },
+        `SELECT bucket, member_count, online_count, ban_count, request_count, invite_count, capped_json FROM ${TABLE} WHERE group_id = @g AND bucket >= @s ORDER BY bucket ASC LIMIT 50000`,
+        { '@g': groupId, '@s': Math.max(0, Math.floor(sinceMs)) }
+    );
+    return rows;
+}
+
+async function clearGroup(groupId) {
+    await ensureTable();
+    await sqliteService.executeNonQuery(`DELETE FROM ${TABLE} WHERE group_id = @g`, { '@g': groupId });
+}
+
+export default { saveSnapshot, loadSnapshots, clearGroup };
