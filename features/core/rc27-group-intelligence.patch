+++ b/src/views/UnderWeb/UwxModerationCenter.vue
@@ -0,0 +1,87 @@
+<template>
+    <div class="uwi" :class="{ compact: settings.compact }">
+        <div v-if="pendingActions.length" class="uwx-undo-bar" role="status">
+            <div v-for="item in pendingActions" :key="item.id" class="uwx-undo-item">
+                <i :class="item.action === 'ban' ? 'ri-forbid-2-line' : 'ri-user-unfollow-line'" />
+                <span class="min-w-0 flex-1 truncate">
+                    <strong>{{ item.action === 'ban' ? 'Banning' : 'Removing' }} {{ item.label }}</strong> from {{ item.groupName }} in {{ secondsLeft(item) }}s
+                </span>
+                <Button size="sm" @click="tools.undo(item.id)">Undo</Button>
+            </div>
+        </div>
+
+        <div class="uwi-panel uwi-bar">
+            <div class="uwi-subtabs" role="tablist" style="border: 0">
+                <button type="button" :class="{ active: view === 'lookup' }" @click="view = 'lookup'"><i class="ri-user-search-line" /> User Intelligence</button>
+                <button type="button" :class="{ active: view === 'cases' }" @click="view = 'cases'"><i class="ri-folder-shield-2-line" /> Cases</button>
+            </div>
+            <div class="grow" />
+            <label class="uwi-field" style="min-width: 200px">
+                <span>Group</span>
+                <select class="uwi-select" :value="settings.groupId" @change="intel.setGroup(val($event))">
+                    <option v-for="g in groups" :key="g.id" :value="g.id">{{ g.name }}{{ g.registered ? ' · UnderWeb' : '' }}</option>
+                </select>
+            </label>
+        </div>
+
+        <UwxUserIntel v-if="view === 'lookup'" @new-case="newCase" />
+        <UwxCases v-else :prefill="prefill" />
+    </div>
+</template>
+
+<script setup>
+    import { onBeforeUnmount, onMounted, ref, watch } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { Button } from '@/components/ui/button';
+
+    import './uwxIntel.css';
+    import { useUwxGroupToolsStore } from '../../stores/uwxGroupTools';
+    import { useUwxIntelStore } from '../../stores/uwxIntel';
+    import { useUwxModerationStore } from '../../stores/uwxModeration';
+    import UwxCases from './UwxCases.vue';
+    import UwxUserIntel from './UwxUserIntel.vue';
+
+    /** @param {Event} e */
+    const val = (e) => /** @type {HTMLInputElement} */ (e.target).value;
+
+    const intel = useUwxIntelStore();
+    const tools = useUwxGroupToolsStore();
+    const moderation = useUwxModerationStore();
+    const { settings, groups } = storeToRefs(intel);
+    const { pendingActions } = storeToRefs(tools);
+
+    const view = ref(moderation.focusView);
+    const prefill = ref(null);
+    watch(
+        () => moderation.focusTick,
+        () => {
+            view.value = moderation.focusView;
+            prefill.value = null;
+        }
+    );
+    // Switching group: anything open belongs to the old group.
+    watch(
+        () => settings.value.groupId,
+        () => {
+            moderation.closeSubject();
+            moderation.openCase = null;
+        }
+    );
+
+    function newCase(p) {
+        prefill.value = { ...p };
+        view.value = 'cases';
+    }
+
+    const now = ref(Date.now());
+    let tick = null;
+    onMounted(() => {
+        void intel.start();
+        tick = setInterval(() => (now.value = Date.now()), 500);
+    });
+    onBeforeUnmount(() => {
+        intel.stop();
+        clearInterval(tick);
+    });
+    const secondsLeft = (item) => Math.max(0, Math.ceil((item.runsAt - now.value) / 1000));
+</script>
