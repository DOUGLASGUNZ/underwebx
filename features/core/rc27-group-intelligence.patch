@@ -0,0 +1,521 @@
+import { computed, ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import { groupRequest, userRequest } from '../api';
+import auditArchive from '../services/uwxAuditArchive';
+import { watchState } from '../services/watchState';
+import { buildTimeline, isUserId, knownRecordedCounts, parseUserQuery } from '../shared/utils/uwxIntel';
+import { useFriendStore } from './friend';
+import { useUwxAccountStore } from './uwxAccount';
+import { useUwxGroupAuditStore } from './uwxGroupAudit';
+import { useUwxGroupToolsStore } from './uwxGroupTools';
+import { useUwxIntelStore } from './uwxIntel';
+import { useUwxMemberNotesStore } from './uwxMemberNotes';
+
+// User Intelligence + Moderation Center.
+// Sources, always labelled in the UI:
+//   VRChat (your session)   — public profile, membership in the selected group, live ban state
+//   This PC                 — the group audit archive, private local notes
+//   UnderWeb (staff, RLS)   — shared audit archive, case files, staff notes, network shares
+// "Known Recorded" counts only ever cover groups we have data for. There is no VRChat-wide ban list.
+
+const errorStatus = (e) => e?.status || e?.statusCode || e?.response?.status || 0;
+const errorText = (e) => e?.error?.message || e?.message || 'Unknown error';
+
+export const useUwxModerationStore = defineStore('UwxModeration', () => {
+    const account = useUwxAccountStore();
+    const intel = useUwxIntelStore();
+    const audit = useUwxGroupAuditStore();
+    const tools = useUwxGroupToolsStore();
+    const localNotes = useUwxMemberNotesStore();
+
+    // Other panels ask to show someone here; UnderWeb.vue switches to the Moderation tab on this tick.
+    const focusTick = ref(0);
+    const focusView = ref('lookup');
+    function focusUser(userId) {
+        focusView.value = 'lookup';
+        focusTick.value += 1;
+        void openSubject(userId);
+    }
+    function focusCase(caseId) {
+        focusView.value = 'cases';
+        focusTick.value += 1;
+        void selectCase(caseId);
+    }
+
+    // ───────── user lookup ─────────
+    const query = ref('');
+    const searching = ref(false);
+    const searchNote = ref('');
+    const results = ref([]);
+
+    const subjectId = ref('');
+    const subject = ref(null); // VRChat profile
+    const subjectError = ref('');
+    const membership = ref(null); // { status: 'member'|'not-member'|'unknown', joinedAt, roles, reason }
+    const localEntries = ref([]);
+    const overview = ref(null); // uwx_subject_overview()
+    const overviewError = ref('');
+    const network = ref([]);
+    const networkNote = ref('');
+    const loadingSubject = ref(false);
+
+    const groupId = computed(() => intel.settings.groupId);
+    const remote = computed(() => intel.remote);
+    const canUseServer = computed(() => Boolean(remote.value && intel.level >= 2));
+
+    async function search(input = query.value) {
+        const parsed = parseUserQuery(input);
+        results.value = [];
+        searchNote.value = '';
+        if (parsed.kind === 'empty') return;
+        if (parsed.kind === 'id') {
+            await openSubject(parsed.id);
+            return;
+        }
+        searching.value = true;
+        try {
+            const q = parsed.query.toLowerCase();
+            const friendStore = useFriendStore();
+            const friends = [];
+            for (const [id, ctx] of friendStore.friends) {
+                const name = String(ctx?.ref?.displayName || ctx?.name || '');
+                if (name.toLowerCase().includes(q)) friends.push({ id, displayName: name, image: ctx?.ref?.currentAvatarThumbnailImageUrl || '', source: 'Friend' });
+                if (friends.length >= 10) break;
+            }
+            const seen = new Set(friends.map((f) => f.id));
+            const fromAudit = [];
+            for (const e of intel.entries) {
+                for (const [id, name] of [
+                    [e.actorId, e.actorName],
+                    [e.targetId, e.data?.targetDisplayName || '']
+                ]) {
+                    if (!isUserId(id) || seen.has(id) || !name || !String(name).toLowerCase().includes(q)) continue;
+                    seen.add(id);
+                    fromAudit.push({ id, displayName: name, image: '', source: 'Group activity' });
+                }
+                if (fromAudit.length >= 10) break;
+            }
+            let vrchat = [];
+            if (watchState.isLoggedIn) {
+                try {
+                    const args = await userRequest.getUsers({ search: parsed.query, n: 15, offset: 0 });
+                    vrchat = (Array.isArray(args?.json) ? args.json : [])
+                        .filter((u) => isUserId(u?.id) && !seen.has(u.id))
+                        .map((u) => ({ id: u.id, displayName: u.displayName, image: u.currentAvatarThumbnailImageUrl || u.userIcon || '', source: 'VRChat search' }));
+                } catch (e) {
+                    searchNote.value = errorStatus(e) === 429 ? 'VRChat search is rate limited — try again in a minute.' : `VRChat search failed: ${errorText(e)}`;
+                }
+            } else {
+                searchNote.value = 'Log in to VRChat to search all users. Showing friends and group activity only.';
+            }
+            results.value = [...friends, ...fromAudit, ...vrchat];
+            if (!results.value.length && !searchNote.value) searchNote.value = 'Nobody found. Try their usr_ id or profile link.';
+        } finally {
+            searching.value = false;
+        }
+    }
+
+    async function openSubject(userId) {
+        if (!isUserId(userId)) {
+            subjectError.value = 'That isn’t a VRChat user id.';
+            return;
+        }
+        subjectId.value = userId;
+        subject.value = null;
+        subjectError.value = '';
+        membership.value = null;
+        overview.value = null;
+        overviewError.value = '';
+        network.value = [];
+        networkNote.value = '';
+        results.value = [];
+        loadingSubject.value = true;
+        await localNotes.load();
+        await Promise.all([loadProfile(userId), loadMembership(userId), loadLocalHistory(userId), loadServer(userId)]);
+        loadingSubject.value = false;
+    }
+
+    async function loadProfile(userId) {
+        if (!watchState.isLoggedIn) {
+            subjectError.value = 'Log in to VRChat to load their profile.';
+            return;
+        }
+        try {
+            const args = await userRequest.getUser({ userId });
+            if (subjectId.value === userId) subject.value = args?.json || args?.ref || null;
+        } catch (e) {
+            if (subjectId.value === userId) subjectError.value = errorStatus(e) === 404 ? 'VRChat has no user with that id.' : `Profile unavailable: ${errorText(e)}`;
+        }
+    }
+
+    async function loadMembership(userId) {
+        const gid = groupId.value;
+        if (!gid) return;
+        if (!watchState.isLoggedIn) {
+            membership.value = { status: 'unknown', reason: 'Log in to VRChat to check membership.' };
+            return;
+        }
+        try {
+            const args = await groupRequest.getGroupMember({ groupId: gid, userId });
+            const json = args?.json;
+            if (subjectId.value !== userId) return;
+            if (!json || json.membershipStatus === 'inactive') {
+                membership.value = { status: 'not-member' };
+                return;
+            }
+            const roles = (intel.groupRef?.roles || []).filter((r) => (json.roleIds || []).includes(r.id)).map((r) => r.name);
+            membership.value = {
+                status: json.membershipStatus === 'member' || !json.membershipStatus ? 'member' : json.membershipStatus,
+                joinedAt: Date.parse(json.joinedAt || '') || 0,
+                roles,
+                isRepresenting: Boolean(json.isRepresenting)
+            };
+        } catch (e) {
+            if (subjectId.value !== userId) return;
+            const status = errorStatus(e);
+            membership.value =
+                status === 404
+                    ? { status: 'not-member' }
+                    : { status: 'unknown', reason: status === 403 ? 'Your VRChat role can’t view members of this group.' : `VRChat: ${errorText(e)}` };
+        }
+    }
+
+    async function loadLocalHistory(userId) {
+        const gid = groupId.value;
+        try {
+            const list = audit.groupId === gid && audit.entries.length ? audit.entries : await auditArchive.loadGroup(gid, 20000);
+            if (subjectId.value === userId) localEntries.value = list.filter((e) => e.targetId === userId || e.actorId === userId);
+        } catch {
+            localEntries.value = [];
+        }
+    }
+
+    async function loadServer(userId) {
+        if (!remote.value) return;
+        if (intel.level < 2) {
+            overviewError.value = 'Your UnderWeb role doesn’t include user intelligence for this group.';
+            return;
+        }
+        try {
+            const data = await account.rpc('uwx_subject_overview', { p_group: remote.value.id, p_vrc_id: userId });
+            if (subjectId.value === userId) overview.value = data;
+        } catch (e) {
+            overviewError.value = errorText(e);
+        }
+        if (!remote.value.network_opt_in) {
+            networkNote.value = 'This group hasn’t joined the UWX Moderation Network, so no other groups share with it.';
+            return;
+        }
+        try {
+            const rows = await account.rpc('uwx_network_lookup', { p_group: remote.value.id, p_vrc_id: userId });
+            if (subjectId.value === userId) network.value = Array.isArray(rows) ? rows : [];
+        } catch (e) {
+            networkNote.value = errorText(e);
+        }
+    }
+
+    /** "Known recorded" counts: local archive merged with the UnderWeb archive (deduped by VRChat event id). */
+    const known = computed(() => {
+        const uid = subjectId.value;
+        if (!uid) return null;
+        const seen = new Set(localEntries.value.map((e) => e.id));
+        const serverRows = (overview.value?.events || [])
+            .filter((row) => !seen.has(row.vrchat_event_id))
+            .map((row) => ({
+                id: row.vrchat_event_id,
+                ts: Date.parse(row.occurred_at) || 0,
+                eventType: row.event_type,
+                actorId: row.actor_vrc_id || '',
+                targetId: row.target_vrc_id || ''
+            }));
+        const counts = knownRecordedCounts([...localEntries.value, ...serverRows], uid);
+        const cases = overview.value?.cases || [];
+        const actions = cases.flatMap((c) => c.actions || []);
+        counts.caseWarnings = actions.filter((a) => a.type === 'warning').length;
+        counts.caseBans = actions.filter((a) => a.type === 'ban').length;
+        counts.caseKicks = actions.filter((a) => a.type === 'kick' || a.type === 'instance_kick').length;
+        counts.incidents = cases.length;
+        counts.openIncidents = cases.filter((c) => ['open', 'under_review', 'escalated', 'appealed'].includes(c.status)).length;
+        counts.networkReports = network.value.length;
+        counts.networkGroups = [...new Set(network.value.map((n) => n.source_group))];
+        return counts;
+    });
+
+    /** Do we have ANY moderation history source for this group? If not, the UI says "History unavailable". */
+    const historyAvailable = computed(() => Boolean(intel.perms.audit || localEntries.value.length || overview.value));
+
+    const timeline = computed(() =>
+        buildTimeline(
+            {
+                local: localEntries.value,
+                server: overview.value?.events || [],
+                cases: overview.value?.cases || [],
+                notes: overview.value?.notes || []
+            },
+            subjectId.value
+        )
+    );
+
+    async function addNote(text) {
+        const body = String(text || '').trim();
+        if (!body || !remote.value) return false;
+        try {
+            await account.api('uwx_subject_notes', {
+                method: 'POST',
+                headers: { Prefer: 'return=minimal' },
+                body: JSON.stringify({ group_id: remote.value.id, subject_vrc_id: subjectId.value, body: body.slice(0, 2000) })
+            });
+            await loadServer(subjectId.value);
+            return true;
+        } catch (e) {
+            toast.error(errorText(e));
+            return false;
+        }
+    }
+
+    async function hideNote(id) {
+        try {
+            await account.api(`uwx_subject_notes?id=eq.${Number(id)}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ hidden_at: new Date().toISOString() }) });
+            await loadServer(subjectId.value);
+        } catch (e) {
+            toast.error(errorText(e));
+        }
+    }
+
+    function closeSubject() {
+        subjectId.value = '';
+        subject.value = null;
+        overview.value = null;
+        localEntries.value = [];
+    }
+
+    // ───────── cases ─────────
+    const cases = ref([]);
+    const casesLoading = ref(false);
+    const casesError = ref('');
+    const openCase = ref(null);
+    const caseEntries = ref([]);
+    const caseLoading = ref(false);
+    const staff = ref([]);
+    const names = ref({}); // user uuid -> display name
+    let casesSeenAt = 0;
+
+    async function resolveNames(ids) {
+        const missing = [...new Set(ids.filter((id) => id && !names.value[id]))];
+        if (!missing.length) return;
+        try {
+            const rows = (await account.api(`profiles?select=id,display_name,username&id=in.(${missing.join(',')})`)) || [];
+            const next = { ...names.value };
+            for (const r of rows) next[r.id] = r.display_name || r.username || 'Staff';
+            names.value = next;
+        } catch {
+            // names are cosmetic
+        }
+    }
+
+    async function loadCases({ notify = false } = {}) {
+        if (!canUseServer.value) {
+            cases.value = [];
+            casesError.value = remote.value ? 'Your UnderWeb role doesn’t include the Moderation Center for this group.' : '';
+            return;
+        }
+        casesLoading.value = true;
+        casesError.value = '';
+        try {
+            const rows =
+                (await account.api(
+                    `uwx_cases?select=id,case_number,subject_vrc_id,subject_name,title,category,severity,status,assigned_to,share_with_network,incident_at,created_by,created_at,updated_at,closed_at&group_id=eq.${remote.value.id}&order=updated_at.desc&limit=1000`
+                )) || [];
+            if (notify && casesSeenAt) {
+                for (const c of rows) {
+                    const updated = Date.parse(c.updated_at) || 0;
+                    if (updated > casesSeenAt && c.assigned_to === account.userId) {
+                        toast.info(`Case #${c.case_number} was updated: ${c.title}`);
+                    }
+                }
+            }
+            casesSeenAt = Date.now();
+            cases.value = rows;
+            await resolveNames(rows.flatMap((c) => [c.assigned_to, c.created_by]));
+        } catch (e) {
+            casesError.value = /uwx_cases|does not exist/i.test(errorText(e)) ? 'The Moderation Center database isn’t set up yet.' : errorText(e);
+        } finally {
+            casesLoading.value = false;
+        }
+    }
+
+    async function loadStaff() {
+        if (!canUseServer.value) return;
+        try {
+            staff.value = (await account.rpc('uwx_group_staff', { p_group: remote.value.id })) || [];
+            const next = { ...names.value };
+            for (const s of staff.value) next[s.user_id] = s.display_name || s.username || 'Staff';
+            names.value = next;
+        } catch {
+            staff.value = [];
+        }
+    }
+
+    async function createCase(input) {
+        const body = {
+            group_id: remote.value.id,
+            title: String(input.title || '').trim().slice(0, 140),
+            summary: String(input.summary || '').trim().slice(0, 4000),
+            category: input.category || 'other',
+            severity: input.severity || 'medium',
+            subject_vrc_id: isUserId(input.subjectId) ? input.subjectId : null,
+            subject_name: input.subjectName ? String(input.subjectName).slice(0, 80) : null,
+            incident_at: input.incidentAt ? new Date(input.incidentAt).toISOString() : null,
+            assigned_to: input.assignToMe ? account.userId : null
+        };
+        const rows = await account.api('uwx_cases?select=id', { method: 'POST', headers: { Prefer: 'return=representation' }, body: JSON.stringify(body) });
+        const created = Array.isArray(rows) ? rows[0] : rows;
+        await loadCases();
+        if (created?.id) await selectCase(created.id);
+        return created;
+    }
+
+    async function selectCase(id) {
+        caseLoading.value = true;
+        try {
+            const [rows, entries] = await Promise.all([
+                account.api(`uwx_cases?select=*&id=eq.${id}`),
+                account.api(`uwx_case_entries?select=*&case_id=eq.${id}&order=created_at.asc,id.asc&limit=2000`)
+            ]);
+            openCase.value = Array.isArray(rows) ? rows[0] || null : null;
+            caseEntries.value = entries || [];
+            await resolveNames([openCase.value?.assigned_to, openCase.value?.created_by, ...caseEntries.value.map((e) => e.created_by)]);
+        } catch (e) {
+            toast.error(errorText(e));
+        } finally {
+            caseLoading.value = false;
+        }
+    }
+
+    async function updateCase(patch) {
+        if (!openCase.value) return false;
+        try {
+            await account.api(`uwx_cases?id=eq.${openCase.value.id}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify(patch) });
+            await selectCase(openCase.value.id);
+            await loadCases();
+            return true;
+        } catch (e) {
+            toast.error(/assign/i.test(errorText(e)) ? 'Only managers can assign cases to someone else.' : errorText(e));
+            return false;
+        }
+    }
+
+    async function addEntry(entry) {
+        if (!openCase.value) return false;
+        try {
+            await account.api('uwx_case_entries', {
+                method: 'POST',
+                headers: { Prefer: 'return=minimal' },
+                body: JSON.stringify({ case_id: openCase.value.id, created_by: account.userId, ...entry })
+            });
+            await selectCase(openCase.value.id);
+            void loadCases();
+            return true;
+        } catch (e) {
+            toast.error(errorText(e));
+            return false;
+        }
+    }
+
+    async function attachEvidence(file, caption = '') {
+        if (!openCase.value || !file) return false;
+        if (file.size > 15 * 1024 * 1024) {
+            toast.error('Evidence files can be up to 15 MB.');
+            return false;
+        }
+        const safe = String(file.name || 'evidence').replace(/[^a-z0-9._-]+/gi, '_').slice(-80);
+        const path = `cases/${openCase.value.group_id}/${openCase.value.id}/${Date.now()}-${safe}`;
+        try {
+            await account.storageUpload('uwx-evidence', path, file, file.type || 'application/octet-stream');
+        } catch (e) {
+            toast.error(errorStatus(e) === 415 || /mime/i.test(errorText(e)) ? 'That file type isn’t allowed (images, mp4/webm, pdf, txt).' : errorText(e));
+            return false;
+        }
+        return addEntry({ kind: 'evidence', evidence_path: path, evidence_name: safe, body: String(caption || '').slice(0, 4000) });
+    }
+
+    async function evidenceUrl(path) {
+        try {
+            return await account.storageSign('uwx-evidence', path, 300);
+        } catch (e) {
+            toast.error(errorText(e));
+            return '';
+        }
+    }
+
+    /**
+     * Run a real VRChat action (remove / ban / unban) through Group Tools — same permission checks,
+     * 10-second undo — then record it in the case. The caller confirms first.
+     */
+    async function vrchatAction(action) {
+        const c = openCase.value;
+        if (!c?.subject_vrc_id) return false;
+        const gid = groupId.value;
+        const ok = await tools.moderate(action, { groupId: gid, groupName: intel.group?.name || 'group', userId: c.subject_vrc_id, displayName: c.subject_name || c.subject_vrc_id });
+        if (ok) {
+            await addEntry({ kind: 'action', action_type: action === 'kick' ? 'kick' : action, done_in_vrchat: true, body: `Done from UWX (${action}).` });
+            audit.nudge(gid);
+        }
+        return ok;
+    }
+
+    const caseTimeline = computed(() =>
+        caseEntries.value.map((e) => ({ ...e, author: names.value[e.created_by] || (e.created_by ? 'Staff' : 'System'), ts: Date.parse(e.created_at) || 0 }))
+    );
+
+    return {
+        focusTick,
+        focusView,
+        focusUser,
+        focusCase,
+        query,
+        searching,
+        searchNote,
+        results,
+        subjectId,
+        subject,
+        subjectError,
+        membership,
+        localEntries,
+        overview,
+        overviewError,
+        network,
+        networkNote,
+        loadingSubject,
+        known,
+        historyAvailable,
+        timeline,
+        canUseServer,
+        search,
+        openSubject,
+        closeSubject,
+        addNote,
+        hideNote,
+        localNotes,
+        cases,
+        casesLoading,
+        casesError,
+        openCase,
+        caseEntries,
+        caseTimeline,
+        caseLoading,
+        staff,
+        names,
+        loadCases,
+        loadStaff,
+        createCase,
+        selectCase,
+        updateCase,
+        addEntry,
+        attachEvidence,
+        evidenceUrl,
+        vrchatAction
+    };
+});
