@@ -0,0 +1,229 @@
+<template>
+    <div class="uwi">
+        <div class="uwi-grid2">
+            <div class="uwi-panel">
+                <div class="uwi-label">ROAD TO {{ goal }} — VRCHAT GROUP MEMBERS</div>
+                <template v-if="progress">
+                    <div class="uwi-bar">
+                        <strong style="font-size: 30px">{{ progress.current }}</strong>
+                        <span class="uwi-note">of {{ progress.goal }} · {{ progress.reached ? 'goal reached' : `${progress.remaining} to go` }}</span>
+                    </div>
+                    <div class="uwi-progress" style="margin: 10px 0"><span :style="{ width: `${progress.pct}%` }" /></div>
+                    <p class="uwi-src"><b class="current">Current</b> VRChat member count</p>
+                    <p class="uwi-note" style="margin-top: 6px">
+                        <template v-if="progress.perDay !== null">
+                            Average {{ progress.perDay >= 0 ? '+' : '' }}{{ progress.perDay.toFixed(1) }}/day (last {{ Math.round(progress.basedOnDays) }} days of snapshots)<template v-if="progress.etaDays">
+                                · at this pace, about {{ progress.etaDays }} days ({{ etaDate }})</template
+                            >
+                            <span class="uwi-src"><b class="estimate">Estimate</b></span>
+                        </template>
+                        <template v-else>Daily growth shows once UWX has about a day of snapshots.</template>
+                    </p>
+                </template>
+                <p v-else class="uwi-note">Member count not loaded yet.</p>
+            </div>
+            <div class="uwi-panel">
+                <div class="uwi-label">MILESTONES</div>
+                <table class="uwi-table">
+                    <thead><tr><th>Milestone</th><th>First recorded at or above</th></tr></thead>
+                    <tbody>
+                        <tr v-for="m in milestones" :key="m.value">
+                            <td>{{ m.value }} members</td>
+                            <td>
+                                <template v-if="m.reachedAt">{{ shortDate(m.reachedAt) }}</template>
+                                <span v-else-if="progress && progress.current >= m.value" class="uwi-note">Before tracking started</span>
+                                <span v-else class="uwi-note">Not yet</span>
+                            </td>
+                        </tr>
+                    </tbody>
+                </table>
+            </div>
+        </div>
+
+        <div v-if="!account.signedIn" class="uwi-empty">
+            <i class="ri-user-star-line" />
+            Sign in to UnderWeb (System tab) to see the recruiting leaderboard and submit recruits.
+        </div>
+        <div v-else-if="!remote" class="uwi-empty">
+            <i class="ri-links-line" />
+            The leaderboard needs this group registered with UnderWeb (Overview → UnderWeb shared history).
+        </div>
+        <template v-else>
+            <p v-if="recruitError" class="uwi-error">{{ recruitError }}</p>
+            <div class="uwi-grid2">
+                <div class="uwi-panel">
+                    <div class="uwi-bar" style="margin-bottom: 6px">
+                        <div class="uwi-label" style="margin: 0">LEADERBOARD</div>
+                        <div class="grow" />
+                        <Button size="sm" variant="ghost" :disabled="recruitLoading" @click="store.loadRecruiting()"><i class="ri-refresh-line" /></Button>
+                    </div>
+                    <p class="uwi-src" style="margin-bottom: 6px"><b>Verified</b> recruits confirmed by a manager · never assigned automatically</p>
+                    <table v-if="leaderboard.length" class="uwi-table">
+                        <thead><tr><th>#</th><th>Member</th><th>Verified</th><th>Pending</th></tr></thead>
+                        <tbody>
+                            <tr v-for="(row, i) in leaderboard" :key="row.user_id">
+                                <td>{{ i + 1 }}</td>
+                                <td class="truncate">{{ row.display_name || row.username || 'Member' }}</td>
+                                <td><strong>{{ row.verified }}</strong></td>
+                                <td class="uwi-note">{{ row.pending }}</td>
+                            </tr>
+                        </tbody>
+                    </table>
+                    <p v-else class="uwi-note">No recruits recorded yet. Be the first — submit someone you brought in.</p>
+                </div>
+
+                <form class="uwi-panel" style="display: flex; flex-direction: column; gap: 8px" @submit.prevent="submit">
+                    <div class="uwi-label" style="margin: 0">I BROUGHT SOMEONE IN</div>
+                    <p class="uwi-note">They don't need an UnderWeb account — just their VRChat profile link or usr_ id. A manager checks it against the group's join log.</p>
+                    <label class="uwi-field"><span>Their VRChat profile link or usr_ id</span><input v-model.trim="form.who" class="uwi-input" required /></label>
+                    <label class="uwi-field"><span>Their display name (optional)</span><input v-model.trim="form.name" class="uwi-input" maxlength="80" /></label>
+                    <label class="uwi-field"><span>How you recruited them (optional)</span><input v-model.trim="form.note" class="uwi-input" maxlength="500" /></label>
+                    <label class="uwi-field"><span>Screenshot (optional)</span><input type="file" accept="image/*" @change="form.file = fileOf($event)" /></label>
+                    <p v-if="formError" class="uwi-error">{{ formError }}</p>
+                    <Button type="submit" size="sm" :disabled="saving">{{ saving ? 'Sending…' : 'Submit recruit' }}</Button>
+                </form>
+            </div>
+
+            <div v-if="myClaims.length" class="uwi-panel">
+                <div class="uwi-label">MY SUBMISSIONS</div>
+                <table class="uwi-table">
+                    <thead><tr><th>Recruit</th><th>Sent</th><th>Status</th><th></th></tr></thead>
+                    <tbody>
+                        <tr v-for="c in myClaims" :key="c.id">
+                            <td class="truncate">{{ c.recruit_name || c.recruit_vrc_id }}</td>
+                            <td>{{ shortDate(Date.parse(c.created_at)) }}</td>
+                            <td>
+                                <span class="uwi-pill" :class="c.status === 'verified' ? 'resolved' : c.status === 'rejected' ? 'high' : 'medium'">{{ c.status }}</span>
+                                <span v-if="c.review_note" class="uwi-note"> {{ c.review_note }}</span>
+                            </td>
+                            <td><Button v-if="c.status === 'pending'" size="sm" variant="ghost" @click="store.withdrawClaim(c.id)">Withdraw</Button></td>
+                        </tr>
+                    </tbody>
+                </table>
+            </div>
+
+            <div v-if="level >= 3" class="uwi-panel">
+                <div class="uwi-label">CLAIMS TO VERIFY ({{ claims.length }})</div>
+                <p class="uwi-note" style="margin-bottom: 8px">
+                    Evidence comes from the group's audit log (VRChat) — a join by that person, and any group invite sent to them. It supports your decision; it doesn't make it. You can't verify your own claims.
+                </p>
+                <div v-if="!claims.length" class="uwi-empty">Nothing waiting.</div>
+                <div v-for="c in claims" :key="c.id" class="uwi-tl" style="grid-template-columns: 1fr auto">
+                    <div>
+                        <strong>{{ c.recruit_name || c.recruit_vrc_id }}</strong>
+                        <span class="uwi-note"> claimed by {{ c.recruiter?.display_name || c.recruiter?.username || 'member' }} · {{ shortDate(Date.parse(c.created_at)) }}</span>
+                        <div class="meta">
+                            <template v-if="c.evidence.joinedAt">
+                                <i class="ri-checkbox-circle-line" style="color: #3fbf7f" /> Joined the group {{ shortDate(c.evidence.joinedAt) }} (audit log)
+                            </template>
+                            <template v-else><i class="ri-question-line" style="color: #fab219" /> No join found in the saved audit log</template>
+                            <template v-if="c.evidence.invitedBy.length"> · group invite from {{ c.evidence.invitedBy.map((i) => i.actorName).join(', ') }}</template>
+                            <template v-if="isMember(c.recruit_vrc_id)"> · currently in the group</template>
+                        </div>
+                        <div v-if="c.note" class="meta">“{{ c.note }}”</div>
+                        <a v-if="c.evidence_path" href="#" class="meta" @click.prevent="openEvidence(c.evidence_path)">View screenshot</a>
+                    </div>
+                    <div class="uwi-bar">
+                        <Button size="sm" variant="outline" @click="lookUp(c.recruit_vrc_id)">Look up</Button>
+                        <Button size="sm" :disabled="busyId === c.id" @click="review(c, true)">Verify</Button>
+                        <Button size="sm" variant="ghost" :disabled="busyId === c.id" @click="review(c, false)">Reject</Button>
+                    </div>
+                </div>
+            </div>
+        </template>
+    </div>
+</template>
+
+<script setup>
+    import { computed, onMounted, reactive, ref } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { toast } from 'vue-sonner';
+    import { Button } from '@/components/ui/button';
+
+    import { openExternalLink } from '../../shared/utils';
+    import { parseUserQuery } from '../../shared/utils/uwxIntel';
+    import { useModalStore } from '../../stores/modal';
+    import { useUwxAccountStore } from '../../stores/uwxAccount';
+    import { useUwxIntelStore } from '../../stores/uwxIntel';
+    import { useUwxModerationStore } from '../../stores/uwxModeration';
+
+    /** @param {Event} e */
+    const fileOf = (e) => /** @type {HTMLInputElement} */ (e.target).files?.[0] || null;
+
+    const store = useUwxIntelStore();
+    const account = useUwxAccountStore();
+    const modal = useModalStore();
+    const { goal, progress, snapshots, remote, level, leaderboard, claims, myClaims, recruitError, recruitLoading, entries } = storeToRefs(store);
+
+    onMounted(() => void store.loadRecruiting());
+
+    const etaDate = computed(() => (progress.value?.etaDays ? shortDate(Date.now() + progress.value.etaDays * 86400000) : ''));
+    const milestones = computed(() => {
+        const g = goal.value;
+        const steps = [];
+        const step = g <= 500 ? 100 : Math.ceil(g / 5 / 100) * 100;
+        for (let v = step; v < g; v += step) steps.push(v);
+        steps.push(g);
+        return steps.map((value) => ({ value, reachedAt: snapshots.value.find((s) => Number.isFinite(s.memberCount) && s.memberCount >= value)?.ts || 0 }));
+    });
+
+    // "Currently in the group" from the newest join/leave in the activity log for that person.
+    function isMember(userId) {
+        const last = entries.value.find((e) => (e.actorId === userId || e.targetId === userId) && /group\.member\.(join|leave|remove)|group\.user\.ban/.test(e.eventType));
+        return last?.eventType === 'group.member.join';
+    }
+
+    const form = reactive({ who: '', name: '', note: '', file: null });
+    const formError = ref('');
+    const saving = ref(false);
+    async function submit() {
+        formError.value = '';
+        const parsed = parseUserQuery(form.who);
+        if (parsed.kind !== 'id') {
+            formError.value = 'Paste their VRChat profile link or usr_ id (open their profile in VRChat or UWX and copy the link).';
+            return;
+        }
+        saving.value = true;
+        try {
+            await store.submitClaim({ recruitId: parsed.id, recruitName: form.name, note: form.note, file: form.file });
+            toast.success('Sent! A manager will verify it.');
+            Object.assign(form, { who: '', name: '', note: '', file: null });
+        } catch (e) {
+            formError.value = /duplicate|unique/i.test(e.message) ? 'You already submitted this person.' : e.message;
+        } finally {
+            saving.value = false;
+        }
+    }
+
+    const busyId = ref('');
+    async function review(c, verify) {
+        const name = c.recruit_name || c.recruit_vrc_id;
+        const { ok } = await modal.confirm({
+            title: verify ? 'Verify recruit' : 'Reject claim',
+            description: verify
+                ? `Credit ${c.recruiter?.display_name || 'this member'} for recruiting ${name}?${c.evidence.joinedAt ? '' : ' No join was found in the saved audit log.'}`
+                : `Reject the claim for ${name}?`
+        });
+        if (!ok) return;
+        busyId.value = c.id;
+        try {
+            await store.reviewClaim(c.id, verify);
+            toast.success(verify ? 'Verified.' : 'Rejected.');
+        } catch (e) {
+            toast.error(e.message);
+        } finally {
+            busyId.value = '';
+        }
+    }
+
+    async function openEvidence(path) {
+        const url = await store.evidenceUrl(path);
+        if (url) openExternalLink(url);
+    }
+    function lookUp(userId) {
+        useUwxModerationStore().focusUser(userId);
+    }
+    function shortDate(ts) {
+        return ts ? new Date(ts).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
+    }
+</script>
diff --git a/src/views/UnderWeb/UwxIntelSync.vue b/src/views/UnderWeb/UwxIntelSync.vue
new file mode 100644
index 0000000..e04533a
