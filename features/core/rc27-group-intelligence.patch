+
+    const setGroup = (gid) => store.setGroup(gid);
+
+    // ── small presentational components ──
+    const Stat = defineComponent({
+        props: { label: String, value: { type: Number, default: null }, source: String, kind: String, na: String, sub: String, capped: Boolean },
