+                        <p class="uwi-src"><b class="current">Current</b> VRChat</p>
+                    </template>
+                    <p v-else class="uwi-note">Pick a group in Group Intelligence first.</p>
+                </div>
+                <div class="uwi-panel">
+                    <div class="uwi-label">UNDERWEB</div>
+                    <template v-if="overview">
+                        <p v-if="overview.account">
+                            <strong>{{ overview.account.display_name || overview.account.username }}</strong>
+                            <span class="uwi-note"> · VRChat link {{ overview.account.verified || 'unverified' }}</span>
+                            <br />
+                            <span v-for="r in overview.account.roles" :key="r.slug" class="uwi-pill" style="margin: 4px 4px 0 0">{{ r.name }}</span>
+                        </p>
+                        <p v-else class="uwi-note">No UnderWeb account linked to this VRChat id.</p>
+                        <p v-if="overview.safety" class="uwi-warn-box" style="margin-top: 6px">
+                            Safety Intel label: <strong>{{ overview.safety.risk_level }}</strong> · {{ overview.safety.verified_report_count }} verified report(s)
+                            <template v-if="overview.safety.public_summary"> — {{ overview.safety.public_summary }}</template>
+                        </p>
+                        <p class="uwi-src" style="margin-top: 4px"><b>UnderWeb</b> staff-only records</p>
+                    </template>
+                    <p v-else-if="overviewError" class="uwi-note">{{ overviewError }}</p>
+                    <p v-else-if="!account.signedIn" class="uwi-note">Sign in to UnderWeb to see their UnderWeb account, case files and staff notes.</p>
+                    <p v-else-if="!remote" class="uwi-note">This group isn't registered with UnderWeb, so there are no shared records for it.</p>
+                    <p v-else class="uwi-note">Loading…</p>
+                </div>
+            </div>
