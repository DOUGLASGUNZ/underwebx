+                areaStyle: { color: 'rgba(61,245,20,0.08)' }
+            }
+        ]
+    }));
+
+    function hasAny(series, keys) {
+        return keys.some((k) => (series[k] || []).some((v) => v > 0));
+    }
+    function signed(n) {
