+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { reactive } from 'vue';
+
+const GROUP = 'grp_11111111-1111-1111-1111-111111111111';
+const groupRequest = { getGroupBans: vi.fn(), getGroupInvites: vi.fn(), getGroupJoinRequests: vi.fn(), getGroupInstances: vi.fn() };
+vi.mock('../../api', () => ({ groupRequest }));
+const config = { store: {}, getString: vi.fn(async (k, d) => config.store[k] ?? d), setString: vi.fn(async (k, v) => (config.store[k] = v)) };
+vi.mock('../../services/config', () => ({ default: config }));
+const archive = { saved: [], saveSnapshot: vi.fn(async (g, s) => archive.saved.push(s)), loadSnapshots: vi.fn(async () => []), clearGroup: vi.fn() };
+vi.mock('../../services/uwxIntelArchive', () => ({ default: archive }));
+vi.mock('../../services/watchState', () => ({ watchState: { isLoggedIn: true } }));
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn(), warning: vi.fn(), info: vi.fn(), message: vi.fn() } }));
+const perms = new Set();
+vi.mock('../../shared/utils', () => ({ hasGroupPermission: (ref, p) => perms.has(p) }));
+
+const tools = reactive({
+    groupInfo: new Map(),
+    myGroups: [{ id: GROUP, name: 'The UnderWeb', ref: {} }],
+    moderatableGroups: [],
+    loadGroupPermissions: vi.fn(async () => ({ id: GROUP, memberCount: 412, onlineMemberCount: 37 }))
+});
+vi.mock('../uwxGroupTools', () => ({ useUwxGroupToolsStore: () => tools }));
+const audit = reactive({ groupId: GROUP, entries: [], open: vi.fn(), nudge: vi.fn() });
+vi.mock('../uwxGroupAudit', () => ({ useUwxGroupAuditStore: () => audit }));
+vi.mock('../underweb', () => ({ useUnderWebStore: () => ({ recruitHomeGroupId: GROUP }) }));
+const account = reactive({ signedIn: false, userId: 'me', topRole: null, rpc: vi.fn(), api: vi.fn(), storageUpload: vi.fn(), storageSign: vi.fn() });
+vi.mock('../uwxAccount', () => ({ useUwxAccountStore: () => account }));
+
+const { useUwxIntelStore, toServerEvent, fromServerEvent } = await import('../uwxIntel');
+
+const page = (count) => ({ json: Array.from({ length: count }, (_, i) => ({ id: i })) });
+
+describe('uwxIntel store', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        vi.clearAllMocks();
+        vi.useFakeTimers();
+        perms.clear();
+        config.store = {};
+        archive.saved = [];
+        account.signedIn = false;
+        audit.entries = [];
+        groupRequest.getGroupInstances.mockResolvedValue({ json: { instances: [] } });
+    });
+
+    async function run(promise) {
+        for (let i = 0; i < 60; i++) await vi.advanceTimersByTimeAsync(1000);
+        return promise;
+    }
+
+    test('reads counts VRChat allows, marks the rest unavailable with a reason, saves a local snapshot', async () => {
+        perms.add('group-bans-manage');
+        groupRequest.getGroupBans.mockImplementation(async ({ offset }) => (offset === 0 ? page(100) : page(23)));
+        const store = useUwxIntelStore();
+        await store.load();
+        expect(store.settings.groupId).toBe(GROUP);
+        await run(store.refresh({ manual: true }));
+        expect(store.live.memberCount).toBe(412);
+        expect(store.live.onlineCount).toBe(37);
+        expect(store.live.banCount).toBe(123);
+        expect(store.live.inviteCount).toBeNull();
+        expect(store.live.unavailable.inviteCount).toMatch(/permission/);
+        expect(groupRequest.getGroupInvites).not.toHaveBeenCalled();
+        expect(archive.saved[0]).toMatchObject({ memberCount: 412, banCount: 123 });
+        expect(store.status).toBe('ok');
+    });
+
+    test('ban counting stops at 1,000 and says so', async () => {
+        perms.add('group-bans-manage');
+        groupRequest.getGroupBans.mockResolvedValue(page(100));
+        const store = useUwxIntelStore();
+        await store.load();
+        await run(store.refresh({ manual: true }));
+        expect(store.live.banCount).toBe(1000);
+        expect(store.live.capped.banCount).toBe(true);
+        expect(groupRequest.getGroupBans).toHaveBeenCalledTimes(10);
+    });
+
+    test('rate limit backs off instead of hammering VRChat', async () => {
+        tools.loadGroupPermissions.mockRejectedValueOnce(Object.assign(new Error('slow down'), { status: 429 }));
+        const store = useUwxIntelStore();
+        await store.load();
+        await run(store.refresh());
+        expect(store.status).toBe('rate-limited');
+        expect(store.failures).toBe(1);
+        expect(store.nextRunAt - Date.now()).toBeGreaterThan(5 * 60 * 1000); // doubled 10 min, minus the 60s the test clock ran
+    });
