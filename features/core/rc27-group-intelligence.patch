+            if (next.onlineCount === null) next.unavailable.onlineCount = 'VRChat didn’t include an online count for this group.';
+            const doHeavy = manual || Date.now() - heavyAt >= HEAVY_EVERY_MS;
+            if (doHeavy) {
+                await readHeavyCounts(gid, next);
+                heavyAt = Date.now();
+            } else {
+                for (const k of ['banCount', 'inviteCount', 'requestCount']) next[k] = live.value[k];
+                next.capped = { ...live.value.capped };
+                next.unavailable = { ...live.value.unavailable, ...next.unavailable };
+                next.heavyAt = live.value.heavyAt;
+            }
+            next.fetchedAt = Date.now();
+            if (gid !== settings.groupId) return;
+            live.value = next;
+
+            try {
+                await intelArchive.saveSnapshot(gid, next);
+                localSnapshots.value = await intelArchive.loadSnapshots(gid, Date.now() - 400 * DAY);
+            } catch {
+                // Local history is a convenience.
+            }
+            if (manual || Date.now() - instancesAt >= INSTANCES_EVERY_MS) await readInstances(gid);
+
+            if (account.signedIn && !registeredLoaded.value) await loadRegistered();
+            if (remote.value) {
+                if (manual || Date.now() - remoteAt >= REMOTE_EVERY_MS) await loadRemote(gid);
+                await pushToUnderWeb(gid);
+            }
+            notifyBursts();
+            failures.value = 0;
+            lastSyncAt.value = Date.now();
+            lastError.value = '';
+            status.value = 'ok';
+        } catch (e) {
+            if (errorStatus(e) === 429) {
+                failures.value += 1;
+                status.value = 'rate-limited';
+                lastError.value = 'VRChat rate limit — UWX is backing off and will try again later.';
+            } else {
+                failures.value += e?.soft ? 0 : 1;
+                status.value = 'error';
+                lastError.value = errorText(e);
+            }
+            if (manual) toast.error(lastError.value);
+        } finally {
+            running = false;
+            schedule();
+        }
+    }
+
+    function schedule() {
+        if (timer) clearTimeout(timer);
+        timer = null;
+        nextRunAt.value = 0;
+        if (!active.value && !settings.background) return;
+        if (!settings.groupId) return;
+        const delay = nextPollDelay(settings.intervalMin * MIN, failures.value);
+        nextRunAt.value = Date.now() + delay;
+        timer = setTimeout(() => void refresh(), delay);
+    }
+
+    const active = ref(false);
+    let started = false;
+
+    /** Called when the Group Intelligence tab is shown. */
+    async function start() {
+        active.value = true;
+        await load();
+        if (!started) {
+            started = true;
+            if (account.signedIn) await loadRegistered();
+            watch(
+                () => account.signedIn,
+                (signedIn) => {
+                    registeredLoaded.value = false;
+                    if (signedIn) void loadRegistered();
+                    else registered.value = [];
+                }
+            );
+            watch(
+                () => tools.myGroups.length,
+                () => {
+                    if (!settings.groupId) {
+                        settings.groupId = defaultGroupId();
+                        if (settings.groupId) void openGroupData().then(() => refresh({ manual: true }));
+                    }
+                }
+            );
+            await openGroupData();
+            await refresh({ manual: true });
+        } else if (Date.now() - lastSyncAt.value > 60 * 1000) {
+            await refresh();
+        } else {
+            schedule();
+        }
+    }
+
+    function stop() {
+        active.value = false;
+        if (!settings.background) schedule();
+    }
+
+    // ───────── Road to 500 (recruiting) ─────────
+    const leaderboard = ref([]);
+    const claims = ref([]);
+    const myClaims = ref([]);
+    const recruitError = ref('');
+    const recruitLoading = ref(false);
+
+    async function loadRecruiting() {
+        const r = remote.value;
+        recruitError.value = '';
+        if (!r) {
+            leaderboard.value = [];
+            claims.value = [];
+            myClaims.value = [];
+            return;
+        }
+        recruitLoading.value = true;
+        try {
+            leaderboard.value = (await account.rpc('uwx_recruit_leaderboard', { p_group: r.id, p_campaign: 'road_to_500' })) || [];
+            myClaims.value =
+                (await account.api(
+                    `uwx_recruit_claims?select=id,recruit_vrc_id,recruit_name,status,created_at,review_note,joined_at&group_id=eq.${r.id}&recruiter_user_id=eq.${account.userId}&order=created_at.desc&limit=100`
+                )) || [];
+            if (level.value >= 3) {
+                const rows =
+                    (await account.api(
+                        `uwx_recruit_claims?select=id,recruiter_user_id,recruit_vrc_id,recruit_name,note,evidence_path,status,created_at&group_id=eq.${r.id}&status=eq.pending&order=created_at.asc&limit=200`
+                    )) || [];
+                const ids = [...new Set(rows.map((c) => c.recruiter_user_id))];
+                const names = ids.length ? (await account.api(`profiles?select=id,display_name,username&id=in.(${ids.join(',')})`)) || [] : [];
+                claims.value = rows.map((c) => ({
+                    ...c,
+                    recruiter: names.find((p) => p.id === c.recruiter_user_id) || null,
+                    evidence: recruitEvidence(entries.value, c.recruit_vrc_id)
+                }));
+            } else {
+                claims.value = [];
+            }
+        } catch (e) {
+            recruitError.value = errorText(e);
+        } finally {
+            recruitLoading.value = false;
+        }
+    }
+
+    async function submitClaim({ recruitId, recruitName, note, file }) {
+        const r = remote.value;
+        if (!r) throw new Error('This group isn’t registered with UnderWeb yet.');
+        let evidencePath = null;
+        if (file) {
+            const safe = String(file.name || 'evidence').replace(/[^a-z0-9._-]+/gi, '_').slice(-60);
+            evidencePath = `recruit/${r.id}/${account.userId}/${Date.now()}-${safe}`;
+            await account.storageUpload('uwx-evidence', evidencePath, file, file.type || 'application/octet-stream');
+        }
+        await account.api('uwx_recruit_claims', {
+            method: 'POST',
+            headers: { Prefer: 'return=minimal' },
+            body: JSON.stringify({ group_id: r.id, recruit_vrc_id: recruitId, recruit_name: recruitName || null, note: note || '', evidence_path: evidencePath })
+        });
+        await loadRecruiting();
+    }
+
+    async function withdrawClaim(id) {
+        await account.api(`uwx_recruit_claims?id=eq.${id}`, { method: 'DELETE', headers: { Prefer: 'return=minimal' } });
+        await loadRecruiting();
+    }
+
+    async function reviewClaim(id, verify, note = '') {
+        const res = await account.rpc('uwx_review_recruit_claim', { p_claim: id, p_verify: verify, p_note: note || null });
+        await loadRecruiting();
+        return res;
+    }
+
+    async function evidenceUrl(path) {
+        return path ? account.storageSign('uwx-evidence', path, 300) : '';
+    }
+
+    // ───────── group settings (owner) ─────────
+    /** @param {{ memberGoal?: number, retentionDays?: number, networkOptIn?: boolean }} changes */
+    async function updateGroupSettings({ memberGoal, retentionDays, networkOptIn } = {}) {
+        const r = remote.value;
+        if (!r) return;
+        await account.rpc('uwx_update_group', {
+            p_group: r.id,
+            p_member_goal: Number.isFinite(memberGoal) ? memberGoal : null,
+            p_retention_days: Number.isFinite(retentionDays) ? retentionDays : null,
+            p_network_opt_in: typeof networkOptIn === 'boolean' ? networkOptIn : null
+        });
+        await loadRegistered();
+    }
+
+    return {
+        settings,
+        INTERVAL_CHOICES,
+        live,
+        instances,
+        instancesNote,
+        snapshots,
+        localSnapshots,
+        remoteSnapshots,
+        entries,
+        activitySource,
+        activityAvailable,
+        status,
+        lastSyncAt,
+        lastError,
+        nextRunAt,
+        failures,
+        groups,
+        group,
+        groupRef,
+        remote,
+        level,
+        perms,
+        goal,
+        progress,
+        registered,
+        serverReady,
+        syncState,
+        upload,
+        canRegister,
+        leaderboard,
+        claims,
+        myClaims,
+        recruitError,
+        recruitLoading,
+        load,
+        start,
+        stop,
+        refresh,
+        setGroup,
+        setInterval: setInterval_,
+        setOption,
+        loadRegistered,
+        registerGroup,
+        uploadFullArchive,
+        loadRecruiting,
+        submitClaim,
+        withdrawClaim,
+        reviewClaim,
+        evidenceUrl,
+        updateGroupSettings
+    };
+});
diff --git a/src/stores/uwxModeration.js b/src/stores/uwxModeration.js
