+                    <Button v-if="moderation.canUseServer" size="sm" @click="emit('new-case', { subjectId, subjectName: subject?.displayName || knownName })">Open a case</Button>
+                    <Button v-if="perms.kick && membership?.status === 'member'" size="sm" variant="outline" @click="act('kick')">Remove from group</Button>
+                    <Button v-if="perms.bans" size="sm" variant="destructive" @click="act('ban')">Ban from group</Button>
+                    <Button v-if="perms.bans && known?.lastBanState === 'group.user.ban'" size="sm" variant="outline" @click="act('unban')">Unban</Button>
+                </div>
+            </div>
+            <p v-if="loadingSubject" class="uwi-note">Loading everything we know…</p>
+
+            <div class="uwi-grid2">
+                <div class="uwi-panel">
+                    <div class="uwi-label">{{ (groupName || 'GROUP').toUpperCase() }} MEMBERSHIP</div>
+                    <template v-if="membership">
+                        <p v-if="membership.status === 'member'">
