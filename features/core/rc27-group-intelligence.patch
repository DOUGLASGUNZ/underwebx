+++ b/src/views/UnderWeb/UwxIntelSync.vue
@@ -0,0 +1,74 @@
+<template>
+    <div class="uwi-panel">
+        <div class="uwi-label">UNDERWEB SHARED HISTORY</div>
+        <p v-if="!account.signedIn" class="uwi-note">
+            Only this PC's history is used right now. Sign in to UnderWeb (System tab) so staff share one archive for this group, which keeps history when someone reinstalls.
+        </p>
+        <p v-else-if="!serverReady" class="uwi-warn-box">
+            UnderWeb's Group Intelligence database isn't set up yet (an owner applies it once). Everything still works from this PC's own history.
+        </p>
+        <template v-else-if="!remote">
+            <p class="uwi-note">{{ group?.name || 'This group' }} isn't registered with UnderWeb, so only this PC's history is used.</p>
+            <div v-if="canRegister" class="uwi-bar" style="margin-top: 8px">
+                <select v-model="scope" class="uwi-select" style="width: auto" aria-label="Whose staff roles count">
+                    <option value="underweb">Staff roles: The UnderWeb</option>
+                    <option value="network">Staff roles: network-wide only</option>
+                </select>
+                <Button size="sm" :disabled="busy" @click="register">Register this group</Button>
+            </div>
+            <p v-else class="uwi-note" style="margin-top: 6px">An UnderWeb Owner or Director can register it from here.</p>
+        </template>
+        <template v-else>
+            <div class="uwi-tiles">
+                <div class="uwi-tile">
+                    <span>Your access</span><strong style="font-size: 16px">{{ LEVELS[level] }}</strong><small>from your UnderWeb role</small>
+                </div>
+                <div class="uwi-tile">
+                    <span>Archived events</span><strong>{{ syncState?.events_total?.toLocaleString() ?? '—' }}</strong>
+                    <small>{{ syncState?.newest_event_at ? `newest ${when(syncState.newest_event_at)}` : 'none yet' }}</small>
+                </div>
+                <div class="uwi-tile">
+                    <span>Last sync from any staff PC</span><strong style="font-size: 16px">{{ syncState?.updated_at ? when(syncState.updated_at) : 'Never' }}</strong>
+                    <small>{{ remoteSnapshots.length }} shared snapshots</small>
+                </div>
+                <div class="uwi-tile">
+                    <span>This PC</span>
+                    <strong style="font-size: 16px">{{ upload.busy ? 'Uploading…' : upload.lastAt ? when(upload.lastAt) : 'Not yet' }}</strong>
+                    <small>{{ upload.lastAt ? `${upload.lastInserted} new rows last time` : 'uploads after each refresh' }}</small>
+                </div>
+            </div>
+            <p v-if="upload.error" class="uwi-error" style="margin-top: 6px">{{ upload.error }}</p>
+            <div class="uwi-bar" style="margin-top: 8px">
+                <Button size="sm" variant="outline" :disabled="upload.busy || !auditHere" @click="store.uploadFullArchive()">Upload this PC's full archive</Button>
+                <span v-if="!auditHere" class="uwi-note">Needs the audit-log permission on this PC.</span>
+            </div>
+        </template>
+    </div>
+</template>
+
+<script setup>
+    import { computed, ref } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { Button } from '@/components/ui/button';
+
+    import { useUwxAccountStore } from '../../stores/uwxAccount';
+    import { useUwxIntelStore } from '../../stores/uwxIntel';
+
+    const store = useUwxIntelStore();
+    const account = useUwxAccountStore();
+    const { remote, group, level, serverReady, canRegister, syncState, upload, remoteSnapshots, perms } = storeToRefs(store);
+    const LEVELS = ['No access', 'Viewer', 'Moderator', 'Manager', 'Group owner'];
+    const scope = ref(/underweb/i.test(group.value?.name || '') ? 'underweb' : 'network');
+    const busy = ref(false);
+    const auditHere = computed(() => perms.value.audit);
+
+    async function register() {
+        busy.value = true;
+        await store.registerGroup({ roleScope: scope.value });
+        busy.value = false;
+    }
+    function when(v) {
+        const ts = typeof v === 'number' ? v : Date.parse(v);
+        return ts ? new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
+    }
+</script>
