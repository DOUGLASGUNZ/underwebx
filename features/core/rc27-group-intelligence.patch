@@ -0,0 +1,174 @@
+import { describe, expect, test } from 'vitest';
+
+import {
+    DAY,
+    activityCounts,
+    activitySeries,
+    buildTimeline,
+    comparePeriods,
+    filterCases,
+    firstResponseMinutes,
+    goalProgress,
+    knownRecordedCounts,
+    mergeSnapshots,
+    nextPollDelay,
+    parseUserQuery,
+    percentChange,
+    recruitEvidence,
+    snapshotBucket,
+    snapshotGrowth
+} from '../uwxIntel';
+
+const NOW = Date.parse('2026-10-22T18:00:00Z');
+const U1 = 'usr_11111111-1111-1111-1111-111111111111';
+const U2 = 'usr_22222222-2222-2222-2222-222222222222';
+const STAFF = 'usr_33333333-3333-3333-3333-333333333333';
+let n = 0;
+const e = (eventType, ts, extra = {}) => ({ id: `gaud_${++n}`, eventType, ts, actorId: STAFF, actorName: 'Darko', targetId: '', description: '', ...extra });
+
+describe('activity counts', () => {
+    const entries = [
+        e('group.member.join', NOW - 1000, { actorId: U1 }),
+        e('group.member.join', NOW - 2 * DAY, { actorId: U2 }),
+        e('group.member.leave', NOW - 3000, { actorId: U2 }),
+        e('group.user.ban', NOW - 4000, { targetId: U1 }),
+        e('group.member.remove', NOW - 8 * DAY, { targetId: U2 }),
+        e('group.member.role.assign', NOW - 5000, { targetId: U2 }),
+        e('group.instance.kick', NOW - 6000, { targetId: U1 })
+    ];
+
+    test('counts each metric in the window; joins/leaves are not staff actions', () => {
+        const c = activityCounts(entries, NOW - DAY, NOW + 1);
+        expect(c).toMatchObject({ joins: 1, leaves: 1, bans: 1, roleChanges: 1, instanceKicks: 1, removals: 0 });
+        expect(c.staffActions).toBe(3);
+        expect(c.netMembers).toBe(0);
+        expect(c.moderation).toBe(2);
+    });
+
+    test('compares a period with the one before', () => {
+        const { current, previous } = comparePeriods(entries, NOW, 7 * DAY);
+        expect(current.joins).toBe(2);
+        expect(previous.removals).toBe(1);
+        expect(percentChange(10, 5)).toBe(100);
+        expect(percentChange(3, 0)).toBeNull();
+    });
+
+    test('daily series fills empty days', () => {
+        const { keys, series } = activitySeries(entries, { sinceMs: NOW - 3 * DAY, untilMs: NOW, metrics: ['joins', 'bans'] });
+        expect(keys.length).toBeGreaterThanOrEqual(4);
+        expect(series.joins.reduce((a, b) => a + b, 0)).toBe(2);
+        expect(series.bans.reduce((a, b) => a + b, 0)).toBe(1);
+        expect(series.joins.length).toBe(keys.length);
+    });
+
+    test('monthly series never skips a month', () => {
+        const { keys } = activitySeries([], { sinceMs: Date.parse('2026-01-31T12:00:00'), untilMs: Date.parse('2026-06-15T12:00:00'), granularity: 'month' });
+        expect(keys).toEqual(['2026-01', '2026-02', '2026-03', '2026-04', '2026-05', '2026-06']);
+    });
+});
+
+describe('snapshots', () => {
+    const snaps = [
+        { ts: NOW - 40 * DAY, memberCount: 300 },
+        { ts: NOW - 7 * DAY, memberCount: 380 },
+        { ts: NOW - DAY, memberCount: 395 },
+        { ts: NOW - 60000, memberCount: 400 }
+    ];
+
+    test('growth over windows; partial when history is shorter than the window', () => {
+        expect(snapshotGrowth(snaps, NOW, DAY)).toMatchObject({ delta: 5, partial: false });
+        expect(snapshotGrowth(snaps, NOW, 7 * DAY).delta).toBe(20);
+        expect(snapshotGrowth(snaps, NOW, Infinity).delta).toBe(100);
+        expect(snapshotGrowth(snaps.slice(2), NOW, 30 * DAY)).toMatchObject({ delta: 5, partial: true });
+        expect(snapshotGrowth(snaps.slice(3), NOW, DAY)).toBeNull();
+    });
+
+    test('merge keeps one row per 15-minute bucket and fills missing values', () => {
+        const t = snapshotBucket(NOW);
+        const merged = mergeSnapshots([{ ts: t + 1000, memberCount: 400, banCount: null }], [{ ts: t + 5000, memberCount: 401, banCount: 12 }]);
+        expect(merged).toHaveLength(1);
+        expect(merged[0]).toMatchObject({ ts: t, memberCount: 401, banCount: 12 });
+    });
+
+    test('goal progress with an estimated ETA, never invented without history', () => {
+        const p = goalProgress(400, 500, snaps, NOW);
+        expect(p).toMatchObject({ remaining: 100, pct: 80, reached: false });
+        expect(p.perDay).toBeCloseTo(20 / 7, 1);
+        expect(p.etaDays).toBe(35);
+        expect(goalProgress(400, 500, [], NOW)).toMatchObject({ perDay: null, etaDays: null });
+        expect(goalProgress(510, 500, snaps, NOW).reached).toBe(true);
+    });
+});
+
+describe('user lookup input', () => {
+    test('profile links, raw ids and names', () => {
+        expect(parseUserQuery(`https://vrchat.com/home/user/${U1}`)).toEqual({ kind: 'id', id: U1 });
+        expect(parseUserQuery(`  ${U1.toUpperCase().replace('USR', 'usr')} `)).toEqual({ kind: 'id', id: U1 });
+        expect(parseUserQuery('@Darko')).toEqual({ kind: 'name', query: 'Darko' });
+        expect(parseUserQuery('   ')).toEqual({ kind: 'empty' });
+    });
+});
+
+describe('known recorded history', () => {
+    const entries = [
+        e('group.member.join', NOW - 10 * DAY, { actorId: U1 }),
+        e('group.user.ban', NOW - 5 * DAY, { targetId: U1 }),
+        e('group.user.unban', NOW - 2 * DAY, { targetId: U1 }),
+        e('group.instance.warn', NOW - 6 * DAY, { targetId: U1 }),
+        e('group.user.ban', NOW - DAY, { targetId: U2 })
+    ];
+
+    test('counts only this person, as target (actions) or actor (joins)', () => {
+        const k = knownRecordedCounts(entries, U1);
+        expect(k).toMatchObject({ bans: 1, unbans: 1, instanceWarns: 1, joins: 1, tracked: 4, lastBanState: 'group.user.unban' });
+        expect(knownRecordedCounts(entries, 'usr_nobody').tracked).toBe(0);
+    });
+
+    test('timeline merges sources, dedupes server copies, newest first', () => {
+        const local = entries.slice(0, 2);
+        const server = [{ vrchat_event_id: local[1].id, occurred_at: new Date(local[1].ts).toISOString(), event_type: 'group.user.ban' }];
+        const cases = [{ id: 'c1', case_number: 7, title: 'Crasher', status: 'open', created_at: new Date(NOW).toISOString(), actions: [{ type: 'ban', at: new Date(NOW).toISOString() }] }];
+        const items = buildTimeline({ local, server, cases, notes: [{ id: 1, body: 'watch', created_at: new Date(NOW - 1000).toISOString() }] }, U1);
+        expect(items.filter((i) => i.kind === 'audit')).toHaveLength(2);
+        expect(items[0].kind).toMatch(/case|action/);
+        expect(items.map((i) => i.ts)).toEqual([...items.map((i) => i.ts)].sort((a, b) => b - a));
+    });
+
+    test('recruit evidence reports joins and invites but decides nothing', () => {
+        const ev = recruitEvidence([e('group.invite.create', NOW - 3 * DAY, { targetId: U1 }), ...entries], U1);
+        expect(ev.joinedAt).toBe(NOW - 10 * DAY);
+        expect(ev.invitedBy).toEqual([{ actorId: STAFF, actorName: 'Darko', ts: NOW - 3 * DAY }]);
+        expect(recruitEvidence(entries, U2)).toMatchObject({ joinedAt: 0, invitedBy: [] });
+    });
+});
+
+describe('cases & polling', () => {
+    test('filters by status, text and assignee', () => {
+        const cases = [
+            { id: 'a', case_number: 1, title: 'Crasher at hub', status: 'open', assigned_to: 'me', updated_at: '2026-10-20T00:00:00Z' },
+            { id: 'b', case_number: 2, title: 'Spam', subject_name: 'Bob', status: 'resolved', updated_at: '2026-10-21T00:00:00Z' }
+        ];
+        expect(filterCases(cases, { statuses: ['open'] }).map((c) => c.id)).toEqual(['a']);
+        expect(filterCases(cases, { text: 'bob' }).map((c) => c.id)).toEqual(['b']);
+        expect(filterCases(cases, { text: '#2' }).map((c) => c.id)).toEqual(['b']);
+        expect(filterCases(cases, { mineUserId: 'me' }).map((c) => c.id)).toEqual(['a']);
+        expect(filterCases(cases).map((c) => c.id)).toEqual(['b', 'a']);
+    });
+
+    test('first response time ignores the automatic created row', () => {
+        expect(
+            firstResponseMinutes([
+                { kind: 'created', created_at: '2026-10-22T10:00:00Z' },
+                { kind: 'note', created_at: '2026-10-22T10:45:00Z' }
+            ])
+        ).toBe(45);
+        expect(firstResponseMinutes([{ kind: 'created', created_at: '2026-10-22T10:00:00Z' }])).toBeNull();
+    });
+
+    test('rate-limit backoff doubles and caps at 30 minutes', () => {
+        const base = 5 * 60 * 1000;
+        expect(nextPollDelay(base, 0)).toBe(base);
+        expect(nextPollDelay(base, 1)).toBe(2 * base);
+        expect(nextPollDelay(base, 10)).toBe(30 * 60 * 1000);
+    });
+});
diff --git a/src/shared/utils/uwxIntel.js b/src/shared/utils/uwxIntel.js
new file mode 100644
index 0000000..cd58f46
--- /dev/null
+++ b/src/shared/utils/uwxIntel.js
@@ -0,0 +1,389 @@
+// UWX Group Intelligence helpers (pure — no Vue, no network).
+// Inputs:
+//   entries   — normalized VRChat audit entries (see uwxAudit.js): { id, ts, eventType, actorId, actorName, targetId, ... }
+//   snapshots — { ts, memberCount, onlineCount, banCount, requestCount, inviteCount, capped }
+// Every number these return is labelled by the caller with its source (VRChat / snapshots / estimate).
+
+export const MIN = 60 * 1000;
+export const HOUR = 60 * MIN;
+export const DAY = 24 * HOUR;
+export const SNAPSHOT_BUCKET_MS = 15 * MIN;
+
+export const WINDOWS = Object.freeze([
+    { id: '24h', label: '24 hours', ms: DAY },
+    { id: '7d', label: '7 days', ms: 7 * DAY },
+    { id: '30d', label: '30 days', ms: 30 * DAY },
+    { id: 'all', label: 'All recorded', ms: Infinity }
+]);
+
+/** Audit event types counted for each activity metric. Joins/leaves are done by the member (actor). */
+export const ACTIVITY_TYPES = Object.freeze({
+    joins: ['group.member.join'],
+    leaves: ['group.member.leave'],
+    removals: ['group.member.remove'],
+    bans: ['group.user.ban'],
+    unbans: ['group.user.unban'],
+    instanceKicks: ['group.instance.kick'],
+    instanceWarns: ['group.instance.warn'],
+    roleChanges: ['group.member.role.assign', 'group.member.role.unassign'],
+    instancesOpened: ['group.instance.create'],
+    invitesSent: ['group.invite.create'],
+    invitesCancelled: ['group.invite.cancel'],
+    requests: ['group.request.create'],
+    requestsRejected: ['group.request.reject']
+});
+
+const TYPE_TO_METRIC = (() => {
+    const map = new Map();
+    for (const [metric, types] of Object.entries(ACTIVITY_TYPES)) for (const t of types) map.set(t, metric);
+    return map;
+})();
+
+const SELF_SERVICE = new Set(['group.member.join', 'group.member.leave', 'group.request.create']);
+const MODERATION_METRICS = ['removals', 'bans', 'unbans', 'instanceKicks', 'instanceWarns'];
+
+function emptyCounts() {
+    const out = { staffActions: 0, total: 0 };
+    for (const key of Object.keys(ACTIVITY_TYPES)) out[key] = 0;
+    return out;
+}
+
+/** Counts of each activity metric for entries with sinceMs <= ts < untilMs. */
+export function activityCounts(entries, sinceMs = 0, untilMs = Infinity) {
+    const out = emptyCounts();
+    for (const e of entries || []) {
+        if (!e || e.ts < sinceMs || e.ts >= untilMs) continue;
+        out.total += 1;
+        const metric = TYPE_TO_METRIC.get(e.eventType);
+        if (metric) out[metric] += 1;
+        if (e.actorId && !SELF_SERVICE.has(e.eventType)) out.staffActions += 1;
+    }
+    out.netMembers = out.joins - out.leaves - out.removals;
+    out.moderation = MODERATION_METRICS.reduce((sum, key) => sum + out[key], 0);
+    return out;
+}
+
+/** This period vs. the one before it (same length). `windowMs` must be finite. */
+export function comparePeriods(entries, now, windowMs) {
+    return {
+        current: activityCounts(entries, now - windowMs, now + 1),
+        previous: activityCounts(entries, now - 2 * windowMs, now - windowMs)
+    };
+}
+
+/** Percent change, or null when there is nothing to compare against. */
+export function percentChange(current, previous) {
+    if (!Number.isFinite(current) || !Number.isFinite(previous) || previous === 0) return null;
+    return ((current - previous) / Math.abs(previous)) * 100;
+}
+
+/** The oldest timestamp we have, i.e. how far back "All recorded" really goes. */
+export function coverageStart(entries) {
+    let min = Infinity;
+    for (const e of entries || []) if (e?.ts && e.ts < min) min = e.ts;
+    return Number.isFinite(min) ? min : 0;
+}
+
+/** Local calendar day key, YYYY-MM-DD. */
+export function dayKey(ts) {
+    const d = new Date(ts);
+    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+}
+
+function startOfLocalDay(ts) {
+    const d = new Date(ts);
+    d.setHours(0, 0, 0, 0);
+    return d.getTime();
+}
+
+/** Monday-based week key (the Monday's day key). */
+export function weekKey(ts) {
+    const d = new Date(startOfLocalDay(ts));
+    const shift = (d.getDay() + 6) % 7;
+    d.setDate(d.getDate() - shift);
+    return dayKey(d.getTime());
+}
+
+export function monthKey(ts) {
+    const d = new Date(ts);
+    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
+}
+
+const KEYERS = { day: dayKey, week: weekKey, month: monthKey };
+
+/**
+ * Activity per day/week/month between sinceMs and untilMs, with empty buckets filled in.
+ * @param {object[]} entries
+ * @param {{ sinceMs: number, untilMs: number, granularity?: string, metrics?: string[] }} options
+ * @returns {{ keys: string[], series: Record<string, number[]> }}
+ */
+export function activitySeries(entries, { sinceMs, untilMs, granularity = 'day', metrics = ['joins', 'leaves', 'removals', 'bans'] }) {
+    const keyer = KEYERS[granularity] || dayKey;
+    const keys = [];
+    const index = new Map();
+    const step = granularity === 'month' ? 28 * DAY : granularity === 'week' ? DAY : DAY;
+    for (let t = startOfLocalDay(sinceMs); t <= untilMs; t += step) {
+        const key = keyer(t);
+        if (!index.has(key)) {
+            index.set(key, keys.length);
+            keys.push(key);
+        }
+    }
+    const lastKey = keyer(untilMs);
+    if (!index.has(lastKey)) {
+        index.set(lastKey, keys.length);
+        keys.push(lastKey);
+    }
+    const series = Object.fromEntries(metrics.map((m) => [m, new Array(keys.length).fill(0)]));
+    for (const e of entries || []) {
+        if (!e || e.ts < sinceMs || e.ts > untilMs) continue;
+        const metric = TYPE_TO_METRIC.get(e.eventType);
+        if (!metric || !series[metric]) continue;
+        const i = index.get(keyer(e.ts));
+        if (i !== undefined) series[metric][i] += 1;
+    }
+    return { keys, series };
+}
+
+export function snapshotBucket(ts) {
+    return Math.floor(ts / SNAPSHOT_BUCKET_MS) * SNAPSHOT_BUCKET_MS;
+}
+
+/** Merge local + server snapshots by 15-minute bucket (newer capture wins), oldest first. */
+export function mergeSnapshots(...lists) {
+    const byBucket = new Map();
+    for (const list of lists) {
+        for (const s of list || []) {
+            if (!s || !Number.isFinite(s.ts)) continue;
+            const bucket = snapshotBucket(s.ts);
+            const prev = byBucket.get(bucket);
+            if (!prev) {
+                byBucket.set(bucket, { ...s, ts: bucket });
+                continue;
+            }
+            // Keep any value the other copy is missing.
+            const merged = { ...prev };
+            for (const [k, v] of Object.entries(s)) if (v !== null && v !== undefined && k !== 'ts') merged[k] = v;
+            byBucket.set(bucket, merged);
+        }
+    }
+    return Array.from(byBucket.values()).sort((a, b) => a.ts - b.ts);
+}
+
+/** Last member count per local day. */
+export function memberCountByDay(snapshots) {
+    const out = new Map();
+    for (const s of snapshots || []) if (Number.isFinite(s?.memberCount)) out.set(dayKey(s.ts), s.memberCount);
+    return { keys: Array.from(out.keys()), values: Array.from(out.values()) };
+}
+
+/**
+ * Member growth over a window, from snapshots. Uses the first snapshot at or after (now - window).
+ * `partial` is true when we don't have history that far back (growth since our first snapshot instead).
+ * Returns null when there are fewer than two usable snapshots.
+ */
+export function snapshotGrowth(snapshots, now, windowMs) {
+    const list = (snapshots || []).filter((s) => Number.isFinite(s?.memberCount)).sort((a, b) => a.ts - b.ts);
+    if (list.length < 2) return null;
+    const latest = list[list.length - 1];
+    const from = windowMs === Infinity ? now - Infinity : now - windowMs;
+    const base = list.find((s) => s.ts >= from) || list[0];
+    if (base === latest) return null;
+    return {
+        delta: latest.memberCount - base.memberCount,
+        fromCount: base.memberCount,
+        toCount: latest.memberCount,
+        fromTs: base.ts,
+        toTs: latest.ts,
+        partial: windowMs !== Infinity && list[0].ts > from
+    };
+}
+
+/** Progress toward a member goal, with a clearly-estimated ETA from recent snapshot growth. */
+export function goalProgress(current, goal, snapshots, now, { lookbackMs = 14 * DAY } = {}) {
+    if (!Number.isFinite(current) || !Number.isFinite(goal) || goal <= 0) return null;
+    const remaining = Math.max(0, goal - current);
+    const pct = Math.min(100, (current / goal) * 100);
+    const growth = snapshotGrowth(snapshots, now, lookbackMs);
+    let perDay = null;
+    let etaDays = null;
+    if (growth && growth.toTs - growth.fromTs >= DAY / 2) {
+        perDay = growth.delta / ((growth.toTs - growth.fromTs) / DAY);
+        if (remaining === 0) etaDays = 0;
+        else if (perDay > 0) etaDays = Math.ceil(remaining / perDay);
+    }
+    return { goal, current, remaining, pct, perDay, etaDays, reached: remaining === 0, basedOnDays: growth ? (growth.toTs - growth.fromTs) / DAY : 0 };
+}
+
+const USER_ID = /usr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
+
+/**
+ * What did staff type into the lookup box? A VRChat user id, a profile URL (contains the id), or a name.
+ * @returns {{ kind: 'id', id: string } | { kind: 'name', query: string } | { kind: 'empty' }}
+ */
+export function parseUserQuery(input) {
+    const text = String(input || '').trim();
+    if (!text) return { kind: 'empty' };
+    const match = text.match(USER_ID);
+    if (match) return { kind: 'id', id: match[0].toLowerCase() };
+    return { kind: 'name', query: text.replace(/^@/, '').slice(0, 64) };
+}
+
+export function isUserId(value) {
+    return typeof value === 'string' && /^usr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value);
+}
+
+/**
+ * Evidence for a recruiting claim from the audit log. Never decides anything by itself.
+ * @returns {{ joinedAt: number, joinEntryId: string, invitedBy: Array<{ actorId: string, actorName: string, ts: number }> }}
+ */
+export function recruitEvidence(entries, recruitId) {
+    let joinedAt = 0;
+    let joinEntryId = '';
+    const invitedBy = [];
+    for (const e of entries || []) {
+        if (e.eventType === 'group.member.join' && (e.actorId === recruitId || e.targetId === recruitId)) {
+            if (!joinedAt || e.ts < joinedAt) {
+                joinedAt = e.ts;
+                joinEntryId = e.id;
+            }
+        } else if (e.eventType === 'group.invite.create' && e.targetId === recruitId) {
+            invitedBy.push({ actorId: e.actorId, actorName: e.actorName, ts: e.ts });
+        }
+    }
+    invitedBy.sort((a, b) => a.ts - b.ts);
+    return { joinedAt, joinEntryId, invitedBy };
+}
+
+/** "Known recorded" counts for one person from the local audit archive of one group. */
+export function knownRecordedCounts(entries, userId) {
+    const out = { bans: 0, unbans: 0, removals: 0, instanceKicks: 0, instanceWarns: 0, joins: 0, leaves: 0, tracked: 0, lastBanState: '', firstSeen: 0, lastSeen: 0 };
+    let lastBanTs = 0;
+    for (const e of entries || []) {
+        const isTarget = e.targetId === userId;
+        const isActor = e.actorId === userId;
+        if (!isTarget && !isActor) continue;
+        out.tracked += 1;
+        if (!out.firstSeen || e.ts < out.firstSeen) out.firstSeen = e.ts;
+        if (e.ts > out.lastSeen) out.lastSeen = e.ts;
+        if (isTarget && e.eventType === 'group.user.ban') out.bans += 1;
+        if (isTarget && e.eventType === 'group.user.unban') out.unbans += 1;
+        if (isTarget && e.eventType === 'group.member.remove') out.removals += 1;
+        if (isTarget && e.eventType === 'group.instance.kick') out.instanceKicks += 1;
+        if (isTarget && e.eventType === 'group.instance.warn') out.instanceWarns += 1;
+        if (e.eventType === 'group.member.join') out.joins += 1;
+        if (e.eventType === 'group.member.leave') out.leaves += 1;
+        if (isTarget && /^group\.user\.(un)?ban$/.test(e.eventType) && e.ts >= lastBanTs) {
+            lastBanTs = e.ts;
+            out.lastBanState = e.eventType;
+        }
+    }
+    return out;
+}
+
+/**
+ * One readable timeline from every source we have, newest first. Each item says where it came from.
+ * sources: { local: audit entries (this PC), server: uwx_group_events rows, cases, notes }
+ */
+export function buildTimeline({ local = [], server = [], cases = [], notes = [] } = {}, userId = '') {
+    const items = [];
+    const seen = new Set();
+    for (const e of local) {
+        if (userId && e.targetId !== userId && e.actorId !== userId) continue;
+        seen.add(e.id);
+        items.push({ key: `a-${e.id}`, ts: e.ts, kind: 'audit', eventType: e.eventType, actorName: e.actorName, text: e.description, source: 'VRChat audit log (this PC)' });
+    }
+    for (const e of server) {
+        const id = e.vrchat_event_id;
+        if (seen.has(id)) continue;
+        seen.add(id);
+        items.push({
+            key: `s-${id}`,
+            ts: Date.parse(e.occurred_at) || 0,
+            kind: 'audit',
+            eventType: e.event_type,
+            actorName: e.actor_name || '',
+            text: e.description || '',
+            source: 'VRChat audit log (UnderWeb archive)'
+        });
+    }
+    for (const c of cases) {
+        items.push({ key: `c-${c.id}`, ts: Date.parse(c.incident_at || c.created_at) || 0, kind: 'case', caseNumber: c.case_number, text: c.title, status: c.status, source: 'UnderWeb case file' });
+        for (const a of c.actions || []) {
+            items.push({ key: `ca-${c.id}-${a.at}`, ts: Date.parse(a.at) || 0, kind: 'action', actionType: a.type, text: a.body || '', inVrchat: a.vrchat, caseNumber: c.case_number, source: 'UnderWeb case file' });
+        }
+    }
+    for (const n of notes) {
+        items.push({ key: `n-${n.id}`, ts: Date.parse(n.created_at) || 0, kind: 'note', text: n.body, actorName: n.author || '', source: 'Staff note' });
+    }
+    return items.sort((a, b) => b.ts - a.ts);
+}
+
+/** Next poll delay with exponential backoff after rate limits (capped). */
+export function nextPollDelay(baseMs, failures, { maxMs = 30 * MIN } = {}) {
+    if (!failures) return baseMs;
+    return Math.min(maxMs, baseMs * 2 ** Math.min(failures, 6));
+}
+
+export const CASE_STATUSES = Object.freeze([
+    { id: 'open', label: 'Open' },
+    { id: 'under_review', label: 'Under Review' },
+    { id: 'escalated', label: 'Escalated' },
+    { id: 'resolved', label: 'Resolved' },
+    { id: 'dismissed', label: 'Dismissed' },
+    { id: 'appealed', label: 'Appealed' }
+]);
+
+export const CASE_CATEGORIES = Object.freeze([
+    { id: 'harassment', label: 'Harassment' },
+    { id: 'crashing', label: 'Crashing / malicious avatar' },
+    { id: 'threats', label: 'Threats' },
+    { id: 'doxxing', label: 'Doxxing / personal info' },
+    { id: 'nsfw', label: 'NSFW outside allowed spaces' },
+    { id: 'age_concern', label: 'Age concern (18+ community)' },
+    { id: 'hate', label: 'Hate speech' },
+    { id: 'spam', label: 'Spam / advertising' },
+    { id: 'impersonation', label: 'Impersonation' },
+    { id: 'ban_evasion', label: 'Ban evasion' },
+    { id: 'other', label: 'Other' }
+]);
+
+export const CASE_SEVERITIES = Object.freeze(['low', 'medium', 'high', 'critical']);
+
+export const ACTION_TYPES = Object.freeze([
+    { id: 'warning', label: 'Warning' },
+    { id: 'kick', label: 'Removed from group' },
+    { id: 'ban', label: 'Group ban' },
+    { id: 'unban', label: 'Unban' },
+    { id: 'instance_kick', label: 'Instance kick' },
+    { id: 'instance_warn', label: 'Instance warn' },
+    { id: 'other', label: 'Other' }
+]);
+
+export function caseStatusLabel(id) {
+    return CASE_STATUSES.find((s) => s.id === id)?.label || id;
+}
+
+/** Case list filter: status set, free text (title, subject name/id, number), sorted newest activity first. */
+export function filterCases(cases, { statuses = [], text = '', mineUserId = '' } = {}) {
+    const q = String(text || '').trim().toLowerCase();
+    return (cases || [])
+        .filter((c) => !statuses.length || statuses.includes(c.status))
+        .filter((c) => !mineUserId || c.assigned_to === mineUserId)
+        .filter((c) => {
+            if (!q) return true;
+            return [c.title, c.subject_name, c.subject_vrc_id, `#${c.case_number}`, String(c.case_number)]
+                .filter(Boolean)
+                .some((v) => String(v).toLowerCase().includes(q));
+        })
+        .sort((a, b) => (Date.parse(b.updated_at) || 0) - (Date.parse(a.updated_at) || 0));
+}
+
+/** Minutes from case creation to the first entry by staff (other than the automatic "created" row). */
+export function firstResponseMinutes(entries) {
+    const list = (entries || []).slice().sort((a, b) => (Date.parse(a.created_at) || 0) - (Date.parse(b.created_at) || 0));
+    const created = list.find((e) => e.kind === 'created');
+    const first = list.find((e) => e.kind !== 'created');
+    if (!created || !first) return null;
+    return Math.max(0, Math.round(((Date.parse(first.created_at) || 0) - (Date.parse(created.created_at) || 0)) / MIN));
+}
