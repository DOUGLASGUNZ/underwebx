+        'network.lookup': 'Checked network shares',
+        'recruit.verify': 'Verified a recruit',
+        'recruit.reject': 'Rejected a recruit claim',
+        'group.register': 'Registered the group',
+        'group.update': 'Changed group settings',
+        'access.role': 'Changed role access',
+        'share.grant': 'Started sharing with a group',
+        'share.revoke': 'Stopped sharing with a group',
+        'case.purge': 'Permanently deleted a case',
+        'retention.apply': 'Deleted old activity'
+    };
+
+    const goalInput = ref(remote.value?.member_goal || 500);
+    const retentionInput = ref(remote.value?.retention_days || 730);
+    const saving = ref(false);
+    watch(remote, (r) => {
+        goalInput.value = r?.member_goal || 500;
+        retentionInput.value = r?.retention_days || 730;
+        void loadAll();
+    });
+
+    const roleDefs = ref([]);
+    const roleAccess = ref([]);
+    const accessError = ref('');
+    const otherGroups = ref([]);
+    const agreements = ref([]);
+    const log = ref([]);
+    const names = ref({});
+
+    const roleRows = computed(() =>
+        roleDefs.value
+            .filter((d) => Number(d.authority_rank) >= 45 || roleAccess.value.some((a) => a.role_slug === d.slug))
+            .map((d) => ({ slug: d.slug, name: d.name, level: roleAccess.value.find((a) => a.role_slug === d.slug)?.level ?? 0 }))
+    );
+
+    async function loadAll() {
+        if (!remote.value) return;
+        if (level.value >= 4) {
+            try {
+                const [defs, access, groups, agr] = await Promise.all([
+                    account.api('role_definitions?select=slug,name,authority_rank&active=eq.true&order=authority_rank.desc'),
+                    account.api(`uwx_group_role_access?select=role_slug,level&group_id=eq.${remote.value.id}`),
+                    account.api(`uwx_groups?select=id,name,network_opt_in&id=neq.${remote.value.id}&order=name`),
+                    account.api(`uwx_share_agreements?select=to_group,scope,status&from_group=eq.${remote.value.id}`)
+                ]);
+                roleDefs.value = defs || [];
+                roleAccess.value = access || [];
+                otherGroups.value = groups || [];
+                agreements.value = agr || [];
+            } catch (e) {
+                accessError.value = e.message;
+            }
+        }
+        if (level.value >= 3) await loadLog();
+    }
+    onMounted(loadAll);
+
+    async function loadLog() {
+        try {
+            log.value = (await account.api(`uwx_access_log?select=id,actor,action,subject_vrc_id,detail,at&group_id=eq.${remote.value.id}&order=at.desc&limit=150`)) || [];
+            const ids = [...new Set(log.value.map((r) => r.actor).filter(Boolean))].filter((id) => !names.value[id]);
+            if (ids.length) {
+                const rows = (await account.api(`profiles?select=id,display_name,username&id=in.(${ids.join(',')})`)) || [];
+                names.value = { ...names.value, ...Object.fromEntries(rows.map((p) => [p.id, p.display_name || p.username])) };
+            }
+        } catch {
+            log.value = [];
+        }
+    }
+
+    async function saveGroup() {
+        saving.value = true;
+        try {
+            await store.updateGroupSettings({ memberGoal: Number(goalInput.value), retentionDays: Number(retentionInput.value) });
+            toast.success('Saved.');
+        } catch (e) {
+            toast.error(e.message);
+        }
+        saving.value = false;
+    }
+
+    async function applyRetention() {
+        const { ok } = await modal.confirm({
+            title: 'Delete old activity',
+            description: `Permanently delete UnderWeb's archived activity for ${remote.value.name} older than ${retentionInput.value} days? Case files and notes are not touched.`
+        });
+        if (!ok) return;
+        try {
+            const n = await account.rpc('uwx_apply_retention', { p_group: remote.value.id });
+            toast.success(`Deleted ${n} old entries.`);
+        } catch (e) {
+            toast.error(e.message);
+        }
+    }
+
+    async function setRole(r, lvl) {
+        try {
+            await account.rpc('uwx_set_role_access', { p_group: remote.value.id, p_role_slug: r.slug, p_level: lvl });
+            await loadAll();
+            toast.success(`${r.name}: ${LEVELS[lvl]}`);
+        } catch (e) {
+            toast.error(e.message);
+        }
+    }
+
+    async function setOptIn(value) {
+        if (!value) {
+            const { ok } = await modal.confirm({
+                title: 'Leave the Moderation Network',
+                description: 'Leaving stops all sharing in both directions immediately. Your own cases stay with you.'
+            });
+            if (!ok) return;
+        }
+        try {
+            await store.updateGroupSettings({ networkOptIn: Boolean(value) });
+            await loadAll();
+        } catch (e) {
+            toast.error(e.message);
+        }
+    }
+
+    function shareScope(groupId) {
+        const a = agreements.value.find((x) => x.to_group === groupId && x.status === 'active');
+        return a ? a.scope : 'none';
+    }
+
+    async function setShare(g, scope) {
+        if (scope !== 'none') {
+            const { ok } = await modal.confirm({
+                title: `Share with ${g.name}`,
+                description: `${g.name}'s moderators will be able to see your network-flagged cases (${scope === 'detailed' ? 'including titles and summaries' : 'summary only'}). You can stop at any time.`
+            });
+            if (!ok) return void loadAll();
+        }
+        try {
+            await account.rpc('uwx_set_sharing', { p_from: remote.value.id, p_to: g.id, p_scope: scope === 'none' ? 'summary' : scope, p_active: scope !== 'none' });
+            await loadAll();
+            toast.success(scope === 'none' ? `Stopped sharing with ${g.name}.` : `Sharing with ${g.name}.`);
+        } catch (e) {
+            toast.error(e.message);
+        }
+    }
+
+    async function clearLocal() {
+        const { ok } = await modal.confirm({ title: 'Clear local snapshots', description: 'Delete the member-count history saved on this PC for this group? UnderWeb’s shared history is not affected.' });
+        if (!ok) return;
+        await intelArchive.clearGroup(settings.value.groupId);
+        toast.success('Cleared.');
+        void store.refresh({ manual: true });
+    }
+
+    function detailText(d) {
+        if (!d || typeof d !== 'object') return '';
+        return Object.entries(d)
+            .map(([k, v]) => `${k}: ${v}`)
+            .join(', ')
+            .slice(0, 120);
+    }
+    function when(v) {
+        return new Date(v).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
+    }
+</script>
+
+<style scoped>
+    .uwi-opts {
+        display: flex;
+        flex-direction: column;
+        gap: 8px;
+        font-size: 13px;
+    }
+    .uwi-opts label {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+    }
+</style>
diff --git a/src/views/UnderWeb/UwxIntelChart.vue b/src/views/UnderWeb/UwxIntelChart.vue
new file mode 100644
index 0000000..9377c61
--- /dev/null
+++ b/src/views/UnderWeb/UwxIntelChart.vue
@@ -0,0 +1,93 @@
+<template>
+    <div class="uwi-chart-wrap">
+        <div ref="el" class="uwi-chart" :style="{ height: `${height}px` }" role="img" :aria-label="label" />
+        <p v-if="empty" class="uwi-chart-empty">{{ emptyText }}</p>
+    </div>
+</template>
+
+<script setup>
+    import { onBeforeUnmount, onMounted, ref, watch } from 'vue';
+    import * as echarts from 'echarts';
+
+    // Thin wrapper around echarts (already a UWX/VRCX dependency) for Group Intelligence charts.
+    const props = defineProps({
+        option: { type: Object, required: true },
+        height: { type: Number, default: 240 },
+        label: { type: String, default: 'Chart' },
+        empty: { type: Boolean, default: false },
+        emptyText: { type: String, default: 'No data for this period yet.' }
+    });
+
+    const el = ref(null);
+    let chart = null;
+    let observer = null;
+
+    const INK = { text: '#c9d1cb', muted: '#7d877f', grid: 'rgba(255,255,255,0.07)', surface: '#0b0f0c' };
+
+    function themed(option) {
+        return {
+            backgroundColor: 'transparent',
+            textStyle: { color: INK.text, fontFamily: 'inherit' },
+            grid: { left: 40, right: 16, top: 36, bottom: 28, containLabel: false },
+            legend: { top: 0, left: 0, textStyle: { color: INK.text, fontSize: 11 }, itemWidth: 10, itemHeight: 10, icon: 'roundRect' },
+            tooltip: {
+                trigger: 'axis',
+                backgroundColor: '#111712',
+                borderColor: 'rgba(255,255,255,0.12)',
+                textStyle: { color: '#e8efe9', fontSize: 12 },
+                axisPointer: { type: 'line', lineStyle: { color: 'rgba(255,255,255,0.25)' } }
+            },
+            ...option,
+            xAxis: {
+                axisLine: { lineStyle: { color: INK.grid } },
+                axisTick: { show: false },
+                axisLabel: { color: INK.muted, fontSize: 10, hideOverlap: true },
+                ...(option.xAxis || {})
+            },
+            yAxis: {
+                splitLine: { lineStyle: { color: INK.grid } },
+                axisLabel: { color: INK.muted, fontSize: 10 },
+                minInterval: 1,
+                ...(option.yAxis || {})
+            }
+        };
+    }
+
+    function render() {
+        if (!chart) return;
+        chart.setOption(themed(props.option), true);
+    }
+
+    onMounted(() => {
+        chart = echarts.init(el.value, null, { renderer: 'svg' });
+        render();
+        observer = new ResizeObserver(() => chart?.resize());
+        observer.observe(el.value);
+    });
+
+    watch(() => props.option, render, { deep: true });
+
+    onBeforeUnmount(() => {
+        observer?.disconnect();
+        chart?.dispose();
+        chart = null;
+    });
+</script>
+
+<style scoped>
+    .uwi-chart-wrap {
+        position: relative;
+    }
+    .uwi-chart {
+        width: 100%;
+    }
+    .uwi-chart-empty {
+        position: absolute;
+        inset: 36px 0 0;
+        display: grid;
+        place-items: center;
+        font-size: 12px;
+        color: var(--muted-foreground);
+        pointer-events: none;
+    }
+</style>
diff --git a/src/views/UnderWeb/UwxIntelFeed.vue b/src/views/UnderWeb/UwxIntelFeed.vue
new file mode 100644
index 0000000..f02b809
--- /dev/null
+++ b/src/views/UnderWeb/UwxIntelFeed.vue
@@ -0,0 +1,174 @@
+<template>
+    <div class="uwi-panel">
+        <div class="uwi-bar" style="margin-bottom: 10px">
+            <label class="uwi-field grow" style="min-width: 200px">
+                <span>Search</span>
+                <input v-model.trim="text" class="uwi-input" placeholder="Name, usr_ id or description" />
+            </label>
+            <label class="uwi-field">
+                <span>Type</span>
+                <select v-model="category" class="uwi-select">
+                    <option v-for="c in AUDIT_CATEGORIES" :key="c.id" :value="c.id">{{ c.label }}</option>
+                </select>
+            </label>
+            <label class="uwi-field"><span>From</span><input v-model="from" type="date" class="uwi-input" /></label>
+            <label class="uwi-field"><span>To</span><input v-model="to" type="date" class="uwi-input" /></label>
+            <Button size="sm" variant="outline" :disabled="!filtered.length" @click="exportCsv">Export CSV</Button>
+        </div>
+        <p class="uwi-src" style="margin-bottom: 6px">
+            <b>Historical</b> {{ activitySource || 'VRChat audit log' }} · {{ filtered.length.toLocaleString() }} of {{ entries.length.toLocaleString() }} entries · right-click a row for actions
+        </p>
+
+        <div v-if="!activityAvailable" class="uwi-empty uwi-denied">
+            <i class="ri-lock-line" />
+            Needs the “View audit log” permission in this VRChat group, or UnderWeb staff access to a registered group.
+        </div>
+        <div v-else-if="!entries.length" class="uwi-empty"><i class="ri-inbox-line" />No activity saved for this group yet.</div>
+        <div v-else-if="!filtered.length" class="uwi-empty"><i class="ri-filter-off-line" />Nothing matches those filters.</div>
+        <template v-else>
+            <table class="uwi-table">
+                <thead>
+                    <tr>
+                        <th class="sortable" @click="sortBy('ts')">When {{ arrow('ts') }}</th>
+                        <th class="sortable" @click="sortBy('eventType')">What {{ arrow('eventType') }}</th>
+                        <th class="sortable" @click="sortBy('actorName')">By {{ arrow('actorName') }}</th>
+                        <th>Details</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    <tr v-for="e in page" :key="e.id" class="clickable" @contextmenu.prevent="openMenu($event, e)" @dblclick="lookUp(e.targetId || e.actorId)">
+                        <td style="white-space: nowrap">{{ when(e.ts) }}</td>
+                        <td>{{ eventLabel(e.eventType) }}</td>
+                        <td class="truncate" style="max-width: 160px">{{ e.actorName || '—' }}</td>
+                        <td class="uwi-note" style="color: var(--foreground)">{{ e.description || '—' }}</td>
+                    </tr>
+                </tbody>
+            </table>
+            <div class="uwi-bar" style="margin-top: 8px">
+                <span class="uwi-note">Showing {{ page.length }} of {{ filtered.length }}</span>
+                <Button v-if="page.length < filtered.length" size="sm" variant="ghost" @click="limit += 200">Show more</Button>
+            </div>
+        </template>
+
+        <div v-if="menu" class="uwi-menu" :style="{ left: `${menu.x}px`, top: `${menu.y}px` }" @mouseleave="menu = null">
+            <button v-if="isUserId(menu.entry.targetId)" type="button" @click="act(() => lookUp(menu.entry.targetId))">Look up target</button>
+            <button v-if="isUserId(menu.entry.actorId)" type="button" @click="act(() => lookUp(menu.entry.actorId))">Look up {{ menu.entry.actorName || 'actor' }}</button>
+            <button v-if="isUserId(menu.entry.targetId)" type="button" @click="act(() => showUserDialog(menu.entry.targetId))">Open VRChat profile</button>
+            <button type="button" @click="act(() => copy(menu.entry.targetId || menu.entry.actorId))">Copy user id</button>
+            <button type="button" @click="act(() => copy(JSON.stringify(menu.entry, null, 2)))">Copy entry</button>
+        </div>
+    </div>
+</template>
+
+<script setup>
+    import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { toast } from 'vue-sonner';
+    import { Button } from '@/components/ui/button';
+
+    import { AUDIT_CATEGORIES, categorizeEvent, eventLabel } from '../../shared/utils/uwxAudit';
+    import { isUserId } from '../../shared/utils/uwxIntel';
+    import { showUserDialog } from '../../coordinators/userCoordinator';
+    import { useUwxGroupAuditStore } from '../../stores/uwxGroupAudit';
+    import { useUwxIntelStore } from '../../stores/uwxIntel';
+    import { useUwxModerationStore } from '../../stores/uwxModeration';
+
+    const intel = useUwxIntelStore();
+    const { entries, activitySource, activityAvailable, group } = storeToRefs(intel);
+    const moderation = useUwxModerationStore();
+
+    const text = ref('');
+    const category = ref('all');
+    const from = ref('');
+    const to = ref('');
+    const sortKey = ref('ts');
+    const sortDir = ref(-1);
+    const limit = ref(200);
+    const menu = ref(null);
+
+    watch([text, category, from, to], () => (limit.value = 200));
+
+    const filtered = computed(() => {
+        const q = text.value.toLowerCase();
+        const fromTs = from.value ? new Date(`${from.value}T00:00:00`).getTime() : 0;
+        const toTs = to.value ? new Date(`${to.value}T23:59:59`).getTime() : Infinity;
+        const list = entries.value.filter((e) => {
+            if (e.ts < fromTs || e.ts > toTs) return false;
+            if (category.value !== 'all' && categorizeEvent(e.eventType) !== category.value) return false;
+            if (!q) return true;
+            return [e.actorName, e.actorId, e.targetId, e.description, eventLabel(e.eventType)].some((v) => String(v || '').toLowerCase().includes(q));
+        });
+        const k = sortKey.value;
+        const dir = sortDir.value;
+        return list.sort((a, b) => {
+            const av = a[k] ?? '';
+            const bv = b[k] ?? '';
+            if (av < bv) return -dir;
+            if (av > bv) return dir;
+            return 0;
+        });
+    });
+    const page = computed(() => filtered.value.slice(0, limit.value));
+
+    function sortBy(key) {
+        if (sortKey.value === key) sortDir.value = -sortDir.value;
+        else {
+            sortKey.value = key;
+            sortDir.value = key === 'ts' ? -1 : 1;
+        }
+    }
+    const arrow = (key) => (sortKey.value === key ? (sortDir.value === 1 ? '↑' : '↓') : '');
+
+    function openMenu(ev, entry) {
+        menu.value = { x: ev.clientX, y: ev.clientY, entry };
+    }
+    function act(fn) {
+        fn();
+        menu.value = null;
+    }
+    function lookUp(userId) {
+        if (isUserId(userId)) moderation.focusUser(userId);
+    }
+    async function copy(value) {
+        try {
+            await navigator.clipboard.writeText(String(value || ''));
+            toast.success('Copied.');
+        } catch {
+            toast.error('Couldn’t copy.');
+        }
+    }
+    function exportCsv() {
+        useUwxGroupAuditStore().exportEntries(filtered.value, 'csv', group.value?.name || 'group');
+    }
+    function when(ts) {
+        return new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', year: '2-digit', hour: '2-digit', minute: '2-digit' });
+    }
+
+    const closeMenu = () => (menu.value = null);
+    onMounted(() => window.addEventListener('click', closeMenu));
+    onBeforeUnmount(() => window.removeEventListener('click', closeMenu));
+</script>
+
+<style scoped>
+    .uwi-menu {
+        position: fixed;
+        z-index: 60;
+        display: flex;
+        flex-direction: column;
+        min-width: 190px;
+        padding: 4px;
+        border-radius: 8px;
+        border: 1px solid var(--border);
+        background: #111712;
+        box-shadow: 0 8px 24px rgb(0 0 0 / 45%);
+    }
+    .uwi-menu button {
+        text-align: left;
+        font-size: 13px;
+        padding: 6px 10px;
+        border-radius: 6px;
+    }
+    .uwi-menu button:hover {
+        background: rgb(255 255 255 / 6%);
+    }
+</style>
diff --git a/src/views/UnderWeb/UwxIntelRecruiting.vue b/src/views/UnderWeb/UwxIntelRecruiting.vue
