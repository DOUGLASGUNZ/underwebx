+    // ───────── Discord moderation log (server posts to the staff channel; any staff client nudges it) ─────────
+    const modLog = reactive({ configured: null, lastPostAt: '', lastError: '', backfilledAt: '' });
+    let modLogAt = 0;
+    let modLogPending = null;
+    /** Ask UnderWeb to post anything new to the staff Discord. Cheap, safe to call often (debounced). */
+    function flushModLog({ soon = false } = {}) {
+        if (!account.signedIn || !remote.value) return;
+        if (modLogPending) return;
+        const wait = Math.max(soon ? 3000 : 0, 20000 - (Date.now() - modLogAt));
+        modLogPending = setTimeout(async () => {
+            modLogPending = null;
+            modLogAt = Date.now();
+            try {
+                await account.callFunction('uwx-mod-discord', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
+            } catch {
+                // the next nudge retries
+            }
+        }, wait);
+    }
+    async function loadModLog() {
+        if (!account.signedIn || !remote.value) return;
+        const res = await account.callFunction('uwx-mod-discord', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: true }) });
+        const st = (res.json?.groups || []).find((g) => g.group_id === remote.value?.id) || {};
+        modLog.configured = res.status === 200 ? Boolean(res.json?.configured) : null;
+        modLog.lastPostAt = st.last_post_at || '';
+        modLog.lastError = st.last_error || (res.status >= 400 ? res.json?.error || `Error ${res.status}` : '');
+        modLog.backfilledAt = st.backfilled_at || '';
+    }
+    async function postModHistory() {
+        const res = await account.callFunction('uwx-mod-discord', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ backfill: true }) });
+        await loadModLog();
+        if (res.status !== 200) throw new Error(res.json?.error || `Error ${res.status}`);
+        const r = (res.json?.results || []).find((x) => x.group === remote.value?.name) || res.json?.results?.[0] || {};
+        return r;
+    }
+
