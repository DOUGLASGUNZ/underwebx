diff --git a/src/stores/uwxApprovals.js b/src/stores/uwxApprovals.js
new file mode 100644
index 0000000..1104ac8
--- /dev/null
+++ b/src/stores/uwxApprovals.js
@@ -0,0 +1,158 @@
+import { computed, reactive, ref } from 'vue';
+import { defineStore } from 'pinia';
+
+import { useUwxAccountStore } from './uwxAccount';
+
+// Staff approvals from inside UWX: the same queues as Staff on underweb.cloud.
+// Every list and every decision goes through the UnderWeb server as you, so the
+// server's own rules decide what you can see and approve (UWX hiding a button is
+// only a convenience). A section you have no access to just stays empty.
+
+export const APPROVAL_SECTIONS = Object.freeze([
+    { id: 'media', label: 'Photos & work' },
+    { id: 'hubcards', label: 'Hub cards' },
+    { id: 'roles', label: 'Role applications' },
+    { id: 'vrchat', label: 'VRChat checks' },
+    { id: 'events', label: 'Events' }
+]);
+
+const errText = (e) => String(e?.message || e || 'Something went wrong.');
+const denied = (e) => e?.status === 401 || e?.status === 403 || /permission|not allowed|authority|required|denied/i.test(errText(e));
+
+export const useUwxApprovalsStore = defineStore('UwxApprovals', () => {
+    const account = useUwxAccountStore();
+
+    const lists = reactive({ media: [], hubcards: [], roles: [], vrchat: [], events: [] });
+    const errors = reactive({ media: '', hubcards: '', roles: '', vrchat: '', events: '' });
+    const names = ref({});
+    const roleNames = ref({});
+    const loading = ref(false);
+    const busyId = ref('');
+    const loadedAt = ref(0);
+
+    const total = computed(() => APPROVAL_SECTIONS.reduce((n, s) => n + lists[s.id].length, 0));
+    const nameOf = (id) => names.value[id]?.name || names.value[id]?.username || `Member ${String(id || '').slice(0, 6)}`;
+    const roleName = (slug) => roleNames.value[slug] || slug;
+
+    async function resolveNames(ids) {
+        const unique = [...new Set(ids.filter(Boolean))].filter((id) => !names.value[id]);
+        if (!unique.length) return;
+        for (const fn of ['uw_staff_resolve_members', 'uw_moderation_resolve_members']) {
+            try {
+                const rows = await account.rpc(fn, { p_user_ids: unique });
+                const next = { ...names.value };
+                for (const r of rows || []) next[r.id] = { name: r.display_name || r.username || '', username: r.username || '' };
+                names.value = next;
+                if (unique.every((id) => next[id])) return;
+            } catch {
+                // try the next resolver
+            }
+        }
+    }
+
+    async function section(id, fn) {
+        errors[id] = '';
+        try {
+            lists[id] = (await fn()) || [];
+        } catch (e) {
+            lists[id] = [];
+            errors[id] = denied(e) ? '' : errText(e);
+        }
+    }
+
+    async function load() {
+        if (!account.signedIn) return;
+        loading.value = true;
+        await Promise.all([
+            section('media', async () => {
+                const rows = (await account.rpc('uw_showcase_review_queue')) || [];
+                return Promise.all(
+                    rows.map(async (r) => ({ ...r, preview: r.storage_path ? await account.storageSign('creator-showcase-pending', r.storage_path).catch(() => '') : '' }))
+                );
+            }),
+            section('hubcards', () => account.api('hub_creator_cards?select=*&status=eq.pending&order=updated_at.asc')),
+            section('roles', async () => {
+                const [apps, defs] = await Promise.all([
+                    account.api('role_applications?select=*&status=in.(pending,reviewing)&order=submitted_at.asc'),
+                    account.api('role_definitions?select=slug,name').catch(() => [])
+                ]);
+                roleNames.value = Object.fromEntries((defs || []).map((d) => [d.slug, d.name]));
+                return apps;
+            }),
+            section('vrchat', () => account.rpc('uw_vrchat_verification_queue')),
+            section('events', () =>
+                account.api('network_events?select=id,title,description,starts_at,location,group_scope,created_by,created_at&status=eq.pending&order=starts_at.asc')
+            )
+        ]);
+        await resolveNames([
+            ...lists.media.map((r) => r.user_id),
+            ...lists.hubcards.map((r) => r.user_id),
+            ...lists.roles.map((r) => r.user_id),
+            ...lists.vrchat.map((r) => r.user_id),
+            ...lists.events.map((r) => r.created_by)
+        ]);
+        loadedAt.value = Date.now();
+        loading.value = false;
+    }
+
+    /** Run one decision; on success drop the item from its list. Returns '' or an error message. */
+    async function decide(sectionId, id, fn) {
+        busyId.value = id;
+        try {
+            await fn();
+            lists[sectionId] = lists[sectionId].filter((x) => (x.id ?? x.user_id) !== id);
+            return '';
+        } catch (e) {
+            return denied(e) ? "You don't have permission to decide this one." : errText(e);
+        } finally {
+            busyId.value = '';
+        }
+    }
+
+    const approveMedia = (item) =>
+        decide('media', item.id, async () => {
+            const { status, json } = await account.callFunction('approve-showcase-media', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ media_id: item.id })
+            });
+            if (status !== 200 || !json?.ok) throw Object.assign(new Error(json?.error || `Approval failed (${status}).`), { status });
+        });
+    const denyMedia = (item, reason) =>
+        decide('media', item.id, () => account.rpc('uw_review_showcase_media', { p_media_id: item.id, p_approve: false, p_reason: reason || null }));
+
+    const reviewHubCard = (item, approve, note) =>
+        decide('hubcards', item.user_id, () => account.rpc('uw_review_hub_card', { p_user_id: item.user_id, p_approve: approve, p_note: note || null }));
+
+    const reviewRole = (item, decision, note) => {
+        if (decision === 'denied' && String(note || '').trim().length < 3) return Promise.resolve('Add a short reason before denying.');
+        return decide('roles', item.id, () =>
+            account.rpc('uw_review_role_application', { p_application_id: item.id, p_decision: decision, p_review_note: String(note || '').trim() })
+        );
+    };
+
+    const reviewVrchat = (item, approve) => decide('vrchat', item.id, () => account.rpc('uw_review_vrchat_connection', { p_connection_id: item.id, p_approve: approve }));
+
+    const reviewEvent = (item, decision, note) => {
+        if (decision === 'rejected' && String(note || '').trim().length < 3) return Promise.resolve('Add a short reason before rejecting.');
+        return decide('events', item.id, () => account.rpc('uw_review_event', { p_event_id: item.id, p_decision: decision, p_note: String(note || '').trim() || null }));
+    };
+
+    return {
+        lists,
+        errors,
+        loading,
+        busyId,
+        loadedAt,
+        total,
+        nameOf,
+        roleName,
+        load,
+        approveMedia,
+        denyMedia,
+        reviewHubCard,
+        reviewRole,
+        reviewVrchat,
+        reviewEvent
+    };
+});
