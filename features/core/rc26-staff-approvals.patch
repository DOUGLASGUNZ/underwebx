@@ -0,0 +1,92 @@
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+
+const account = vi.hoisted(() => ({
+    signedIn: true,
+    rpc: vi.fn(),
+    api: vi.fn(),
+    callFunction: vi.fn(),
+    storageSign: vi.fn(async () => 'https://signed.example/preview.jpg')
+}));
+vi.mock('../uwxAccount', () => ({ useUwxAccountStore: () => account }));
+
+const { useUwxApprovalsStore } = await import('../uwxApprovals');
+
+const forbidden = Object.assign(new Error('permission denied for table role_applications'), { status: 403 });
+
+function routes() {
+    account.rpc.mockImplementation(async (name, args) => {
+        if (name === 'uw_showcase_review_queue') return [{ id: 'm1', user_id: 'u1', title: 'Hub night', storage_path: 'u1/1.jpg', media_type: 'image' }];
+        if (name === 'uw_vrchat_verification_queue') return [{ id: 'v1', user_id: 'u2', verification_code: 'UW-ABC' }];
+        if (name === 'uw_staff_resolve_members') return args.p_user_ids.map((id) => ({ id, display_name: `Name ${id}`, username: id }));
+        return null;
+    });
+    account.api.mockImplementation(async (path) => {
+        if (path.startsWith('hub_creator_cards')) return [{ user_id: 'u3', kind: 'market', headline: 'Shop' }];
+        if (path.startsWith('role_applications')) throw forbidden;
+        if (path.startsWith('role_definitions')) return [];
+        if (path.startsWith('network_events')) return [{ id: 'e1', title: 'Hub opening', created_by: 'u4' }];
+        return [];
+    });
+}
+
+describe('UWX staff approvals', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        vi.clearAllMocks();
+        routes();
+    });
+
+    test('loads every queue as you; sections you cannot see stay empty without an error', async () => {
+        const s = useUwxApprovalsStore();
+        await s.load();
+        expect(s.lists.media).toHaveLength(1);
+        expect(s.lists.media[0].preview).toBe('https://signed.example/preview.jpg');
+        expect(account.storageSign).toHaveBeenCalledWith('creator-showcase-pending', 'u1/1.jpg');
+        expect(s.lists.hubcards).toHaveLength(1);
+        expect(s.lists.vrchat).toHaveLength(1);
+        expect(s.lists.events).toHaveLength(1);
+        expect(s.lists.roles).toEqual([]);
+        expect(s.errors.roles).toBe('');
+        expect(s.total).toBe(4);
+        expect(s.nameOf('u4')).toBe('Name u4');
+    });
+
+    test('approving a photo goes through the approve function and removes it from the list', async () => {
+        account.callFunction.mockResolvedValue({ status: 200, json: { ok: true } });
+        const s = useUwxApprovalsStore();
+        await s.load();
+        expect(await s.approveMedia(s.lists.media[0])).toBe('');
+        expect(account.callFunction).toHaveBeenCalledWith('approve-showcase-media', expect.objectContaining({ method: 'POST', body: JSON.stringify({ media_id: 'm1' }) }));
+        expect(s.lists.media).toHaveLength(0);
+    });
+
+    test('a failed decision keeps the item and explains why', async () => {
+        account.callFunction.mockResolvedValue({ status: 403, json: { error: 'Media reviewer authority required' } });
+        const s = useUwxApprovalsStore();
+        await s.load();
+        expect(await s.approveMedia(s.lists.media[0])).toMatch(/permission/);
+        expect(s.lists.media).toHaveLength(1);
+    });
+
+    test('denying a role application or rejecting an event needs a reason', async () => {
+        const s = useUwxApprovalsStore();
+        await s.load();
+        expect(await s.reviewRole({ id: 'a1' }, 'denied', '')).toMatch(/reason/);
+        expect(await s.reviewEvent(s.lists.events[0], 'rejected', ' ')).toMatch(/reason/);
+        expect(account.rpc).not.toHaveBeenCalledWith('uw_review_event', expect.anything());
+        expect(await s.reviewEvent(s.lists.events[0], 'published', '')).toBe('');
+        expect(account.rpc).toHaveBeenCalledWith('uw_review_event', { p_event_id: 'e1', p_decision: 'published', p_note: null });
+        expect(s.lists.events).toHaveLength(0);
+    });
+
+    test('hub cards and VRChat checks use the server review functions', async () => {
+        const s = useUwxApprovalsStore();
+        await s.load();
+        await s.reviewHubCard(s.lists.hubcards[0], true);
+        expect(account.rpc).toHaveBeenCalledWith('uw_review_hub_card', { p_user_id: 'u3', p_approve: true, p_note: null });
+        await s.reviewVrchat(s.lists.vrchat[0], false);
+        expect(account.rpc).toHaveBeenCalledWith('uw_review_vrchat_connection', { p_connection_id: 'v1', p_approve: false });
+        expect(s.total).toBe(2);
+    });
+});
