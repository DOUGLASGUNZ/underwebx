diff --git a/src/stores/uwxTheme.js b/src/stores/uwxTheme.js
new file mode 100644
index 0000000..1ebd4c4
--- /dev/null
+++ b/src/stores/uwxTheme.js
@@ -0,0 +1,86 @@
+import { reactive } from 'vue';
+import { defineStore } from 'pinia';
+
+import configRepository from '../services/config';
+import { accentOf, DEFAULT_THEME, normalizeTheme, themeCss } from '../shared/utils/uwxTheme';
+
+// UWX client theme: one accent color for the whole client (UnderWeb pages, premium
+// cards, VRCX's own buttons/highlights) plus an optional tint on the dark background.
+// Saved per PC. A copy in localStorage paints the theme instantly on startup.
+
+const KEY = 'UWX_clientTheme';
+const STYLE_ID = 'uwx-theme-vars';
+
+function readCache() {
+    try {
+        return JSON.parse(localStorage.getItem(KEY) || 'null');
+    } catch {
+        return null;
+    }
+}
+
+function writeCache(theme) {
+    try {
+        localStorage.setItem(KEY, JSON.stringify(theme));
+    } catch {
+        // storage may be unavailable; the config copy still persists it
+    }
+}
+
+/** Put the theme CSS last in <head> so it wins over VRCX's theme files. */
+export function paintTheme(theme) {
+    if (typeof document === 'undefined') return;
+    let el = document.getElementById(STYLE_ID);
+    if (!el) {
+        el = document.createElement('style');
+        el.id = STYLE_ID;
+    }
+    el.textContent = themeCss(theme);
+    document.head.appendChild(el); // (re)append keeps it last
+}
+
+export const useUwxThemeStore = defineStore('UwxTheme', () => {
+    const theme = reactive({ ...DEFAULT_THEME, ...normalizeTheme(readCache()) });
+
+    function commit() {
+        const clean = normalizeTheme(theme);
+        Object.assign(theme, clean);
+        paintTheme(clean);
+        writeCache(clean);
+        void configRepository.setString(KEY, JSON.stringify(clean));
+    }
+
+    async function init() {
+        paintTheme(theme);
