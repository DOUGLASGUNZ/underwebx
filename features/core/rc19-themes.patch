+        theme.preset = id;
+        commit();
+    }
+    function setCustom(hex) {
+        theme.preset = 'custom';
+        theme.custom = String(hex || '').toLowerCase();
+        commit();
+    }
+    function setTint(tint) {
+        theme.tint = tint;
+        commit();
+    }
+    function setEnabled(value) {
+        theme.enabled = Boolean(value);
+        commit();
+    }
+
+    return { theme, accent: () => accentOf(theme), init, setPreset, setCustom, setTint, setEnabled };
+});
