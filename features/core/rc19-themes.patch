+import { describe, expect, it } from 'vitest';
+import { accentOf, foregroundFor, hexToRgb, normalizeTheme, themeCss, THEME_PRESETS } from '../uwxTheme';
+
+describe('uwxTheme', () => {
+    it('defaults to UnderWeb green and cleans bad input', () => {
+        expect(normalizeTheme(null)).toEqual({ enabled: true, preset: 'underweb', custom: '', tint: 'subtle' });
+        expect(normalizeTheme({ preset: 'nope', custom: 'red', tint: 'max' })).toMatchObject({ preset: 'underweb', custom: '', tint: 'subtle' });
+        expect(accentOf(normalizeTheme({}))).toBe('#3df514');
+        expect(accentOf(normalizeTheme({ preset: 'custom', custom: '#FF00AA' }))).toBe('#ff00aa');
+    });
+
+    it('keeps button text readable on any accent', () => {
+        expect(foregroundFor(hexToRgb('#3df514'))).toBe('#0a0a0a');
+        expect(foregroundFor(hexToRgb('#a855f7'))).toBe('#ffffff');
+        expect(foregroundFor(hexToRgb('#d4d4d8'))).toBe('#0a0a0a');
+        for (const p of THEME_PRESETS) expect(['#0a0a0a', '#ffffff']).toContain(foregroundFor(hexToRgb(p.accent)));
+    });
+
+    it('recolors UWX and VRCX variables, and turns off cleanly', () => {
+        const css = themeCss({ preset: 'blood', tint: 'none' });
+        expect(css).toContain('--uwx-accent: #ff3b3b;');
+        expect(css).toContain('--uwx-accent-rgb: 255 59 59;');
+        expect(css).toContain('--primary: #ff3b3b;');
+        expect(css).toContain('--sidebar-primary: #ff3b3b;');
+        expect(css).not.toContain('color-mix');
+        expect(themeCss({ preset: 'violet', tint: 'strong' })).toContain('color-mix(in oklab, #a855f7 9%');
+        expect(themeCss({ enabled: false })).toBe('');
+    });
+});
