index 0000000..870304d
--- /dev/null
+++ b/src/shared/utils/uwxTheme.js
@@ -0,0 +1,94 @@
+// UWX client themes (pure): an accent color drives UnderWeb pages, premium cards and
+// VRCX's own primary/ring/sidebar colors. Output is plain CSS text.
+
+export const THEME_PRESETS = Object.freeze([
+    { id: 'underweb', name: 'UnderWeb Green', accent: '#3df514' },
+    { id: 'blood', name: 'Blood Moon', accent: '#ff3b3b' },
+    { id: 'violet', name: 'Violet', accent: '#a855f7' },
+    { id: 'ice', name: 'Ice', accent: '#38bdf8' },
+    { id: 'gold', name: 'Gold', accent: '#fbbf24' },
+    { id: 'rose', name: 'Rose', accent: '#fb7185' },
+    { id: 'mono', name: 'Mono', accent: '#d4d4d8' }
+]);
+
+export const DEFAULT_THEME = Object.freeze({ enabled: true, preset: 'underweb', custom: '', tint: 'subtle' });
+const HEX = /^#([0-9a-f]{6})$/i;
+
+export function normalizeTheme(raw) {
+    const t = { ...DEFAULT_THEME, ...(raw && typeof raw === 'object' ? raw : {}) };
+    return {
+        enabled: t.enabled !== false,
+        preset: t.preset === 'custom' || THEME_PRESETS.some((p) => p.id === t.preset) ? t.preset : 'underweb',
+        custom: HEX.test(String(t.custom || '')) ? String(t.custom).toLowerCase() : '',
+        tint: ['none', 'subtle', 'strong'].includes(t.tint) ? t.tint : 'subtle'
+    };
+}
+
+export function accentOf(theme) {
+    if (theme.preset === 'custom' && theme.custom) return theme.custom;
+    return (THEME_PRESETS.find((p) => p.id === theme.preset) || THEME_PRESETS[0]).accent;
+}
+
+export function hexToRgb(hex) {
+    const m = HEX.exec(hex);
+    if (!m) return [61, 245, 20];
+    const n = parseInt(m[1], 16);
+    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+}
+
+/**
+ * Relative luminance (WCAG), 0..1.
+ * @param {number[]} rgb
+ */
+export function luminance([r, g, b]) {
+    const f = (c) => {
+        const v = c / 255;
+        return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+    };
+    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
+}
+
+/** Text color that stays readable on the accent (for primary buttons). */
+export function foregroundFor(rgb) {
+    return luminance(rgb) > 0.32 ? '#0a0a0a' : '#ffffff';
+}
+
+/** @param {number[]} rgb */
+function lighten([r, g, b], amount) {
+    return [r, g, b].map((c) => Math.round(c + (255 - c) * amount));
+}
+
+const toHex = (rgb) => '#' + rgb.map((c) => c.toString(16).padStart(2, '0')).join('');
+
+/** CSS for the chosen theme. Empty string when the UWX theme is turned off (VRCX's theme applies). */
+export function themeCss(rawTheme) {
+    const theme = normalizeTheme(rawTheme);
+    if (!theme.enabled) return '';
+    const accent = accentOf(theme);
+    const rgb = hexToRgb(accent);
+    const soft = toHex(lighten(rgb, 0.35));
+    const fg = foregroundFor(rgb);
+    const tintPct = { none: 0, subtle: 4, strong: 9 }[theme.tint];
+    const base = 'oklch(0.155 0.006 285)';
+    const tinted = (pct, b = base) => (tintPct ? `color-mix(in oklab, ${accent} ${pct}%, ${b})` : b);
+    // Doubled :root raises specificity over VRCX's :root[data-theme=…] theme files.
+    return `:root:root, :root:root[data-theme='dark'], :root:root[data-theme='light'], html.dark, .dark {
+    --uwx-accent: ${accent};
+    --uwx-accent-soft: ${soft};
+    --uwx-accent-rgb: ${rgb.join(' ')};
+    --primary: ${accent};
+    --primary-foreground: ${fg};
+    --ring: ${accent};
+    --sidebar-primary: ${accent};
+    --sidebar-primary-foreground: ${fg};
+    --sidebar-ring: ${accent};
+    --chart-1: ${accent};
+}
+:root:root[data-theme='dark'], html.dark, .dark {
+    --background: ${tinted(tintPct * 0.6)};
+    --card: ${tinted(tintPct, 'oklch(0.19 0.008 285)')};
+    --popover: ${tinted(tintPct, 'oklch(0.18 0.008 285)')};
+    --sidebar: ${tinted(tintPct, 'oklch(0.172 0.008 285)')};
+}
+`;
+}
