@@ -0,0 +1,50 @@
+// UnderWeb hub world: ♥ likes from the Creator Room.
+//
+// When someone in your instance taps ♥ under a card, the hub world writes
+//   [VRCX] UWLike <their display name><TAB><card id><TAB><code>
+// to VRChat's log (for every like in the instance, not just yours). UWX passes name + card + code
+// to underweb.cloud, which checks the code (only the world can make it), so the creator sees the like.
+// Nothing else is sent: no instance, no world, nothing about you.
+
+export const LIKE_REPORT_URL = 'https://pxipclkptxpqukefwexh.supabase.co/functions/v1/hub-likes/report';
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+/** "UWLike Name With Spaces\t<uuid>\t123456-654321" -> { name, card, code }, or null if it isn't one. */
+export function parseLikeLine(data) {
+    const text = String(data ?? '');
+    if (!text.startsWith('UWLike ')) return null;
+    const parts = text.slice(7).replace(/[\r\n]+$/, '').split('\t');
+    if (parts.length !== 3) return null;
+    const [name, card, codeRaw] = parts;
+    const code = codeRaw.trim();
+    if (!name || name.length > 64) return null;
+    if (!UUID.test(card)) return null;
+    if (!/^\d{6}-\d{6}$/.test(code)) return null;
+    return { name, card: card.toLowerCase(), code };
+}
+
+/** One report per name + card per UWX session (the server ignores repeats anyway). */
+export function createLikeReporter({ fetchImpl = (...a) => fetch(...a), url = LIKE_REPORT_URL } = {}) {
+    const sent = new Set();
+    return async function report(data) {
+        const entry = parseLikeLine(data);
+        if (!entry) return false;
+        const key = entry.name + '\t' + entry.card;
+        if (sent.has(key)) return false;
+        sent.add(key);
+        try {
+            const res = await fetchImpl(url, {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify(entry)
+            });
+            return !!res?.ok;
+        } catch {
+            sent.delete(key); // offline: try again the next time the world logs it
+            return false;
+        }
+    };
+}
+
+export const reportHubLike = createLikeReporter();
