+import { describe, expect, test, vi } from 'vitest';
+
+import { createLikeReporter, parseLikeLine } from '../uwxLikes';
+
+const CARD = '582affa4-c6d4-4bcb-bdf3-a26bf40dcad7';
+
+describe('UWX hub likes', () => {
+    test('parses the world line, names with spaces and Cyrillic letters included', () => {
+        expect(parseLikeLine(`UWLike Dаrko\t${CARD}\t915006-329339`)).toEqual({ name: 'Dаrko', card: CARD, code: '915006-329339' });
+        expect(parseLikeLine(`UWLike Some Body\t${CARD.toUpperCase()}\t000001-999978\r\n`)).toEqual({ name: 'Some Body', card: CARD, code: '000001-999978' });
+    });
+
+    test('ignores anything else', () => {
+        expect(parseLikeLine('UWRoot Vex\t123456-654321')).toBeNull();
+        expect(parseLikeLine(`UWLike Vex\t${CARD}`)).toBeNull();
+        expect(parseLikeLine('UWLike Vex\tnot-a-card\t123456-654321')).toBeNull();
+        expect(parseLikeLine(`UWLike Vex\t${CARD}\tabc`)).toBeNull();
+        expect(parseLikeLine(`UWLike \t${CARD}\t123456-654321`)).toBeNull();
+        expect(parseLikeLine(`UWLike ${'x'.repeat(65)}\t${CARD}\t123456-654321`)).toBeNull();
+        expect(parseLikeLine(undefined)).toBeNull();
+    });
+
+    test('sends only name + card + code, once per name and card', async () => {
+        const fetchImpl = vi.fn(async () => ({ ok: true }));
+        const report = createLikeReporter({ fetchImpl, url: 'https://example.test/report' });
+        expect(await report(`UWLike Vex\t${CARD}\t123456-654321`)).toBe(true);
+        expect(await report(`UWLike Vex\t${CARD}\t123456-654321`)).toBe(false);
+        expect(fetchImpl).toHaveBeenCalledTimes(1);
+        const [url, init] = fetchImpl.mock.calls[0];
+        expect(url).toBe('https://example.test/report');
+        expect(JSON.parse(init.body)).toEqual({ name: 'Vex', card: CARD, code: '123456-654321' });
+    });
+
+    test('retries after a network failure', async () => {
+        const fetchImpl = vi.fn().mockRejectedValueOnce(new Error('offline')).mockResolvedValue({ ok: true });
+        const report = createLikeReporter({ fetchImpl });
+        expect(await report(`UWLike Vex\t${CARD}\t123456-654321`)).toBe(false);
+        expect(await report(`UWLike Vex\t${CARD}\t123456-654321`)).toBe(true);
+    });
+});
