+
+describe('UWX share → Discord opt-in', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        for (const k of Object.keys(config)) delete config[k];
+        account.signedIn = true;
+        account.storageUpload.mockClear();
+        account.storageRemove.mockClear();
+        account.api.mockReset();
+        account.api.mockImplementation(async () => null);
+        toast.success.mockClear();
+        toast.info.mockClear();
+    });
+
+    test('off by default: the row never asks for Discord', async () => {
+        const store = useUwxShareStore();
+        await store.init();
+        await store.selectLatest();
+        await store.post();
+        const row = JSON.parse(account.api.mock.calls[0][1].body);
+        expect('share_to_discord' in row).toBe(false);
+    });
+
+    test('ticked: the row asks for Discord after approval, and the choice is remembered', async () => {
+        const store = useUwxShareStore();
+        await store.init();
+        await store.setShareToDiscord(true);
+        await store.selectLatest();
+        await store.post();
+        expect(JSON.parse(account.api.mock.calls[0][1].body)).toMatchObject({ share_to_discord: true, moderation_status: 'pending' });
+        expect(toast.success.mock.calls.at(-1)[0]).toMatch(/UnderWeb Discord/);
+        expect(JSON.parse(config.UWX_share).shareToDiscord).toBe(true);
+    });
+
+    test('server not updated yet: still posts to the showcase and says Discord is not on', async () => {
+        account.api.mockImplementationOnce(async () => {
+            throw Object.assign(new Error("Could not find the 'share_to_discord' column of 'creator_showcase' in the schema cache"), { status: 400 });
+        });
+        const store = useUwxShareStore();
+        await store.init();
+        await store.setShareToDiscord(true);
+        await store.selectLatest();
+        expect(await store.post()).toBe(true);
+        expect(account.api).toHaveBeenCalledTimes(2);
+        expect('share_to_discord' in JSON.parse(account.api.mock.calls[1][1].body)).toBe(false);
+        expect(toast.info.mock.calls.at(-1)[0]).toMatch(/isn’t switched on/);
+        expect(account.storageRemove).not.toHaveBeenCalled();
+    });
+});
