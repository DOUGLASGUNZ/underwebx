+import { describe, expect, it } from 'vitest';
+import { channelReleases, compareUwxVersions, parseUwxVersion, pickUpdate, setupAsset } from '../uwxRelease';
+
+const HASH = 'a'.repeat(64);
+const asset = (over = {}) => ({
+    name: 'UnderWebX_20261015_Setup.exe',
+    state: 'uploaded',
+    size: 205880620,
+    digest: `sha256:${HASH}`,
+    browser_download_url: 'https://github.com/DOUGLASGUNZ/underwebx/releases/download/v0.5.4-rc13/UnderWebX_20261015_Setup.exe',
+    ...over
+});
+const release = (tag, over = {}) => ({
+    tag_name: tag,
+    name: `UnderWeb X ${tag}`,
+    draft: false,
+    prerelease: /-/.test(tag),
+    body: 'notes',
+    assets: [asset()],
+    ...over
+});
+
+describe('uwxRelease', () => {
+    it('parses tags, names and bare versions', () => {
+        expect(parseUwxVersion('v0.5.4-rc13')).toEqual({ major: 0, minor: 5, patch: 4, pre: ['rc', 13] });
+        expect(parseUwxVersion('UnderWeb X v0.5.0')).toEqual({ major: 0, minor: 5, patch: 0, pre: [] });
+        expect(parseUwxVersion('VRCX 2026.09.16')).toEqual({ major: 2026, minor: 9, patch: 16, pre: [] });
+        expect(parseUwxVersion('nonsense')).toBeNull();
+    });
+
+    it('orders versions like semver, with rc9 < rc10 and rc < final', () => {
+        expect(compareUwxVersions('0.5.2-rc9', '0.5.2-rc10')).toBe(-1);
+        expect(compareUwxVersions('0.5.3-rc12', '0.5.2-rc11')).toBe(1);
+        expect(compareUwxVersions('0.5.4', '0.5.4-rc13')).toBe(1);
+        expect(compareUwxVersions('0.5.0', '0.5.3-rc12')).toBe(-1);
+        expect(compareUwxVersions('v0.5.3-rc12', '0.5.3-rc12')).toBe(0);
+    });
+
+    it('only accepts the UWX installer from this repo with a sha256 digest', () => {
+        expect(setupAsset(release('v0.5.4-rc13'))).toMatchObject({ hashString: HASH, size: 205880620 });
+        expect(setupAsset({ assets: [asset({ digest: '' })] })).toBeNull();
+        expect(setupAsset({ assets: [asset({ name: 'VRCX_Setup.exe' })] })).toBeNull();
+        expect(setupAsset({ assets: [asset({ browser_download_url: 'https://github.com/vrcx-team/VRCX/releases/download/x/UnderWebX_1_Setup.exe' })] })).toBeNull();
+        expect(setupAsset({ assets: [asset({ browser_download_url: 'http://github.com/DOUGLASGUNZ/underwebx/releases/download/x/UnderWebX_1_Setup.exe' })] })).toBeNull();
+        expect(setupAsset({ assets: [asset({ name: 'UnderWebX_20261015.zip' })] })).toBeNull();
+        expect(setupAsset({ assets: [asset({ state: 'starter' })] })).toBeNull();
+    });
+
+    it('Stable ignores pre-releases; Beta includes them; drafts never count', () => {
+        const list = [release('v0.5.4-rc13'), release('v0.5.0'), release('v0.6.0', { draft: true })];
+        expect(channelReleases(list, 'Stable').map((r) => r.tag_name)).toEqual(['v0.5.0']);
+        expect(channelReleases(list, 'Beta').map((r) => r.tag_name)).toEqual(['v0.5.4-rc13', 'v0.5.0']);
+    });
+
+    it('sorts by version, not by publish order', () => {
+        const list = [release('v0.5.2-rc11'), release('v0.5.4-rc13'), release('v0.5.3-rc12')];
+        expect(channelReleases(list, 'Beta')[0].tag_name).toBe('v0.5.4-rc13');
+    });
+
+    it('offers an update only when the channel has something newer than what is installed', () => {
+        const list = [release('v0.5.4-rc13'), release('v0.5.0')];
+        expect(pickUpdate(list, 'Beta', '0.5.3-rc12')).toMatchObject({ isNewer: true });
+        expect(pickUpdate(list, 'Beta', '0.5.4-rc13')).toMatchObject({ isNewer: false });
+        // Stable user on an rc build is never "updated" backwards to an older stable.
+        expect(pickUpdate(list, 'Stable', '0.5.3-rc12')).toMatchObject({ isNewer: false });
+        expect(pickUpdate([], 'Stable', '0.5.0')).toEqual({ release: null, isNewer: false });
+    });
+
+    it('never treats a stock VRCX release as an update', () => {
+        const vrcx = {
+            tag_name: 'v2026.10.20',
+            name: 'VRCX 2026.10.20',
+            draft: false,
+            prerelease: false,
+            assets: [asset({ name: 'VRCX_20261020_Setup.exe', browser_download_url: 'https://github.com/vrcx-team/VRCX/releases/download/v2026.10.20/VRCX_20261020_Setup.exe' })]
+        };
+        expect(pickUpdate([vrcx], 'Stable', '0.5.3-rc12')).toEqual({ release: null, isNewer: false });
+    });
+});
diff --git a/src/shared/utils/uwxRelease.js b/src/shared/utils/uwxRelease.js
new file mode 100644
index 0000000..8fa9c33
--- /dev/null
+++ b/src/shared/utils/uwxRelease.js
@@ -0,0 +1,96 @@
+// UWX updates come from UnderWeb X's own GitHub releases — never from VRCX's update server,
+// which would offer stock VRCX and replace UWX.
+//   Stable channel: normal releases only.  Beta channel: also pre-releases (rc builds).
+// Release data is untrusted input: only an UnderWebX_*_Setup.exe asset hosted on
+// github.com with a SHA-256 digest is ever downloaded, and the hash is checked before install.
+
+export const UWX_RELEASES_URL = 'https://api.github.com/repos/DOUGLASGUNZ/underwebx/releases?per_page=30';
+export const UWX_RELEASES_PAGE = 'https://github.com/DOUGLASGUNZ/underwebx/releases';
+export const UWX_CHANNELS = Object.freeze(['Stable', 'Beta']);
+
+const SETUP_NAME = /^UnderWebX_[\w.-]*_Setup\.exe$/i;
+const DOWNLOAD_ORIGIN = /^https:\/\/github\.com\/DOUGLASGUNZ\/underwebx\/releases\/download\//i;
+
+/**
+ * "v0.5.4-rc13", "UnderWeb X v0.5.4-rc13", "0.5.2-rc11" -> { major, minor, patch, pre }
+ * @returns {{ major: number, minor: number, patch: number, pre: (string|number)[] } | null}
+ */
+export function parseUwxVersion(value) {
+    const match = String(value || '').match(/(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?/);
+    if (!match) return null;
+    const pre = match[4]
+        ? match[4].split(/[.-]/).flatMap((part) => {
+              // "rc13" -> ["rc", 13] so rc9 < rc10
+              const m = part.match(/^([A-Za-z]+)(\d+)$/);
+              if (m) return [m[1].toLowerCase(), Number(m[2])];
+              return [/^\d+$/.test(part) ? Number(part) : part.toLowerCase()];
+          })
+        : [];
+    return { major: Number(match[1]), minor: Number(match[2]), patch: Number(match[3]), pre };
+}
+
+/** Semver-style compare. A release without a pre-release tag is newer than its rc builds. */
+export function compareUwxVersions(a, b) {
+    const A = typeof a === 'string' ? parseUwxVersion(a) : a;
+    const B = typeof b === 'string' ? parseUwxVersion(b) : b;
+    if (!A && !B) return 0;
+    if (!A) return -1;
+    if (!B) return 1;
+    for (const key of ['major', 'minor', 'patch']) {
+        if (A[key] !== B[key]) return A[key] > B[key] ? 1 : -1;
+    }
+    if (!A.pre.length && !B.pre.length) return 0;
+    if (!A.pre.length) return 1;
+    if (!B.pre.length) return -1;
+    const len = Math.max(A.pre.length, B.pre.length);
+    for (let i = 0; i < len; i++) {
+        const x = A.pre[i];
+        const y = B.pre[i];
+        if (x === undefined) return -1;
+        if (y === undefined) return 1;
+        if (x === y) continue;
+        if (typeof x === 'number' && typeof y === 'number') return x > y ? 1 : -1;
+        if (typeof x === 'number') return -1;
+        if (typeof y === 'number') return 1;
+        return x > y ? 1 : -1;
+    }
+    return 0;
+}
+
+/** The installer asset of a release, or null if it isn't safe to download. */
+export function setupAsset(release) {
+    for (const asset of release?.assets || []) {
+        if (asset?.state && asset.state !== 'uploaded') continue;
+        if (!SETUP_NAME.test(String(asset?.name || ''))) continue;
+        const url = String(asset?.browser_download_url || '');
+        if (!DOWNLOAD_ORIGIN.test(url)) continue;
+        const digest = String(asset?.digest || '');
+        if (!/^sha256:[0-9a-f]{64}$/i.test(digest)) continue;
+        const size = Number(asset?.size) || 0;
+        if (size <= 0) continue;
+        return { downloadUrl: url, hashString: digest.slice(7), size, name: asset.name };
+    }
+    return null;
+}
+
+export function releaseVersion(release) {
+    return parseUwxVersion(release?.tag_name) || parseUwxVersion(release?.name);
+}
+
+/** Releases usable on a channel, newest version first. */
+export function channelReleases(releases, channel = 'Stable') {
+    return (Array.isArray(releases) ? releases : [])
+        .filter((r) => r && !r.draft && (channel === 'Beta' || !r.prerelease))
+        .filter((r) => releaseVersion(r) && setupAsset(r))
+        .sort((a, b) => compareUwxVersions(releaseVersion(b), releaseVersion(a)));
+}
+
+/**
+ * Newest release on the channel and whether it's newer than what's installed.
+ * @returns {{ release: object|null, isNewer: boolean }}
+ */
+export function pickUpdate(releases, channel, installedVersion) {
+    const [release] = channelReleases(releases, channel);
+    if (!release) return { release: null, isNewer: false };
+    return { release, isNewer: compareUwxVersions(releaseVersion(release), installedVersion) > 0 };
+}
