@@ -0,0 +1,61 @@
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { reactive } from 'vue';
+
+const account = reactive({ signedIn: false, isStaff: false, canReviewSafety: false });
+const tools = reactive({ moderatableGroups: [], myGroups: [], loadingPermissions: false, loadAllPermissions: vi.fn() });
+const underweb = reactive({ recruitGroupId: '' });
+vi.mock('../uwxAccount', () => ({ useUwxAccountStore: () => account }));
+vi.mock('../uwxGroupTools', () => ({ useUwxGroupToolsStore: () => tools }));
+vi.mock('../underweb', () => ({ useUnderWebStore: () => underweb }));
+vi.mock('../../api', () => ({ queryRequest: {} }));
+vi.mock('../../services/watchState', () => ({ watchState: { isLoggedIn: true } }));
+vi.mock('../../shared/utils', async () => ({ ...(await vi.importActual('../../shared/utils/group')) }));
+
+const { useUwxAccessStore, accessLevel } = await import('../uwxAccess');
+const group = (id, permissions) => ({ id, permissionsLoaded: true, ref: { myMember: { permissions } } });
+
+describe('UWX access levels', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        Object.assign(account, { signedIn: false, isStaff: false, canReviewSafety: false });
+        tools.moderatableGroups = [];
+        tools.myGroups = [];
+        underweb.recruitGroupId = '';
+    });
+
+    test('member by default: no Groups tab, no group invites', () => {
+        const a = useUwxAccessStore();
+        expect(a.level).toBe('member');
+        expect(a.showGroupsTab).toBe(false);
+        expect(a.showGroupInvites).toBe(false);
+    });
+
+    test('group staff comes from VRChat group permissions, per group', () => {
+        tools.myGroups = [group('grp_uw', ['group-invites-manage']), group('grp_other', [])];
+        const a = useUwxAccessStore();
+        expect(a.level).toBe('group-staff');
+        expect(a.showGroupInvites).toBe(true);
+        underweb.recruitGroupId = 'grp_other';
+        expect(a.canGroupInviteHere).toBe(false);
+        underweb.recruitGroupId = 'grp_uw';
+        expect(a.canGroupInviteHere).toBe(true);
+    });
+
+    test('owners ("*") can invite; UnderWeb staff needs the server to confirm while signed in', () => {
+        tools.myGroups = [group('grp_uw', ['*'])];
+        tools.moderatableGroups = tools.myGroups;
+        const a = useUwxAccessStore();
+        expect(a.inviteGroupIds).toEqual(['grp_uw']);
+        account.isStaff = true; // stale flag without a session doesn't count
+        expect(a.level).toBe('group-staff');
+        account.signedIn = true;
+        expect(a.level).toBe('underweb-staff');
+        expect(a.label).toBe('UnderWeb staff');
+    });
+
+    test('accessLevel helper', () => {
+        expect(accessLevel({ underwebStaff: false, groupStaff: false })).toBe('member');
+        expect(accessLevel({ underwebStaff: true, groupStaff: false })).toBe('underweb-staff');
+    });
+});
