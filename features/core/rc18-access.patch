diff --git a/src/stores/uwxAccess.js b/src/stores/uwxAccess.js
new file mode 100644
index 0000000..7465d5a
--- /dev/null
+++ b/src/stores/uwxAccess.js
@@ -0,0 +1,79 @@
+import { computed, watch } from 'vue';
+import { defineStore } from 'pinia';
+
+import { hasGroupPermission } from '../shared/utils';
+import { watchState } from '../services/watchState';
+import { useUnderWebStore } from './underweb';
+import { useUwxAccountStore } from './uwxAccount';
+import { useUwxGroupToolsStore } from './uwxGroupTools';
+
+// Who's using UWX, decided only from what the servers say:
+//   member         — default
+//   group staff    — your VRChat role in a group can moderate or invite (VRChat group permissions)
+//   UnderWeb staff — signed in to UnderWeb and the server confirms staff
+// This only decides what UWX shows. The actions themselves are still enforced by VRChat
+// and the UnderWeb server, so a modified client gains nothing.
+
+export function accessLevel({ underwebStaff, groupStaff }) {
+    if (underwebStaff) return 'underweb-staff';
+    if (groupStaff) return 'group-staff';
+    return 'member';
+}
+
+export const ACCESS_LABELS = Object.freeze({
+    member: 'Member',
+    'group-staff': 'Group staff',
+    'underweb-staff': 'UnderWeb staff'
+});
+
+export const useUwxAccessStore = defineStore('UwxAccess', () => {
+    const account = useUwxAccountStore();
+    const tools = useUwxGroupToolsStore();
+    const underweb = useUnderWebStore();
+
+    /** Groups where your VRChat role can moderate anything. */
+    const moderatedGroups = computed(() => tools.moderatableGroups);
+    /** Groups where your VRChat role can send group invites. */
+    const inviteGroupIds = computed(() =>
+        tools.myGroups.filter((g) => g.permissionsLoaded && hasGroupPermission(g.ref, 'group-invites-manage')).map((g) => g.id)
+    );
+
+    const underwebStaff = computed(() => Boolean(account.signedIn && (account.isStaff || account.canReviewSafety)));
+    const groupStaff = computed(() => moderatedGroups.value.length > 0 || inviteGroupIds.value.length > 0);
+    const level = computed(() => accessLevel({ underwebStaff: underwebStaff.value, groupStaff: groupStaff.value }));
+    const label = computed(() => ACCESS_LABELS[level.value]);
+
+    /** Can you send group invites to the group that applies where you are? */
+    const canGroupInviteHere = computed(() => Boolean(underweb.recruitGroupId && inviteGroupIds.value.includes(underweb.recruitGroupId)));
+    /** Show group-invite tools at all (you can invite for at least one group). */
+    const showGroupInvites = computed(() => inviteGroupIds.value.length > 0);
+    const showGroupsTab = computed(() => moderatedGroups.value.length > 0);
+    const checking = computed(() => tools.loadingPermissions);
+
+    let started = false;
+    function init() {
+        if (started) return;
+        started = true;
+        // Learn your group roles once you're logged in (gentle, cached for 10 minutes).
+        watch(
+            () => [watchState.isLoggedIn, tools.myGroups.length],
+            ([loggedIn, count]) => {
+                if (loggedIn && count) void tools.loadAllPermissions();
+            },
+            { immediate: true }
+        );
+    }
+
+    return {
+        level,
+        label,
+        underwebStaff,
+        groupStaff,
+        inviteGroupIds,
+        canGroupInviteHere,
+        showGroupInvites,
+        showGroupsTab,
+        checking,
+        init
+    };
+});
