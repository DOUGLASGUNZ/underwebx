+                    <div v-for="entry in moderationLog.slice(0, 60)" :key="entry.id" class="uwx-log-row">
+                        <span class="uwx-log-time">{{ formatWhen(entry.at) }}</span>
+                        <Badge :variant="entry.result === 'ok' ? 'outline' : 'destructive'">{{ entry.action }}</Badge>
+                        <span class="min-w-0 break-words">
+                            {{ entry.displayName }} · {{ entry.groupName }}
+                            <template v-if="entry.result !== 'ok'"> — {{ entry.error }}</template>
+                        </span>
+                    </div>
