+                                v-if="member.membershipStatus !== 'member' && can(selectedGroup.id, 'ban')"
+                                size="sm"
+                                variant="outline"
+                                :disabled="!!busyAction"
+                                @click="act('unban', member)">Unban</Button>
+                        </div>
+                    </div>
