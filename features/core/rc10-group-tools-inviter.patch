+                        <CardDescription>
+                            Actions taken from this PC. VRChat's own audit log (all staff) is under Full moderation.
+                        </CardDescription>
+                    </div>
+                    <Button size="sm" variant="ghost" :disabled="!moderationLog.length" @click="clearLog">Clear</Button>
