+
+        <Card v-if="selectedGroup" class="uwx-card uwx-card-wide">
+            <CardHeader>
+                <div class="flex items-start justify-between gap-4">
+                    <div>
+                        <CardTitle>{{ selectedGroup.name }}</CardTitle>
+                        <CardDescription>Look up a member by name, or anyone by their usr_ ID.</CardDescription>
+                    </div>
+                    <Button size="sm" variant="outline" @click="openFullModeration(selectedGroup.id)">
+                        <i class="ri-shield-user-line" />
+                        Full moderation (bans, invites, audit log)
+                    </Button>
+                </div>
+            </CardHeader>
+            <CardContent class="space-y-4">
+                <form class="flex gap-2" @submit.prevent="runLookup">
+                    <Input v-model="lookupQuery" placeholder="Display name or usr_xxxxxxxx-…" aria-label="Member name or VRChat user ID" />
+                    <Button type="submit" :disabled="lookingUp">
+                        <i :class="lookingUp ? 'ri-loader-4-line animate-spin' : 'ri-search-line'" />
