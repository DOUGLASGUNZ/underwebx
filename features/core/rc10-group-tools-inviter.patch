+
+<script setup>
+    import { computed, onMounted, ref, watch } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { Badge } from '@/components/ui/badge';
+    import { Button } from '@/components/ui/button';
+    import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+    import { Input } from '@/components/ui/input';
+
+    import { useUwxGroupToolsStore } from '../../stores/uwxGroupTools';
+
+    const store = useUwxGroupToolsStore();
+    const { loadingPermissions, moderationLog, busyAction, myGroups, moderatableGroups, currentInstanceGroupId, instanceOccupants } =
+        storeToRefs(store);
+    const { can, clearLog, lookupMember, moderate, openFullModeration, loadAllPermissions } = store;
+
+    const selectedGroupId = ref('');
+    const lookupQuery = ref('');
+    const lookupResults = ref([]);
+    const lookupNote = ref('');
+    const lookingUp = ref(false);
+
+    const selectedGroup = computed(() => moderatableGroups.value.find((group) => group.id === selectedGroupId.value) || null);
+
+    function selectGroup(groupId) {
+        if (selectedGroupId.value === groupId) return;
+        selectedGroupId.value = groupId;
+        lookupResults.value = [];
+        lookupNote.value = '';
+    }
+
+    async function refresh(force = false) {
+        await loadAllPermissions({ force });
+        if (!selectedGroupId.value) {
+            const inInstance = moderatableGroups.value.find((group) => group.id === currentInstanceGroupId.value);
+            selectedGroupId.value = (inInstance || moderatableGroups.value[0])?.id || '';
+        }
+    }
+
+    async function runLookup() {
+        if (!selectedGroup.value) return;
+        lookingUp.value = true;
+        try {
+            const { results, note } = await lookupMember(selectedGroup.value.id, lookupQuery.value);
+            lookupResults.value = results;
+            lookupNote.value = note;
+        } finally {
+            lookingUp.value = false;
+        }
+    }
+
+    function lookupPlayer(player) {
+        lookupQuery.value = player.userId;
+        void runLookup();
+    }
+
+    async function act(action, member) {
+        if (!selectedGroup.value) return;
+        const ok = await moderate(action, {
+            groupId: selectedGroup.value.id,
+            groupName: selectedGroup.value.name,
+            userId: member.userId,
+            displayName: member.displayName
+        });
+        if (ok && lookupResults.value.some((m) => m.userId === member.userId)) {
+            const next = action === 'ban' ? 'banned' : action === 'kick' ? 'not a member' : 'not a member';
+            lookupResults.value = lookupResults.value.map((m) => (m.userId === member.userId ? { ...m, membershipStatus: next } : m));
+        }
+    }
+
+    function formatWhen(at) {
+        const date = new Date(Number(at) || Date.now());
+        return date.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
+    }
+
+    onMounted(async () => {
+        await store.init();
+        await refresh(false);
+    });
+
+    // Groups load after VRChat login; pick them up when they arrive.
+    watch(
+        () => myGroups.value.length,
+        (count, previous) => {
+            if (count && count !== previous) void refresh(false);
+        }
+    );
+</script>
