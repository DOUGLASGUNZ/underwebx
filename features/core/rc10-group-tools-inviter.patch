+            </CardHeader>
+            <CardContent>
+                <p v-if="!myGroups.length" class="text-sm text-muted-foreground">
+                    You're not in any VRChat groups yet, or your group list hasn't loaded.
+                </p>
+                <p v-else-if="loadingPermissions && !moderatableGroups.length" class="text-sm text-muted-foreground">
+                    Checking your role in {{ myGroups.length }} group{{ myGroups.length === 1 ? '' : 's' }}…
+                </p>
+                <p v-else-if="!moderatableGroups.length" class="text-sm text-muted-foreground">
+                    None of your groups give your role moderation permissions.
+                </p>
+                <div v-else class="uwx-group-tool-list">
+                    <button
+                        v-for="group in moderatableGroups"
+                        :key="group.id"
+                        type="button"
+                        class="uwx-group-tool-row"
+                        :class="{ active: selectedGroupId === group.id }"
+                        @click="selectGroup(group.id)">
+                        <img v-if="group.iconUrl" :src="group.iconUrl" alt="" class="uwx-group-icon" />
+                        <span v-else class="uwx-group-icon uwx-group-icon-empty"><i class="ri-group-line" /></span>
+                        <span class="min-w-0 flex-1 text-left">
+                            <strong class="block truncate">{{ group.name }}</strong>
+                            <small class="text-muted-foreground">
+                                {{ group.memberCount != null ? group.memberCount + ' members' : group.id }}
+                                <template v-if="currentInstanceGroupId === group.id"> · you're in its instance</template>
+                            </small>
+                        </span>
+                        <span class="flex flex-wrap gap-1 justify-end">
+                            <Badge v-if="can(group.id, 'kick')" variant="outline">REMOVE</Badge>
+                            <Badge v-if="can(group.id, 'ban')" variant="outline">BAN</Badge>
