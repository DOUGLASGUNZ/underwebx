+                                    size="sm"
+                                    variant="destructive"
+                                    :disabled="!!busyAction"
+                                    @click="act('ban', { userId: player.userId, displayName: player.displayName })">Ban</Button>
+                            </div>
+                        </div>
+                    </div>
+                    <p class="uwx-help mt-2">
+                        Banning removes them from the group. UWX doesn't kick people out of an instance — use VRChat's
+                        in-game group instance moderation for that.
+                    </p>
+                </div>
