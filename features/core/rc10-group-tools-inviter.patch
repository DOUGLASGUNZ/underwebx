@@ -0,0 +1,132 @@
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { reactive } from 'vue';
+
+const groupRequest = {
+    getGroup: vi.fn(),
+    getGroupMember: vi.fn(),
+    getGroupMembersSearch: vi.fn(),
+    kickGroupMember: vi.fn(),
+    banGroupMember: vi.fn(),
+    unbanGroupMember: vi.fn()
+};
+vi.mock('../../api', () => ({ groupRequest }));
+
+const configStore = {};
+vi.mock('../../services/config', () => ({
+    default: {
+        getArray: vi.fn(async (key, d) => configStore[key] ?? d),
+        setArray: vi.fn(async (key, value) => {
+            configStore[key] = value;
+        })
+    }
+}));
+vi.mock('../../services/watchState', () => ({ watchState: { isLoggedIn: true } }));
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn(), info: vi.fn() } }));
+vi.mock('../../shared/utils', async () => ({
+    ...(await vi.importActual('../../shared/utils/group')),
+    ...(await vi.importActual('../../shared/utils/location'))
+}));
+vi.mock('../../coordinators/groupCoordinator', () => ({ showGroupMemberModerationDialog: vi.fn() }));
+
+const groupStore = { currentUserGroups: reactive(new Map()) };
+vi.mock('../group', () => ({ useGroupStore: () => groupStore }));
+const locationStore = reactive({ lastLocation: { location: '', playerList: new Map() } });
+vi.mock('../location', () => ({ useLocationStore: () => locationStore }));
+const modalStore = { confirm: vi.fn() };
+vi.mock('../modal', () => ({ useModalStore: () => modalStore }));
+
+const { useUwxGroupToolsStore } = await import('../uwxGroupTools');
+
+const GROUP = 'grp_11111111-1111-1111-1111-111111111111';
+const USER = 'usr_22222222-2222-2222-2222-222222222222';
+
+function groupWithPerms(permissions) {
+    return { id: GROUP, name: 'The UnderWeb', myMember: { permissions } };
+}
+
+describe('uwxGroupTools', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        Object.values(groupRequest).forEach((fn) => fn.mockReset());
+        modalStore.confirm.mockReset();
+        for (const key of Object.keys(configStore)) delete configStore[key];
+        groupStore.currentUserGroups.clear();
+        groupStore.currentUserGroups.set(GROUP, { id: GROUP, name: 'The UnderWeb' });
+    });
+
+    test('only lists groups where VRChat says the role can moderate', async () => {
+        groupRequest.getGroup.mockResolvedValue({ ref: groupWithPerms(['group-bans-manage']) });
+        const store = useUwxGroupToolsStore();
+        await store.loadAllPermissions();
+        expect(store.moderatableGroups.map((g) => g.id)).toEqual([GROUP]);
+        expect(store.can(GROUP, 'ban')).toBe(true);
+        expect(store.can(GROUP, 'kick')).toBe(false);
+
+        groupRequest.getGroup.mockResolvedValue({ ref: groupWithPerms([]) });
+        await store.loadAllPermissions({ force: true });
+        expect(store.moderatableGroups).toEqual([]);
+    });
+
+    test('refuses an action the role lacks, without calling VRChat or prompting', async () => {
+        groupRequest.getGroup.mockResolvedValue({ ref: groupWithPerms(['group-bans-manage']) });
+        const store = useUwxGroupToolsStore();
+        await store.loadAllPermissions();
+        const ok = await store.moderate('kick', { groupId: GROUP, groupName: 'The UnderWeb', userId: USER });
+        expect(ok).toBe(false);
+        expect(modalStore.confirm).not.toHaveBeenCalled();
+        expect(groupRequest.kickGroupMember).not.toHaveBeenCalled();
+    });
+
+    test('cancelling the confirmation sends nothing', async () => {
+        groupRequest.getGroup.mockResolvedValue({ ref: groupWithPerms(['*']) });
+        modalStore.confirm.mockResolvedValue({ ok: false });
+        const store = useUwxGroupToolsStore();
+        await store.loadAllPermissions();
+        expect(await store.moderate('ban', { groupId: GROUP, groupName: 'The UnderWeb', userId: USER })).toBe(false);
+        expect(groupRequest.banGroupMember).not.toHaveBeenCalled();
+        expect(store.moderationLog).toEqual([]);
+    });
+
+    test('a confirmed ban calls VRChat once and is logged persistently', async () => {
+        groupRequest.getGroup.mockResolvedValue({ ref: groupWithPerms(['group-bans-manage']) });
+        groupRequest.banGroupMember.mockResolvedValue({ json: {} });
+        modalStore.confirm.mockResolvedValue({ ok: true });
+        const store = useUwxGroupToolsStore();
+        await store.init();
+        await store.loadAllPermissions();
+        const ok = await store.moderate('ban', { groupId: GROUP, groupName: 'The UnderWeb', userId: USER, displayName: 'Troll' });
+        expect(ok).toBe(true);
+        expect(groupRequest.banGroupMember).toHaveBeenCalledWith({ groupId: GROUP, userId: USER });
+        expect(store.moderationLog[0]).toMatchObject({ action: 'ban', result: 'ok', userId: USER });
+        expect(configStore.UWX_groupModerationLog).toHaveLength(1);
+    });
+
+    test('a VRChat 403 is reported and logged as failed', async () => {
+        groupRequest.getGroup.mockResolvedValue({ ref: groupWithPerms(['group-members-remove']) });
+        groupRequest.kickGroupMember.mockRejectedValue({ status: 403 });
+        modalStore.confirm.mockResolvedValue({ ok: true });
+        const store = useUwxGroupToolsStore();
+        await store.loadAllPermissions();
+        expect(await store.moderate('kick', { groupId: GROUP, groupName: 'The UnderWeb', userId: USER })).toBe(false);
+        expect(store.moderationLog[0]).toMatchObject({ action: 'kick', result: 'failed' });
+        expect(store.moderationLog[0].error).toMatch(/permission/);
+    });
+
+    test('lookup by usr_ ID treats 404 as not a member, so they can still be banned', async () => {
+        groupRequest.getGroupMember.mockRejectedValue({ status: 404 });
+        const store = useUwxGroupToolsStore();
+        const { results } = await store.lookupMember(GROUP, USER);
+        expect(results).toEqual([expect.objectContaining({ userId: USER, membershipStatus: 'not a member' })]);
+    });
+
+    test('lookup by name uses member search', async () => {
+        groupRequest.getGroupMembersSearch.mockResolvedValue({
+            json: { results: [{ userId: USER, user: { displayName: 'Darko' }, membershipStatus: 'member', roleIds: ['grol_x'] }] }
+        });
+        const store = useUwxGroupToolsStore();
+        const { results } = await store.lookupMember(GROUP, 'dar');
+        expect(groupRequest.getGroupMembersSearch).toHaveBeenCalledWith({ groupId: GROUP, query: 'dar', n: 25, offset: 0 });
+        expect(results[0]).toMatchObject({ displayName: 'Darko', membershipStatus: 'member' });
+    });
+});
