diff --git a/src/stores/uwxGroupTools.js b/src/stores/uwxGroupTools.js
new file mode 100644
index 0000000..a404557
--- /dev/null
+++ b/src/stores/uwxGroupTools.js
@@ -0,0 +1,279 @@
+import { computed, reactive, ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import { groupRequest } from '../api';
+import configRepository from '../services/config';
+import { hasGroupModerationPermission, hasGroupPermission, parseLocation } from '../shared/utils';
+import { watchState } from '../services/watchState';
+import { showGroupMemberModerationDialog } from '../coordinators/groupCoordinator';
+import { useGroupStore } from './group';
+import { useLocationStore } from './location';
+import { useModalStore } from './modal';
+
+// UWX Group Tools: a dashboard over VRChat's real group moderation API.
+// Every action here maps to a VRChat endpoint VRCX already uses:
+//   kick   -> DELETE /groups/{groupId}/members/{userId}   (needs group-members-remove)
+//   ban    -> POST   /groups/{groupId}/bans               (needs group-bans-manage)
+//   unban  -> DELETE /groups/{groupId}/bans/{userId}      (needs group-bans-manage)
+// VRChat enforces these permissions server-side; UWX only hides buttons you can't use.
+
+const CONFIG = Object.freeze({
+    log: 'UWX_groupModerationLog'
+});
+const MAX_LOG = 300;
+const PERMISSION_TTL_MS = 10 * 60 * 1000;
+const PERMISSION_FETCH_GAP_MS = 400;
+
+export const GROUP_PERMS = Object.freeze({
+    kick: 'group-members-remove',
+    ban: 'group-bans-manage',
+    audit: 'group-audit-view',
+    invite: 'group-invites-manage'
+});
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+const errorStatus = (error) => error?.status || error?.statusCode || error?.response?.status || 0;
+const errorMessage = (error) => error?.error?.message || error?.message || 'Unknown error';
+
+export const useUwxGroupToolsStore = defineStore('UwxGroupTools', () => {
+    const groupStore = useGroupStore();
+    const locationStore = useLocationStore();
+    const modalStore = useModalStore();
+
+    /** groupId -> { ref, loadedAt, error } */
+    const groupInfo = reactive(new Map());
+    const loadingPermissions = ref(false);
+    const moderationLog = ref([]);
+    const initialized = ref(false);
+    const busyAction = ref('');
+
+    const myGroups = computed(() =>
+        Array.from(groupStore.currentUserGroups.values())
+            .filter((group) => group && String(group.id || '').startsWith('grp_'))
+            .map((group) => {
+                const info = groupInfo.get(group.id);
+                const ref = info?.ref || group;
+                return {
+                    id: group.id,
+                    name: ref.name || group.name || group.id,
+                    iconUrl: ref.iconUrl || group.iconUrl || '',
+                    memberCount: ref.memberCount ?? group.memberCount ?? null,
+                    ref,
+                    permissionsLoaded: Boolean(info?.ref?.myMember),
+                    error: info?.error || ''
+                };
+            })
+            .sort((a, b) => a.name.localeCompare(b.name))
+    );
+
+    const moderatableGroups = computed(() =>
+        myGroups.value.filter((group) => group.permissionsLoaded && hasGroupModerationPermission(group.ref))
+    );
+
+    function can(groupId, action) {
+        const ref = groupInfo.get(groupId)?.ref;
+        return Boolean(ref && hasGroupPermission(ref, GROUP_PERMS[action]));
+    }
+
+    async function init() {
+        if (initialized.value) return;
+        const stored = await configRepository.getArray(CONFIG.log, []);
+        moderationLog.value = Array.isArray(stored) ? stored.slice(0, MAX_LOG) : [];
+        initialized.value = true;
+    }
+
+    async function addLog(entry) {
+        moderationLog.value = [{ id: `${Date.now()}-${Math.random().toString(16).slice(2)}`, at: Date.now(), ...entry }, ...moderationLog.value].slice(0, MAX_LOG);
+        await configRepository.setArray(CONFIG.log, moderationLog.value);
+    }
+
+    async function clearLog() {
+        moderationLog.value = [];
+        await configRepository.setArray(CONFIG.log, []);
+    }
+
+    async function loadGroupPermissions(groupId, { force = false } = {}) {
+        const existing = groupInfo.get(groupId);
+        if (!force && existing?.ref?.myMember && Date.now() - existing.loadedAt < PERMISSION_TTL_MS) {
+            return existing.ref;
+        }
+        try {
+            const args = await groupRequest.getGroup({ groupId, includeRoles: true });
+            groupInfo.set(groupId, { ref: args.ref, loadedAt: Date.now(), error: '' });
+            return args.ref;
+        } catch (error) {
+            groupInfo.set(groupId, { ref: existing?.ref || null, loadedAt: Date.now(), error: errorMessage(error) });
+            if (errorStatus(error) === 429) throw error;
+            return null;
+        }
+    }
+
+    /** Fetch permissions for every group you're in, gently (one request at a time). */
+    async function loadAllPermissions({ force = false } = {}) {
+        if (loadingPermissions.value || !watchState.isLoggedIn) return;
+        loadingPermissions.value = true;
+        try {
+            for (const group of myGroups.value) {
+                const info = groupInfo.get(group.id);
+                if (!force && info?.ref?.myMember && Date.now() - info.loadedAt < PERMISSION_TTL_MS) continue;
+                try {
+                    await loadGroupPermissions(group.id, { force });
+                } catch (error) {
+                    if (errorStatus(error) === 429) {
+                        toast.error('VRChat rate limit while loading groups. Try again in a minute.');
+                        break;
+                    }
+                }
+                await sleep(PERMISSION_FETCH_GAP_MS);
+            }
+        } finally {
+            loadingPermissions.value = false;
+        }
+    }
+
+    function normalizeMember(json, fallbackUserId = '') {
+        if (!json) return null;
+        return {
+            userId: json.userId || json.user?.id || fallbackUserId,
+            displayName: json.user?.displayName || json.userId || fallbackUserId,
+            membershipStatus: json.membershipStatus || 'member',
+            roleIds: Array.isArray(json.roleIds) ? json.roleIds : [],
+            joinedAt: json.joinedAt || json.createdAt || null,
+            isRepresenting: Boolean(json.isRepresenting)
+        };
+    }
+
+    /**
+     * Look up someone in a group by VRChat user ID (usr_…) or by name.
+     * @returns {Promise<{ results: object[], note: string }>}
+     */
+    async function lookupMember(groupId, rawQuery) {
+        const query = String(rawQuery || '').trim();
+        if (!groupId || !query) return { results: [], note: 'Pick a group and type a name or usr_ ID.' };
+        const idMatch = query.match(/usr_[0-9a-f-]{36}/i);
+        if (idMatch) {
+            const userId = idMatch[0];
+            try {
+                const args = await groupRequest.getGroupMember({ groupId, userId });
+                const member = normalizeMember(args?.json, userId);
+                if (!member) {
+                    return { results: [{ userId, displayName: userId, membershipStatus: 'not a member', roleIds: [] }], note: '' };
+                }
+                return { results: [member], note: '' };
+            } catch (error) {
+                if (errorStatus(error) === 404) {
+                    return { results: [{ userId, displayName: userId, membershipStatus: 'not a member', roleIds: [] }], note: '' };
+                }
+                return { results: [], note: `Lookup failed: ${errorMessage(error)}` };
+            }
+        }
+        if (query.length < 2) return { results: [], note: 'Type at least 2 characters.' };
+        try {
+            const args = await groupRequest.getGroupMembersSearch({ groupId, query, n: 25, offset: 0 });
+            const results = (args?.json?.results || []).map((json) => normalizeMember(json)).filter(Boolean);
+            return { results, note: results.length ? '' : 'No members match that name. Search by usr_ ID to act on non-members.' };
+        } catch (error) {
+            return { results: [], note: `Search failed: ${errorMessage(error)}` };
+        }
+    }
+
+    const ACTIONS = {
+        kick: {
+            perm: 'kick',
+            title: 'Remove from group',
+            verb: 'removed from',
+            run: (groupId, userId) => groupRequest.kickGroupMember({ groupId, userId })
+        },
+        ban: {
+            perm: 'ban',
+            title: 'Ban from group',
+            verb: 'banned from',
+            run: (groupId, userId) => groupRequest.banGroupMember({ groupId, userId })
+        },
+        unban: {
+            perm: 'ban',
+            title: 'Unban',
+            verb: 'unbanned from',
+            run: (groupId, userId) => groupRequest.unbanGroupMember({ groupId, userId })
+        }
+    };
+
+    /**
+     * Run a moderation action after a confirmation prompt. Returns true if VRChat accepted it.
+     */
+    async function moderate(action, { groupId, groupName, userId, displayName }) {
+        const spec = ACTIONS[action];
+        if (!spec) return false;
+        if (!can(groupId, spec.perm)) {
+            toast.error(`Your role in ${groupName} doesn't have permission to ${action}.`);
+            return false;
+        }
+        const label = displayName || userId;
+        const { ok } = await modalStore.confirm({
+            title: `${spec.title}?`,
+            description: `${label} will be ${spec.verb} ${groupName}. This runs on VRChat immediately.`,
+            confirmText: spec.title,
+            destructive: action !== 'unban'
+        });
+        if (!ok) return false;
+        busyAction.value = `${action}:${userId}`;
+        try {
+            await spec.run(groupId, userId);
+            await addLog({ action, groupId, groupName, userId, displayName: label, result: 'ok' });
+            toast.success(`${label} ${spec.verb} ${groupName}.`);
+            return true;
+        } catch (error) {
+            const status = errorStatus(error);
+            const message =
+                status === 403
+                    ? 'VRChat refused: your group role lacks this permission, or the target outranks you.'
+                    : status === 404
+                      ? action === 'unban'
+                          ? 'That user is not banned from this group.'
+                          : 'That user is not a member of this group.'
+                      : status === 429
+                        ? 'VRChat rate limit — wait a minute and try again.'
+                        : errorMessage(error);
+            await addLog({ action, groupId, groupName, userId, displayName: label, result: 'failed', error: message });
+            toast.error(message);
+            return false;
+        } finally {
+            busyAction.value = '';
+        }
+    }
+
+    function openFullModeration(groupId, userId = '') {
+        showGroupMemberModerationDialog(groupId, userId);
+    }
+
+    const currentInstanceGroupId = computed(() => parseLocation(locationStore.lastLocation.location || '').groupId || '');
+
+    const instanceOccupants = computed(() =>
+        Array.from(locationStore.lastLocation.playerList?.values?.() || [])
+            .map((player) => ({
+                userId: String(player?.userId || ''),
+                displayName: player?.displayName || player?.userId || 'Unknown user'
+            }))
+            .filter((player) => player.userId.startsWith('usr_'))
+    );
+
+    return {
+        groupInfo,
+        loadingPermissions,
+        moderationLog,
+        busyAction,
+        myGroups,
+        moderatableGroups,
+        currentInstanceGroupId,
+        instanceOccupants,
+        init,
+        can,
+        clearLog,
+        loadGroupPermissions,
+        loadAllPermissions,
+        lookupMember,
+        moderate,
+        openFullModeration
+    };
+});
