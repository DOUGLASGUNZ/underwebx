@@ -0,0 +1,136 @@
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { reactive } from 'vue';
+
+const notificationRequest = { sendInvite: vi.fn() };
+vi.mock('../../api', () => ({
+    groupRequest: {},
+    notificationRequest,
+    queryRequest: { fetch: vi.fn().mockResolvedValue({ ref: { name: 'Test World' } }) }
+}));
+vi.mock('../../services/config', () => ({
+    default: {
+        getBool: vi.fn(async (_k, d) => d),
+        setBool: vi.fn(),
+        getArray: vi.fn(async (_k, d) => d),
+        setArray: vi.fn(),
+        getString: vi.fn(async (_k, d) => d),
+        setString: vi.fn(),
+        getInt: vi.fn(async (_k, d) => d),
+        setInt: vi.fn(),
+        getObject: vi.fn(async (_k, d) => d),
+        setObject: vi.fn()
+    }
+}));
+vi.mock('../../shared/utils', async () => ({
+    ...(await vi.importActual('../../shared/utils/invite')),
+    ...(await vi.importActual('../../shared/utils/location'))
+}));
+vi.mock('../../services/watchState', () => ({ watchState: { isLoggedIn: true } }));
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn(), info: vi.fn() } }));
+
+const ME = 'usr_00000000-0000-0000-0000-000000000000';
+const A = 'usr_aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa';
+const B = 'usr_bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb';
+const C = 'usr_cccccccc-cccc-cccc-cccc-cccccccccccc';
+
+const friendStore = reactive({ friends: new Map(), allFavoriteFriendIds: new Set(), allFavoriteOnlineFriends: [] });
+const locationStore = reactive({ lastLocation: { location: '', name: 'Test World', friendList: new Map(), playerList: new Map() } });
+const instanceStore = { cachedInstances: new Map() };
+const userStore = { currentUser: { id: ME } };
+const networkStore = {
+    staffUserIds: new Set(),
+    creatorUserIds: new Set(),
+    partnerUserIds: new Set(),
+    notificationRules: {},
+    initUnderWebNetwork: vi.fn()
+};
+vi.mock('../friend', () => ({ useFriendStore: () => friendStore }));
+vi.mock('../location', () => ({ useLocationStore: () => locationStore }));
+vi.mock('../instance', () => ({ useInstanceStore: () => instanceStore }));
+vi.mock('../user', () => ({ useUserStore: () => userStore }));
+vi.mock('../underwebNetwork', () => ({ useUnderWebNetworkStore: () => networkStore }));
+
+const { useUnderWebStore } = await import('../underweb');
+
+const WORLD = 'wrld_12345678-1234-1234-1234-123456789012';
+const at = (suffix) => `${WORLD}:12345${suffix}`;
+
+function friend(id, state = 'online', location = 'wrld_other:1') {
+    return { id, state, name: id.slice(4, 8), ref: { displayName: id.slice(4, 8), location } };
+}
+
+describe('UWX Instance Inviter — invite now', () => {
+    beforeEach(() => {
+        vi.useFakeTimers();
+        setActivePinia(createPinia());
+        notificationRequest.sendInvite.mockReset().mockResolvedValue({ json: {} });
+        friendStore.friends = new Map([[A, friend(A)], [B, friend(B)], [C, friend(C, 'offline')]]);
+        locationStore.lastLocation.friendList = new Map();
+    });
+
+    async function run(store, ids) {
+        const pending = store.inviteFriendsNow(ids);
+        await vi.runAllTimersAsync();
+        return pending;
+    }
+
+    test('works in a public (non-group) instance', async () => {
+        locationStore.lastLocation.location = at('~region(us)');
+        const store = useUnderWebStore();
+        expect(store.canInviteHere).toBe(true);
+        const result = await run(store, [A, B, C]);
+        expect(result.sent).toBe(2);
+        expect(result.skipped).toEqual([{ userId: C, reason: 'not in-game right now' }]);
+        expect(notificationRequest.sendInvite).toHaveBeenCalledTimes(2);
+        expect(notificationRequest.sendInvite.mock.calls[0][0]).toMatchObject({ instanceId: at('~region(us)') });
+    });
+
+    test('is blocked in an Invite instance owned by someone else, with a clear reason', async () => {
+        locationStore.lastLocation.location = at(`~private(${A})~region(us)`);
+        const store = useUnderWebStore();
+        expect(store.canInviteHere).toBe(false);
+        expect(store.inviteBlockedReason).toMatch(/Only the instance owner/);
+        const result = await run(store, [B]);
+        expect(result.sent).toBe(0);
+        expect(notificationRequest.sendInvite).not.toHaveBeenCalled();
+    });
+
+    test('is allowed in your own Invite instance', async () => {
+        locationStore.lastLocation.location = at(`~private(${ME})~region(us)`);
+        const store = useUnderWebStore();
+        expect(store.canInviteHere).toBe(true);
+    });
+
+    test('skips friends already here and does not double-invite within 2 minutes', async () => {
+        locationStore.lastLocation.location = at('~region(us)');
+        locationStore.lastLocation.friendList = new Map([[B, {}]]);
+        const store = useUnderWebStore();
+        const first = await run(store, [A, B]);
+        expect(first.sent).toBe(1);
+        expect(first.skipped).toEqual([{ userId: B, reason: 'already in this instance' }]);
+        const second = await run(store, [A]);
+        expect(second.sent).toBe(0);
+        expect(second.skipped[0].reason).toMatch(/less than 2 minutes/);
+        expect(notificationRequest.sendInvite).toHaveBeenCalledTimes(1);
+    });
+
+    test('stops the batch on a VRChat rate limit', async () => {
+        locationStore.lastLocation.location = at('~region(us)');
+        notificationRequest.sendInvite.mockRejectedValueOnce({ status: 429, message: 'Too many' });
+        const store = useUnderWebStore();
+        const result = await run(store, [A, B]);
+        expect(result.sent).toBe(0);
+        expect(result.failed).toHaveLength(1);
+        expect(result.skipped).toEqual([{ userId: B, reason: 'VRChat rate limit — paused' }]);
+        expect(store.rateLimitBackoffUntil).toBeGreaterThan(Date.now());
+    });
+
+    test('auto-invite stays limited to approved groups unless "any instance" is on', async () => {
+        locationStore.lastLocation.location = at('~region(us)');
+        const store = useUnderWebStore();
+        expect(store.canAutoInviteHere).toBe(false);
+        await store.setAutoInviteAnywhere(true);
+        expect(store.canAutoInviteHere).toBe(true);
+    });
+});
