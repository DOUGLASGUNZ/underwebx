diff --git a/src/stores/uwxCrew.js b/src/stores/uwxCrew.js
new file mode 100644
index 0000000..ab10bf3
--- /dev/null
+++ b/src/stores/uwxCrew.js
@@ -0,0 +1,173 @@
+import { computed, ref, watch } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import sqliteService from '../services/sqlite.js';
+import { watchState } from '../services/watchState';
+import { CREW_WINDOW_DAYS, cameOnline, crewPresence, rankCrew, sortByPresence } from '../shared/utils/uwxCrew';
+import { useFriendStore } from './friend';
+import { useLocationStore } from './location';
+import { useSafetyIntelStore } from './safetyIntel';
+import { useUnderWebStore } from './underweb';
+import { useUserStore } from './user';
+
+// Your crew: regulars worked out from VRCX's own join/leave history on this PC
+// (nothing is uploaded). Pin people to always keep them, hide people you don't want listed.
+
+const KEY = 'UWX_crew';
+const RELOAD_MS = 15 * 60 * 1000;
+
+/** Time spent with each person over the last N days, from VRCX's game log. */
+export async function loadTogetherStats(days = CREW_WINDOW_DAYS) {
+    const since = new Date(Date.now() - days * 86400000).toISOString();
+    const rows = [];
+    await sqliteService.execute(
+        (r) => rows.push({ userId: r[0], displayName: r[1], ms: Number(r[2]) || 0, days: Number(r[3]) || 0, lastSeen: r[4] || '' }),
+        `SELECT user_id, display_name, SUM(time), COUNT(DISTINCT substr(created_at, 1, 10)), MAX(created_at)
+         FROM gamelog_join_leave
+         WHERE type = 'OnPlayerLeft' AND created_at >= @since AND user_id LIKE 'usr_%'
+         GROUP BY user_id, display_name
+         ORDER BY SUM(time) DESC
+         LIMIT 120`,
+        { '@since': since }
+    );
+    return rows;
+}
+
+export const useUwxCrewStore = defineStore('UwxCrew', () => {
+    const friendStore = useFriendStore();
+    const locationStore = useLocationStore();
+    const userStore = useUserStore();
+    const safety = useSafetyIntelStore();
+    const underweb = useUnderWebStore();
+
+    const stats = ref([]);
+    const loadedAt = ref(0);
+    const loading = ref(false);
+    const prefs = ref({ pinned: [], hidden: [], alerts: true });
+    const seen = new Map();
+    let stopWatch = null;
+
+    const nameOf = (id) => {
+        const f = friendStore.friends.get(id);
+        return f?.ref?.displayName || f?.name || '';
+    };
+
+    const crew = computed(() => {
+        const ranked = rankCrew(stats.value, {
+            selfId: userStore.currentUser?.id || '',
+            pinned: prefs.value.pinned,
+            hidden: prefs.value.hidden,
+            isLabeled: (id) => Boolean(safety.getIntel?.(id)),
+            nameOf
+        });
+        const lobby = locationStore.lastLocation?.playerList;
+        return sortByPresence(
+            ranked.map((r) => ({
+                ...r,
+                presence: crewPresence(friendStore.friends.get(r.userId), { here: Boolean(lobby?.has?.(r.userId)) })
+            }))
+        );
+    });
+
+    const onlineNotHere = computed(() => crew.value.filter((r) => r.presence === 'online'));
+
+    async function loadPrefs() {
+        try {
+            const raw = JSON.parse((await configRepository.getString(KEY, '')) || '{}');
+            prefs.value = {
+                pinned: Array.isArray(raw.pinned) ? raw.pinned.filter((id) => String(id).startsWith('usr_')).slice(0, 50) : [],
+                hidden: Array.isArray(raw.hidden) ? raw.hidden.filter((id) => String(id).startsWith('usr_')).slice(0, 200) : [],
+                alerts: raw.alerts !== false
+            };
+        } catch {
+            prefs.value = { pinned: [], hidden: [], alerts: true };
+        }
+    }
+
+    async function savePrefs() {
+        await configRepository.setString(KEY, JSON.stringify(prefs.value));
+    }
+
+    async function refresh({ force = false } = {}) {
+        if (loading.value || (!force && Date.now() - loadedAt.value < RELOAD_MS)) return;
+        loading.value = true;
+        try {
+            stats.value = await loadTogetherStats();
+            loadedAt.value = Date.now();
+        } catch (error) {
+            console.error('UWX crew: could not read history', error);
+        } finally {
+            loading.value = false;
+        }
+    }
+
+    async function togglePin(userId) {
+        const pinned = prefs.value.pinned.includes(userId) ? prefs.value.pinned.filter((id) => id !== userId) : [...prefs.value.pinned, userId];
+        prefs.value = { ...prefs.value, pinned, hidden: prefs.value.hidden.filter((id) => id !== userId) };
+        await savePrefs();
+    }
+
+    async function hide(userId) {
+        prefs.value = { ...prefs.value, hidden: [...new Set([...prefs.value.hidden, userId])], pinned: prefs.value.pinned.filter((id) => id !== userId) };
+        await savePrefs();
+    }
+
+    async function unhideAll() {
+        prefs.value = { ...prefs.value, hidden: [] };
+        await savePrefs();
+    }
+
+    async function setAlerts(value) {
+        prefs.value = { ...prefs.value, alerts: Boolean(value) };
+        await savePrefs();
+    }
+
+    /** Invite everyone in the crew who is in VRChat but not with you (friend invite, with your message). */
+    async function inviteCrew() {
+        const ids = onlineNotHere.value.map((r) => r.userId);
+        if (!ids.length) {
+            toast.info('Nobody from your crew is online somewhere else right now.');
+            return null;
+        }
+        return underweb.inviteFriendsNow(ids);
+    }
+
+    function alertOnline(rows) {
+        if (!prefs.value.alerts) return;
+        for (const row of rows.slice(0, 3)) {
+            const canInvite = underweb.canInviteHere && row.presence === 'online';
+            toast(`${row.displayName} is online`, {
+                description: 'From your crew',
+                action: canInvite ? { label: 'Invite', onClick: () => underweb.inviteFriendsNow([row.userId]) } : undefined
+            });
+        }
+        if (rows.length > 3) toast(`${rows.length - 3} more of your crew came online`);
+    }
+
+    async function init() {
+        await loadPrefs();
+        void refresh({ force: true });
+        stopWatch?.();
+        stopWatch = watch(
+            () => crew.value.map((r) => `${r.userId}:${r.presence}`).join(','),
+            () => {
+                // Only start comparing once the friends list has loaded, so login doesn't fire every alert.
+                if (!watchState.isFriendsLoaded) {
+                    seen.clear();
+                    return;
+                }
+                alertOnline(cameOnline(seen, crew.value));
+            }
+        );
+    }
+
+    function dispose() {
+        stopWatch?.();
+        stopWatch = null;
+        seen.clear();
+    }
+
+    return { crew, stats, prefs, loading, loadedAt, onlineNotHere, init, dispose, refresh, togglePin, hide, unhideAll, setAlerts, inviteCrew };
+});
