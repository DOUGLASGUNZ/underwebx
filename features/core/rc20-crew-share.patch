+import { describe, expect, test } from 'vitest';
+
+import { fitSize, pngHasTextChunks, postError, showcasePath, showcaseRow, suggestTitle, validatePost } from '../uwxShare';
+
+const UID = '582affa4-c6d4-4bcb-bdf3-a26bf40dcad7';
+
+function png(chunks) {
+    const parts = [[0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]];
+    for (const [type, data] of chunks) {
+        const len = data.length;
+        parts.push([(len >>> 24) & 255, (len >>> 16) & 255, (len >>> 8) & 255, len & 255, ...[...type].map((c) => c.charCodeAt(0)), ...data, 0, 0, 0, 0]);
+    }
+    return new Uint8Array(parts.flat());
+}
+
+describe('UWX share', () => {
+    test('fits big photos inside 2560px and leaves small ones alone', () => {
+        expect(fitSize(3840, 2160)).toEqual({ width: 2560, height: 1440 });
+        expect(fitSize(2160, 3840)).toEqual({ width: 1440, height: 2560 });
+        expect(fitSize(1920, 1080)).toEqual({ width: 1920, height: 1080 });
+    });
+
+    test('title suggestion uses the event, never the world', () => {
+        const at = new Date(2026, 9, 15, 21, 0).getTime();
+        expect(suggestTitle({ eventName: 'Music Video Night', at })).toBe('Music Video Night · Oct 15');
+        expect(suggestTitle({ at })).toBe('VRChat photo · Oct 15');
+    });
+
+    test('validates and cleans title/caption', () => {
+        expect(validatePost({ title: '   ', caption: '' })).toEqual({ ok: false, error: 'Give the photo a title.' });
+        expect(validatePost({ title: ' MVN\u0007  night ', caption: 'x'.repeat(600) })).toEqual({ ok: true, title: 'MVN night', caption: 'x'.repeat(500) });
+    });
+
+    test('path and row match what the website and review queue expect', () => {
+        expect(showcasePath(UID, 1700000000000, 'ab/c..d')).toBe(`${UID}/1700000000000-abcd.jpg`);
+        expect(() => showcasePath('')).toThrow(/Sign in/);
+        expect(() => showcasePath('../other')).toThrow();
+        const row = showcaseRow(UID, `${UID}/1-x.jpg`, { title: 'T', caption: 'C' });
+        expect(row).toEqual({
+            user_id: UID,
+            media_url: `pending://${UID}/1-x.jpg`,
+            storage_path: `${UID}/1-x.jpg`,
+            media_type: 'image',
+            title: 'T',
+            caption: 'C',
+            is_featured: false,
+            sort_order: 0,
+            moderation_status: 'pending'
+        });
+    });
+
+    test('server refusals become plain English', () => {
+        expect(postError({ status: 403, message: 'new row violates row-level security policy' })).toMatch(/approved network access/);
+        expect(postError(new Error('Sign in to UnderWeb first.'))).toMatch(/System tab/);
+        expect(postError({ status: 413, message: 'Payload too large' })).toMatch(/too big/);
+    });
+
+    test('detects metadata chunks in a PNG (VRCX stores the instance there)', () => {
+        const tagged = png([['IHDR', [0, 0, 0, 1, 0, 0, 0, 1, 8, 2, 0, 0, 0]], ['iTXt', [...'Description\0\0\0\0\0{"instanceId":"wrld_x:123~private"}'].map((c) => c.charCodeAt(0))], ['IEND', []]]);
+        const clean = png([['IHDR', [0, 0, 0, 1, 0, 0, 0, 1, 8, 2, 0, 0, 0]], ['IEND', []]]);
+        expect(pngHasTextChunks(tagged)).toBe(true);
+        expect(pngHasTextChunks(clean)).toBe(false);
+    });
+});
diff --git a/src/shared/utils/uwxCrew.js b/src/shared/utils/uwxCrew.js
new file mode 100644
index 0000000..7ffc595
--- /dev/null
+++ b/src/shared/utils/uwxCrew.js
@@ -0,0 +1,105 @@
+// "Your crew": the people you actually hang out with, worked out from VRCX's own
+// join/leave history on this PC. Pure logic — the store feeds it rows from SQLite.
+
+export const CREW_WINDOW_DAYS = 30;
+export const CREW_SIZE = 12;
+
+const HOUR = 3600 * 1000;
+
+/**
+ * How much someone counts as a regular. Showing up on many different days matters
+ * more than one very long night, so days weigh double and hours are capped.
+ */
+export function crewScore(row) {
+    const days = Math.max(0, Number(row?.days) || 0);
+    const hours = Math.max(0, Number(row?.ms) || 0) / HOUR;
+    return days * 2 + Math.min(hours, 40);
+}
+
+/**
+ * @param {Array<{userId:string, displayName:string, ms:number, days:number, lastSeen:string}>} rows
+ * @param {{ selfId?: string, pinned?: string[], hidden?: string[], isLabeled?: (id:string)=>boolean, nameOf?: (id:string)=>string, limit?: number }} opts
+ */
+export function rankCrew(rows, { selfId = '', pinned = [], hidden = [], isLabeled = () => false, nameOf = () => '', limit = CREW_SIZE } = {}) {
+    const hide = new Set(hidden);
+    const byId = new Map();
+    for (const row of rows || []) {
+        const id = String(row?.userId || '');
+        if (!id.startsWith('usr_') || id === selfId || hide.has(id) || isLabeled(id)) continue;
+        const prev = byId.get(id);
+        // A display-name change splits one person into two rows: merge them.
+        const merged = prev
+            ? { ...prev, ms: prev.ms + (Number(row.ms) || 0), days: Math.max(prev.days, Number(row.days) || 0), lastSeen: [prev.lastSeen, row.lastSeen].sort().pop() || '' }
+            : { userId: id, displayName: row.displayName || id, ms: Number(row.ms) || 0, days: Number(row.days) || 0, lastSeen: row.lastSeen || '' };
+        byId.set(id, merged);
+    }
+    const pins = pinned.filter((id) => String(id).startsWith('usr_') && id !== selfId && !hide.has(id) && !isLabeled(id));
+    for (const id of pins) {
+        if (!byId.has(id)) byId.set(id, { userId: id, displayName: nameOf(id) || id, ms: 0, days: 0, lastSeen: '' });
+    }
+    const all = Array.from(byId.values()).map((r) => ({
+        ...r,
+        displayName: nameOf(r.userId) || r.displayName,
+        pinned: pins.includes(r.userId),
+        score: crewScore(r)
+    }));
+    const pinnedRows = all.filter((r) => r.pinned).sort((a, b) => b.score - a.score);
+    const rest = all
+        .filter((r) => !r.pinned && r.days > 0)
+        .sort((a, b) => b.score - a.score || b.ms - a.ms)
+        .slice(0, Math.max(0, limit - pinnedRows.length));
+    return [...pinnedRows, ...rest];
+}
+
+/** "14h together · 9 days" */
+export function togetherText(row) {
+    const hours = (Number(row?.ms) || 0) / HOUR;
+    const days = Number(row?.days) || 0;
+    if (!hours && !days) return 'Pinned';
+    const h = hours >= 10 ? Math.round(hours) : Math.round(hours * 10) / 10;
+    const time = hours < 1 ? `${Math.max(1, Math.round(hours * 60))}m` : `${h}h`;
+    return `${time} together · ${days} day${days === 1 ? '' : 's'}`;
+}
+
+/**
+ * Where a crew member is, from what VRCX already knows about the friend.
+ * @returns {'here'|'online'|'web'|'offline'|'not-friend'}
+ */
+export function crewPresence(friend, { here = false } = {}) {
+    if (here) return 'here';
+    if (!friend) return 'not-friend';
+    if (friend.state === 'online') return 'online';
+    if (friend.state === 'active') return 'web';
+    return 'offline';
+}
+
+export const PRESENCE_LABELS = Object.freeze({
+    here: 'With you',
+    online: 'In VRChat',
+    web: 'On the website/app',
+    offline: 'Offline',
+    'not-friend': 'Not friends'
+});
+
+/** Sort: with you, in VRChat, web, offline; then by score. */
+export function sortByPresence(list) {
+    const rank = { here: 0, online: 1, web: 2, offline: 3, 'not-friend': 4 };
+    return [...list].sort((a, b) => rank[a.presence] - rank[b.presence] || b.score - a.score);
+}
+
+/**
+ * Who just came online since the last look. `seen` is mutated to the new states.
+ * The first time someone is seen nothing fires (avoids a flood when friends load).
+ * @param {Map<string,string>} seen userId -> last presence
+ * @param {Array<{userId:string, presence:string}>} list
+ */
+export function cameOnline(seen, list) {
+    const out = [];
+    for (const row of list) {
+        const prev = seen.get(row.userId);
+        const nowIn = row.presence === 'online' || row.presence === 'here';
+        if (prev !== undefined && nowIn && prev !== 'online' && prev !== 'here') out.push(row);
+        seen.set(row.userId, row.presence);
+    }
+    return out;
+}
