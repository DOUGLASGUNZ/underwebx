+import { describe, expect, test } from 'vitest';
+
+import { cameOnline, crewPresence, crewScore, rankCrew, sortByPresence, togetherText } from '../uwxCrew';
+
+const H = 3600 * 1000;
+const ME = 'usr_me';
+const row = (userId, displayName, hours, days, lastSeen = '2026-10-10T00:00:00Z') => ({ userId, displayName, ms: hours * H, days, lastSeen });
+
+describe('UWX crew', () => {
+    test('regulars over many days beat one very long night', () => {
+        expect(crewScore(row('usr_a', 'A', 6, 8))).toBeGreaterThan(crewScore(row('usr_b', 'B', 12, 1)));
+        // hours are capped so a 200h AFK doesn't top the list
+        expect(crewScore(row('usr_c', 'C', 200, 1))).toBe(2 + 40);
+    });
+
+    test('ranks, skips you, hidden and labeled people, and merges name changes', () => {
+        const rows = [
+            row(ME, 'Me', 99, 30),
+            row('usr_vex', 'Vex', 10, 9),
+            row('usr_vex', 'Vex (old name)', 4, 3, '2026-10-12T00:00:00Z'),
+            row('usr_blooty', 'Blooty', 20, 6),
+            row('usr_bad', 'Crasher', 30, 10),
+            row('usr_hidden', 'Hidden', 30, 10),
+            row('nope', 'Broken', 30, 10)
+        ];
+        const crew = rankCrew(rows, { selfId: ME, hidden: ['usr_hidden'], isLabeled: (id) => id === 'usr_bad' });
+        expect(crew.map((r) => r.userId)).toEqual(['usr_blooty', 'usr_vex']);
+        const vex = crew.find((r) => r.userId === 'usr_vex');
+        expect(vex.ms).toBe(14 * H);
+        expect(vex.days).toBe(9);
+        expect(vex.lastSeen).toBe('2026-10-12T00:00:00Z');
+    });
+
+    test('pinned people always show first, even without history, using the friend name', () => {
+        const rows = Array.from({ length: 20 }, (_, i) => row(`usr_${i}`, `P${i}`, 20 - i, 5));
+        const crew = rankCrew(rows, { pinned: ['usr_new', 'usr_19'], nameOf: (id) => (id === 'usr_new' ? 'Newbie' : ''), limit: 5 });
+        expect(crew).toHaveLength(5);
+        expect(crew.slice(0, 2).map((r) => r.userId).sort()).toEqual(['usr_19', 'usr_new']);
+        expect(crew.find((r) => r.userId === 'usr_new').displayName).toBe('Newbie');
+        expect(crew.every((r, i) => (i < 2) === r.pinned)).toBe(true);
+    });
+
+    test('labeled people cannot be pinned into the crew', () => {
+        expect(rankCrew([], { pinned: ['usr_bad'], isLabeled: () => true })).toEqual([]);
+    });
+
+    test('together text', () => {
+        expect(togetherText(row('usr_a', 'A', 14.4, 9))).toBe('14h together · 9 days');
+        expect(togetherText(row('usr_a', 'A', 2.25, 1))).toBe('2.3h together · 1 day');
+        expect(togetherText(row('usr_a', 'A', 0.25, 1))).toBe('15m together · 1 day');
+        expect(togetherText({ ms: 0, days: 0 })).toBe('Pinned');
+    });
+
+    test('presence and sorting', () => {
+        expect(crewPresence({ state: 'online' })).toBe('online');
+        expect(crewPresence({ state: 'online' }, { here: true })).toBe('here');
+        expect(crewPresence({ state: 'active' })).toBe('web');
+        expect(crewPresence({ state: 'offline' })).toBe('offline');
+        expect(crewPresence(undefined)).toBe('not-friend');
+        const sorted = sortByPresence([
+            { userId: 'a', presence: 'offline', score: 50 },
+            { userId: 'b', presence: 'online', score: 1 },
+            { userId: 'c', presence: 'here', score: 2 },
+            { userId: 'd', presence: 'online', score: 9 }
+        ]);
+        expect(sorted.map((r) => r.userId)).toEqual(['c', 'd', 'b', 'a']);
+    });
+
+    test('came-online alerts: nothing on first sight, then only offline/web → in VRChat', () => {
+        const seen = new Map();
+        expect(cameOnline(seen, [{ userId: 'a', presence: 'online' }, { userId: 'b', presence: 'offline' }])).toEqual([]);
+        expect(cameOnline(seen, [{ userId: 'a', presence: 'here' }, { userId: 'b', presence: 'online' }]).map((r) => r.userId)).toEqual(['b']);
+        // leaving your instance (here → online) is not "coming online"
+        expect(cameOnline(seen, [{ userId: 'a', presence: 'online' }, { userId: 'b', presence: 'online' }])).toEqual([]);
+        expect(cameOnline(seen, [{ userId: 'a', presence: 'web' }])).toEqual([]);
+        expect(cameOnline(seen, [{ userId: 'a', presence: 'online' }]).map((r) => r.userId)).toEqual(['a']);
+    });
+});
