+    import { useUwxAccountStore } from '../../stores/uwxAccount';
+    import { useUwxShareStore } from '../../stores/uwxShare';
+
+    const store = useUwxShareStore();
+    const { photo, title, caption, loadingPhoto, posting, error, prefs, recent } = storeToRefs(store);
+    const { selectLatest, selectFromFile, post, clear, setOfferAfterScreenshot } = store;
+    const { signedIn } = storeToRefs(useUwxAccountStore());
+
+    function ago(at) {
+        const m = Math.round((Date.now() - at) / 60000);
+        if (m < 1) return 'just now';
+        if (m < 60) return `${m}m ago`;
+        const h = Math.round(m / 60);
+        return h < 24 ? `${h}h ago` : `${Math.round(h / 24)}d ago`;
+    }
