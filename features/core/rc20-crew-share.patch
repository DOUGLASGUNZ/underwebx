diff --git a/src/stores/uwxShare.js b/src/stores/uwxShare.js
new file mode 100644
index 0000000..5211512
--- /dev/null
+++ b/src/stores/uwxShare.js
@@ -0,0 +1,184 @@
+import { markRaw, ref, shallowRef } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import { encodePhoto } from '../services/uwxPhotoEncode';
+import { postError, SHOWCASE_BUCKET, showcasePath, showcaseRow, suggestTitle, validatePost } from '../shared/utils/uwxShare';
+import { useUwxAccountStore } from './uwxAccount';
+
+// Post VRChat photos to your UnderWeb showcase. Same flow as the website: the photo goes
+// to the pending bucket and staff approve it before it shows on your profile.
+
+const KEY = 'UWX_share';
+const MAX_RECENT = 20;
+
+const isLinux = () => typeof LINUX !== 'undefined' && Boolean(LINUX);
+
+export const useUwxShareStore = defineStore('UwxShare', () => {
+    const account = useUwxAccountStore();
+
+    const prefs = ref({ offerAfterScreenshot: false });
+    const recent = ref([]); // [{ at, title }]
+    const selectedPath = ref('');
+    // shallowRef + markRaw: the Blob must reach fetch() as a real Blob, not a Vue proxy.
+    const photo = shallowRef(null); // { blob, width, height, previewUrl }
+    const title = ref('');
+    const caption = ref('');
+    const loadingPhoto = ref(false);
+    const posting = ref(false);
+    const error = ref('');
+    /** Bumped when something asks the UnderWeb page to show the share card. */
+    const focusTick = ref(0);
+
+    async function init() {
+        try {
+            const raw = JSON.parse((await configRepository.getString(KEY, '')) || '{}');
+            prefs.value = { offerAfterScreenshot: Boolean(raw.offerAfterScreenshot) };
+            recent.value = Array.isArray(raw.recent) ? raw.recent.slice(0, MAX_RECENT) : [];
+        } catch {
+            prefs.value = { offerAfterScreenshot: false };
+        }
+    }
+
+    async function save() {
+        await configRepository.setString(KEY, JSON.stringify({ ...prefs.value, recent: recent.value }));
+    }
+
+    async function setOfferAfterScreenshot(value) {
+        prefs.value = { ...prefs.value, offerAfterScreenshot: Boolean(value) };
+        await save();
+    }
+
+    function clear() {
+        if (photo.value?.previewUrl) URL.revokeObjectURL(photo.value.previewUrl);
+        photo.value = null;
+        selectedPath.value = '';
+        title.value = '';
+        caption.value = '';
+        error.value = '';
+    }
+
+    async function eventName() {
+        try {
+            const { useUwxEventModeStore } = await import('./uwxEventMode');
+            return useUwxEventModeStore().active?.name || '';
+        } catch {
+            return '';
+        }
+    }
+
+    /** Load a photo from disk and prepare the clean copy that will be uploaded. */
+    async function select(path) {
+        if (!path) return false;
+        clear();
+        loadingPhoto.value = true;
+        try {
+            const base64 = await AppApi.GetFileBase64(path);
+            const encoded = await encodePhoto(base64);
+            photo.value = markRaw({ ...encoded, blob: markRaw(encoded.blob) });
+            selectedPath.value = path;
+            title.value = suggestTitle({ eventName: await eventName() });
+            return true;
+        } catch (e) {
+            error.value = e?.message || 'Could not read that photo.';
+            return false;
+        } finally {
+            loadingPhoto.value = false;
+        }
+    }
+
+    async function selectLatest() {
+        const path = await AppApi.GetLastScreenshot();
+        if (!path) {
+            toast.info('No VRChat photos found yet.');
+            return false;
+        }
+        return select(path);
+    }
+
+    async function selectFromFile() {
+        const path = isLinux()
+            ? await window.electron.openFileDialog()
+            : await AppApi.OpenFileSelectorDialog(await AppApi.GetVRChatPhotosLocation(), '.png', 'PNG Files (*.png)|*.png');
+        return path ? select(path) : false;
+    }
+
+    async function post() {
+        if (posting.value || !photo.value) return false;
+        const checked = validatePost({ title: title.value, caption: caption.value });
+        if ('error' in checked) {
+            error.value = checked.error;
+            return false;
+        }
+        posting.value = true;
+        error.value = '';
+        let path = '';
+        let uploaded = false;
+        try {
+            if (!account.signedIn) throw new Error('Sign in to UnderWeb first.');
+            path = showcasePath(account.userId);
+            await account.storageUpload(SHOWCASE_BUCKET, path, photo.value.blob, 'image/jpeg');
+            uploaded = true;
+            await account.api('creator_showcase', {
+                method: 'POST',
+                headers: { Prefer: 'return=minimal' },
+                body: JSON.stringify(showcaseRow(account.userId, path, checked))
+            });
+            recent.value = [{ at: Date.now(), title: checked.title }, ...recent.value].slice(0, MAX_RECENT);
+            await save();
+            toast.success('Sent to your showcase — it appears once staff approve it.');
+            clear();
+            return true;
+        } catch (e) {
+            if (uploaded) await account.storageRemove(SHOWCASE_BUCKET, [path]);
+            error.value = postError(e);
+            toast.error(error.value);
+            return false;
+        } finally {
+            posting.value = false;
+        }
+    }
+
+    /** Called after VRChat saves a photo. Only offers anything if you switched it on. */
+    function offer(path) {
+        if (!prefs.value.offerAfterScreenshot || !path) return;
+        toast('Photo saved', {
+            description: 'Post it to your UnderWeb showcase?',
+            action: { label: 'Post…', onClick: () => openComposer(path) }
+        });
+    }
+
+    async function openComposer(path) {
+        focusTick.value += 1;
+        try {
+            const { router } = await import('../plugins/router');
+            await router.push({ name: 'underweb' });
+        } catch {
+            // UnderWeb page not reachable (tests / overlay); the card still has the photo
+        }
+        await select(path);
+    }
+
+    return {
+        prefs,
+        recent,
+        selectedPath,
+        photo,
+        title,
+        caption,
+        loadingPhoto,
+        posting,
+        error,
+        focusTick,
+        init,
+        setOfferAfterScreenshot,
+        select,
+        selectLatest,
+        selectFromFile,
+        post,
+        clear,
+        offer,
+        openComposer
+    };
+});
