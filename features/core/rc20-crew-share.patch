diff --git a/src/services/uwxPhotoEncode.js b/src/services/uwxPhotoEncode.js
new file mode 100644
index 0000000..857dae0
--- /dev/null
+++ b/src/services/uwxPhotoEncode.js
@@ -0,0 +1,44 @@
+// Re-draw a photo into a brand-new JPEG. Drawing to a canvas keeps only the pixels,
+// so VRCX's embedded metadata (world, instance ID, player list) never leaves the PC.
+
+import { fitSize, JPEG_QUALITY, MAX_SIDE, MAX_UPLOAD_BYTES } from '../shared/utils/uwxShare';
+
+function loadImage(src) {
+    return new Promise((resolve, reject) => {
+        const img = new Image();
+        img.onload = () => resolve(img);
+        img.onerror = () => reject(new Error('Could not read that image.'));
+        img.src = src;
+    });
+}
+
+function toBlob(canvas, quality) {
+    return new Promise((resolve, reject) =>
+        canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('Could not prepare the photo.'))), 'image/jpeg', quality)
+    );
+}
+
+/**
+ * @param {string} base64Png  file contents as base64 (from AppApi.GetFileBase64)
+ * @returns {Promise<{ blob: Blob, width: number, height: number, previewUrl: string }>}
+ */
+export async function encodePhoto(base64Png) {
+    if (!base64Png) throw new Error('Could not read that photo.');
+    const img = await loadImage(`data:image/png;base64,${base64Png}`);
+    const attempts = [
+        [MAX_SIDE, JPEG_QUALITY],
+        [MAX_SIDE, 0.8],
+        [1920, 0.8]
+    ];
+    for (const [side, quality] of attempts) {
+        const { width, height } = fitSize(img.naturalWidth || img.width, img.naturalHeight || img.height, side);
+        const canvas = document.createElement('canvas');
+        canvas.width = width;
+        canvas.height = height;
+        const ctx = canvas.getContext('2d');
+        ctx.drawImage(img, 0, 0, width, height);
+        const blob = await toBlob(canvas, quality);
+        if (blob.size <= MAX_UPLOAD_BYTES) return { blob, width, height, previewUrl: URL.createObjectURL(blob) };
+    }
+    throw new Error('That photo is too big to upload.');
+}
