diff --git a/src/shared/utils/uwxShare.js b/src/shared/utils/uwxShare.js
new file mode 100644
index 0000000..34942bb
--- /dev/null
+++ b/src/shared/utils/uwxShare.js
@@ -0,0 +1,89 @@
+// Posting VRChat photos to your UnderWeb showcase (underweb.cloud). Pure helpers.
+//
+// Privacy: VRCX writes the world, the exact instance ID and everyone in the lobby
+// into each PNG it saves. Photos are always re-drawn into a fresh JPEG before upload,
+// which carries none of that — only the pixels go up.
+
+export const SHOWCASE_BUCKET = 'creator-showcase-pending';
+export const MAX_SIDE = 2560;
+export const MAX_UPLOAD_BYTES = 12 * 1024 * 1024; // same limit as the website
+export const JPEG_QUALITY = 0.9;
+
+/** Scale down so the longest side is at most `max`. */
+export function fitSize(width, height, max = MAX_SIDE) {
+    const w = Math.max(1, Math.round(Number(width) || 0));
+    const h = Math.max(1, Math.round(Number(height) || 0));
+    const scale = Math.min(1, max / Math.max(w, h));
+    return { width: Math.max(1, Math.round(w * scale)), height: Math.max(1, Math.round(h * scale)) };
+}
+
+const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+
+/** "Music Video Night · Oct 15" during an event, otherwise "VRChat photo · Oct 15". Never the world or instance. */
+export function suggestTitle({ eventName = '', at = Date.now() } = {}) {
+    const d = new Date(at);
+    const date = `${MONTHS[d.getMonth()]} ${d.getDate()}`;
+    const base = String(eventName || '').trim() || 'VRChat photo';
+    return `${base} · ${date}`.slice(0, 80);
+}
+
+const clean = (value, max) =>
+    String(value || '')
+        .replace(/[\u0000-\u0008\u000B-\u001F\u007F]/g, '')
+        .trim()
+        .slice(0, max);
+
+/** @returns {{ ok: true, title: string, caption: string } | { ok: false, error: string }} */
+export function validatePost({ title, caption }) {
+    const t = clean(title, 80).replace(/\s+/g, ' ');
+    const c = clean(caption, 500);
+    if (!t) return { ok: false, error: 'Give the photo a title.' };
+    return { ok: true, title: t, caption: c };
+}
+
+/** Storage path in the same shape the website uses: <your account id>/<time>-<random>.jpg */
+export function showcasePath(userId, now = Date.now(), rand = Math.random().toString(36).slice(2, 12)) {
+    if (!/^[0-9a-f-]{36}$/i.test(String(userId))) throw new Error('Sign in to UnderWeb first.');
+    return `${userId}/${now}-${String(rand).replace(/[^a-z0-9]/gi, '').slice(0, 16) || 'photo'}.jpg`;
+}
+
+/** The pending row the website's review queue expects. */
+export function showcaseRow(userId, path, { title, caption }) {
+    return {
+        user_id: userId,
+        media_url: `pending://${path}`,
+        storage_path: path,
+        media_type: 'image',
+        title,
+        caption,
+        is_featured: false,
+        sort_order: 0,
+        moderation_status: 'pending'
+    };
+}
+
+/** Friendly text for what UnderWeb's server said no to. */
+export function postError(error) {
+    const status = Number(error?.status) || 0;
+    const msg = String(error?.message || '');
+    if (/sign in/i.test(msg)) return 'Sign in to UnderWeb (System tab) to post.';
+    if (status === 401 || status === 403 || /row-level security|violates|unauthorized/i.test(msg))
+        return 'Your UnderWeb account can’t post to the showcase yet — it needs approved network access on underweb.cloud.';
+    if (status === 413 || /too large|exceeded/i.test(msg)) return 'That photo is too big to upload.';
+    return msg || 'Upload failed.';
+}
+
+/** True if a PNG still carries text metadata chunks (tEXt/iTXt/zTXt). Used to prove uploads are clean. */
+export function pngHasTextChunks(bytes) {
+    const b = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+    if (b.length < 8 || b[0] !== 0x89 || b[1] !== 0x50) return false;
+    let i = 8;
+    while (i + 8 <= b.length) {
+        const len = (b[i] << 24) | (b[i + 1] << 16) | (b[i + 2] << 8) | b[i + 3];
+        const type = String.fromCharCode(b[i + 4], b[i + 5], b[i + 6], b[i + 7]);
+        if (type === 'tEXt' || type === 'iTXt' || type === 'zTXt') return true;
+        if (type === 'IEND' || len < 0) break;
+        i += 12 + len;
+    }
+    return false;
+}
