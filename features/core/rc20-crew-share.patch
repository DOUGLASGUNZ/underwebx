+                    <Input v-model="title" maxlength="80" placeholder="Title" aria-label="Title" />
+                    <textarea v-model="caption" maxlength="500" rows="3" placeholder="Caption (optional)" aria-label="Caption" class="uwx-share-caption" />
+                    <p class="uwx-help"><i class="ri-shield-check-line" /> Only the picture is sent — the world, instance and player list VRCX saves inside the file are left out.</p>
+                    <div class="flex flex-wrap gap-2">
+                        <Button type="submit" :disabled="posting || !signedIn || !title.trim()"><i class="ri-upload-2-line" /> {{ posting ? 'Posting…' : 'Post for review' }}</Button>
+                        <Button type="button" variant="ghost" :disabled="posting" @click="clear">Cancel</Button>
+                    </div>
+                </div>
+            </form>
+
+            <p v-if="error" class="uwx-share-error" role="alert">{{ error }}</p>
+
+            <label class="uwx-inline-toggle">
+                <Switch :model-value="prefs.offerAfterScreenshot" @update:modelValue="setOfferAfterScreenshot" />
+                <span><strong>Offer after every photo</strong><small>A small pop-up with “Post…” when VRChat saves a photo.</small></span>
+            </label>
+            <p v-if="recent.length" class="uwx-help">Last posted: “{{ recent[0].title }}” · {{ ago(recent[0].at) }}</p>
