+            </p>
+
+            <div v-if="!photo" class="uwx-share-pick">
+                <Button :disabled="loadingPhoto" @click="selectLatest"><i class="ri-image-line" /> Latest photo</Button>
+                <Button variant="outline" :disabled="loadingPhoto" @click="selectFromFile"><i class="ri-folder-open-line" /> Choose…</Button>
+                <span v-if="loadingPhoto" class="text-sm text-muted-foreground">Preparing…</span>
