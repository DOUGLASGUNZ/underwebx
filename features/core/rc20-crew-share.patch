--- /dev/null
+++ b/src/stores/__tests__/uwxCrew.test.js
@@ -0,0 +1,117 @@
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { nextTick, reactive } from 'vue';
+
+const config = {};
+vi.mock('../../services/config', () => ({
+    default: {
+        getString: vi.fn(async (k, d) => (k in config ? config[k] : d)),
+        setString: vi.fn(async (k, v) => (config[k] = v))
+    }
+}));
+const H = 3600 * 1000;
+let dbRows = [];
+const sqlite = { execute: vi.fn(async (cb, sql, args) => dbRows.forEach((r) => cb(r))) };
+vi.mock('../../services/sqlite.js', () => ({ default: sqlite }));
+const watchState = reactive({ isFriendsLoaded: true });
+vi.mock('../../services/watchState', () => ({ watchState }));
+const toast = vi.fn();
+toast.info = vi.fn();
+vi.mock('vue-sonner', () => ({ toast }));
+
+const friends = reactive(new Map());
+vi.mock('../friend', () => ({ useFriendStore: () => ({ friends }) }));
+const location = reactive({ lastLocation: { playerList: new Map() } });
+vi.mock('../location', () => ({ useLocationStore: () => location }));
+vi.mock('../user', () => ({ useUserStore: () => ({ currentUser: { id: 'usr_me' } }) }));
+vi.mock('../safetyIntel', () => ({ useSafetyIntelStore: () => ({ getIntel: (id) => (id === 'usr_bad' ? { risk_level: 'high' } : null) }) }));
+const underweb = reactive({ canInviteHere: true, inviteFriendsNow: vi.fn(async (ids) => ({ sent: ids.length })) });
+vi.mock('../underweb', () => ({ useUnderWebStore: () => underweb }));
+
+const { useUwxCrewStore, loadTogetherStats } = await import('../uwxCrew');
+
+const friend = (id, name, state) => friends.set(id, reactive({ id, state, ref: { displayName: name } }));
+
+describe('UWX crew store', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        for (const k of Object.keys(config)) delete config[k];
+        friends.clear();
+        location.lastLocation.playerList = new Map();
+        toast.mockClear();
+        underweb.inviteFriendsNow.mockClear();
+        dbRows = [
+            ['usr_vex', 'Vex', 12 * H, 9, '2026-10-14T01:00:00Z'],
+            ['usr_blooty', 'Blooty', 30 * H, 12, '2026-10-14T02:00:00Z'],
+            ['usr_bad', 'Crasher', 40 * H, 15, '2026-10-14T02:00:00Z'],
+            ['usr_me', 'Darko', 99 * H, 30, '2026-10-14T02:00:00Z']
+        ];
+        friend('usr_vex', 'Vex', 'online');
+        friend('usr_blooty', 'Blooty', 'offline');
+    });
+
+    test('reads only the last 30 days of leave events from local history', async () => {
+        await loadTogetherStats();
+        const [, sql, args] = sqlite.execute.mock.calls.at(-1);
+        expect(sql).toMatch(/type = 'OnPlayerLeft'/);
+        expect(sql).toMatch(/created_at >= @since/);
+        const since = Date.parse(args['@since']);
+        expect(Math.round((Date.now() - since) / 86400000)).toBe(30);
+    });
+
+    test('builds the crew with presence, never including you or labeled people', async () => {
+        const store = useUwxCrewStore();
+        await store.init();
+        await vi.waitFor(() => expect(store.crew.length).toBe(2));
+        expect(store.crew.map((r) => [r.displayName, r.presence])).toEqual([
+            ['Vex', 'online'],
+            ['Blooty', 'offline']
+        ]);
+        location.lastLocation.playerList = new Map([['usr_blooty', {}]]);
+        await nextTick();
+        expect(store.crew[0]).toMatchObject({ displayName: 'Blooty', presence: 'here' });
+        store.dispose();
+    });
+
+    test('invite crew sends only to crew who are in VRChat somewhere else', async () => {
+        friend('usr_blooty', 'Blooty', 'online');
