+    import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+    import { Input } from '@/components/ui/input';
+
+    import { useUwxAccountStore } from '../../stores/uwxAccount';
+
+    const account = useUwxAccountStore();
+    const { email, signedIn, isStaff, canReviewSafety, busy, codeSentTo } = storeToRefs(account);
+    const { requestCode, cancelCode, signOut } = account;
+
+    const emailDraft = ref(email.value);
+    const code = ref('');
+    watch(email, (v) => {
+        if (!emailDraft.value) emailDraft.value = v;
+    });
+
+    async function verifyCode(value) {
+        if (await account.verifyCode(value)) code.value = '';
+    }
+</script>
