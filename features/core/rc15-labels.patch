+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+
+const config = {};
+vi.mock('../../services/config', () => ({
+    default: {
+        getString: vi.fn(async (k, d) => (k in config ? config[k] : d)),
+        setString: vi.fn(async (k, v) => (config[k] = v))
+    }
+}));
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn() } }));
+const safety = { lookupUser: vi.fn(async () => null) };
+vi.mock('../safetyIntel', () => ({ useSafetyIntelStore: () => safety }));
+
+const { useUwxAccountStore } = await import('../uwxAccount');
+const { useUwxLabelsStore, validateLabel } = await import('../uwxLabels');
+const { toast } = await import('vue-sonner');
+
+const BAD = 'usr_11111111-2222-3333-4444-555555555555';
+let calls;
+let routes;
+function json(status, body) {
+    return { ok: status >= 200 && status < 300, status, json: async () => body, text: async () => (body === undefined ? '' : JSON.stringify(body)) };
+}
+global.fetch = vi.fn(async (url, init = {}) => {
+    const path = url.replace('https://pxipclkptxpqukefwexh.supabase.co', '');
+    const entry = { path, method: init.method || 'GET', auth: init.headers?.Authorization || '', body: init.body ? JSON.parse(init.body) : null };
+    calls.push(entry);
+    for (const [match, handler] of routes) if (path.startsWith(match)) return handler(entry);
+    return json(404, { message: 'no route ' + path });
+});
+
+const session = (n = 1) => ({ access_token: `access-${n}`, refresh_token: `refresh-${n}`, expires_in: 3600, user: { id: 'uid-darko', email: 'darko@example.com' } });
+
+describe('UnderWeb sign-in in UWX', () => {
+    beforeEach(() => {
+        setActivePinia(createPinia());
+        for (const k of Object.keys(config)) delete config[k];
+        calls = [];
+        routes = [
+            ['/auth/v1/otp', () => json(200, {})],
+            ['/auth/v1/verify', () => json(200, session(1))],
+            ['/auth/v1/token', () => json(200, session(2))],
+            ['/auth/v1/logout', () => json(204)],
+            ['/rest/v1/rpc/uwx_is_underweb_staff', () => json(200, true)],
+            ['/rest/v1/rpc/uwx_can_review_safety', () => json(200, true)]
+        ];
+        toast.error.mockClear();
+    });
+
+    test('email code sign-in never creates accounts, keeps only the refresh token, and loads staff permissions', async () => {
+        const account = useUwxAccountStore();
+        expect(await account.requestCode('Darko@Example.com')).toBe(true);
+        expect(calls[0]).toMatchObject({ path: '/auth/v1/otp', body: { email: 'darko@example.com', create_user: false } });
+        expect(await account.verifyCode('123 456')).toBe(true);
+        expect(calls[1].body).toEqual({ type: 'email', email: 'darko@example.com', token: '123456' });
+        expect(account.signedIn).toBe(true);
+        expect(account.isStaff).toBe(true);
+        expect(account.canReviewSafety).toBe(true);
+        expect(config.UWX_underwebRefreshToken).toBe('refresh-1');
+        expect(Object.values(config).join(' ')).not.toContain('access-1');
+    });
+
+    test('resumes from the saved refresh token, and retries once after a 401', async () => {
+        config.UWX_underwebRefreshToken = 'refresh-0';
+        const account = useUwxAccountStore();
+        await account.init();
+        expect(account.signedIn).toBe(true);
+        let first = true;
+        routes.unshift(['/rest/v1/thing', (e) => (first ? ((first = false), json(401, { message: 'JWT expired' })) : json(200, [{ ok: e.auth }]))]);
+        const rows = await account.api('thing');
+        expect(rows[0].ok).toBe('Bearer access-2');
+    });
+
+    test('a revoked refresh token signs you out locally', async () => {
+        config.UWX_underwebRefreshToken = 'revoked';
+        routes.unshift(['/auth/v1/token', () => json(400, { error: 'invalid_grant' })]);
+        const account = useUwxAccountStore();
+        await account.init();
+        expect(account.signedIn).toBe(false);
+        expect(config.UWX_underwebRefreshToken).toBe('');
+    });
+});
+
+describe('Staff labels', () => {
+    const good = {
+        vrchatUserId: BAD,
+        displayName: 'BadActor',
+        category: 'crashing',
+        riskLevel: 'high',
+        publicSummary: 'Crashed two UnderWeb events with a modded client.',
+        reason: 'Crashed MVN twice, see clips in staff chat.',
+        days: 180
+    };
+
+    beforeEach(async () => {
+        setActivePinia(createPinia());
+        calls = [];
+        routes = [
+            ['/auth/v1/verify', () => json(200, session(1))],
+            ['/auth/v1/otp', () => json(200, {})],
+            ['/rest/v1/rpc/uwx_is_underweb_staff', () => json(200, true)],
+            ['/rest/v1/rpc/uwx_can_review_safety', () => json(200, true)],
+            ['/rest/v1/uwx_safety_reports?select=id&vrchat_user_id', () => json(200, [{ id: 'r1' }, { id: 'r2' }])],
+            ['/rest/v1/uwx_safety_reports', () => json(201, [{ id: 'report-1' }])],
+            ['/rest/v1/rpc/uwx_review_safety_report', () => json(200, [{ report_id: 'report-1', report_status: 'verified', public_record_active: true }])]
+        ];
+        const account = useUwxAccountStore();
+        await account.requestCode('darko@example.com');
+        await account.verifyCode('123456');
+        calls = [];
+        toast.error.mockClear();
+    });
+
+    test('validates the same rules the database enforces', () => {
+        expect(validateLabel(good)).toBe('');
+        expect(validateLabel({ ...good, publicSummary: 'too short' })).toMatch(/20–500/);
+        expect(validateLabel({ ...good, days: 999 })).toMatch(/how long/);
+        expect(validateLabel({ ...good, vrchatUserId: 'Bob' })).toMatch(/usr_/);
+    });
+
+    test('label now: creates the report as you, verifies it, and refreshes the shared label', async () => {
+        const labels = useUwxLabelsStore();
+        expect(await labels.labelNow(good)).toBe(true);
+        const [insert, verify] = calls;
+        expect(insert).toMatchObject({ path: '/rest/v1/uwx_safety_reports?select=id', method: 'POST', auth: 'Bearer access-1' });
+        expect(insert.body).toMatchObject({ vrchat_user_id: BAD, category: 'crashing', status: 'pending', source: 'uwx' });
+        expect(verify.path).toBe('/rest/v1/rpc/uwx_review_safety_report');
+        expect(verify.body).toMatchObject({ p_report_id: 'report-1', p_decision: 'verified', p_risk_level: 'high', p_public_summary: good.publicSummary });
+        const days = (Date.parse(verify.body.p_expires_at) - Date.now()) / 86400000;
+        expect(Math.round(days)).toBe(180);
+        expect(safety.lookupUser).toHaveBeenCalledWith(BAD, { force: true });
+    });
+
+    test('non-reviewers cannot publish from UWX', async () => {
+        useUwxAccountStore().canReviewSafety = false;
+        const labels = useUwxLabelsStore();
+        expect(await labels.labelNow(good)).toBe(false);
+        expect(calls).toHaveLength(0);
+    });
+
+    test('remove label expires every verified report for that person', async () => {
+        const labels = useUwxLabelsStore();
+        expect(await labels.removeLabel(BAD, 'Appeal accepted by staff vote.')).toBe(true);
+        const reviews = calls.filter((c) => c.path === '/rest/v1/rpc/uwx_review_safety_report');
+        expect(reviews.map((c) => [c.body.p_report_id, c.body.p_decision])).toEqual([['r1', 'expired'], ['r2', 'expired']]);
+    });
+});
