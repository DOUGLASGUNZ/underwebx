+++ b/src/views/UnderWeb/UwxLabelReviewQueue.vue
@@ -0,0 +1,147 @@
+<template>
+    <Card class="uwx-card uwx-card-wide">
+        <CardHeader>
+            <div class="flex items-start justify-between gap-4">
+                <div>
+                    <CardTitle>Reports waiting for review</CardTitle>
+                    <CardDescription>
+                        From UWX and the website. Approving publishes a label every UWX user sees; rejecting publishes nothing.
+                    </CardDescription>
+                </div>
+                <Button size="sm" variant="outline" :disabled="queueLoading" @click="loadQueue">
+                    <i :class="queueLoading ? 'ri-loader-4-line animate-spin' : 'ri-refresh-line'" /> Refresh
+                </Button>
+            </div>
+        </CardHeader>
+        <CardContent>
+            <p v-if="!queue.length" class="text-sm text-muted-foreground">{{ queueLoading ? 'Loading…' : 'Nothing waiting. 🎉' }}</p>
+            <div v-else class="uwx-queue">
+                <div v-for="report in queue" :key="report.id" class="uwx-queue-item">
+                    <div class="flex flex-wrap items-start justify-between gap-2">
+                        <div class="min-w-0">
+                            <strong>{{ report.last_known_display_name || report.vrchat_user_id }}</strong>
+                            <span class="uwx-queue-cat">{{ categoryLabel(report.category) }}</span>
+                            <div class="text-xs text-muted-foreground">
+                                {{ report.vrchat_user_id }} · reported {{ when(report.created_at) }} · suggested {{ report.suggested_severity }}
+                                <template v-if="report.incident_world"> · {{ report.incident_world }}</template>
+                            </div>
+                        </div>
+                        <Button v-if="report.private_evidence_url" size="sm" variant="ghost" @click="openExternalLink(report.private_evidence_url)">
+                            <i class="ri-external-link-line" /> Evidence
+                        </Button>
+                    </div>
+                    <p class="uwx-queue-summary">{{ report.summary }}</p>
+
+                    <div v-if="openId === report.id" class="uwx-queue-form">
+                        <textarea v-model="draft.publicSummary" rows="2" maxlength="500" class="uwx-report-input" placeholder="Public note everyone sees (20–500 characters). No personal info." />
+                        <div class="flex flex-wrap gap-2">
+                            <NativeSelect v-model="draft.riskLevel" aria-label="Risk level">
+                                <NativeSelectOption value="info">Heads up</NativeSelectOption>
+                                <NativeSelectOption value="caution">Caution</NativeSelectOption>
+                                <NativeSelectOption value="high">High risk</NativeSelectOption>
+                            </NativeSelect>
+                            <NativeSelect v-model="draft.days" aria-label="How long">
+                                <NativeSelectOption v-for="d in LABEL_DURATIONS" :key="d.days" :value="d.days">{{ d.label }}</NativeSelectOption>
+                            </NativeSelect>
+                            <Button :disabled="busy" @click="approve(report)">Publish label</Button>
+                            <Button variant="ghost" @click="openId = ''">Cancel</Button>
+                        </div>
+                    </div>
+                    <div v-else class="flex flex-wrap gap-2 mt-2">
+                        <Button size="sm" @click="startApprove(report)">Approve…</Button>
+                        <Button size="sm" variant="outline" :disabled="busy" @click="rejectReport(report)">Reject</Button>
+                    </div>
+                </div>
+            </div>
+        </CardContent>
+    </Card>
+</template>
+
+<script setup>
+    import { onMounted, reactive, ref } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { Button } from '@/components/ui/button';
+    import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+    import { NativeSelect, NativeSelectOption } from '@/components/ui/native-select';
+
+    import { openExternalLink } from '../../shared/utils';
+    import { categoryLabel } from '../../shared/utils/uwxSafety';
+    import { LABEL_DURATIONS, useUwxLabelsStore } from '../../stores/uwxLabels';
+    import { useModalStore } from '../../stores';
+
+    const labels = useUwxLabelsStore();
+    const { queue, queueLoading, busy } = storeToRefs(labels);
+    const { loadQueue } = labels;
+    const modalStore = useModalStore();
+
+    const openId = ref('');
+    const draft = reactive({ publicSummary: '', riskLevel: 'caution', days: 180 });
+
+    function startApprove(report) {
+        openId.value = report.id;
+        draft.publicSummary = '';
+        draft.riskLevel = report.suggested_severity || 'caution';
+        draft.days = 180;
+    }
+
+    async function approve(report) {
+        if (await labels.approve(report, { ...draft, days: Number(draft.days) })) openId.value = '';
+    }
+
+    async function rejectReport(report) {
+        const { ok, value } = await modalStore.prompt({
+            title: 'Reject this report?',
+            description: 'Private reason for staff (10+ characters). Nothing is published.',
+            confirmText: 'Reject'
+        });
+        if (ok) await labels.reject(report, value);
+    }
+
+    function when(ts) {
+        return new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
+    }
+
+    onMounted(loadQueue);
+</script>
+
+<style scoped>
+    .uwx-queue {
+        display: flex;
+        flex-direction: column;
+        gap: 10px;
+    }
+    .uwx-queue-item {
+        padding: 12px;
+        border-radius: 10px;
+        border: 1px solid var(--border);
+        border-left: 3px solid #ffb84d;
+    }
+    .uwx-queue-cat {
+        margin-left: 8px;
+        font-size: 11px;
+        padding: 1px 8px;
+        border-radius: 999px;
+        color: #ffb84d;
+        border: 1px solid rgb(255 184 77 / 45%);
+    }
+    .uwx-queue-summary {
+        margin-top: 8px;
+        font-size: 13px;
+        white-space: pre-wrap;
+        overflow-wrap: anywhere;
+    }
+    .uwx-queue-form {
+        display: flex;
+        flex-direction: column;
+        gap: 8px;
+        margin-top: 10px;
+    }
+    .uwx-report-input {
+        width: 100%;
+        padding: 8px 10px;
+        border-radius: 8px;
+        border: 1px solid var(--border);
+        background: rgb(0 0 0 / 20%);
+        font-size: 13px;
+    }
+</style>
