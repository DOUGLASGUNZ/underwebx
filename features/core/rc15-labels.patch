@@ -0,0 +1,52 @@
+// Shared "bad news" labels (UWX Safety Intel): labels, risk ordering and alert decisions.
+
+export const LABEL_CATEGORIES = Object.freeze([
+    { id: 'crashing', label: 'Crasher', icon: 'ri-flashlight-line' },
+    { id: 'doxxing_privacy_threat', label: 'Doxxer / privacy threat', icon: 'ri-spy-line' },
+    { id: 'malicious_client_behavior', label: 'Malicious client', icon: 'ri-bug-line' },
+    { id: 'harassment', label: 'Harasser', icon: 'ri-chat-off-line' },
+    { id: 'scam_impersonation', label: 'Scammer / impersonator', icon: 'ri-mask-line' },
+    { id: 'ban_evasion', label: 'Ban evader', icon: 'ri-door-lock-line' },
+    { id: 'other', label: 'Other bad news', icon: 'ri-error-warning-line' }
+]);
+
+const RISK_ORDER = { info: 1, caution: 2, high: 3 };
+
+export function categoryLabel(id) {
+    return LABEL_CATEGORIES.find((c) => c.id === id)?.label || String(id || '').replaceAll('_', ' ');
+}
+
+export function riskLabel(level) {
+    if (level === 'high') return 'High risk';
+    if (level === 'caution') return 'Caution';
+    return 'Heads up';
+}
+
+export function riskRank(level) {
+    return RISK_ORDER[level] || 0;
+}
+
+/** Short one-line label, e.g. "Crasher · Malicious client". */
+export function labelSummary(intel) {
+    const flags = Array.isArray(intel?.verified_flags) ? intel.verified_flags : [];
+    return flags.length ? flags.map(categoryLabel).join(' · ') : riskLabel(intel?.risk_level);
+}
+
+/**
+ * Which labeled people in the lobby we haven't warned about yet.
+ * @param {Array<{userId:string, displayName:string}>} players
+ * @param {(id:string) => object|null} getIntel
+ * @param {Set<string>} alreadyAlerted  userIds already warned about for this instance
+ * @param {string} minLevel  'info' | 'caution' | 'high'
+ */
+export function pendingAlerts(players, getIntel, alreadyAlerted, minLevel = 'info') {
+    const min = riskRank(minLevel);
+    const out = [];
+    for (const player of players || []) {
+        const intel = getIntel(player.userId);
+        if (!intel || alreadyAlerted.has(player.userId)) continue;
+        if (riskRank(intel.risk_level) < min) continue;
+        out.push({ ...player, intel });
+    }
+    return out.sort((a, b) => riskRank(b.intel.risk_level) - riskRank(a.intel.risk_level));
+}
