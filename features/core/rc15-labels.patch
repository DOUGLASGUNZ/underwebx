@@ -0,0 +1,237 @@
+import { computed, ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+
+// UnderWeb account sign-in inside UWX (email + 6-digit code, the same passwordless
+// sign-in as underweb.cloud). This is your UnderWeb account — never your VRChat login.
+// The refresh token is kept in UWX's local settings on this PC and never logged.
+// What you can do once signed in is decided by the server (RLS / staff checks), not by UWX.
+
+export const UNDERWEB_SUPABASE_URL = 'https://pxipclkptxpqukefwexh.supabase.co';
+// Publishable (anon) key — safe to ship in a client.
+export const UNDERWEB_ANON_KEY =
+    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB4aXBjbGtwdHhwcXVrZWZ3ZXhoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwOTM0MDcsImV4cCI6MjEwNDY2OTQwN30.B7hucEUAMsVvoyEpScq9SWQXEGsfg3C9FHuRTBLgKnc';
+
+const REFRESH_KEY = 'UWX_underwebRefreshToken';
+const EMAIL_KEY = 'UWX_underwebEmail';
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function authError(json, status) {
+    const msg = json?.msg || json?.error_description || json?.message || json?.error || '';
+    if (status === 429) return 'Too many attempts. Wait a minute and try again.';
+    if (/expired|invalid/i.test(msg)) return 'That code is wrong or expired. Request a new one.';
+    if (/signups not allowed|user not found/i.test(msg)) return 'No UnderWeb account uses that email. Join on underweb.cloud first.';
+    return msg || `Sign-in failed (${status}).`;
+}
+
+export const useUwxAccountStore = defineStore('UwxAccount', () => {
+    const email = ref('');
+    const userId = ref('');
+    const accessToken = ref('');
+    const expiresAt = ref(0);
+    const isStaff = ref(false);
+    const canReviewSafety = ref(false);
+    const busy = ref(false);
+    const codeSentTo = ref('');
+    const initialized = ref(false);
+    let refreshToken = '';
+    let refreshing = null;
+
+    const signedIn = computed(() => Boolean(accessToken.value && userId.value));
+
+    async function authFetch(path, body) {
+        const response = await fetch(`${UNDERWEB_SUPABASE_URL}/auth/v1/${path}`, {
+            method: 'POST',
+            headers: { apikey: UNDERWEB_ANON_KEY, 'Content-Type': 'application/json' },
+            body: JSON.stringify(body)
+        });
+        const json = await response.json().catch(() => ({}));
+        if (!response.ok) throw new Error(authError(json, response.status));
+        return json;
+    }
+
+    async function applySession(json) {
+        accessToken.value = json.access_token || '';
+        refreshToken = json.refresh_token || '';
+        expiresAt.value = Date.now() + (Number(json.expires_in) || 3600) * 1000;
+        userId.value = json.user?.id || '';
+        email.value = json.user?.email || email.value;
+        await configRepository.setString(REFRESH_KEY, refreshToken);
+        await configRepository.setString(EMAIL_KEY, email.value);
+        await loadPermissions();
+    }
+
+    async function clearSession() {
+        accessToken.value = '';
+        refreshToken = '';
+        userId.value = '';
+        expiresAt.value = 0;
+        isStaff.value = false;
+        canReviewSafety.value = false;
+        await configRepository.setString(REFRESH_KEY, '');
+    }
+
+    async function requestCode(address) {
+        const value = String(address || '').trim().toLowerCase();
+        if (!EMAIL_RE.test(value)) {
+            toast.error('Enter the email you use for UnderWeb.');
+            return false;
+        }
+        busy.value = true;
+        try {
+            await authFetch('otp', { email: value, create_user: false });
+            email.value = value;
+            codeSentTo.value = value;
+            toast.success(`Code sent to ${value}.`);
+            return true;
+        } catch (error) {
+            toast.error(error.message);
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    async function verifyCode(code) {
+        const token = String(code || '').replace(/\s+/g, '');
+        if (!/^\d{6,10}$/.test(token)) {
+            toast.error('Enter the code from the email.');
+            return false;
+        }
+        busy.value = true;
+        try {
+            const json = await authFetch('verify', { type: 'email', email: codeSentTo.value || email.value, token });
+            await applySession(json);
+            codeSentTo.value = '';
+            toast.success('Signed in to UnderWeb.');
+            return true;
+        } catch (error) {
+            toast.error(error.message);
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    async function refresh() {
+        if (!refreshToken) return false;
+        if (refreshing) return refreshing;
+        refreshing = (async () => {
+            try {
+                const response = await fetch(`${UNDERWEB_SUPABASE_URL}/auth/v1/token?grant_type=refresh_token`, {
+                    method: 'POST',
+                    headers: { apikey: UNDERWEB_ANON_KEY, 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ refresh_token: refreshToken })
+                });
+                const json = await response.json().catch(() => ({}));
+                if (!response.ok) {
+                    // Refresh token revoked or expired: sign out locally.
+                    if (response.status === 400 || response.status === 401) await clearSession();
+                    return false;
+                }
+                await applySession(json);
+                return true;
+            } catch {
+                return false;
+            } finally {
+                refreshing = null;
+            }
+        })();
+        return refreshing;
+    }
+
+    /** fetch() against UnderWeb's REST API as you, refreshing the session if needed. */
+    async function api(path, init = {}) {
+        if (!signedIn.value && !(await refresh())) throw new Error('Sign in to UnderWeb first.');
+        if (Date.now() > expiresAt.value - 60 * 1000) await refresh();
+        const doFetch = () =>
+            fetch(`${UNDERWEB_SUPABASE_URL}/rest/v1/${path}`, {
+                ...init,
+                headers: {
+                    apikey: UNDERWEB_ANON_KEY,
+                    Authorization: `Bearer ${accessToken.value}`,
+                    'Content-Type': 'application/json',
+                    Accept: 'application/json',
+                    ...(init.headers || {})
+                }
+            });
+        let response = await doFetch();
+        if (response.status === 401 && (await refresh())) response = await doFetch();
+        const text = await response.text();
+        let json = null;
+        try {
+            json = text ? JSON.parse(text) : null;
+        } catch {
+            json = text;
+        }
+        if (!response.ok) {
+            const message = json?.message || json?.hint || `Request failed (${response.status}).`;
+            const error = /** @type {Error & { status?: number }} */ (new Error(message));
+            error.status = response.status;
+            throw error;
+        }
+        return json;
+    }
+
+    const rpc = (name, args = {}) => api(`rpc/${name}`, { method: 'POST', body: JSON.stringify(args) });
+
+    async function loadPermissions() {
+        try {
+            isStaff.value = Boolean(await rpc('uwx_is_underweb_staff'));
+        } catch {
+            isStaff.value = false;
+        }
+        try {
+            canReviewSafety.value = Boolean(await rpc('uwx_can_review_safety'));
+        } catch {
+            canReviewSafety.value = false;
+        }
+    }
+
+    async function init() {
+        if (initialized.value) return;
+        initialized.value = true;
+        email.value = (await configRepository.getString(EMAIL_KEY, '')) || '';
+        refreshToken = (await configRepository.getString(REFRESH_KEY, '')) || '';
+        if (refreshToken) await refresh();
+    }
+
+    async function signOut() {
+        if (accessToken.value) {
+            try {
+                await fetch(`${UNDERWEB_SUPABASE_URL}/auth/v1/logout?scope=local`, {
+                    method: 'POST',
+                    headers: { apikey: UNDERWEB_ANON_KEY, Authorization: `Bearer ${accessToken.value}` }
+                });
+            } catch {
+                // Signing out locally is enough if the network is down.
+            }
+        }
+        await clearSession();
+        toast.success('Signed out of UnderWeb.');
+    }
+
+    function cancelCode() {
+        codeSentTo.value = '';
+    }
+
+    return {
+        email,
+        userId,
+        isStaff,
+        canReviewSafety,
+        signedIn,
+        busy,
+        codeSentTo,
+        init,
+        requestCode,
+        verifyCode,
+        cancelCode,
+        signOut,
+        api,
+        rpc,
+        loadPermissions
+    };
+});
diff --git a/src/stores/uwxLabels.js b/src/stores/uwxLabels.js
new file mode 100644
index 0000000..e90de02
--- /dev/null
+++ b/src/stores/uwxLabels.js
@@ -0,0 +1,195 @@
+import { ref } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import { useSafetyIntelStore } from './safetyIntel';
+import { useUwxAccountStore } from './uwxAccount';
+
+// Staff side of the shared "bad news" labels. Every action here runs as the signed-in
+// UnderWeb account; the database decides who may do it (safety reviewers: Owner,
+// Director, Moderator, Security, Admin). UWX only hides buttons you can't use.
+
+const USER_ID_RE = /^usr_[A-Za-z0-9-]{8,}$/;
+const DAY = 24 * 60 * 60 * 1000;
+const REPORT_FIELDS =
+    'id,vrchat_user_id,last_known_display_name,category,suggested_severity,incident_at,incident_world,summary,status,created_at,private_evidence_url,source';
+
+export const LABEL_DURATIONS = Object.freeze([
+    { days: 30, label: '30 days' },
+    { days: 90, label: '3 months' },
+    { days: 180, label: '6 months' },
+    { days: 365, label: '1 year (max)' }
+]);
+
+function cleanSummary(text) {
+    return String(text || '').trim().replace(/\s+/g, ' ');
+}
+
+/** Checks the same rules the database enforces, so staff get a clear message first. */
+export function validateLabel({ vrchatUserId, category, riskLevel, publicSummary, reason, days }) {
+    if (!USER_ID_RE.test(String(vrchatUserId || ''))) return 'That isn’t a valid VRChat user ID (usr_…).';
+    if (!category) return 'Pick what kind of bad news this is.';
+    if (!['info', 'caution', 'high'].includes(riskLevel)) return 'Pick a risk level.';
+    const summary = cleanSummary(publicSummary);
+    if (summary.length < 20 || summary.length > 500) return 'The public note needs 20–500 characters (everyone using UWX sees it).';
+    if (cleanSummary(reason).length < 10) return 'Add what happened for staff (at least 10 characters, private).';
+    if (!LABEL_DURATIONS.some((d) => d.days === Number(days))) return 'Pick how long the label lasts.';
+    return '';
+}
+
+export const useUwxLabelsStore = defineStore('UwxLabels', () => {
+    const account = useUwxAccountStore();
+    const safety = useSafetyIntelStore();
+
+    const queue = ref([]);
+    const queueLoading = ref(false);
+    const busy = ref(false);
+
+    async function review(reportId, decision, { publicSummary = null, riskLevel = null, days = null, note = null } = {}) {
+        return account.rpc('uwx_review_safety_report', {
+            p_report_id: reportId,
+            p_decision: decision,
+            p_review_note: note,
+            p_public_summary: decision === 'verified' ? cleanSummary(publicSummary) : null,
+            p_risk_level: decision === 'verified' ? riskLevel : null,
+            p_expires_at: decision === 'verified' ? new Date(Date.now() + Number(days) * DAY).toISOString() : null
+        });
+    }
+
+    /** Staff: label someone right now (creates the report and verifies it in one step). */
+    async function labelNow(input) {
+        const problem = validateLabel(input);
+        if (problem) {
+            toast.error(problem);
+            return false;
+        }
+        if (!account.canReviewSafety) {
+            toast.error('Only UnderWeb safety reviewers can publish labels. Use Report instead.');
+            return false;
+        }
+        busy.value = true;
+        try {
+            const rows = await account.api(`uwx_safety_reports?select=id`, {
+                method: 'POST',
+                headers: { Prefer: 'return=representation' },
+                body: JSON.stringify({
+                    vrchat_user_id: input.vrchatUserId,
+                    last_known_display_name: String(input.displayName || '').trim().slice(0, 100) || null,
+                    category: input.category,
+                    suggested_severity: input.riskLevel,
+                    summary: cleanSummary(input.reason).slice(0, 2000),
+                    incident_world: String(input.world || '').trim().slice(0, 160) || null,
+                    private_evidence_url: String(input.evidenceUrl || '').trim() || null,
+                    status: 'pending',
+                    source: 'uwx'
+                })
+            });
+            const reportId = Array.isArray(rows) ? rows[0]?.id : rows?.id;
+            if (!reportId) throw new Error('The report was saved but UWX could not read it back to publish it. Check the review queue.');
+            await review(reportId, 'verified', {
+                publicSummary: input.publicSummary,
+                riskLevel: input.riskLevel,
+                days: input.days,
+                note: 'Labeled directly from UWX.'
+            });
+            await safety.lookupUser(input.vrchatUserId, { force: true }).catch(() => {});
+            toast.success(`${input.displayName || input.vrchatUserId} is now labeled for everyone using UWX.`);
+            return true;
+        } catch (error) {
+            toast.error(error?.message || 'Could not publish the label.');
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    async function loadQueue() {
+        if (!account.canReviewSafety) return [];
+        queueLoading.value = true;
+        try {
+            const rows = await account.api(
+                `uwx_safety_reports?select=${REPORT_FIELDS}&status=in.(pending,reviewing)&order=created_at.desc&limit=50`
+            );
+            queue.value = Array.isArray(rows) ? rows : [];
+        } catch (error) {
+            toast.error(error?.message || 'Could not load the review queue.');
+        } finally {
+            queueLoading.value = false;
+        }
+        return queue.value;
+    }
+
+    async function approve(report, { publicSummary, riskLevel, days }) {
+        const problem = validateLabel({
+            vrchatUserId: report.vrchat_user_id,
+            category: report.category,
+            riskLevel,
+            publicSummary,
+            reason: report.summary,
+            days
+        });
+        if (problem) {
+            toast.error(problem);
+            return false;
+        }
+        busy.value = true;
+        try {
+            await review(report.id, 'verified', { publicSummary, riskLevel, days, note: 'Approved in UWX.' });
+            queue.value = queue.value.filter((r) => r.id !== report.id);
+            await safety.lookupUser(report.vrchat_user_id, { force: true }).catch(() => {});
+            toast.success('Label published.');
+            return true;
+        } catch (error) {
+            toast.error(error?.message || 'Could not approve.');
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    async function reject(report, reason) {
+        if (cleanSummary(reason).length < 10) {
+            toast.error('Add a short private reason (10+ characters).');
+            return false;
+        }
+        busy.value = true;
+        try {
+            await review(report.id, 'rejected', { note: cleanSummary(reason) });
+            queue.value = queue.value.filter((r) => r.id !== report.id);
+            toast.success('Report rejected. Nothing was published.');
+            return true;
+        } catch (error) {
+            toast.error(error?.message || 'Could not reject.');
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    /** Staff: take a label down (expires every verified report for that person). */
+    async function removeLabel(vrchatUserId, reason) {
+        if (cleanSummary(reason).length < 10) {
+            toast.error('Add a short private reason for removing the label (10+ characters).');
+            return false;
+        }
+        busy.value = true;
+        try {
+            const rows = await account.api(
+                `uwx_safety_reports?select=id&vrchat_user_id=eq.${encodeURIComponent(vrchatUserId)}&status=eq.verified`
+            );
+            for (const row of Array.isArray(rows) ? rows : []) {
+                await review(row.id, 'expired', { note: cleanSummary(reason) });
+            }
+            await safety.lookupUser(vrchatUserId, { force: true }).catch(() => {});
+            toast.success('Label removed for everyone.');
+            return true;
+        } catch (error) {
+            toast.error(error?.message || 'Could not remove the label.');
+            return false;
+        } finally {
+            busy.value = false;
+        }
+    }
+
+    return { queue, queueLoading, busy, labelNow, loadQueue, approve, reject, removeLabel };
+});
diff --git a/src/stores/uwxLobbyGuard.js b/src/stores/uwxLobbyGuard.js
new file mode 100644
index 0000000..39ac4cb
--- /dev/null
+++ b/src/stores/uwxLobbyGuard.js
@@ -0,0 +1,135 @@
+import { computed, reactive, ref, watch } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import { labelSummary, pendingAlerts, riskLabel, riskRank } from '../shared/utils/uwxSafety';
+import { useLocationStore } from './location';
+import { useSafetyIntelStore } from './safetyIntel';
+import { useUserStore } from './user';
+
+// Lobby Guard: checks everyone in your instance against the shared, staff-reviewed
+// "bad news" labels as they join, and warns you privately. It never kicks, bans,
+// blocks or tells anyone else — it's a heads-up for you.
+// Only VRChat user IDs are sent to the label lookup (no names, worlds or your identity).
+
+const CONFIG = Object.freeze({
+    enabled: 'UWX_lobbyGuardEnabled',
+    minLevel: 'UWX_lobbyGuardMinLevel'
+});
+const DEBOUNCE_MS = 1500;
+const RECHECK_MS = 10 * 60 * 1000;
+
+export const useUwxLobbyGuardStore = defineStore('UwxLobbyGuard', () => {
+    const locationStore = useLocationStore();
+    const safety = useSafetyIntelStore();
+    const userStore = useUserStore();
+
+    const enabled = ref(true);
+    const minLevel = ref('info');
+    const lastCheckAt = ref(0);
+    const lastError = ref('');
+    const initialized = ref(false);
+    // Warned about in the current instance: userId -> true
+    const alerted = reactive(new Set());
+
+    let debounceTimer = null;
+    let recheckTimer = null;
+    let lastLocation = '';
+    const stops = [];
+
+    const players = computed(() =>
+        Array.from(locationStore.lastLocation.playerList?.values?.() || [])
+            .map((p) => ({ userId: String(p?.userId || ''), displayName: p?.displayName || p?.userId || 'Unknown' }))
+            .filter((p) => p.userId.startsWith('usr_') && p.userId !== userStore.currentUser?.id)
+    );
+
+    /** Labeled people in your instance right now, worst first. */
+    const flaggedHere = computed(() =>
+        players.value
+            .map((p) => ({ ...p, intel: safety.getIntel(p.userId) }))
+            .filter((p) => p.intel)
+            .sort((a, b) => riskRank(b.intel.risk_level) - riskRank(a.intel.risk_level))
+    );
+
+    async function check({ force = false } = {}) {
+        if (!enabled.value || !players.value.length) return;
+        try {
+            await safety.batchLookup(
+                players.value.map((p) => p.userId),
+                { force }
+            );
+            lastCheckAt.value = Date.now();
+            lastError.value = '';
+        } catch (error) {
+            lastError.value = error?.message || 'Could not check labels.';
+            return;
+        }
+        const fresh = pendingAlerts(players.value, (id) => safety.getIntel(id), alerted, minLevel.value);
+        for (const person of fresh) {
+            alerted.add(person.userId);
+            const level = person.intel.risk_level;
+            const message = `${person.displayName} is labeled: ${labelSummary(person.intel)}`;
+            const options = {
+                description: person.intel.public_summary || `${riskLabel(level)} · ${person.intel.verified_report_count} verified report(s)`,
+                duration: level === 'high' ? 20000 : 10000
+            };
+            if (level === 'high') toast.error(message, options);
+            else toast.warning(message, options);
+        }
+    }
+
+    function schedule(force = false) {
+        if (debounceTimer) clearTimeout(debounceTimer);
+        debounceTimer = setTimeout(() => {
+            debounceTimer = null;
+            void check({ force });
+        }, DEBOUNCE_MS);
+    }
+
+    async function init() {
+        if (initialized.value) return;
+        initialized.value = true;
+        enabled.value = await configRepository.getBool(CONFIG.enabled, true);
+        const level = await configRepository.getString(CONFIG.minLevel, 'info');
+        minLevel.value = ['info', 'caution', 'high'].includes(level) ? level : 'info';
+
+        stops.push(watch(
+            () => locationStore.lastLocation.location,
+            (location) => {
+                if (location !== lastLocation) {
+                    lastLocation = location;
+                    alerted.clear(); // warn again in a new instance
+                }
+                schedule(true);
+            }
+        ));
+        stops.push(watch(
+            () => players.value.map((p) => p.userId).join(','),
+            () => schedule(false)
+        ));
+        // Labels can be added while you're in an instance; recheck now and then.
+        recheckTimer = setInterval(() => void check({ force: true }), RECHECK_MS);
+        schedule(true);
+    }
+
+    async function setEnabled(value) {
+        enabled.value = Boolean(value);
+        await configRepository.setBool(CONFIG.enabled, enabled.value);
+        if (enabled.value) schedule(true);
+    }
+
+    async function setMinLevel(value) {
+        minLevel.value = ['info', 'caution', 'high'].includes(value) ? value : 'info';
+        await configRepository.setString(CONFIG.minLevel, minLevel.value);
+    }
+
+    function dispose() {
+        if (recheckTimer) clearInterval(recheckTimer);
+        if (debounceTimer) clearTimeout(debounceTimer);
+        stops.splice(0).forEach((stop) => stop());
+        initialized.value = false;
+    }
+
+    return { enabled, minLevel, lastCheckAt, lastError, flaggedHere, players, init, check, setEnabled, setMinLevel, dispose };
+});
