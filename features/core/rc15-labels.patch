+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { reactive } from 'vue';
+
+const config = {};
+vi.mock('../../services/config', () => ({
+    default: {
+        getBool: vi.fn(async (k, d) => (k in config ? config[k] : d)),
+        setBool: vi.fn(async (k, v) => (config[k] = v)),
+        getString: vi.fn(async (k, d) => (k in config ? config[k] : d)),
+        setString: vi.fn(async (k, v) => (config[k] = v))
+    }
+}));
+const toast = { error: vi.fn(), warning: vi.fn() };
+vi.mock('vue-sonner', () => ({ toast }));
+
+const ME = 'usr_00000000-0000-0000-0000-000000000000';
+const CRASHER = 'usr_11111111-0000-0000-0000-000000000000';
+const MINOR = 'usr_22222222-0000-0000-0000-000000000000';
+const FINE = 'usr_33333333-0000-0000-0000-000000000000';
+const labels = {
+    [CRASHER]: { vrchat_user_id: CRASHER, risk_level: 'high', verified_flags: ['crashing', 'malicious_client_behavior'], verified_report_count: 3, public_summary: 'Crashed two UnderWeb events with a modded client.' },
+    [MINOR]: { vrchat_user_id: MINOR, risk_level: 'info', verified_flags: ['other'], verified_report_count: 1, public_summary: '' }
+};
+const safety = { getIntel: (id) => labels[id] || null, batchLookup: vi.fn(async () => []) };
+vi.mock('../safetyIntel', () => ({ useSafetyIntelStore: () => safety }));
+const locationStore = reactive({ lastLocation: { location: 'wrld_a:1', playerList: new Map() } });
+vi.mock('../location', () => ({ useLocationStore: () => locationStore }));
+vi.mock('../user', () => ({ useUserStore: () => ({ currentUser: { id: ME } }) }));
+
+const { useUwxLobbyGuardStore } = await import('../uwxLobbyGuard');
+
+function lobby(...people) {
+    locationStore.lastLocation.playerList = new Map(people.map(([id, name]) => [id, { userId: id, displayName: name }]));
+}
+
+describe('UWX Lobby Guard', () => {
+    afterEach(() => useUwxLobbyGuardStore().dispose());
+    beforeEach(() => {
+        vi.useFakeTimers();
+        setActivePinia(createPinia());
+        for (const k of Object.keys(config)) delete config[k];
+        toast.error.mockReset();
+        toast.warning.mockReset();
+        safety.batchLookup.mockClear();
+        locationStore.lastLocation.location = 'wrld_a:1';
+        lobby([ME, 'Darko'], [FINE, 'Friendly']);
+    });
+
+    test('warns privately when a labeled person joins, once per instance', async () => {
+        const guard = useUwxLobbyGuardStore();
+        await guard.init();
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(toast.error).not.toHaveBeenCalled();
+
+        lobby([ME, 'Darko'], [FINE, 'Friendly'], [CRASHER, 'BadActor']);
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(toast.error).toHaveBeenCalledTimes(1);
+        expect(toast.error.mock.calls[0][0]).toBe('BadActor is labeled: Crasher · Malicious client');
+        expect(guard.flaggedHere.map((p) => p.displayName)).toEqual(['BadActor']);
+        // Only IDs are looked up, and never your own.
+        expect(safety.batchLookup.mock.calls.at(-1)[0]).not.toContain(ME);
+
+        lobby([ME, 'Darko'], [CRASHER, 'BadActor']);
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(toast.error).toHaveBeenCalledTimes(1);
+
+        locationStore.lastLocation.location = 'wrld_b:2';
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(toast.error).toHaveBeenCalledTimes(2);
+    });
+
+    test('respects the minimum level and the off switch', async () => {
+        const guard = useUwxLobbyGuardStore();
+        await guard.init();
+        await guard.setMinLevel('caution');
+        lobby([ME, 'Darko'], [MINOR, 'Meh']);
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(toast.warning).not.toHaveBeenCalled();
+        await guard.setMinLevel('info');
+        await guard.check();
+        expect(toast.warning).toHaveBeenCalledTimes(1);
+
+        await guard.setEnabled(false);
+        safety.batchLookup.mockClear();
+        lobby([ME, 'Darko'], [CRASHER, 'BadActor']);
+        await vi.advanceTimersByTimeAsync(2000);
+        expect(safety.batchLookup).not.toHaveBeenCalled();
+    });
+});
