+<template>
+    <Card class="uwx-card">
+        <CardHeader>
+            <CardTitle>UnderWeb account</CardTitle>
+            <CardDescription>
+                Sign in with the email you use on underweb.cloud. This is your UnderWeb account — never your VRChat login.
+            </CardDescription>
+        </CardHeader>
+        <CardContent class="space-y-3">
+            <template v-if="signedIn">
+                <div class="uwx-acct-row">
+                    <span class="uwx-acct-avatar"><i class="ri-user-3-line" /></span>
+                    <div class="min-w-0 flex-1">
+                        <strong class="block truncate">{{ email }}</strong>
+                        <div class="flex flex-wrap gap-1 mt-1">
+                            <Badge v-if="isStaff" variant="default">UNDERWEB STAFF</Badge>
+                            <Badge v-if="canReviewSafety" variant="outline">LABEL REVIEWER</Badge>
+                            <Badge v-if="!isStaff && !canReviewSafety" variant="outline">MEMBER</Badge>
+                        </div>
+                    </div>
+                    <Button size="sm" variant="ghost" @click="signOut">Sign out</Button>
+                </div>
+                <p class="uwx-help">
+                    <template v-if="canReviewSafety">You can publish and remove shared labels and review reports in Safety Intel.</template>
+                    <template v-else>Staff tools appear here automatically if your UnderWeb role allows them.</template>
+                </p>
+            </template>
+
+            <form v-else-if="!codeSentTo" class="flex flex-wrap gap-2" @submit.prevent="requestCode(emailDraft)">
+                <Input v-model="emailDraft" type="email" class="flex-1 min-w-[12rem]" placeholder="you@example.com" aria-label="UnderWeb email" autocomplete="email" />
+                <Button type="submit" :disabled="busy">{{ busy ? 'Sending…' : 'Email me a code' }}</Button>
+            </form>
+
+            <form v-else class="space-y-2" @submit.prevent="verifyCode(code)">
+                <p class="text-sm">Enter the code sent to <strong>{{ codeSentTo }}</strong>.</p>
+                <div class="flex flex-wrap gap-2">
+                    <Input v-model="code" inputmode="numeric" autocomplete="one-time-code" class="max-w-[10rem] tracking-widest" placeholder="123456" aria-label="Sign-in code" />
+                    <Button type="submit" :disabled="busy">{{ busy ? 'Checking…' : 'Sign in' }}</Button>
+                    <Button type="button" variant="ghost" @click="cancelCode">Use a different email</Button>
+                </div>
+                <p class="uwx-help">No code? Check spam. If the email only has a link and no code, the site's email template needs the code added (Supabase → Authentication → Email templates).</p>
+            </form>
