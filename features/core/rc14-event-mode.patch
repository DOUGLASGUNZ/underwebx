@@ -0,0 +1,158 @@
+// UWX Event Mode helpers (pure). An event run switches UWX into an event setup
+// (recruiting, invites + message, chatbox status), tracks who came, and produces a recap.
+
+export const EVENT_SCOPES = Object.freeze(['selected', 'favorites', 'all-online', 'staff', 'creators', 'partners']);
+
+export const DEFAULT_EVENT_PRESETS = Object.freeze([
+    {
+        id: 'music-video-night',
+        name: 'Music Video Night',
+        status: '🎬 Music Video Night — come through',
+        recruit: true,
+        autoInvite: true,
+        scope: 'favorites',
+        messageSlot: -1
+    },
+    {
+        id: 'cinema-night',
+        name: 'Cinema Night',
+        status: '🍿 UnderWeb Cinema — movie starting soon',
+        recruit: true,
+        autoInvite: true,
+        scope: 'favorites',
+        messageSlot: -1
+    },
+    {
+        id: 'hub-hangout',
+        name: 'Hub Hangout',
+        status: 'Hanging at the UnderWeb Hub',
+        recruit: true,
+        autoInvite: false,
+        scope: 'favorites',
+        messageSlot: -1
+    },
+    {
+        id: 'staff-meeting',
+        name: 'Staff Meeting',
+        status: 'Staff meeting — back soon',
+        recruit: false,
+        autoInvite: true,
+        scope: 'staff',
+        messageSlot: -1
+    }
+]);
+
+export function normalizePreset(raw, fallbackId = '') {
+    const name = String(raw?.name || '').trim().slice(0, 60);
+    if (!name) return null;
+    const slot = Number(raw?.messageSlot);
+    return {
+        id: String(raw?.id || fallbackId || name.toLowerCase().replace(/[^a-z0-9]+/g, '-')).slice(0, 60),
+        name,
+        status: String(raw?.status || '').trim().slice(0, 140),
+        recruit: Boolean(raw?.recruit),
+        autoInvite: Boolean(raw?.autoInvite),
+        scope: EVENT_SCOPES.includes(raw?.scope) ? raw.scope : 'favorites',
+        messageSlot: Number.isInteger(slot) && slot >= 0 && slot < 12 ? slot : -1
+    };
+}
+
+export function normalizePresets(list) {
+    const out = [];
+    for (const raw of Array.isArray(list) ? list : []) {
+        const preset = normalizePreset(raw);
+        if (preset && !out.some((p) => p.id === preset.id)) out.push(preset);
+    }
+    return out.length ? out : DEFAULT_EVENT_PRESETS.map((p) => ({ ...p }));
+}
+
+/** Fresh attendance tracker. */
+export function createAttendance(startedAt) {
+    return { startedAt, lastTickAt: startedAt, peak: 0, peakAt: startedAt, people: {}, instances: [] };
+}
+
+/**
+ * Record who is in the lobby right now. `players` is [{ userId, displayName }].
+ * Time present is accumulated per person; leaving and rejoining is handled.
+ * Mutates and returns `state` (it's plain JSON so it can be saved between restarts).
+ */
+export function trackAttendance(state, players, now, { selfId = '', location = '' } = {}) {
+    const present = new Set();
+    const elapsed = Math.max(0, now - (state.lastTickAt || now));
+    for (const player of players || []) {
+        const id = String(player?.userId || '');
+        if (!id.startsWith('usr_') || id === selfId) continue;
+        present.add(id);
+        const person = state.people[id] || { name: player.displayName || id, firstSeen: now, lastSeen: now, ms: 0, present: false };
+        if (person.present) person.ms += elapsed;
+        person.present = true;
+        person.lastSeen = now;
+        if (player.displayName) person.name = player.displayName;
+        state.people[id] = person;
+    }
+    for (const [id, person] of Object.entries(state.people)) {
+        if (!present.has(id) && person.present) {
+            person.ms += elapsed;
+            person.present = false;
+        }
+    }
+    if (present.size > state.peak) {
+        state.peak = present.size;
+        state.peakAt = now;
+    }
+    if (location && state.instances[state.instances.length - 1] !== location) state.instances.push(location);
+    state.lastTickAt = now;
+    return state;
+}
+
+export function currentHeadcount(state) {
+    return Object.values(state?.people || {}).filter((p) => p.present).length;
+}
+
+/**
+ * Summary for the history list and for posting to Discord.
+ * @param {object} run { name, startedAt, endedAt, groupInvites, instanceInvites, attendance, staffIds: Set|string[] }
+ */
+export function buildRecap(run) {
+    const people = Object.entries(run.attendance?.people || {}).map(([userId, p]) => ({ userId, ...p }));
+    const staff = new Set(run.staffIds || []);
+    const durationMs = Math.max(0, (run.endedAt || Date.now()) - run.startedAt);
+    const stayed = people.filter((p) => p.ms >= 5 * 60 * 1000);
+    return {
+        name: run.name,
+        startedAt: run.startedAt,
+        endedAt: run.endedAt,
+        durationMs,
+        peak: run.attendance?.peak || 0,
+        unique: people.length,
+        stayedFiveMinutes: stayed.length,
+        groupInvites: run.groupInvites || 0,
+        instanceInvites: run.instanceInvites || 0,
+        staffPresent: people.filter((p) => staff.has(p.userId)).map((p) => p.name),
+        topStayers: people
+            .slice()
+            .sort((a, b) => b.ms - a.ms)
+            .slice(0, 5)
+            .map((p) => ({ name: p.name, minutes: Math.round(p.ms / 60000) }))
+    };
+}
+
+export function formatDuration(ms) {
+    const minutes = Math.round(ms / 60000);
+    if (minutes < 60) return `${minutes}m`;
+    const h = Math.floor(minutes / 60);
+    const m = minutes % 60;
+    return m ? `${h}h ${m}m` : `${h}h`;
+}
+
+/** Plain-text recap to paste into Discord. Names only — no IDs, locations or instance links. */
+export function formatRecap(recap) {
+    const lines = [
+        `**${recap.name}** — recap`,
+        `⏱️ ${formatDuration(recap.durationMs)} · 👥 peak ${recap.peak} · ${recap.unique} came by (${recap.stayedFiveMinutes} stayed 5m+)`,
+        `📨 ${recap.groupInvites} group invite${recap.groupInvites === 1 ? '' : 's'} · ${recap.instanceInvites} instance invite${recap.instanceInvites === 1 ? '' : 's'}`
+    ];
+    if (recap.staffPresent.length) lines.push(`🛡️ Staff: ${recap.staffPresent.join(', ')}`);
+    if (recap.topStayers.length) lines.push(`⭐ Stayed longest: ${recap.topStayers.map((p) => `${p.name} (${formatDuration(p.minutes * 60000)})`).join(', ')}`);
+    return lines.join('\n');
+}
