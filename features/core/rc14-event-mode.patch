+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { nextTick, reactive } from 'vue';
+
+const config = {};
+vi.mock('../../services/config', () => ({
+    default: {
+        getString: vi.fn(async (k, d) => (k in config ? config[k] : d)),
+        setString: vi.fn(async (k, v) => {
+            config[k] = v;
+        })
+    }
+}));
+vi.mock('vue-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn(), info: vi.fn() } }));
+
+const underweb = reactive({
+    groupRecruitEnabled: false,
+    autoInviteEnabled: false,
+    inviteScope: 'selected',
+    inviteMessageSlot: -1,
+    sessionGroupInvitesSent: 0,
+    sessionInvitesSent: 0,
+    setGroupRecruitEnabled: vi.fn(async (v) => (underweb.groupRecruitEnabled = v)),
+    setAutoInviteEnabled: vi.fn(async (v) => (underweb.autoInviteEnabled = v)),
+    setInviteScope: vi.fn(async (v) => (underweb.inviteScope = v)),
+    setInviteMessageSlot: vi.fn(async (v) => (underweb.inviteMessageSlot = v))
+});
+const osc = { eventStatus: '', setEventStatus: vi.fn((t) => (osc.eventStatus = t)) };
+const ME = 'usr_00000000-0000-0000-0000-000000000000';
+const BLOOTY = 'usr_11111111-0000-0000-0000-000000000000';
+const VEX = 'usr_22222222-0000-0000-0000-000000000000';
+const locationStore = reactive({ lastLocation: { location: 'wrld_x:1~hidden(' + ME + ')', playerList: new Map() } });
+vi.mock('../underweb', () => ({ useUnderWebStore: () => underweb }));
+vi.mock('../oscLab', () => ({ useOscLabStore: () => osc }));
+vi.mock('../location', () => ({ useLocationStore: () => locationStore }));
+vi.mock('../underwebNetwork', () => ({ useUnderWebNetworkStore: () => ({ staffUserIds: new Set([BLOOTY]) }) }));
+vi.mock('../user', () => ({ useUserStore: () => ({ currentUser: { id: ME } }) }));
+
+const { useUwxEventModeStore } = await import('../uwxEventMode');
+
+function setLobby(ids) {
+    locationStore.lastLocation.playerList = new Map(ids.map(([id, name]) => [id, { userId: id, displayName: name }]));
+}
+
+describe('UWX Event Mode', () => {
+    beforeEach(() => {
+        vi.useFakeTimers();
+        vi.setSystemTime(new Date('2026-10-16T00:00:00Z'));
+        setActivePinia(createPinia());
+        for (const k of Object.keys(config)) delete config[k];
+        Object.assign(underweb, { groupRecruitEnabled: false, autoInviteEnabled: false, inviteScope: 'selected', inviteMessageSlot: 2, sessionGroupInvitesSent: 0, sessionInvitesSent: 0 });
+        osc.eventStatus = '';
+        setLobby([[ME, 'Darko']]);
+    });
+
+    test('start switches UWX into the preset and pins the chatbox status', async () => {
+        const store = useUwxEventModeStore();
+        await store.init();
+        expect(await store.start('music-video-night')).toBe(true);
+        expect(underweb.groupRecruitEnabled).toBe(true);
+        expect(underweb.autoInviteEnabled).toBe(true);
+        expect(underweb.inviteScope).toBe('favorites');
+        expect(osc.eventStatus).toMatch(/Music Video Night/);
+        expect(await store.start('cinema-night')).toBe(false);
+    });
+
+    test('tracks attendance and invites, then end restores settings and saves a recap', async () => {
+        const store = useUwxEventModeStore();
+        await store.init();
+        await store.start('music-video-night', { name: 'MVN #12' });
+        setLobby([[ME, 'Darko'], [BLOOTY, 'Blooty'], [VEX, 'Vex']]);
+        await nextTick();
+        underweb.sessionGroupInvitesSent = 3;
+        underweb.sessionInvitesSent = 5;
+        await nextTick();
+        expect(store.headcount).toBe(2);
+        expect(store.staffHere).toEqual(['Blooty']);
+        vi.advanceTimersByTime(45 * 60 * 1000);
+        const recap = await store.end();
+        expect(recap).toMatchObject({ name: 'MVN #12', peak: 2, unique: 2, groupInvites: 3, instanceInvites: 5, staffPresent: ['Blooty'] });
+        expect(underweb.groupRecruitEnabled).toBe(false);
+        expect(underweb.autoInviteEnabled).toBe(false);
+        expect(underweb.inviteScope).toBe('selected');
+        expect(underweb.inviteMessageSlot).toBe(2);
+        expect(osc.eventStatus).toBe('');
+        expect(store.history[0].name).toBe('MVN #12');
+        expect(config.UWX_activeEventRun).toBe('');
+    });
+
+    test('an event survives UWX being closed and reopened', async () => {
+        const first = useUwxEventModeStore();
+        await first.init();
+        await first.start('cinema-night');
+        setLobby([[ME, 'Darko'], [VEX, 'Vex']]);
+        await nextTick();
+        vi.advanceTimersByTime(2000);
+        setActivePinia(createPinia());
+        osc.eventStatus = '';
+        const second = useUwxEventModeStore();
+        await second.init();
+        expect(second.isRunning).toBe(true);
+        expect(second.active.name).toBe('Cinema Night');
+        expect(osc.eventStatus).toMatch(/Cinema/);
+    });
+
+    test('presets can be added and edited', async () => {
+        const store = useUwxEventModeStore();
+        await store.init();
+        const p = await store.upsertPreset({ name: 'Halloween Party', status: '🎃 Halloween at the Hub', recruit: true, autoInvite: true, scope: 'all-online' });
+        expect(store.presets.find((x) => x.id === p.id)).toMatchObject({ scope: 'all-online' });
+        expect(JSON.parse(config.UWX_eventPresets).some((x) => x.name === 'Halloween Party')).toBe(true);
+    });
+});
