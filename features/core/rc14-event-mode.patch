@@ -0,0 +1,271 @@
+import { computed, ref, watch } from 'vue';
+import { defineStore } from 'pinia';
+import { toast } from 'vue-sonner';
+
+import configRepository from '../services/config';
+import {
+    buildRecap,
+    createAttendance,
+    currentHeadcount,
+    DEFAULT_EVENT_PRESETS,
+    formatRecap,
+    normalizePreset,
+    normalizePresets,
+    trackAttendance
+} from '../shared/utils/uwxEvent';
+import { useLocationStore } from './location';
+import { useOscLabStore } from './oscLab';
+import { useUnderWebStore } from './underweb';
+import { useUnderWebNetworkStore } from './underwebNetwork';
+import { useUserStore } from './user';
+
+// Event Mode: one button switches UWX into an event setup, tracks the night, and
+// puts everything back the way it was when the event ends.
+// Everything is stored locally on this PC.
+
+const CONFIG = Object.freeze({
+    presets: 'UWX_eventPresets',
+    active: 'UWX_activeEventRun',
+    history: 'UWX_eventHistory'
+});
+const MAX_HISTORY = 30;
+const TICK_MS = 15 * 1000;
+
+export const useUwxEventModeStore = defineStore('UwxEventMode', () => {
+    const underweb = useUnderWebStore();
+    const osc = useOscLabStore();
+    const locationStore = useLocationStore();
+    const network = useUnderWebNetworkStore();
+    const userStore = useUserStore();
+
+    const presets = ref(DEFAULT_EVENT_PRESETS.map((p) => ({ ...p })));
+    const active = ref(null); // { id, presetId, name, startedAt, before, groupInvites, instanceInvites, attendance }
+    const history = ref([]);
+    const initialized = ref(false);
+    const now = ref(Date.now());
+
+    let timer = null;
+    let unwatchPlayers = null;
+    let unwatchGroupSent = null;
+    let unwatchInstanceSent = null;
+    let saveTimer = null;
+
+    const isRunning = computed(() => Boolean(active.value));
+    const headcount = computed(() => (active.value ? currentHeadcount(active.value.attendance) : 0));
+    const elapsedMs = computed(() => (active.value ? now.value - active.value.startedAt : 0));
+    const staffHere = computed(() => {
+        if (!active.value) return [];
+        return Object.entries(active.value.attendance.people)
+            .filter(([id, p]) => p.present && network.staffUserIds.has(id))
+            .map(([, p]) => p.name);
+    });
+    const uniqueCount = computed(() => (active.value ? Object.keys(active.value.attendance.people).length : 0));
+
+    function lobby() {
+        return Array.from(locationStore.lastLocation.playerList?.values?.() || []).map((player) => ({
+            userId: String(player?.userId || ''),
+            displayName: player?.displayName || ''
+        }));
+    }
+
+    function saveSoon() {
+        if (saveTimer) clearTimeout(saveTimer);
+        saveTimer = setTimeout(() => {
+            saveTimer = null;
+            void configRepository.setString(CONFIG.active, active.value ? JSON.stringify(active.value) : '');
+        }, 1000);
+    }
+
+    function tick() {
+        now.value = Date.now();
+        if (!active.value) return;
+        trackAttendance(active.value.attendance, lobby(), now.value, {
+            selfId: userStore.currentUser?.id || '',
+            location: locationStore.lastLocation.location || ''
+        });
+        saveSoon();
+    }
+
+    function startTracking() {
+        stopTracking();
+        tick();
+        timer = setInterval(tick, TICK_MS);
+        unwatchPlayers = watch(
+            () => locationStore.lastLocation.playerList?.size,
+            () => tick()
+        );
+        // Count invites sent during the event (the store counters reset on restart, so count deltas).
+        unwatchGroupSent = watch(
+            () => underweb.sessionGroupInvitesSent,
+            (next, prev) => {
+                if (active.value && next > prev) {
+                    active.value.groupInvites += next - prev;
+                    saveSoon();
+                }
+            }
+        );
+        unwatchInstanceSent = watch(
+            () => underweb.sessionInvitesSent,
+            (next, prev) => {
+                if (active.value && next > prev) {
+                    active.value.instanceInvites += next - prev;
+                    saveSoon();
+                }
+            }
+        );
+    }
+
+    function stopTracking() {
+        if (timer) clearInterval(timer);
+        timer = null;
+        unwatchPlayers?.();
+        unwatchGroupSent?.();
+        unwatchInstanceSent?.();
+        unwatchPlayers = unwatchGroupSent = unwatchInstanceSent = null;
+    }
+
+    async function init() {
+        if (initialized.value) return;
+        initialized.value = true;
+        try {
+            presets.value = normalizePresets(JSON.parse((await configRepository.getString(CONFIG.presets, '')) || 'null'));
+        } catch {
+            presets.value = normalizePresets(null);
+        }
+        try {
+            const h = JSON.parse((await configRepository.getString(CONFIG.history, '')) || '[]');
+            history.value = Array.isArray(h) ? h.slice(0, MAX_HISTORY) : [];
+        } catch {
+            history.value = [];
+        }
+        try {
+            const saved = JSON.parse((await configRepository.getString(CONFIG.active, '')) || 'null');
+            if (saved?.startedAt && saved?.attendance) {
+                // UWX was closed mid-event: carry on. Time while closed isn't counted as presence.
+                saved.attendance.lastTickAt = Date.now();
+                for (const person of Object.values(saved.attendance.people || {})) person.present = false;
+                active.value = saved;
+                if (saved.status) osc.setEventStatus(saved.status);
+                startTracking();
+            }
+        } catch {
+            active.value = null;
+        }
+    }
+
+    async function savePresets() {
+        await configRepository.setString(CONFIG.presets, JSON.stringify(presets.value));
+    }
+
+    async function upsertPreset(raw) {
+        const preset = normalizePreset(raw, raw?.id || `event-${Date.now()}`);
+        if (!preset) {
+            toast.error('Give the event a name.');
+            return null;
+        }
+        const index = presets.value.findIndex((p) => p.id === preset.id);
+        if (index >= 0) presets.value.splice(index, 1, preset);
+        else presets.value.push(preset);
+        await savePresets();
+        return preset;
+    }
+
+    async function deletePreset(id) {
+        presets.value = presets.value.filter((p) => p.id !== id);
+        if (!presets.value.length) presets.value = normalizePresets(null);
+        await savePresets();
+    }
+
+    /** Switch UWX into the preset's setup. Everything changed is remembered and put back on end(). */
+    async function start(presetId, { name = '' } = {}) {
+        if (active.value) {
+            toast.info(`${active.value.name} is already running.`);
+            return false;
+        }
+        const preset = presets.value.find((p) => p.id === presetId);
+        if (!preset) return false;
+        const before = {
+            groupRecruitEnabled: underweb.groupRecruitEnabled,
+            autoInviteEnabled: underweb.autoInviteEnabled,
+            inviteScope: underweb.inviteScope,
+            inviteMessageSlot: underweb.inviteMessageSlot
+        };
+        const startedAt = Date.now();
+        const title = String(name || preset.name).trim().slice(0, 80) || preset.name;
+        active.value = {
+            id: `${startedAt}`,
+            presetId: preset.id,
+            name: title,
+            status: preset.status,
+            startedAt,
+            before,
+            groupInvites: 0,
+            instanceInvites: 0,
+            attendance: createAttendance(startedAt)
+        };
+        await underweb.setInviteScope(preset.scope);
+        if (preset.messageSlot >= 0) await underweb.setInviteMessageSlot(preset.messageSlot);
+        await underweb.setGroupRecruitEnabled(preset.recruit);
+        await underweb.setAutoInviteEnabled(preset.autoInvite);
+        osc.setEventStatus(preset.status);
+        startTracking();
+        await configRepository.setString(CONFIG.active, JSON.stringify(active.value));
+        toast.success(`${title} started.`);
+        return true;
+    }
+
+    /** End the event: put settings back, save the recap. Returns the recap. */
+    async function end() {
+        if (!active.value) return null;
+        tick();
+        const run = active.value;
+        stopTracking();
+        const endedAt = Date.now();
+        const recap = buildRecap({ ...run, endedAt, staffIds: Array.from(network.staffUserIds || []) });
+        recap.id = run.id;
+        history.value = [recap, ...history.value].slice(0, MAX_HISTORY);
+        await configRepository.setString(CONFIG.history, JSON.stringify(history.value));
+        active.value = null;
+        await configRepository.setString(CONFIG.active, '');
+        osc.setEventStatus('');
+        const b = run.before || {};
+        await underweb.setGroupRecruitEnabled(Boolean(b.groupRecruitEnabled));
+        await underweb.setAutoInviteEnabled(Boolean(b.autoInviteEnabled));
+        if (b.inviteScope) await underweb.setInviteScope(b.inviteScope);
+        if (typeof b.inviteMessageSlot === 'number') await underweb.setInviteMessageSlot(b.inviteMessageSlot);
+        toast.success(`${run.name} ended — your usual settings are back.`);
+        return recap;
+    }
+
+    async function deleteRecap(id) {
+        history.value = history.value.filter((r) => r.id !== id);
+        await configRepository.setString(CONFIG.history, JSON.stringify(history.value));
+    }
+
+    async function copyRecap(recap) {
+        try {
+            await navigator.clipboard.writeText(formatRecap(recap));
+            toast.success('Recap copied — paste it in Discord.');
+        } catch {
+            toast.error('Could not copy the recap.');
+        }
+    }
+
+    return {
+        presets,
+        active,
+        history,
+        isRunning,
+        headcount,
+        elapsedMs,
+        staffHere,
+        uniqueCount,
+        init,
+        upsertPreset,
+        deletePreset,
+        start,
+        end,
+        deleteRecap,
+        copyRecap
+    };
+});
