+<template>
+    <Card class="uwx-card uwx-card-wide uwx-event-mode" :class="{ live: isRunning }">
+        <CardHeader>
+            <div class="flex items-start justify-between gap-4">
+                <div>
+                    <CardTitle>Event Mode</CardTitle>
+                    <CardDescription>
+                        One button sets UWX up for the night: group recruiting, friend invites with your message, and a chatbox line.
+                        Ending it puts your usual settings back and gives you a recap.
+                    </CardDescription>
+                </div>
+                <Badge :variant="isRunning ? 'default' : 'outline'">{{ isRunning ? 'LIVE' : 'STANDBY' }}</Badge>
+            </div>
+        </CardHeader>
+
+        <CardContent class="space-y-5">
+            <!-- Running -->
+            <section v-if="isRunning && active" class="uwx-em-live">
+                <div class="uwx-em-live-head">
+                    <span class="uwx-em-dot" />
+                    <div class="min-w-0 flex-1">
+                        <div class="uwx-em-kicker">LIVE NOW · {{ formatDuration(elapsedMs) }}</div>
+                        <h3>{{ active.name }}</h3>
+                        <p v-if="active.status" class="uwx-em-status"><i class="ri-chat-3-line" /> Chatbox: {{ active.status }}</p>
+                    </div>
+                    <Button variant="destructive" @click="confirmEnd">End event</Button>
+                </div>
+                <div class="uwx-em-stats">
+                    <div><strong>{{ headcount }}</strong><span>here now</span></div>
+                    <div><strong>{{ active.attendance.peak }}</strong><span>peak</span></div>
+                    <div><strong>{{ uniqueCount }}</strong><span>came by</span></div>
+                    <div class="group"><strong>{{ active.groupInvites }}</strong><span>group invites</span></div>
+                    <div class="instance"><strong>{{ active.instanceInvites }}</strong><span>friend invites</span></div>
+                </div>
+                <div class="uwx-em-staff">
+                    <span class="uwx-section-label">STAFF HERE</span>
+                    <span v-for="name in staffHere" :key="name" class="uwx-em-chip">{{ name }}</span>
+                    <span v-if="!staffHere.length" class="text-xs text-muted-foreground">No UnderWeb staff in the lobby right now.</span>
+                </div>
+            </section>
+
+            <!-- Standby -->
+            <template v-else>
+                <div class="flex flex-wrap items-center gap-2">
+                    <Input v-model="eventName" class="max-w-sm" placeholder="Name for tonight (optional), e.g. MVN #12" aria-label="Event name" />
+                    <span v-if="upcomingEvents.length" class="text-xs text-muted-foreground">or use an upcoming event:</span>
+                    <Button
+                        v-for="event in upcomingEvents.slice(0, 3)"
+                        :key="event.id"
+                        size="sm"
+                        variant="ghost"
+                        @click="eventName = event.title">
+                        {{ event.title }}
+                    </Button>
+                </div>
+
+                <div class="uwx-em-presets">
+                    <div v-for="preset in presets" :key="preset.id" class="uwx-em-preset">
+                        <template v-if="editingId !== preset.id">
+                            <div class="min-w-0">
+                                <strong class="block truncate">{{ preset.name }}</strong>
+                                <small class="block truncate text-muted-foreground">{{ preset.status || 'No chatbox line' }}</small>
+                            </div>
+                            <div class="uwx-em-tags">
+                                <span :class="preset.recruit ? 'on group' : 'off'">{{ preset.recruit ? 'Group invites' : 'No group invites' }}</span>
+                                <span :class="preset.autoInvite ? 'on instance' : 'off'">{{ preset.autoInvite ? 'Auto-invite ' + scopeLabel(preset.scope) : 'No auto friend invites' }}</span>
+                                <span v-if="preset.messageSlot >= 0" class="on instance">Message {{ preset.messageSlot + 1 }}</span>
+                            </div>
+                            <div class="flex gap-2">
+                                <Button class="flex-1" @click="startPreset(preset.id)"><i class="ri-play-fill" /> Start</Button>
+                                <Button variant="ghost" size="icon" aria-label="Edit" @click="beginEdit(preset)"><i class="ri-pencil-line" /></Button>
+                            </div>
+                        </template>
+                        <form v-else class="space-y-2" @submit.prevent="saveEdit">
+                            <Input v-model="draft.name" placeholder="Event type name" aria-label="Event type name" />
+                            <Input v-model="draft.status" placeholder="Chatbox line while it runs" aria-label="Chatbox line" />
+                            <label class="uwx-em-check"><Switch v-model="draft.recruit" /> Group invites (our instances only)</label>
+                            <label class="uwx-em-check"><Switch v-model="draft.autoInvite" /> Auto friend invites</label>
+                            <NativeSelect v-model="draft.scope" aria-label="Who to invite">
+                                <NativeSelectOption v-for="scope in scopes" :key="scope.id" :value="scope.id">{{ scope.label }}</NativeSelectOption>
+                            </NativeSelect>
+                            <NativeSelect v-model="draft.messageSlot" aria-label="Invite message">
+                                <NativeSelectOption :value="-1">Keep my current invite message</NativeSelectOption>
+                                <NativeSelectOption v-for="row in inviteMessages" :key="row.slot" :value="row.slot">
+                                    {{ row.slot + 1 }}. {{ row.message || '(empty)' }}
+                                </NativeSelectOption>
+                            </NativeSelect>
+                            <div class="flex gap-2">
+                                <Button type="submit" class="flex-1">Save</Button>
+                                <Button type="button" variant="ghost" @click="editingId = ''">Cancel</Button>
+                                <Button v-if="presets.length > 1" type="button" variant="ghost" size="icon" aria-label="Delete" @click="removePreset(preset.id)">
+                                    <i class="ri-delete-bin-line" />
+                                </Button>
+                            </div>
+                        </form>
+                    </div>
+                    <button type="button" class="uwx-em-preset uwx-em-new" @click="beginEdit(null)">
+                        <i class="ri-add-line" /> New event type
+                    </button>
+                </div>
+            </template>
+
+            <!-- History -->
+            <section v-if="history.length">
+                <div class="uwx-section-label">PAST EVENTS</div>
+                <div class="uwx-em-history">
+                    <div v-for="recap in history.slice(0, showAllHistory ? 30 : 5)" :key="recap.id" class="uwx-em-recap">
+                        <div class="min-w-0 flex-1">
+                            <strong class="block truncate">{{ recap.name }}</strong>
+                            <small class="text-muted-foreground">
+                                {{ formatDate(recap.startedAt) }} · {{ formatDuration(recap.durationMs) }} · peak {{ recap.peak }} ·
+                                {{ recap.unique }} came by · {{ recap.groupInvites }} group invites
+                            </small>
+                        </div>
+                        <Button size="sm" variant="outline" @click="copyRecap(recap)"><i class="ri-file-copy-line" /> Copy recap</Button>
+                        <Button size="icon" variant="ghost" aria-label="Delete recap" @click="deleteRecap(recap.id)"><i class="ri-close-line" /></Button>
+                    </div>
+                </div>
+                <Button v-if="history.length > 5" size="sm" variant="ghost" class="mt-2" @click="showAllHistory = !showAllHistory">
+                    {{ showAllHistory ? 'Show fewer' : `Show all ${history.length}` }}
+                </Button>
+            </section>
+        </CardContent>
+    </Card>
+</template>
+
+<script setup>
+    import { onMounted, reactive, ref } from 'vue';
+    import { storeToRefs } from 'pinia';
+    import { Badge } from '@/components/ui/badge';
+    import { Button } from '@/components/ui/button';
+    import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
+    import { Input } from '@/components/ui/input';
+    import { NativeSelect, NativeSelectOption } from '@/components/ui/native-select';
+    import { Switch } from '@/components/ui/switch';
+
+    import { formatDuration } from '../../shared/utils/uwxEvent';
+    import { useUwxEventModeStore } from '../../stores/uwxEventMode';
+    import { useUnderWebNetworkStore, useUnderWebStore, useModalStore } from '../../stores';
+
+    const store = useUwxEventModeStore();
+    const { presets, active, history, isRunning, headcount, elapsedMs, staffHere, uniqueCount } = storeToRefs(store);
+    const { inviteMessages } = storeToRefs(useUnderWebStore());
+    const { upcomingEvents } = storeToRefs(useUnderWebNetworkStore());
+    const modalStore = useModalStore();
+
+    const eventName = ref('');
+    const editingId = ref('');
+    const showAllHistory = ref(false);
+    const draft = reactive({ id: '', name: '', status: '', recruit: true, autoInvite: true, scope: 'favorites', messageSlot: -1 });
+
+    const scopes = [
+        { id: 'favorites', label: 'Favorite friends' },
+        { id: 'all-online', label: 'All online friends' },
+        { id: 'selected', label: 'Selected friends' },
+        { id: 'staff', label: 'UnderWeb staff' },
+        { id: 'creators', label: 'UnderWeb creators' },
+        { id: 'partners', label: 'UnderWeb partners' }
+    ];
+    const scopeLabel = (id) => (scopes.find((s) => s.id === id)?.label || id).replace(/^(Favorite|All|Selected)/, (w) => w.toLowerCase());
+
+    function beginEdit(preset) {
+        const p = preset || { id: '', name: '', status: '', recruit: true, autoInvite: true, scope: 'favorites', messageSlot: -1 };
+        Object.assign(draft, { ...p, messageSlot: Number(p.messageSlot) });
+        editingId.value = preset ? preset.id : '__new__';
+        if (!preset) presets.value.push({ ...draft, id: '__new__', name: 'New event' });
+    }
+
+    async function saveEdit() {
+        const isNew = editingId.value === '__new__';
+        if (isNew) presets.value = presets.value.filter((p) => p.id !== '__new__');
+        const saved = await store.upsertPreset({ ...draft, id: isNew ? '' : draft.id, messageSlot: Number(draft.messageSlot) });
+        if (saved) editingId.value = '';
+        else if (isNew) beginEdit(null);
+    }
+
+    async function removePreset(id) {
+        editingId.value = '';
+        if (id === '__new__') {
+            presets.value = presets.value.filter((p) => p.id !== '__new__');
+            return;
+        }
+        await store.deletePreset(id);
+    }
+
+    async function startPreset(id) {
+        const ok = await store.start(id, { name: eventName.value });
+        if (ok) eventName.value = '';
+    }
+
+    async function confirmEnd() {
+        const { ok } = await modalStore.confirm({
+            title: `End ${active.value?.name}?`,
+            description: 'UWX turns off the event setup, puts your usual invite and chatbox settings back, and saves a recap.',
+            confirmText: 'End event'
+        });
+        if (ok) await store.end();
+    }
+
+    const copyRecap = (recap) => store.copyRecap(recap);
+    const deleteRecap = (id) => store.deleteRecap(id);
+
+    function formatDate(ts) {
