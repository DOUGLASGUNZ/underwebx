+import { describe, expect, it } from 'vitest';
+import {
+    buildRecap,
+    createAttendance,
+    currentHeadcount,
+    DEFAULT_EVENT_PRESETS,
+    formatRecap,
+    normalizePreset,
+    normalizePresets,
+    trackAttendance
+} from '../uwxEvent';
+
+const MIN = 60 * 1000;
+const T0 = Date.parse('2026-10-16T00:00:00Z');
+const p = (n, name) => ({ userId: `usr_${String(n).padStart(8, '0')}-0000-0000-0000-000000000000`, displayName: name });
+const ME = p(0, 'Darko').userId;
+
+describe('uwxEvent', () => {
+    it('falls back to the UnderWeb presets and cleans bad input', () => {
+        expect(normalizePresets(null).map((x) => x.name)).toEqual(DEFAULT_EVENT_PRESETS.map((x) => x.name));
+        expect(normalizePreset({ name: '  ' })).toBeNull();
+        expect(normalizePreset({ name: 'Rave', scope: 'everyone', messageSlot: 99 })).toMatchObject({ scope: 'favorites', messageSlot: -1, id: 'rave' });
+    });
+
+    it('tracks time present, peak and leaving/rejoining, never counting yourself', () => {
+        const s = createAttendance(T0);
+        trackAttendance(s, [p(0, 'Darko'), p(1, 'Blooty'), p(2, 'Vex')], T0, { selfId: ME });
+        trackAttendance(s, [p(1, 'Blooty'), p(2, 'Vex'), p(3, 'Newbie')], T0 + 10 * MIN, { selfId: ME });
+        trackAttendance(s, [p(1, 'Blooty')], T0 + 20 * MIN, { selfId: ME });
+        trackAttendance(s, [p(1, 'Blooty'), p(2, 'Vex')], T0 + 30 * MIN, { selfId: ME });
+        expect(s.peak).toBe(3);
+        expect(currentHeadcount(s)).toBe(2);
+        expect(Object.keys(s.people)).toHaveLength(3);
+        expect(s.people[p(1).userId].ms).toBe(30 * MIN);
+        expect(s.people[p(2).userId].ms).toBe(20 * MIN); // left at 20, back at 30
+        expect(s.people[p(3).userId].ms).toBe(10 * MIN);
+    });
+
+    it('builds a recap with staff and longest stayers, and a Discord-ready text without IDs', () => {
+        const s = createAttendance(T0);
+        trackAttendance(s, [p(1, 'Blooty'), p(2, 'Vex')], T0);
+        trackAttendance(s, [p(1, 'Blooty'), p(2, 'Vex')], T0 + 90 * MIN);
+        const recap = buildRecap({
+            name: 'Music Video Night',
+            startedAt: T0,
+            endedAt: T0 + 95 * MIN,
+            groupInvites: 4,
+            instanceInvites: 12,
+            attendance: s,
+            staffIds: [p(1).userId]
+        });
+        expect(recap).toMatchObject({ peak: 2, unique: 2, stayedFiveMinutes: 2, staffPresent: ['Blooty'], groupInvites: 4 });
+        const text = formatRecap(recap);
+        expect(text).toContain('**Music Video Night**');
+        expect(text).toContain('1h 35m');
+        expect(text).toContain('Staff: Blooty');
+        expect(text).not.toMatch(/usr_|wrld_/);
+    });
+});
