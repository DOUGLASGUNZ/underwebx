+    /**
+     * Call an UnderWeb edge function as you (signs you back in from the saved session first).
+     * Never throws for HTTP errors: returns { status, json }. status 0 = not signed in / offline.
+     * @param {string} name e.g. 'uwx-releases'
+     * @param {RequestInit} [options]
+     */
+    async function callFunction(name, options = {}) {
+        await init();
+        if (!signedIn.value && !(await refresh())) return { status: 401, json: { error: 'sign_in_required' } };
+        if (Date.now() > expiresAt.value - 60 * 1000) await refresh();
+        const doFetch = () =>
+            fetch(`${UNDERWEB_SUPABASE_URL}/functions/v1/${name}`, {
+                ...options,
+                headers: { apikey: UNDERWEB_ANON_KEY, Authorization: `Bearer ${accessToken.value}`, ...(options.headers || {}) }
+            });
+        try {
+            let response = await doFetch();
+            if (response.status === 401 && (await refresh())) response = await doFetch();
+            const json = await response.json().catch(() => null);
+            return { status: response.status, json };
+        } catch {
+            return { status: 0, json: { error: 'offline' } };
+        }
+    }
