+import { describe, expect, test, vi } from 'vitest';
+
+import { createRootReporter, parseRootLine } from '../uwxRoot';
+
+describe('UWX root access reports', () => {
+    test('parses the world line, names with spaces and Cyrillic letters included', () => {
+        expect(parseRootLine('UWRoot Dаrko\t915006-329339')).toEqual({ name: 'Dаrko', code: '915006-329339' });
+        expect(parseRootLine('UWRoot Some Body Here\t000001-999978\r\n')).toEqual({ name: 'Some Body Here', code: '000001-999978' });
+    });
+
+    test('ignores anything else', () => {
+        expect(parseRootLine('VideoPlay(PyPyDance) "x"')).toBeNull();
+        expect(parseRootLine('UWRoot NoCode')).toBeNull();
+        expect(parseRootLine('UWRoot Name\tabc')).toBeNull();
+        expect(parseRootLine('UWRoot \t123456-123456')).toBeNull();
+        expect(parseRootLine('UWRoot ' + 'x'.repeat(65) + '\t123456-123456')).toBeNull();
+        expect(parseRootLine(undefined)).toBeNull();
+    });
+
+    test('sends only name + code, once per name', async () => {
+        const fetchImpl = vi.fn(async () => ({ ok: true }));
+        const report = createRootReporter({ fetchImpl, url: 'https://example.test/report' });
+        expect(await report('UWRoot Vex\t123456-654321')).toBe(true);
+        expect(await report('UWRoot Vex\t123456-654321')).toBe(false);
+        expect(fetchImpl).toHaveBeenCalledTimes(1);
+        const [url, init] = fetchImpl.mock.calls[0];
+        expect(url).toBe('https://example.test/report');
+        expect(JSON.parse(init.body)).toEqual({ name: 'Vex', code: '123456-654321' });
+    });
+
+    test('retries a name after a network failure', async () => {
+        const fetchImpl = vi.fn().mockRejectedValueOnce(new Error('offline')).mockResolvedValue({ ok: true });
+        const report = createRootReporter({ fetchImpl });
+        expect(await report('UWRoot Vex\t123456-654321')).toBe(false);
+        expect(await report('UWRoot Vex\t123456-654321')).toBe(true);
+    });
+});
diff --git a/src/shared/utils/uwxRoot.js b/src/shared/utils/uwxRoot.js
new file mode 100644
index 0000000..983b9ca
--- /dev/null
+++ b/src/shared/utils/uwxRoot.js
@@ -0,0 +1,46 @@
+// UnderWeb hub world: the permanent ROOT ACCESS list on THE CORE board.
+//
+// When someone in your instance has finished CLEARANCE, the hub world writes
+//   [VRCX] UWRoot <their display name><TAB><code>
+// to VRChat's log. UWX passes that name + code to underweb.cloud, which checks the
+// code (only the world can make it) and adds the name to the list. Nothing else is
+// sent: no instance, no world, no other players, and nothing about you.
+
+export const ROOT_REPORT_URL = 'https://pxipclkptxpqukefwexh.supabase.co/functions/v1/hub-root/report';
+
+/** "UWRoot Name With Spaces\t123456-654321" -> { name, code }, or null if it isn't one. */
+export function parseRootLine(data) {
+    const text = String(data ?? '');
+    if (!text.startsWith('UWRoot ')) return null;
+    const rest = text.slice(7).replace(/[\r\n]+$/, '');
+    const tab = rest.lastIndexOf('\t');
+    if (tab <= 0) return null;
+    const name = rest.slice(0, tab);
+    const code = rest.slice(tab + 1).trim();
+    if (!name || name.length > 64 || /[\t\r\n]/.test(name)) return null;
+    if (!/^\d{6}-\d{6}$/.test(code)) return null;
+    return { name, code };
+}
+
+/** One report per name per UWX session (the server ignores repeats anyway). */
+export function createRootReporter({ fetchImpl = (...a) => fetch(...a), url = ROOT_REPORT_URL } = {}) {
+    const sent = new Set();
+    return async function report(data) {
+        const entry = parseRootLine(data);
+        if (!entry || sent.has(entry.name)) return false;
+        sent.add(entry.name);
+        try {
+            const res = await fetchImpl(url, {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify(entry)
+            });
+            return !!res?.ok;
+        } catch {
+            sent.delete(entry.name); // offline: try again the next time the world logs it
+            return false;
+        }
+    };
+}
+
+export const reportRootAccess = createRootReporter();
